    1           =00000002               ST4_UNIT    equ     2
    2                                           include "YX6.S"
    1                                   ; -----------------------------------------------------------------------------
    2                                   ; YX6.S - streaming YM chiptune player for the plain 68000 (Atari ST)
    3                                   ;
    4                                   ; By Robbert van Dalen. Plays a .yx6 file: eighteen streams - the fourteen
    5                                   ; YM2149 registers plus each effect slot's control byte and timer count -
    6                                   ; every one packed as its own embedded ST4 container and decoded through its
    7                                   ; own small ring by ST4_wrap.S. Written by Claude (Anthropic's Claude Code)
    8                                   ; under Robbert's direction, based on ZX1 v1.5 by Einar Saukas and inspired
    9                                   ; by Steve Clarets' MinYMiser. Use it freely, including commercially, as long
   10                                   ; as your documentation says you used ZX1 through ST4 (see LICENSE).
   11                                   ;
   12                                   ; It plays the fourteen standard sound registers, loops, and plays the YM
   13                                   ; special effects - digidrums, SID voices, the sync-buzzer - on MFP Timers
   14                                   ; A and D. Sinus-SID, which no player has ever implemented, is dropped at
   15                                   ; pack time. EFFECTS.md, next to this file, holds the design.
   16                                   ;
   17                                   ; REQUIRES ST4_wrap.S, built for the SAME unit size the tune was packed with
   18                                   ; (yx6 -kK; byte units unless the packer was told otherwise). Include both, in
   19                                   ; either order, with the unit size defined first:
   20                                   ;
   21                                   ;       ST4_UNIT    equ     1
   22                                   ;               include "YX6.S"
   23                                   ;               include "ST4_wrap.S"
   24                                   ;
   25                                   ; YX6 calls ST4_init and ST4_resume by label, and YX6_init checks every
   26                                   ; section's ST4 signature against this build's unit size - a tune packed for
   27                                   ; a different one is rejected, not garbled.
   28                                   ;
   29                                   ; -----------------------------------------------------------------------------
   30                                   ; THE DESIGN, in one paragraph. A tune is O frames long. Each of the eighteen
   31                                   ; streams gets its own ring of N bytes and its own saved decoder state, and
   32                                   ; is decoded C values at a time (C = 24 by default). On every VBL the player
   33                                   ; uses one value from each of the eighteen rings and refills exactly one
   34                                   ; stream - stream k on the VBL where the frame number modulo C is k. With
   35                                   ; C >= 18 every stream is refilled once per C frames, one refill per VBL, so
   36                                   ; the work per frame is flat: the effect stage, fourteen register writes and
   37                                   ; one ST4_resume of C bytes. Since C divides N and a call never reaches the
   38                                   ; ring end, ST4_wrap.S is the decoder that fits: the player counts the calls
   39                                   ; itself and wraps the write pointer when it lands on the ring end.
   40                                   ;
   41                                   ; EFFECTS. The last four rings carry each slot's effect code and timer count,
   42                                   ; one value per frame like everything else. Before the burst the effect stage
   43                                   ; pops them and programs Timers A and D, whose tick handlers - digidrum, SID
   44                                   ; square, sync-buzzer - write the sound chip between frames. A drum start
   45                                   ; also edits this frame's ring bytes (the sample number, the mixer); every
   46                                   ; such edit is logged and undone right after the burst, because a ring is
   47                                   ; decode history that later matches copy from.
   48                                   ;
   49                                   ; LOOPING. A packed stream can only be restarted from its beginning, so the packer
   50                                   ; splits every register at the loop frame L: an intro stream for frames [0, L)
   51                                   ; and a loop stream for [L, O). When a register's section runs out mid-refill
   52                                   ; the player starts its loop stream over - a fresh decoder writing on into the
   53                                   ; same ring - so the rings always hold one continuous sequence of values and
   54                                   ; the read side never learns that anything happened. Nothing requires L to fall
   55                                   ; on a group boundary: a refill that straddles the split simply decodes two
   56                                   ; pieces. A tune that loops from frame 0 has no intro streams at all.
   57                                   ;
   58                                   ; -----------------------------------------------------------------------------
   59                                   ; USING IT
   60                                   ;
   61                                   ;       lea     song,a0                 ; the .yx6 file, loaded anywhere
   62                                   ;       lea     workspace,a1            ; even address, YX6_SIZE bytes
   63                                   ;       bsr     YX6_init                ; d0 = 0 when the file was accepted
   64                                   ;       tst.l   d0
   65                                   ;       bne     bad_file
   66                                   ;   vbl:                                ; once per frame, in supervisor mode
   67                                   ;       lea     workspace,a0
   68                                   ;       bsr     YX6_play                ; d0 = 0 played, 1 wrapped, -1 ended
   69                                   ;       ...
   70                                   ;       lea     workspace,a0
   71                                   ;       bsr     YX6_stop                ; chip quiet, timers handed back
   72                                   ;
   73                                   ; The workspace holds the player's own fields, the eighteen decoder states and
   74                                   ; the eighteen rings, so its size depends on the ring size in the file:
   75                                   ;
   76                                   ;   YX6_SIZE = YX6_FIXED + 18 * N       ; 1222 + 18 * N bytes
   77                                   ;
   78                                   ; For the default 960-byte rings that is 18502 bytes. A program that knows N
   79                                   ; at build time can reserve it with
   80                                   ;
   81                                   ;       ds.b    YX6_FIXED+(YX6_STREAMS*960)
   82                                   ;
   83                                   ; where the parentheses matter: rmac evaluates expressions left to right.
   84                                   ;
   85                                   ; CALLS AND REGISTERS
   86                                   ;
   87                                   ;   YX6_init   in   a0 = .yx6 file, at an even address, a1 = workspace
   88                                   ;              out  d0 = 0 accepted, -1 not a v4 yx6 file with 18 streams
   89                                   ;                        packed at this build's unit size
   90                                   ;              Claims MFP Timers A and D for the effect slots: stops them,
   91                                   ;              parks their vectors, drops stale pendings, enables and
   92                                   ;              unmasks both. It saves NOTHING - the machine state is the
   93                                   ;              host's, see assumption 5. Timer B stays free for rasters,
   94                                   ;              Timer C stays the system's. Pair every init with a stop
   95                                   ;   YX6_play   in   a0 = workspace
   96                                   ;              out  d0 = 0 played a frame
   97                                   ;                   d0 = 1 played a frame, and that frame ended the tune: the
   98                                   ;                          next one is the loop frame L
   99                                   ;                   d0 = -1 the tune is over and nothing was written, which
  100                                   ;                          only a tune packed with -o can report
  101                                   ;   YX6_stop   in   a0 = workspace
  102                                   ;              Quiesces: stops both timers, disables their interrupts,
  103                                   ;              drops pendings, silences the three voices. Restores nothing
  104                                   ;   CLOBBERED  d0-d5, a0-a5. d6, d7 and a6 survive, as with ST4 - whose
  105                                   ;              decoder state spans a4 and a5, which is why they no longer do.
  106                                   ;
  107                                   ; YX6_play writes to the sound chip at $FFFF8800, so it must run in supervisor
  108                                   ; mode - which a VBL handler already does. It masks interrupts around the
  109                                   ; fourteen writes, because selecting a register and writing it are two bus
  110                                   ; cycles and TOS's own handlers use the chip too. Its effect stage programs
  111                                   ; the two timers YX6_init claimed, vectors included, and beyond those it
  112                                   ; performs no side effect: no memory allocation, nothing outside the
  113                                   ; workspace, the chip and the claimed timers.
  114                                   ;
  115                                   ; ASSUMPTIONS (unchecked beyond the magic, version and stream count):
  116                                   ;
  117                                   ;   1. the file comes from the yx6 packer, which enforces C >= 18, N mod C = 0,
  118                                   ;      N >= 2C, offsets that stay inside the ring, and - at ST4_UNIT above 1 -
  119                                   ;      a tune length, loop frame and C that are whole units, so every budget
  120                                   ;      this player passes to the decoder divides cleanly
  121                                   ;   2. the workspace is at an even address and large enough for the file's N
  122                                   ;   3. YX6_play is called once per frame and never after it returns -1.
  123                                   ;      Calling it again is harmless - it returns -1 and writes nothing - which
  124                                   ;      is what keeps ST4_wrap's "never call the decoder again" rule intact
  125                                   ;   4. a looping tune plays for as long as you keep calling: d0 = 1 marks each
  126                                   ;      time round, and YX6_init is only needed to start again from frame 0
  127                                   ;   5. the HOST owns the machine state - the player saves and restores none
  128                                   ;      of it. A host that wants the machine back afterwards saves, around
  129                                   ;      init..stop, exactly what the player touches: the vectors $134 and
  130                                   ;      $110, TACR, TADR, TDDR, TCDCR's low (Timer D) nibble, bit 5 of IERA
  131                                   ;      and IMRA, bit 4 of IERB and IMRB - and, built with YX6_SUPER_HOST,
  132                                   ;      the USP, which the drum tick parks a0 in. A demo that has already
  133                                   ;      taken the machine over saves nothing at all. YX6_player.S is the
  134                                   ;      worked example of the polite version
  135                                   ; -----------------------------------------------------------------------------
  136                                   
  137                                   ; A host that never runs user-mode code while the player is live - a demo
  138                                   ; under its own takeover, say - may define YX6_SUPER_HOST equ 1 before
  139                                   ; including this file: the drum tick then parks a0 in the then-unused USP
  140                                   ; (4 cycles each way instead of 12 through the stack). The park restores a0
  141                                   ; but not the USP: a host that ever returns to user mode must save its USP
  142                                   ; before YX6_init and restore it after YX6_stop, with the rest of the
  143                                   ; machine state assumption 5 lists. Default off, because a program that
  144                                   ; hooks the VBL from user mode has a live USP at every tick.
  145                                           .if ^^defined YX6_SUPER_HOST
  146                                 -         .else
  147           =00000000               YX6_SUPER_HOST  equ     0
  148                                           .endif
  149                                   
  150           =00000012               YX6_STREAMS     equ     18              ; R0..R13, then E1 T1 E2 T2: the two
  151                                                                           ; effect slots' control and timer-count
  152                                                                           ; streams, decoded like any register
  153           =0000000E               YX6_REGISTERS   equ     14              ; the streams the burst writes
  154           =00000040               YX6_STATE_SIZE  equ     64              ; per stream, so the index is a shift
  155                                                                           ; both ways: *64 in, /16 back to *4
  156                                   
  157                                   ; Workspace layout. Counters that a frame touches are kept in the form the
  158                                   ; frame wants them in: a pointer to walk, and a countdown to test against zero.
  159           =00000000               YX6_CURSOR      equ     0               ; long  this frame's byte in ring 0
  160           =00000004               YX6_LEFTFR      equ     4               ; long  frames before the tune ends
  161           =00000008               YX6_NEXT        equ     8               ; long  values decoded so far
  162           =0000000C               YX6_RINGEND     equ     12              ; long  one past ring 0, where it wraps
  163           =00000010               YX6_RINGS       equ     16              ; long  base of the ring area
  164           =00000014               YX6_FILE        equ     20              ; long  the .yx6 file
  165           =00000018               YX6_TOTAL       equ     24              ; long  O, the tune length in frames
  166           =0000001C               YX6_LOOPLEN     equ     28              ; long  O - L, zero when it does not loop
  167           =00000020               YX6_LOOP        equ     32              ; long  L, read at init to split sections
  168           =00000024               YX6_N           equ     36              ; word  ring size N
  169           =00000026               YX6_C           equ     38              ; word  values per call C
  170           =00000028               YX6_SLOT        equ     40              ; word  refill slot, 0..C-1
  171           =0000002A               YX6_INDEX       equ     42              ; word  stream index, during init only
  172           =0000002C               YX6_LOOPS       equ     44              ; word  nonzero when the tune loops
  173           =0000002E               YX6_EFXOFF      equ     46              ; long  14*N: the cursor's ring to E1's
  174           =00000032               YX6_R7OFF       equ     50              ; long  7*N: the cursor's ring to R7's
  175                                   ; The sanitize log. The effect stage edits ring bytes so the burst plays a
  176                                   ; sanitized frame - but the ring is decode history, and a later match may
  177                                   ; copy from any byte of it. So every edit is recorded here and undone right
  178                                   ; after the burst: the chip sees the edit, the ring never keeps it.
  179           =00000036               YX6_PATCHES     equ     54              ; byte  how many edits this frame, 0..3
  180           =00000037               YX6_PATCH_VAL   equ     55              ; 3 bytes: the originals
  181           =0000003A               YX6_PATCH_ADDR  equ     58              ; 3 longs: where they go back
  182           =00000046               YX6_STATE       equ     70              ; 18 decoder states, from an even base
  183                                   
  184                                   ; Each effect slot's own state - its code and count from last frame, its
  185                                   ; parameter ring offset, its timer and its handlers - lives in a descriptor
  186                                   ; in the code blob (yx6_desc1/2 below), so ONE slot machine serves both
  187                                   ; slots. The hardware addresses are words: movea.w sign-extends $FAxx to
  188                                   ; $FFFFFAxx. The two run-time pointers are filled in by YX6_init.
  189           =00000000               SD_ELAST        equ     0               ; byte  the slot's code last frame
  190           =00000001               SD_TLAST        equ     1               ; byte  the count its timer last got:
  191                                                                           ; a held effect reloads its data
  192                                                                           ; register only when the count CHANGES,
  193                                                                           ; because a write that lands while the
  194                                                                           ; counter passes 01 loads an
  195                                                                           ; indeterminate value - pitch glitches
  196           =00000002               SD_CTRL         equ     2               ; word  timer control register
  197           =00000004               SD_DATA         equ     4               ; word  timer data register
  198           =00000006               SD_VEC          equ     6               ; word  timer vector
  199           =00000008               SD_PARM         equ     8               ; long  (8+voice)*N: the cursor's ring
  200                                                                           ;       to the slot's parameter byte
  201           =0000000C               SD_ISR          equ     12              ; long  the slot's tick handlers
  202           =00000010               SD_OTHER        equ     16              ; long  the other slot's descriptor
  203                                   ; rmac evaluates left to right, so the parentheses here are load-bearing:
  204                                   ; without them this reads as (YX6_STATE+YX6_STREAMS)*YX6_STATE_SIZE.
  205           =000004C6               YX6_FIXED       equ     YX6_STATE+(YX6_STREAMS*YX6_STATE_SIZE)
  206                                   
  207                                   ; One saved ST4_wrap state, plus the ring bounds the wrap check needs. The
  208                                   ; first four longs are in movem order - d1, d2, then a0, a1 - so that much of
  209                                   ; the decoder state loads and stores in one instruction; the three extra
  210                                   ; stream pointers ST4 carries (literals, byte offsets, word offsets) follow.
  211           =00000000               YS_D1           equ     0               ; long  d1, -ring.low : remaining
  212           =00000004               YS_D2           equ     4               ; long  d2, N : signed offset
  213           =00000008               YS_INPUT        equ     8               ; long  a0, stream A position
  214           =0000000C               YS_WRITE        equ     12              ; long  a1, write pointer
  215           =00000010               YS_LIT          equ     16              ; long  a2, stream B position
  216           =00000014               YS_BOFF         equ     20              ; long  a4, stream C position
  217           =00000018               YS_WOFF         equ     24              ; long  a5, stream D position
  218           =0000001C               YS_QUEUE        equ     28              ; word  d0, bit queue
  219           =00000020               YS_START        equ     32              ; long  this stream's ring
  220           =00000024               YS_END          equ     36              ; long  one past its last byte
  221           =00000028               YS_LEFT         equ     40              ; long  values left in the current section
  222                                   ; The movem block starts at the top of the state, so the two movems address it
  223                                   ; as plain (a2) - see the note where they are used.
  224                                   
  225                                   ; The .yx6 header, as written by the packer.
  226           =00000000               YH_MAGIC        equ     0
  227           =00000004               YH_VERSION      equ     4
  228           =00000006               YH_FLAGS        equ     6
  229           =00000008               YH_FRAMES       equ     8
  230           =0000000C               YH_PLAYER_HZ    equ     12
  231           =0000000E               YH_STREAM_COUNT equ     14
  232           =00000010               YH_RING         equ     16
  233           =00000012               YH_CHUNK        equ     18
  234           =00000014               YH_LOOP         equ     20
  235           =00000018               YH_CLOCK        equ     24
  236           =0000001C               YH_DRUMS        equ     28              ; long: the drum table, 0 when none
  237           =00000020               YH_DRUMCOUNT    equ     32              ; word
  238           =00000022               YH_INTRO_TABLE  equ     34              ; 18 offsets: the frames before the loop
  239           =0000006A               YH_LOOP_TABLE   equ     106             ; 18 offsets: the frames from L on
  240                                   
  241           =59583621               YX6_MAGIC       equ     $59583621       ; 'YX6!'
  242           =00000004               YX6_VERSION     equ     4               ; 4: effect streams and the drum table
  243           =00000001               YX6_FLAG_LOOPS  equ     1               ; header flag: the tune loops
  244           =FFFF8800               YX6_PSG         equ     $FFFF8800       ; select/read at +0, write at +2
  245           =000000FF               YX6_NO_ENV      equ     $FF             ; R13 value meaning "leave it alone"
  246           =000000C0               YX6_PORTS       equ     $C0             ; R7 bits the ST needs as outputs
  247           =00000007               YX6_MIXER       equ     7
  248           =0000000D               YX6_ENVELOPE    equ     13
  249                                   
  250                                   ; -----------------------------------------------------------------------------
  251                                   ; YX6_WRITE: send one register's value straight from its ring to the sound
  252                                   ; chip, then step a1 on to the next register's ring.
  253                                   ;
  254                                   ; Two moves and an add, with the register number assembled in as an immediate:
  255                                   ; nothing is tested, nothing is counted, and the value never passes through a
  256                                   ; data register. Registers 7 and 13 need their values touched, so they are
  257                                   ; written out of line rather than through this macro.
  258                                   ;
  259                                   ; Skipping a register whose value has not changed was measured and dropped: a
  260                                   ; sound-chip access on an ST costs about 1.5 cycles more than a RAM one, so the
  261                                   ; compare that would save the write costs about as much as the write.
  262                                   ; -----------------------------------------------------------------------------
  263                                           .macro YX6_WRITE number
  264                                 .         move.b  #\number,(a2)           ; select
  265                                 .         move.b  (a1),2(a2)              ; and write
  266                                 .         adda.l  d3,a1
  267                                 .         .endm
  268                                   
  269                                   ; Jump table: bra.w keeps 4-byte slots for a program that loads YX6 as a blob.
  270  00000000  6000xxxx                               bra.w   YX6_init
  271  00000004  6000xxxx                               bra.w   YX6_play
  272  00000008  6000xxxx                               bra.w   YX6_stop
  273                                   
  274                                   ; -----------------------------------------------------------------------------
  275                                   ; YX6_init: a0 = .yx6 file, a1 = workspace. Sets up eighteen decoders, decodes
  276                                   ; each stream's first group so frame 0 can be played immediately, and takes
  277                                   ; over MFP Timers A and D for the effect slots.
  278                                   ; -----------------------------------------------------------------------------
  279                                   YX6_init:
  280  0000000C  2649                           movea.l a1,a3                   ; a3 is the workspace throughout
  281  0000000E  27480014                       move.l  a0,YX6_FILE(a3)
  282  00000012  0C9059583621                   cmp.l   #YX6_MAGIC,YH_MAGIC(a0)
  283  00000018  6600xxxx                       bne     .rejected
  284  0000001C  0C6800040004                   cmp.w   #YX6_VERSION,YH_VERSION(a0)
  285  00000022  6600xxxx                       bne     .rejected
  286  00000026  0C680012000E                   cmp.w   #YX6_STREAMS,YH_STREAM_COUNT(a0)
  287  0000002C  6600xxxx                       bne     .rejected
  288                                   
  289  00000030  276800080018                   move.l  YH_FRAMES(a0),YX6_TOTAL(a3)
  290  00000036  276800140020                   move.l  YH_LOOP(a0),YX6_LOOP(a3)
  291  0000003C  376800100024                   move.w  YH_RING(a0),YX6_N(a3)
  292  00000042  376800120026                   move.w  YH_CHUNK(a0),YX6_C(a3)
  293  00000048  30280006                       move.w  YH_FLAGS(a0),d0
  294  0000004C  C07C0001                       and.w   #YX6_FLAG_LOOPS,d0
  295  00000050  3740002C                       move.w  d0,YX6_LOOPS(a3)
  296  00000054  276800080004                   move.l  YH_FRAMES(a0),YX6_LEFTFR(a3)
  297  0000005A  426B0028                       clr.w   YX6_SLOT(a3)
  298  0000005E  43EB04C6                       lea     YX6_FIXED(a3),a1        ; the rings follow the decoder states
  299  00000062  27490010                       move.l  a1,YX6_RINGS(a3)
  300  00000066  2689                           move.l  a1,YX6_CURSOR(a3)       ; frame 0 is the first byte of ring 0
  301  00000068  7000                           moveq   #0,d0
  302  0000006A  30280010                       move.w  YH_RING(a0),d0
  303  0000006E  D089                           add.l   a1,d0
  304  00000070  2740000C                       move.l  d0,YX6_RINGEND(a3)      ; where the cursor goes back to the top
  305                                   
  306  00000074  202B0018                       move.l  YX6_TOTAL(a3),d0        ; the loop section is O - L frames long,
  307  00000078  90AB0020                       sub.l   YX6_LOOP(a3),d0         ; and empty when the tune plays once
  308  0000007C  4A6B002C                       tst.w   YX6_LOOPS(a3)
  309  00000080  66xx                           bne.s   .loop_length
  310  00000082  7000                           moveq   #0,d0
  311                                   .loop_length:
  312  00000084  2740001C                       move.l  d0,YX6_LOOPLEN(a3)
  313                                   
  314  00000088  7200                           moveq   #0,d1                   ; the first group is C values, or the
  315  0000008A  322B0026                       move.w  YX6_C(a3),d1            ; whole tune when that is shorter and
  316  0000008E  4A6B002C                       tst.w   YX6_LOOPS(a3)           ; there is no loop to carry on into
  317  00000092  66xx                           bne.s   .first_group
  318  00000094  202B0018                       move.l  YX6_TOTAL(a3),d0
  319  00000098  B081                           cmp.l   d1,d0
  320  0000009A  64xx                           bcc.s   .first_group
  321  0000009C  2200                           move.l  d0,d1
  322                                   .first_group:
  323  0000009E  27410008                       move.l  d1,YX6_NEXT(a3)         ; values decoded once init is done
  324                                   
  325  000000A2  426B002A                       clr.w   YX6_INDEX(a3)           ; the loop counter lives here: every
  326                                   .stream:                                ; register is state during the calls
  327  000000A6  302B002A                       move.w  YX6_INDEX(a3),d0
  328  000000AA  ED48                           lsl.w   #6,d0                   ; * YX6_STATE_SIZE
  329  000000AC  45F30046                       lea     YX6_STATE(a3,d0.w),a2
  330  000000B0  7600                           moveq   #0,d3
  331  000000B2  362B0024                       move.w  YX6_N(a3),d3
  332  000000B6  302B002A                       move.w  YX6_INDEX(a3),d0
  333  000000BA  C0C3                           mulu.w  d3,d0                   ; this stream's ring is the k'th
  334  000000BC  226B0010                       movea.l YX6_RINGS(a3),a1
  335  000000C0  D3C0                           adda.l  d0,a1
  336  000000C2  25490020                       move.l  a1,YS_START(a2)
  337  000000C6  2549000C                       move.l  a1,YS_WRITE(a2)
  338  000000CA  2009                           move.l  a1,d0
  339  000000CC  D083                           add.l   d3,d0
  340  000000CE  25400024                       move.l  d0,YS_END(a2)
  341                                   
  342                                   ; A tune that loops from frame 0 has no intro streams, so its registers start
  343                                   ; on the loop section - which is then the whole tune. The load of L comes
  344                                   ; last because it is the branch condition: a move to a data register writes
  345                                   ; the flags, a lesson the original version of this choice taught by always
  346                                   ; picking the intro table and leaning on the section-exhausted path to
  347                                   ; recover. The signature check below ended that arrangement.
  348  000000D2  383C0022                       move.w  #YH_INTRO_TABLE,d4
  349  000000D6  202B0020                       move.l  YX6_LOOP(a3),d0
  350  000000DA  66xx                           bne.s   .section                ; L != 0: the intro covers [0, L)
  351  000000DC  383C006A                       move.w  #YH_LOOP_TABLE,d4
  352  000000E0  202B001C                       move.l  YX6_LOOPLEN(a3),d0
  353                                   .section:
  354  000000E4  25400028                       move.l  d0,YS_LEFT(a2)          ; values before this stream runs out
  355                                   
  356  000000E8  302B002A                       move.w  YX6_INDEX(a3),d0
  357  000000EC  E548                           lsl.w   #2,d0                   ; the tables hold long offsets
  358  000000EE  D044                           add.w   d4,d0
  359  000000F0  206B0014                       movea.l YX6_FILE(a3),a0
  360  000000F4  20300000                       move.l  0(a0,d0.w),d0
  361  000000F8  D1C0                           adda.l  d0,a0                   ; the section's ST4 container
  362  000000FA  0C90xxxxxxxx                   cmp.l   #ST4_SIGNATURE,(a0)     ; magic, version and unit in one compare:
  363  00000100  6600xxxx                       bne     .rejected               ; a tune packed for another unit size
  364                                   
  365                                   ; Open the container. The state block goes to the stack; ST4_init clobbers
  366                                   ; a3, so the workspace pointer does too.
  367  00000104  2F0A                           move.l  a2,-(sp)
  368  00000106  2F0B                           move.l  a3,-(sp)
  369  00000108  6100xxxx                       bsr     yx6_open
  370  0000010C  265F                           movea.l (sp)+,a3
  371                                   
  372  0000010E  225F                           movea.l (sp)+,a1                ; the state block; a1 is recomputed
  373  00000110  23480008                       move.l  a0,YS_INPUT(a1)         ; every time round this loop
  374  00000114  234A0010                       move.l  a2,YS_LIT(a1)
  375  00000118  234C0014                       move.l  a4,YS_BOFF(a1)
  376  0000011C  234D0018                       move.l  a5,YS_WOFF(a1)
  377  00000120  3340001C                       move.w  d0,YS_QUEUE(a1)
  378  00000124  2281                           move.l  d1,YS_D1(a1)
  379  00000126  23420004                       move.l  d2,YS_D2(a1)
  380                                   
  381  0000012A  302B002A                       move.w  YX6_INDEX(a3),d0        ; and its first group
  382  0000012E  ED48                           lsl.w   #6,d0
  383  00000130  362B000A                       move.w  YX6_NEXT+2(a3),d3       ; C, or fewer: both fit a word
  384  00000134  6100xxxx                       bsr     YX6_fill
  385  00000138  526B002A                       addq.w  #1,YX6_INDEX(a3)
  386  0000013C  0C6B0012002A                   cmp.w   #YX6_STREAMS,YX6_INDEX(a3)
  387  00000142  6600FF62                       bne     .stream
  388                                   
  389                                   ; The cursor reaches the effect and mixer rings by fixed hops, computed once.
  390  00000146  302B0024                       move.w  YX6_N(a3),d0
  391  0000014A  C0FC0007                       mulu.w  #7,d0
  392  0000014E  27400032                       move.l  d0,YX6_R7OFF(a3)
  393  00000152  D080                           add.l   d0,d0                   ; and 14*N, from the same mulu
  394  00000154  2740002E                       move.l  d0,YX6_EFXOFF(a3)
  395  00000158  422B0036                       clr.b   YX6_PATCHES(a3)
  396  0000015C  41FAxxxx                       lea     yx6_drums(pc),a0
  397  00000160  4210                           clr.b   (a0)
  398  00000162  6100xxxx                       bsr     yx6_link                ; descriptors: pointers and last codes
  399                                   
  400                                   ; Claim Timers A and D: park our handlers on the vectors and leave both
  401                                   ; timers stopped but enabled and unmasked. Nothing is saved - the machine
  402                                   ; state is the host's, see assumption 5 in the header. bset/bclr only:
  403                                   ; Timer C's bits and the ACIA's live in the same registers.
  404  00000166  40E7                           move.w  sr,-(sp)
  405  00000168  007C0700                       ori.w   #$0700,sr
  406  0000016C  4238FA19                       clr.b   $FFFFFA19.w             ; Timer A stopped
  407  00000170  023800F0FA1D                   andi.b  #$F0,$FFFFFA1D.w        ; Timer D stopped; Timer C untouched
  408  00000176  41FAxxxx                       lea     yx6_parkA(pc),a0
  409  0000017A  21C80134                       move.l  a0,$134.w
  410  0000017E  41FAxxxx                       lea     yx6_parkD(pc),a0
  411  00000182  21C80110                       move.l  a0,$110.w
  412  00000186  08B80005FA0B                   bclr    #5,$FFFFFA0B.w          ; drop stale pendings
  413  0000018C  08B80004FA0D                   bclr    #4,$FFFFFA0D.w
  414  00000192  08F80005FA07                   bset    #5,$FFFFFA07.w          ; Timer A enabled and unmasked
  415  00000198  08F80005FA13                   bset    #5,$FFFFFA13.w
  416  0000019E  08F80004FA09                   bset    #4,$FFFFFA09.w          ; Timer D likewise
  417  000001A4  08F80004FA15                   bset    #4,$FFFFFA15.w
  418  000001AA  46DF                           move.w  (sp)+,sr
  419                                   
  420  000001AC  7000                           moveq   #0,d0
  421  000001AE  4E75                           rts
  422                                   .rejected:
  423  000001B0  70FF                           moveq   #-1,d0
  424  000001B2  4E75                           rts
  425                                   
  426                                   ; -----------------------------------------------------------------------------
  427                                   ; YX6_fill: d0.w = stream index * YX6_STATE_SIZE, d3.w = values wanted.
  428                                   ; Produces exactly that many values for one register, crossing into the loop
  429                                   ; section - and around it again - as often as it takes. Straddling matters even
  430                                   ; for one group: nothing says the loop frame falls on a group boundary.
  431                                   ; -----------------------------------------------------------------------------
  432                                   YX6_fill:
  433  000001B4  48E70302                       movem.l d6-d7/a6,-(sp)          ; three registers that survive a decoder
  434  000001B8  45F30046                       lea     YX6_STATE(a3,d0.w),a2   ; call, which its own state needs
  435  000001BC  2C4B                           movea.l a3,a6                   ; ST4 clobbers a3: a6 keeps the workspace
  436  000001BE  2C0A                           move.l  a2,d6
  437  000001C0  7E00                           moveq   #0,d7
  438  000001C2  3E03                           move.w  d3,d7                   ; values still wanted
  439                                   .piece:
  440  000001C4  202A0028                       move.l  YS_LEFT(a2),d0
  441  000001C8  66xx                           bne.s   .section
  442  000001CA  6100xxxx                       bsr     YX6_start_loop          ; this section ran out: go round again
  443  000001CE  202A0028                       move.l  YS_LEFT(a2),d0
  444  000001D2  67xx                           beq.s   .done                   ; nothing to go round to; do not hang
  445                                   .section:
  446  000001D4  B087                           cmp.l   d7,d0
  447  000001D6  65xx                           bcs.s   .piece_size
  448  000001D8  2007                           move.l  d7,d0                   ; the section covers all that is wanted
  449                                   .piece_size:
  450  000001DA  91AA0028                       sub.l   d0,YS_LEFT(a2)
  451  000001DE  9E80                           sub.l   d0,d7
  452  000001E0  3600                           move.w  d0,d3                   ; a piece is at most C, so it fits a word
  453                                   ; The decoder's budget counts units of ST4_UNIT bytes. The packer enforces
  454                                   ; that every piece boundary - C, the loop frame, the tune length - is a whole
  455                                   ; number of units, so this shift never drops a remainder.
  456                                           .if ST4_UNIT=2
  457  000001E2  E24B                           lsr.w   #1,d3
  458                                           .endif
  459                                           .if ST4_UNIT=4
  460                                 -         lsr.w   #2,d3
  461                                 -         .endif
  462                                   
  463                                   ; (a2) written out rather than YS_D1(a2): with +o3 rmac folds a zero
  464                                   ; displacement away on movem but keeps the addressing mode, and emits the
  465                                   ; instruction without its extension word. The next word becomes the
  466                                   ; displacement and the code runs off into nothing.
  467  000001E4  4CD20306                       movem.l (a2),d1-d2/a0-a1
  468  000001E8  286A0014                       movea.l YS_BOFF(a2),a4
  469  000001EC  2A6A0018                       movea.l YS_WOFF(a2),a5
  470  000001F0  302A001C                       move.w  YS_QUEUE(a2),d0
  471  000001F4  246A0010                       movea.l YS_LIT(a2),a2           ; loaded last: a2 was the base
  472  000001F8  6100xxxx                       bsr     ST4_resume
  473  000001FC  264E                           movea.l a6,a3                   ; the decoder clobbered the workspace
  474  000001FE  CD8A                           exg     a2,d6                   ; a2 = the block again, d6 = stream B
  475  00000200  B3EA0024                       cmpa.l  YS_END(a2),a1           ; YX6_save, inlined: this is the hot path
  476  00000204  66xx                           bne.s   .stored
  477  00000206  226A0020                       movea.l YS_START(a2),a1         ; the call landed on the ring end
  478                                   .stored:
  479  0000020A  48D20306                       movem.l d1-d2/a0-a1,(a2)
  480  0000020E  25460010                       move.l  d6,YS_LIT(a2)
  481  00000212  254C0014                       move.l  a4,YS_BOFF(a2)
  482  00000216  254D0018                       move.l  a5,YS_WOFF(a2)
  483  0000021A  3540001C                       move.w  d0,YS_QUEUE(a2)
  484  0000021E  2C0A                           move.l  a2,d6                   ; the block pointer, back where fill keeps it
  485  00000220  4A87                           tst.l   d7
  486  00000222  66A0                           bne.s   .piece
  487                                   .done:
  488  00000224  4CDF40C0                       movem.l (sp)+,d6-d7/a6
  489  00000228  4E75                           rts
  490                                   
  491                                   ; -----------------------------------------------------------------------------
  492                                   ; YX6_start_loop: a2 = state block. Starts this register's loop stream over -
  493                                   ; a fresh decoder, reading from the top of the loop section, still writing
  494                                   ; where the last one stopped. ST4_init wants the ring start so that its packed
  495                                   ; metadata comes out right; the write pointer is restored from the block, which
  496                                   ; is why it is stored rather than held in a register.
  497                                   ; -----------------------------------------------------------------------------
  498                                   ; It runs inside YX6_fill, which guarantees d6 = the state block and a6 = the
  499                                   ; workspace - the two anchors that survive the decoder call.
  500                                   YX6_start_loop:
  501  0000022A  200A                           move.l  a2,d0
  502  0000022C  908B                           sub.l   a3,d0
  503  0000022E  907C0046                       sub.w   #YX6_STATE,d0
  504  00000232  E848                           lsr.w   #4,d0                   ; k * 64 becomes k * 4, a table index
  505  00000234  206B0014                       movea.l YX6_FILE(a3),a0
  506  00000238  2030006A                       move.l  YH_LOOP_TABLE(a0,d0.w),d0
  507  0000023C  67xx                           beq.s   .no_loop                ; this tune has no loop section
  508  0000023E  D1C0                           adda.l  d0,a0                   ; the loop section's ST4 container
  509  00000240  226A0020                       movea.l YS_START(a2),a1         ; read before a2 becomes stream B
  510  00000244  61xx                           bsr.s   yx6_open
  511  00000246  264E                           movea.l a6,a3                   ; the decoder clobbered the workspace
  512  00000248  CD8A                           exg     a2,d6                   ; a2 = the block again, d6 = stream B
  513  0000024A  25480008                       move.l  a0,YS_INPUT(a2)
  514  0000024E  25460010                       move.l  d6,YS_LIT(a2)
  515  00000252  254C0014                       move.l  a4,YS_BOFF(a2)
  516  00000256  254D0018                       move.l  a5,YS_WOFF(a2)
  517  0000025A  3540001C                       move.w  d0,YS_QUEUE(a2)
  518  0000025E  2481                           move.l  d1,YS_D1(a2)
  519  00000260  25420004                       move.l  d2,YS_D2(a2)
  520  00000264  256B001C0028                   move.l  YX6_LOOPLEN(a3),YS_LEFT(a2)
  521  0000026A  2C0A                           move.l  a2,d6                   ; the block pointer, as fill keeps it
  522                                   .no_loop:
  523  0000026C  4E75                           rts
  524                                   
  525                                   ; -----------------------------------------------------------------------------
  526                                   ; yx6_open: a0 = an ST4 container. Points the four stream registers at its
  527                                   ; streams - A begins where the header ends, B, C and D sit at the recorded
  528                                   ; header-relative offsets, exactly as ST4.S documents - and tail-calls
  529                                   ; ST4_init: its rts returns to yx6_open's caller with the decoder registers
  530                                   ; as ST4_init leaves them. ST4_init clobbers a3; callers restore it
  531                                   ; themselves, init from the stack and the loop restart from a6.
  532                                   ; -----------------------------------------------------------------------------
  533                                   yx6_open:
  534  0000026E  2448                           movea.l a0,a2
  535  00000270  D5E80008                       adda.l  8(a0),a2                ; stream B, the literals
  536  00000274  2848                           movea.l a0,a4
  537  00000276  D9E8000C                       adda.l  12(a0),a4               ; stream C, the byte offsets
  538  0000027A  2A48                           movea.l a0,a5
  539  0000027C  DBE80010                       adda.l  16(a0),a5               ; stream D, the word offsets
  540  00000280  41E80014                       lea     20(a0),a0               ; stream A, the bits
  541  00000284  7600                           moveq   #0,d3
  542  00000286  362B0024                       move.w  YX6_N(a3),d3            ; N, ST4_init's argument
  543  0000028A  6000xxxx                       bra     ST4_init
  544                                   
  545                                   ; -----------------------------------------------------------------------------
  546                                   ; YX6_play: a0 = workspace. One frame: run the effect stage, write fourteen
  547                                   ; registers, undo the stage's ring edits, refill one stream.
  548                                   ; -----------------------------------------------------------------------------
  549                                   YX6_play:
  550  0000028E  2648                           movea.l a0,a3
  551  00000290  4AAB0004                       tst.l   YX6_LEFTFR(a3)
  552  00000294  66xx                           bne.s   .frame
  553  00000296  70FF                           moveq   #-1,d0                  ; past the last frame of a tune that
  554  00000298  4E75                           rts                             ; does not loop: write nothing
  555                                   
  556                                   .frame:
  557  0000029A  7600                           moveq   #0,d3
  558  0000029C  362B0024                       move.w  YX6_N(a3),d3            ; one ring to the next
  559                                   
  560                                   ; The effect stage, inlined: it runs BEFORE the burst so it may rewrite this
  561                                   ; frame's ring bytes. Each slot is gated on E | E-last: a slot that has, and
  562                                   ; had, nothing to do costs one test - the common frame. A slot machine call
  563                                   ; therefore always means something changed, holds, or just ended; yx6_slot's
  564                                   ; held path leans on that (E is never 0 there).
  565  000002A0  2053                           movea.l YX6_CURSOR(a3),a0
  566  000002A2  D1EB002E                       adda.l  YX6_EFXOFF(a3),a0       ; ring E1, at this frame's offset
  567  000002A6  4BFAxxxx                       lea     yx6_desc1(pc),a5
  568  000002AA  1010                           move.b  (a0),d0                 ; E1 | its last code: zero is idle
  569  000002AC  8015                           or.b    (a5),d0
  570  000002AE  67xx                           beq.s   .slot1_idle
  571  000002B0  1010                           move.b  (a0),d0                 ; the real E1
  572  000002B2  D1C3                           adda.l  d3,a0
  573  000002B4  1210                           move.b  (a0),d1                 ; T1
  574  000002B6  D1C3                           adda.l  d3,a0
  575  000002B8  2F08                           move.l  a0,-(sp)                ; ring E2's byte, for after slot 1
  576  000002BA  6100xxxx                       bsr     yx6_slot
  577  000002BE  205F                           movea.l (sp)+,a0
  578  000002C0  60xx                           bra.s   .slot2
  579                                   .slot1_idle:
  580  000002C2  D1C3                           adda.l  d3,a0
  581  000002C4  D1C3                           adda.l  d3,a0
  582                                   .slot2:
  583  000002C6  4BFAxxxx                       lea     yx6_desc2(pc),a5
  584  000002CA  1010                           move.b  (a0),d0                 ; E2, the same gate
  585  000002CC  8015                           or.b    (a5),d0
  586  000002CE  67xx                           beq.s   .effects_done
  587  000002D0  1010                           move.b  (a0),d0
  588  000002D2  D1C3                           adda.l  d3,a0
  589  000002D4  1210                           move.b  (a0),d1                 ; T2
  590  000002D6  6100xxxx                       bsr     yx6_slot
  591                                   .effects_done:
  592                                   
  593                                   ; While a drum runs its voice leaves the mixer, as the original replay
  594                                   ; routines had it: force the tone and noise bits in this frame's R7.
  595  000002DA  103Axxxx                       move.b  yx6_drums(pc),d0
  596  000002DE  67xx                           beq.s   .mixer_ok
  597  000002E0  1200                           move.b  d0,d1
  598  000002E2  E709                           lsl.b   #3,d1
  599  000002E4  8200                           or.b    d0,d1                   ; the voice's tone and noise disables
  600  000002E6  2053                           movea.l YX6_CURSOR(a3),a0
  601  000002E8  D1EB0032                       adda.l  YX6_R7OFF(a3),a0
  602  000002EC  6100xxxx                       bsr     yx6_borrow              ; the ring gets this byte back
  603  000002F0  8310                           or.b    d1,(a0)
  604                                   .mixer_ok:
  605  000002F2  2253                           movea.l YX6_CURSOR(a3),a1       ; the same offset in all fourteen
  606  000002F4  45F9FFFF8800                   lea     YX6_PSG,a2              ; register rings
  607                                   
  608                                   ; Selecting a register and writing it are two bus cycles. An interrupt that
  609                                   ; uses the sound chip in between - TOS has several, its floppy motor timeout
  610                                   ; among them - would leave this write going to whatever register it selected,
  611                                   ; so the burst runs masked. Cheap: about 24 cycles for the whole frame.
  612  000002FA  40E7                           move.w  sr,-(sp)
  613  000002FC  007C0700                       ori.w   #$0700,sr
  614                                   
                                                YX6_WRITE 0                     ; channel A period, fine and coarse
       00000300  14BC0000             @         move.b  #$0,(a2)           
       00000304  15510002             @         move.b  (a1),2(a2)              
  615  00000308  D3C3                 @         adda.l  d3,a1
                                                YX6_WRITE 1
       0000030A  14BC0001             @         move.b  #$1,(a2)           
       0000030E  15510002             @         move.b  (a1),2(a2)              
  616  00000312  D3C3                 @         adda.l  d3,a1
                                                YX6_WRITE 2                     ; channel B
       00000314  14BC0002             @         move.b  #$2,(a2)           
       00000318  15510002             @         move.b  (a1),2(a2)              
  617  0000031C  D3C3                 @         adda.l  d3,a1
                                                YX6_WRITE 3
       0000031E  14BC0003             @         move.b  #$3,(a2)           
       00000322  15510002             @         move.b  (a1),2(a2)              
  618  00000326  D3C3                 @         adda.l  d3,a1
                                                YX6_WRITE 4                     ; channel C
       00000328  14BC0004             @         move.b  #$4,(a2)           
       0000032C  15510002             @         move.b  (a1),2(a2)              
  619  00000330  D3C3                 @         adda.l  d3,a1
                                                YX6_WRITE 5
       00000332  14BC0005             @         move.b  #$5,(a2)           
       00000336  15510002             @         move.b  (a1),2(a2)              
  620  0000033A  D3C3                 @         adda.l  d3,a1
                                                YX6_WRITE 6                     ; noise period
       0000033C  14BC0006             @         move.b  #$6,(a2)           
       00000340  15510002             @         move.b  (a1),2(a2)              
  621  00000344  D3C3                 @         adda.l  d3,a1
  622                                   
  623  00000346  14BC0007                       move.b  #YX6_MIXER,(a2)         ; R7 also carries the ST's I/O port
  624  0000034A  1211                           move.b  (a1),d1                 ; directions, which port A needs kept
  625  0000034C  823C00C0                       or.b    #YX6_PORTS,d1           ; as outputs for the floppy select
  626  00000350  15410002                       move.b  d1,2(a2)
  627  00000354  D3C3                           adda.l  d3,a1
  628                                   
                                                YX6_WRITE 8                     ; the three volumes
       00000356  14BC0008             @         move.b  #$8,(a2)           
       0000035A  15510002             @         move.b  (a1),2(a2)              
  629  0000035E  D3C3                 @         adda.l  d3,a1
                                                YX6_WRITE 9
       00000360  14BC0009             @         move.b  #$9,(a2)           
       00000364  15510002             @         move.b  (a1),2(a2)              
  630  00000368  D3C3                 @         adda.l  d3,a1
                                                YX6_WRITE 10
       0000036A  14BC000A             @         move.b  #$A,(a2)           
       0000036E  15510002             @         move.b  (a1),2(a2)              
  631  00000372  D3C3                 @         adda.l  d3,a1
                                                YX6_WRITE 11                    ; envelope period
       00000374  14BC000B             @         move.b  #$B,(a2)           
       00000378  15510002             @         move.b  (a1),2(a2)              
  632  0000037C  D3C3                 @         adda.l  d3,a1
                                                YX6_WRITE 12
       0000037E  14BC000C             @         move.b  #$C,(a2)           
       00000382  15510002             @         move.b  (a1),2(a2)              
  633  00000386  D3C3                 @         adda.l  d3,a1
  634                                   
  635  00000388  1211                           move.b  (a1),d1                 ; R13 restarts the envelope whenever it
  636  0000038A  B23C00FF                       cmp.b   #YX6_NO_ENV,d1          ; is written, so $FF means leave it be
  637  0000038E  67xx                           beq.s   .envelope_held
  638  00000390  14BC000D                       move.b  #YX6_ENVELOPE,(a2)
  639  00000394  15410002                       move.b  d1,2(a2)
  640                                   .envelope_held:
  641  00000398  46DF                           move.w  (sp)+,sr
  642                                   
  643                                   ; Undo this frame's ring edits: the chip has heard the sanitized frame, and
  644                                   ; the ring must stay exact decode history for every match yet to come.
  645  0000039A  102B0036                       move.b  YX6_PATCHES(a3),d0
  646  0000039E  67xx                           beq.s   .pristine
  647  000003A0  422B0036                       clr.b   YX6_PATCHES(a3)         ; cleared only when it was used
  648  000003A4  41EB003A                       lea     YX6_PATCH_ADDR(a3),a0
  649  000003A8  43EB0037                       lea     YX6_PATCH_VAL(a3),a1
  650                                   .restore:
  651  000003AC  2458                           movea.l (a0)+,a2
  652  000003AE  1499                           move.b  (a1)+,(a2)
  653  000003B0  5300                           subq.b  #1,d0
  654  000003B2  66F8                           bne.s   .restore
  655                                   .pristine:
  656                                   
  657                                   ; Refill the stream whose turn it is. Slots 18..C-1 exist when C is larger
  658                                   ; than the stream count; they simply have nothing to do.
  659  000003B4  302B0028                       move.w  YX6_SLOT(a3),d0
  660  000003B8  B07C0012                       cmp.w   #YX6_STREAMS,d0
  661  000003BC  64xx                           bcc.s   .advance
  662  000003BE  7600                           moveq   #0,d3
  663  000003C0  362B0026                       move.w  YX6_C(a3),d3            ; a whole group
  664  000003C4  4A6B002C                       tst.w   YX6_LOOPS(a3)
  665  000003C8  66xx                           bne.s   .refill                 ; a looping tune never runs out
  666  000003CA  222B0018                       move.l  YX6_TOTAL(a3),d1
  667  000003CE  92AB0008                       sub.l   YX6_NEXT(a3),d1         ; values still packed
  668  000003D2  6Fxx                           ble.s   .advance                ; all decoded: never call ST4 again
  669  000003D4  B283                           cmp.l   d3,d1
  670  000003D6  64xx                           bcc.s   .refill
  671  000003D8  2601                           move.l  d1,d3                   ; the last group is a short one
  672                                   .refill:
  673  000003DA  ED48                           lsl.w   #6,d0
  674  000003DC  6100FDD6                       bsr     YX6_fill
  675                                   
  676                                   .advance:
  677  000003E0  5293                           addq.l  #1,YX6_CURSOR(a3)       ; one byte along every ring
  678  000003E2  2013                           move.l  YX6_CURSOR(a3),d0
  679  000003E4  B0AB000C                       cmp.l   YX6_RINGEND(a3),d0
  680  000003E8  65xx                           bcs.s   .cursor_ready
  681  000003EA  26AB0010                       move.l  YX6_RINGS(a3),YX6_CURSOR(a3)
  682                                   .cursor_ready:
  683  000003EE  302B0028                       move.w  YX6_SLOT(a3),d0
  684  000003F2  5240                           addq.w  #1,d0
  685  000003F4  B06B0026                       cmp.w   YX6_C(a3),d0
  686  000003F8  65xx                           bcs.s   .slot_ready
  687  000003FA  7000                           moveq   #0,d0                   ; a cycle ended: the groups move on
  688  000003FC  7200                           moveq   #0,d1
  689  000003FE  322B0026                       move.w  YX6_C(a3),d1
  690  00000402  D3AB0008                       add.l   d1,YX6_NEXT(a3)
  691                                   .slot_ready:
  692  00000406  37400028                       move.w  d0,YX6_SLOT(a3)
  693                                   
  694                                   ; The rings hold the tune as one continuous sequence, so reaching the end of
  695                                   ; the last frame simply means the next values in them are the loop section's.
  696                                   ; The countdown follows: it reloads with the loop section's length.
  697  0000040A  53AB0004                       subq.l  #1,YX6_LEFTFR(a3)
  698  0000040E  66xx                           bne.s   .played
  699  00000410  4A6B002C                       tst.w   YX6_LOOPS(a3)
  700  00000414  67xx                           beq.s   .played                 ; zero and no loop: the next call ends
  701  00000416  276B001C0004                   move.l  YX6_LOOPLEN(a3),YX6_LEFTFR(a3)
  702  0000041C  7001                           moveq   #1,d0                   ; played, and wrapped to the loop point
  703  0000041E  4E75                           rts
  704                                   .played:
  705  00000420  7000                           moveq   #0,d0
  706  00000422  4E75                           rts
  707                                   
  708                                   ; -----------------------------------------------------------------------------
  709                                   ; YX6_stop: a0 = workspace. Quiesces what YX6_init claimed - both timers
  710                                   ; stopped, their interrupts disabled and masked, pendings dropped - then
  711                                   ; silences the three voices. It restores NOTHING: the host that saved the
  712                                   ; machine state hands it back itself, after this returns. Tone and envelope
  713                                   ; settings stay, and a fresh YX6_init starts the tune over.
  714                                   ; -----------------------------------------------------------------------------
  715                                   YX6_stop:
  716  00000424  2648                           movea.l a0,a3
  717  00000426  40E7                           move.w  sr,-(sp)
  718  00000428  007C0700                       ori.w   #$0700,sr
  719  0000042C  4238FA19                       clr.b   $FFFFFA19.w             ; both timers stopped,
  720  00000430  023800F0FA1D                   andi.b  #$F0,$FFFFFA1D.w
  721  00000436  08B80005FA07                   bclr    #5,$FFFFFA07.w          ; disabled and masked - the claim
  722  0000043C  08B80005FA13                   bclr    #5,$FFFFFA13.w          ; handed back bit by bit
  723  00000442  08B80004FA09                   bclr    #4,$FFFFFA09.w
  724  00000448  08B80004FA15                   bclr    #4,$FFFFFA15.w
  725  0000044E  08B80005FA0B                   bclr    #5,$FFFFFA0B.w          ; and no pending ticks of ours
  726  00000454  08B80004FA0D                   bclr    #4,$FFFFFA0D.w
  727  0000045A  41FAxxxx                       lea     yx6_drums(pc),a0
  728  0000045E  4210                           clr.b   (a0)
  729                                   ; The silence stays inside the mask: selecting a register and writing it are
  730                                   ; two bus cycles, and a polite host's system interrupts - about to get their
  731                                   ; state back - use the chip too.
  732  00000460  41F9FFFF8800                   lea     YX6_PSG,a0
  733  00000466  7008                           moveq   #8,d0                   ; R8, R9, R10 are the voice volumes
  734                                   .silence:
  735  00000468  1080                           move.b  d0,(a0)
  736  0000046A  42280002                       clr.b   2(a0)
  737  0000046E  5200                           addq.b  #1,d0
  738  00000470  B03C000B                       cmp.b   #11,d0
  739  00000474  66F2                           bne.s   .silence
  740  00000476  46DF                           move.w  (sp)+,sr
  741  00000478  4E75                           rts
  742                                   
  743                                   ; -----------------------------------------------------------------------------
  744                                   ; The effect machinery. The per-frame stage lives inlined in YX6_play; what
  745                                   ; follows is everything it drives: the two slot descriptors, the tick
  746                                   ; handlers, and the one slot machine that serves both timers.
  747                                   ; -----------------------------------------------------------------------------
  748                                   
  749                                   ; The slot descriptors - see the SD_ equates. Slot 1 owns Timer A, slot 2
  750                                   ; Timer D, whose control nibble is shared with Timer C and only ever changed
  751                                   ; read-modify-write; the slot machine uses that form for both, which on
  752                                   ; Timer A writes the same values a clear would.
  753                                           even
  754                                   yx6_desc1:
  755  0000047A  0000                           dc.b    0,0                     ; E last, T last
  756  0000047C  FA19FA1F0134                   dc.w    $FA19,$FA1F,$0134       ; control, data, vector
  757  00000482  00000000                       dc.l    0                       ; PARM, set per effect
  758  00000486  0000000000000000               dc.l    0,0                     ; ISR block, other slot: yx6_link
  759                                   yx6_desc2:
  760  0000048E  0000                           dc.b    0,0
  761  00000490  FA1DFA250110                   dc.w    $FA1D,$FA25,$0110
  762  00000496  00000000                       dc.l    0
  763  0000049A  0000000000000000               dc.l    0,0
  764                                   
  765                                   ; -----------------------------------------------------------------------------
  766                                   ; The tick handlers, in maxYMiser's shipping forms: the PSG select and write
  767                                   ; in as few instructions as the bus allows, patched immediates instead of
  768                                   ; state, software end-of-interrupt as TOS runs the MFP - written as an
  769                                   ; immediate byte, since the in-service registers ignore written ones. All
  770                                   ; MFP interrupts arrive at 68000 level 6, so these never nest, and every
  771                                   ; patched operand is addressed pc-relatively so the player stays loadable
  772                                   ; anywhere - which also means it must run from RAM, where a demo lives.
  773                                   ;
  774                                   ; The two slots' handlers are the same text twice, and MUST stay
  775                                   ; byte-congruent: the slot machine and yx6_drum_start reach every patched
  776                                   ; operand through ISR_ offsets measured on the A block. The rig checks the
  777                                   ; congruence from the symbol table. The park entries - where YX6_init aims
  778                                   ; the vectors while no effect runs - are the handlers' own tails.
  779                                   ;
  780                                   ; The patch offsets are load-bearing:
  781                                   ;   drum:  select immediate at +3, sample address at +8, flag mask at _clear+3
  782                                   ;   sid:   select at +2 and volume at +4 inside the imm long; the partner's
  783                                   ;          address low word at +10, patched once by yx6_link
  784                                   ;   buzz:  the shape at +4
  785                                   ; The SID vector swap patches the vector's LOW word only, so the two halves
  786                                   ; of a block must share their address high word: keep the player inside one
  787                                   ; 64K segment - anywhere a program smaller than 64K naturally loads.
  788                                   ; -----------------------------------------------------------------------------
  789                                   
  790                                   ; One drum tick: the sample byte goes straight to the voice's volume register.
  791                                   ; The byte after the last has bit 7 set, so the same move answers "done": park
  792                                   ; the volume mid-scale against the click, stop the timer, drop the flag.
  793                                   yx6_drumA:
  794  000004A2  11FC00088800                   move.b  #8,$FFFF8800.w          ; SMC +3: select the drummed volume
  795  000004A8  11F9123456788802               move.b  $12345678,$FFFF8802.w   ; SMC +8: the next sample byte
  796  000004B0  6Bxx                           bmi.s   .ended
  797                                           .if YX6_SUPER_HOST
  798                                 -         move    a0,usp                  ; the USP is the host's spare register
  799                                 -         .else
  800  000004B2  2F08                           move.l  a0,-(sp)
  801                                           .endif
  802  000004B4  41FAFFF4                       lea     yx6_drumA+8(pc),a0
  803  000004B8  5290                           addq.l  #1,(a0)                 ; step the operand itself
  804                                           .if YX6_SUPER_HOST
  805                                 -         move    usp,a0
  806                                 -         .else
  807  000004BA  205F                           movea.l (sp)+,a0
  808                                           .endif
  809  000004BC  11FC00DFFA0F                   move.b  #$DF,$FFFFFA0F.w
  810  000004C2  4E73                           rte
  811                                   .ended:
  812  000004C4  11FC000D8802                   move.b  #$D,$FFFF8802.w         ; middle volume: no click
  813  000004CA  023800F0FA19                   andi.b  #$F0,$FFFFFA19.w        ; the sample ran out: stop Timer A
  814                                           .if YX6_SUPER_HOST
  815                                 -         move    a0,usp
  816                                 -         .else
  817  000004D0  2F08                           move.l  a0,-(sp)
  818                                           .endif
  819  000004D2  41FAxxxx                       lea     yx6_drums(pc),a0
  820                                   yx6_drumA_clear:
  821  000004D6  021000FF                       andi.b  #$FF,(a0)               ; SMC +3: drop the voice's drum flag
  822                                           .if YX6_SUPER_HOST
  823                                 -         move    usp,a0
  824                                 -         .else
  825  000004DA  205F                           movea.l (sp)+,a0
  826                                           .endif
  827                                   yx6_parkA:
  828  000004DC  11FC00DFFA0F                   move.b  #$DF,$FFFFFA0F.w
  829  000004E2  4E73                           rte
  830                                   
  831                                   ; The SID square: each tick writes one half of the square - the volume or
  832                                   ; silence - and installs the other half as the next tick, one word into the
  833                                   ; vector. Select and data land in one move.l: the immediate's bytes hit
  834                                   ; $8800 (select) and $8802 (data) by bus layout.
  835                                   yx6_sidA_on:
  836  000004E4  21FC08000F008800               move.l  #$08000F00,$FFFF8800.w  ; SMC +2 select, +4 volume
  837  000004EC  31FC00000136                   move.w  #0,$136.w               ; SMC +10: the quiet half is next
  838  000004F2  11FC00DFFA0F                   move.b  #$DF,$FFFFFA0F.w
  839  000004F8  4E73                           rte
  840                                   yx6_sidA_off:
  841  000004FA  21FC080000008800               move.l  #$08000000,$FFFF8800.w  ; SMC +2 select; silence
  842  00000502  31FC00000136                   move.w  #0,$136.w               ; SMC +10: the loud half is next
  843  00000508  11FC00DFFA0F                   move.b  #$DF,$FFFFFA0F.w
  844  0000050E  4E73                           rte
  845                                   
  846                                   ; The sync-buzzer tick: writing the shape to R13 restarts the envelope, and
  847                                   ; that restart at the timer's rate is the whole effect.
  848                                   yx6_buzzA:
  849  00000510  21FC0D0000008800               move.l  #$0D000000,$FFFF8800.w  ; SMC +4: the shape
  850  00000518  11FC00DFFA0F                   move.b  #$DF,$FFFFFA0F.w
  851  0000051E  4E73                           rte
  852                                   
  853                                   ; Slot 2's instances: Timer D's stop, vector and in-service bit, otherwise
  854                                   ; the A block byte for byte.
  855                                   yx6_drumD:
  856  00000520  11FC00088800                   move.b  #8,$FFFF8800.w
  857  00000526  11F9123456788802               move.b  $12345678,$FFFF8802.w
  858  0000052E  6Bxx                           bmi.s   .ended
  859                                           .if YX6_SUPER_HOST
  860                                 -         move    a0,usp
  861                                 -         .else
  862  00000530  2F08                           move.l  a0,-(sp)
  863                                           .endif
  864  00000532  41FAFFF4                       lea     yx6_drumD+8(pc),a0
  865  00000536  5290                           addq.l  #1,(a0)
  866                                           .if YX6_SUPER_HOST
  867                                 -         move    usp,a0
  868                                 -         .else
  869  00000538  205F                           movea.l (sp)+,a0
  870                                           .endif
  871  0000053A  11FC00EFFA11                   move.b  #$EF,$FFFFFA11.w
  872  00000540  4E73                           rte
  873                                   .ended:
  874  00000542  11FC000D8802                   move.b  #$D,$FFFF8802.w
  875  00000548  023800F0FA1D                   andi.b  #$F0,$FFFFFA1D.w
  876                                           .if YX6_SUPER_HOST
  877                                 -         move    a0,usp
  878                                 -         .else
  879  0000054E  2F08                           move.l  a0,-(sp)
  880                                           .endif
  881  00000550  41FAxxxx                       lea     yx6_drums(pc),a0
  882                                   yx6_drumD_clear:
  883  00000554  021000FF                       andi.b  #$FF,(a0)
  884                                           .if YX6_SUPER_HOST
  885                                 -         move    usp,a0
  886                                 -         .else
  887  00000558  205F                           movea.l (sp)+,a0
  888                                           .endif
  889                                   yx6_parkD:
  890  0000055A  11FC00EFFA11                   move.b  #$EF,$FFFFFA11.w
  891  00000560  4E73                           rte
  892                                   
  893                                   yx6_sidD_on:
  894  00000562  21FC08000F008800               move.l  #$08000F00,$FFFF8800.w
  895  0000056A  31FC00000112                   move.w  #0,$112.w
  896  00000570  11FC00EFFA11                   move.b  #$EF,$FFFFFA11.w
  897  00000576  4E73                           rte
  898                                   yx6_sidD_off:
  899  00000578  21FC080000008800               move.l  #$08000000,$FFFF8800.w
  900  00000580  31FC00000112                   move.w  #0,$112.w
  901  00000586  11FC00EFFA11                   move.b  #$EF,$FFFFFA11.w
  902  0000058C  4E73                           rte
  903                                   
  904                                   yx6_buzzD:
  905  0000058E  21FC0D0000008800               move.l  #$0D000000,$FFFF8800.w
  906  00000596  11FC00EFFA11                   move.b  #$EF,$FFFFFA11.w
  907  0000059C  4E73                           rte
  908                                   
  909                                   yx6_drums:
  910  0000059E  00                             dc.b    0                       ; voice bits 0-2: a drum is running
  911  0000059F  00                             even
  912                                   
  913                                   ; Where the patched operands sit, measured on the A block; the D block is
  914                                   ; byte-congruent, so the same offsets serve both through SD_ISR.
  915                                   ; rmac evaluates left to right: the parentheses are load-bearing.
  916           =00000003               ISR_DRUM_SEL    equ     3
  917           =00000008               ISR_DRUM_PTR    equ     8
  918           =00000037               ISR_CLEAR       equ     (yx6_drumA_clear-yx6_drumA)+3
  919           =00000042               ISR_SIDON       equ     yx6_sidA_on-yx6_drumA
  920           =00000044               ISR_SIDON_SEL   equ     ISR_SIDON+2
  921           =00000046               ISR_SID_VOL     equ     ISR_SIDON+4
  922           =0000004C               ISR_SIDON_NEXT  equ     ISR_SIDON+10
  923           =00000058               ISR_SIDOFF      equ     yx6_sidA_off-yx6_drumA
  924           =0000005A               ISR_SIDOFF_SEL  equ     ISR_SIDOFF+2
  925           =00000062               ISR_SIDOFF_NEXT equ     ISR_SIDOFF+10
  926           =0000006E               ISR_BUZZ        equ     yx6_buzzA-yx6_drumA
  927           =00000072               ISR_BUZZ_SHAPE  equ     ISR_BUZZ+4
  928                                   
  929                                   ; -----------------------------------------------------------------------------
  930                                   ; yx6_link, from YX6_init: the run-time addresses only a loaded player knows.
  931                                   ; Each descriptor gets its ISR block and its partner, both slots' last code
  932                                   ; and count are cleared, and the SID halves get each other's address low
  933                                   ; word - the vector's high word never changes, and neither do these, so
  934                                   ; they are patched once here rather than on every SID start.
  935                                   ; -----------------------------------------------------------------------------
  936                                   yx6_link:
  937  000005A0  41FAFED8                       lea     yx6_desc1(pc),a0
  938  000005A4  43FAFEE8                       lea     yx6_desc2(pc),a1
  939  000005A8  21490010                       move.l  a1,SD_OTHER(a0)
  940  000005AC  23480010                       move.l  a0,SD_OTHER(a1)
  941  000005B0  4250                           clr.w   (a0)                    ; E and T last, both slots
  942  000005B2  4251                           clr.w   (a1)
  943  000005B4  45FAFEEC                       lea     yx6_drumA(pc),a2
  944  000005B8  214A000C                       move.l  a2,SD_ISR(a0)
  945  000005BC  61xx                           bsr.s   .partners
  946  000005BE  45FAFF60                       lea     yx6_drumD(pc),a2
  947  000005C2  234A000C                       move.l  a2,SD_ISR(a1)
  948                                   .partners:
  949  000005C6  41EA0058                       lea     ISR_SIDOFF(a2),a0       ; each half installs the other
  950  000005CA  2008                           move.l  a0,d0
  951  000005CC  3540004C                       move.w  d0,ISR_SIDON_NEXT(a2)
  952  000005D0  41EA0042                       lea     ISR_SIDON(a2),a0
  953  000005D4  2008                           move.l  a0,d0
  954  000005D6  35400062                       move.w  d0,ISR_SIDOFF_NEXT(a2)
  955  000005DA  4E75                           rts
  956                                   
  957                                   ; -----------------------------------------------------------------------------
  958                                   ; yx6_slot: one slot of the effect stage - both slots, through a5.
  959                                   ; A changed code reprograms the slot's timer from scratch, a held one
  960                                   ; updates only the count (a running MFP timer loads it at its next reload),
  961                                   ; a dropped one stops the timer - unless the slot ran a drum, which
  962                                   ; finishes by itself. A held DRUM code is a trigger on EVERY frame it is
  963                                   ; present, as the reference player starts one on each coded frame: real
  964                                   ; dumps carry back-to-back codes whose ring bytes name different samples -
  965                                   ; an attack, then a body - and only a full restart plays the second one.
  966                                   ;
  967                                   ; in: d0.b = E (never 0 with E-last also 0: the caller's gate), d1.b = T,
  968                                   ;     a5 = the slot's descriptor, a3 = workspace, d3.l = N.
  969                                   ; preserves d3/a3/a5; clobbers d0-d2/d4-d5, a0-a2/a4.
  970                                   ; -----------------------------------------------------------------------------
  971                                   yx6_slot:
  972  000005DC  B015                           cmp.b   (a5),d0
  973  000005DE  6700xxxx                       beq.w   .held
  974  000005E2  1815                           move.b  (a5),d4                 ; what the slot was doing before
  975  000005E4  1A80                           move.b  d0,(a5)
  976  000005E6  4A00                           tst.b   d0
  977  000005E8  6700xxxx                       beq.w   .released
  978                                   ; A new code: find the parameter register's ring - r8+voice carries the SID
  979                                   ; volume, the drum number or the buzzer shape - then let the type arm its
  980                                   ; handler; every type then (re)programs the timer the same way. The voice
  981                                   ; stays live in d5, the parameter byte in a1, for whoever needs them.
  982  000005EC  1A00                           move.b  d0,d5
  983  000005EE  E80D                           lsr.b   #4,d5
  984  000005F0  CA7C0003                       and.w   #3,d5
  985  000005F4  5345                           subq.w  #1,d5                   ; the voice, 0..2
  986  000005F6  3805                           move.w  d5,d4
  987  000005F8  5044                           addq.w  #8,d4
  988  000005FA  C8EB0024                       mulu.w  YX6_N(a3),d4
  989  000005FE  2B440008                       move.l  d4,SD_PARM(a5)
  990  00000602  2253                           movea.l YX6_CURSOR(a3),a1
  991  00000604  D3C4                           adda.l  d4,a1                   ; a1 = the slot's parameter byte
  992  00000606  1400                           move.b  d0,d2
  993  00000608  C43C00C0                       and.b   #$C0,d2
  994  0000060C  67xx                           beq.s   .sid
  995  0000060E  B43C0040                       cmp.b   #$40,d2
  996  00000612  67xx                           beq.s   .drum
  997  00000614  1811                           move.b  (a1),d4                 ; $C0, the buzzer ($80 never packs):
  998  00000616  C83C000F                       and.b   #15,d4                  ; the shape rides the tick's immediate
  999  0000061A  206D000C                       movea.l SD_ISR(a5),a0
 1000  0000061E  11440072                       move.b  d4,ISR_BUZZ_SHAPE(a0)
 1001  00000622  41E8006E                       lea     ISR_BUZZ(a0),a0
 1002  00000626  60xx                           bra.s   .armed
 1003                                   .sid:
 1004                                   ; While a drum owns this voice, its volume register is the drum's alone: the
 1005                                   ; SID stays un-armed and the cleared last-code makes every following frame
 1006                                   ; retry, so it comes back by itself the frame after the drum ends. That is
 1007                                   ; the reference player's priority, where the drum overrides the volume.
 1008  00000628  7801                           moveq   #1,d4
 1009  0000062A  EB2C                           lsl.b   d5,d4
 1010  0000062C  C83AFF70                       and.b   yx6_drums(pc),d4
 1011  00000630  67xx                           beq.s   .sid_free
 1012  00000632  4215                           clr.b   (a5)
 1013  00000634  4E75                           rts
 1014                                   .sid_free:
 1015  00000636  3805                           move.w  d5,d4                   ; the SID start: the voice's volume
 1016  00000638  5044                           addq.w  #8,d4                   ; register into both halves' selects
 1017  0000063A  206D000C                       movea.l SD_ISR(a5),a0
 1018  0000063E  11440044                       move.b  d4,ISR_SIDON_SEL(a0)
 1019  00000642  1144005A                       move.b  d4,ISR_SIDOFF_SEL(a0)
 1020  00000646  1811                           move.b  (a1),d4
 1021  00000648  C83C000F                       and.b   #15,d4
 1022  0000064C  11440046                       move.b  d4,ISR_SID_VOL(a0)      ; the loud half's volume
 1023  00000650  41E80042                       lea     ISR_SIDON(a0),a0
 1024  00000654  60xx                           bra.s   .armed
 1025                                   .drum:
 1026  00000656  6100xxxx                       bsr     yx6_drum_start
 1027                                   .armed:
 1028  0000065A  1B410001                       move.b  d1,SD_TLAST(a5)
 1029  0000065E  326D0002                       movea.w SD_CTRL(a5),a1
 1030  00000662  346D0006                       movea.w SD_VEC(a5),a2
 1031  00000666  40E7                           move.w  sr,-(sp)
 1032  00000668  007C0700                       ori.w   #$0700,sr
 1033  0000066C  021100F0                       andi.b  #$F0,(a1)               ; stop, then vector, count, prescaler
 1034  00000670  2488                           move.l  a0,(a2)
 1035  00000672  346D0004                       movea.w SD_DATA(a5),a2
 1036  00000676  1481                           move.b  d1,(a2)
 1037  00000678  1A00                           move.b  d0,d5
 1038  0000067A  CA3C0007                       and.b   #7,d5
 1039  0000067E  8B11                           or.b    d5,(a1)
 1040  00000680  46DF                           move.w  (sp)+,sr
 1041  00000682  4E75                           rts
 1042                                   .released:
 1043  00000684  C83C00C0                       and.b   #$C0,d4                 ; the level dropped: stop the timer -
 1044  00000688  B83C0040                       cmp.b   #$40,d4                 ; unless a drum is finishing by itself
 1045  0000068C  67xx                           beq.s   .out
 1046  0000068E  326D0002                       movea.w SD_CTRL(a5),a1
 1047  00000692  021100F0                       andi.b  #$F0,(a1)
 1048                                   .out:
