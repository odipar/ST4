  703                                   ; -----------------------------------------------------------------------------
  704                                   ; YX6_effects: the frame's effect stage. Runs BEFORE the register burst so it
  705                                   ; may sanitize the frame in the rings. Pops E and T from each slot's ring;
  706                                   ; a changed code reprograms the slot's timer from scratch, a held one updates
  707                                   ; only the count (a running MFP timer loads it at its next reload), a dropped
  708                                   ; one stops the timer - unless the slot ran a drum, which finishes by itself.
  709                                   ; Slot 1 owns Timer A, slot 2 Timer D, whose control nibble is shared with
  710                                   ; Timer C and only ever changed read-modify-write.
  711                                   ; in: d3.l = N; clobbers d0-d2/d4-d5, a0-a2.
  712                                   ; -----------------------------------------------------------------------------
  713                                   YX6_effects:
  714  000004EE  422B0050                       clr.b   YX6_PATCHES(a3)         ; a fresh frame, no edits yet
  715  000004F2  2053                           movea.l YX6_CURSOR(a3),a0
  716  000004F4  D1EB002E                       adda.l  YX6_EFXOFF(a3),a0       ; ring E1, at this frame's offset
  717  000004F8  1010                           move.b  (a0),d0                 ; E1
  718  000004FA  D1C3                           adda.l  d3,a0
  719  000004FC  1210                           move.b  (a0),d1                 ; T1
