  678  000003C0  12297FFF                       move.b  $7FFF(a1),d1            ; R13 restarts the envelope whenever it
  679  000003C4  B23C00FF                       cmp.b   #YX6_NO_ENV,d1          ; is written, so $FF means leave it be
  680  000003C8  67xx                           beq.s   .envelope_held
  681  000003CA  14BC000D                       move.b  #YX6_ENVELOPE,(a2)
  682  000003CE  15410002                       move.b  d1,2(a2)
  683                                   .envelope_held:
  684  000003D2  46DF                           move.w  (sp)+,sr
  685                                   
  686                                   ; Undo this frame's ring edits: the chip has heard the sanitized frame, and
  687                                   ; the ring must stay exact decode history for every match yet to come.
  688  000003D4  102B0036                       move.b  YX6_PATCHES(a3),d0
  689  000003D8  67xx                           beq.s   .pristine
  690  000003DA  422B0036                       clr.b   YX6_PATCHES(a3)         ; cleared only when it was used
  691  000003DE  41EB003A                       lea     YX6_PATCH_ADDR(a3),a0
  692  000003E2  43EB0037                       lea     YX6_PATCH_VAL(a3),a1
  693                                   .restore:
  694  000003E6  2458                           movea.l (a0)+,a2
  695  000003E8  1499                           move.b  (a1)+,(a2)
  696  000003EA  5300                           subq.b  #1,d0
  697  000003EC  66F8                           bne.s   .restore
  698                                   .pristine:
  699                                   
  700                                   ; Refill the stream whose turn it is. Slots 18..C-1 exist when C is larger
  701                                   ; than the stream count; they simply have nothing to do.
  702  000003EE  302B0028                       move.w  YX6_SLOT(a3),d0
  703  000003F2  B07C0012                       cmp.w   #YX6_STREAMS,d0
  704  000003F6  64xx                           bcc.s   .advance
  705  000003F8  7600                           moveq   #0,d3
  706  000003FA  362B0026                       move.w  YX6_C(a3),d3            ; a whole group
  707  000003FE  4A6B002C                       tst.w   YX6_LOOPS(a3)
  708  00000402  66xx                           bne.s   .refill                 ; a looping tune never runs out
  709  00000404  222B0018                       move.l  YX6_TOTAL(a3),d1
  710  00000408  92AB0008                       sub.l   YX6_NEXT(a3),d1         ; values still packed
  711  0000040C  6Fxx                           ble.s   .advance                ; all decoded: never call ST4 again
  712  0000040E  B283                           cmp.l   d3,d1
  713  00000410  64xx                           bcc.s   .refill
  714  00000412  2601                           move.l  d1,d3                   ; the last group is a short one
  715                                   .refill:
  716  00000414  ED48                           lsl.w   #6,d0
  717  00000416  6100FDD4                       bsr     YX6_fill
  718                                   
  719                                   .advance:
  720  0000041A  5293                           addq.l  #1,YX6_CURSOR(a3)       ; one byte along every ring
  721  0000041C  2013                           move.l  YX6_CURSOR(a3),d0
  722  0000041E  B0AB000C                       cmp.l   YX6_RINGEND(a3),d0
  723  00000422  65xx                           bcs.s   .cursor_ready
  724  00000424  26AB0010                       move.l  YX6_RINGS(a3),YX6_CURSOR(a3)
  725                                   .cursor_ready:
  726  00000428  302B0028                       move.w  YX6_SLOT(a3),d0
  727  0000042C  5240                           addq.w  #1,d0
  728  0000042E  B06B0026                       cmp.w   YX6_C(a3),d0
  729  00000432  65xx                           bcs.s   .slot_ready
  730  00000434  7000                           moveq   #0,d0                   ; a cycle ended: the groups move on
  731  00000436  7200                           moveq   #0,d1
  732  00000438  322B0026                       move.w  YX6_C(a3),d1
  733  0000043C  D3AB0008                       add.l   d1,YX6_NEXT(a3)
  734                                   .slot_ready:
  735  00000440  37400028                       move.w  d0,YX6_SLOT(a3)
  736                                   
  737                                   ; The rings hold the tune as one continuous sequence, so reaching the end of
  738                                   ; the last frame simply means the next values in them are the loop section's.
  739                                   ; The countdown follows: it reloads with the loop section's length.
  740  00000444  53AB0004                       subq.l  #1,YX6_LEFTFR(a3)
  741  00000448  66xx                           bne.s   .played
  742  0000044A  4A6B002C                       tst.w   YX6_LOOPS(a3)
  743  0000044E  67xx                           beq.s   .played                 ; zero and no loop: the next call ends
  744  00000450  276B001C0004                   move.l  YX6_LOOPLEN(a3),YX6_LEFTFR(a3)
  745  00000456  7001                           moveq   #1,d0                   ; played, and wrapped to the loop point
  746  00000458  4E75                           rts
  747                                   .played:
  748  0000045A  7000                           moveq   #0,d0
  749  0000045C  4E75                           rts
  750                                   
  751                                   ; -----------------------------------------------------------------------------
  752                                   ; YX6_stop: a0 = workspace. Quiesces what YX6_init claimed - both timers
  753                                   ; stopped, their interrupts disabled and masked, pendings dropped - then
  754                                   ; silences the three voices. It restores NOTHING: the host that saved the
  755                                   ; machine state hands it back itself, after this returns. Tone and envelope
  756                                   ; settings stay, and a fresh YX6_init starts the tune over.
  757                                   ; -----------------------------------------------------------------------------
  758                                   YX6_stop:
  759  0000045E  2648                           movea.l a0,a3
  760  00000460  40E7                           move.w  sr,-(sp)
  761  00000462  007C0700                       ori.w   #$0700,sr
  762  00000466  4238FA19                       clr.b   $FFFFFA19.w             ; both timers stopped,
  763  0000046A  023800F0FA1D                   andi.b  #$F0,$FFFFFA1D.w
  764  00000470  08B80005FA07                   bclr    #5,$FFFFFA07.w          ; disabled and masked - the claim
  765  00000476  08B80005FA13                   bclr    #5,$FFFFFA13.w          ; handed back bit by bit
  766  0000047C  08B80004FA09                   bclr    #4,$FFFFFA09.w
  767  00000482  08B80004FA15                   bclr    #4,$FFFFFA15.w
  768  00000488  08B80005FA0B                   bclr    #5,$FFFFFA0B.w          ; and no pending ticks of ours
  769  0000048E  08B80004FA0D                   bclr    #4,$FFFFFA0D.w
  770  00000494  41FAxxxx                       lea     yx6_drums(pc),a0
  771  00000498  4210                           clr.b   (a0)
  772  0000049A  7402                           moveq   #2,d2                   ; every burst gate open again
  773  0000049C  3F02                   .gates: move.w  d2,-(sp)
  774  0000049E  7802                           moveq   #2,d4
  775  000004A0  6100xxxx                       bsr     yx6_burst_gate
  776  000004A4  341F                           move.w  (sp)+,d2
  777  000004A6  51CAFFF4                       dbra    d2,.gates
  778                                   ; The silence stays inside the mask: selecting a register and writing it are
  779                                   ; two bus cycles, and a polite host's system interrupts - about to get their
  780                                   ; state back - use the chip too.
  781  000004AA  41F9FFFF8800                   lea     YX6_PSG,a0
  782  000004B0  7008                           moveq   #8,d0                   ; R8, R9, R10 are the voice volumes
  783                                   .silence:
  784  000004B2  1080                           move.b  d0,(a0)
  785  000004B4  42280002                       clr.b   2(a0)
  786  000004B8  5200                           addq.b  #1,d0
  787  000004BA  B03C000B                       cmp.b   #11,d0
  788  000004BE  66F2                           bne.s   .silence
  789  000004C0  46DF                           move.w  (sp)+,sr
  790  000004C2  4E75                           rts
  791                                   
  792                                   ; -----------------------------------------------------------------------------
  793                                   ; The effect machinery. The per-frame stage lives inlined in YX6_play; what
  794                                   ; follows is everything it drives: the two slot descriptors, the tick
  795                                   ; handlers, and the one slot machine that serves both timers.
  796                                   ; -----------------------------------------------------------------------------
  797                                   
  798                                   ; The slot descriptors - see the SD_ equates. Slot 1 owns Timer A, slot 2
  799                                   ; Timer D, whose control nibble is shared with Timer C and only ever changed
  800                                   ; read-modify-write; the slot machine uses that form for both, which on
  801                                   ; Timer A writes the same values a clear would.
  802                                           even
  803                                   yx6_desc1:
  804  000004C4  0000                           dc.b    0,0                     ; E last, T last
  805  000004C6  FA19FA1F0134                   dc.w    $FA19,$FA1F,$0134       ; control, data, vector
  806  000004CC  00000000                       dc.l    0                       ; PARM, set per effect
  807  000004D0  0000000000000000               dc.l    0,0                     ; ISR block, other slot: yx6_link
  808                                   yx6_desc2:
  809  000004D8  0000                           dc.b    0,0
  810  000004DA  FA1DFA250110                   dc.w    $FA1D,$FA25,$0110
  811  000004E0  00000000                       dc.l    0
  812  000004E4  0000000000000000               dc.l    0,0
  813                                   
  814                                   ; -----------------------------------------------------------------------------
  815                                   ; The tick handlers, in maxYMiser's shipping forms: the PSG select and write
  816                                   ; in as few instructions as the bus allows, patched immediates instead of
  817                                   ; state, software end-of-interrupt as TOS runs the MFP - written as an
  818                                   ; immediate byte, since the in-service registers ignore written ones. All
  819                                   ; MFP interrupts arrive at 68000 level 6, so these never nest, and every
  820                                   ; patched operand is addressed pc-relatively so the player stays loadable
  821                                   ; anywhere - which also means it must run from RAM, where a demo lives.
  822                                   ;
  823                                   ; The two slots' handlers are the same text twice, and MUST stay
  824                                   ; byte-congruent: the slot machine and yx6_drum_start reach every patched
  825                                   ; operand through ISR_ offsets measured on the A block. The rig checks the
  826                                   ; congruence from the symbol table. The park entries - where YX6_init aims
  827                                   ; the vectors while no effect runs - are the handlers' own tails.
  828                                   ;
  829                                   ; The timers STACK: each handler drops the IPL to 5 as soon as its PSG
  830                                   ; select/data pair is complete, so the MFP's higher-priority channel -
  831                                   ; Timer A over Timer D - can nest instead of waiting a whole tick. The
  832                                   ; nesting is strictly one-way: Timer A interrupts Timer D's handlers,
  833                                   ; never the reverse (SEI mode admits only higher MFP priorities while an
  834                                   ; in-service bit is set), and nothing of the player's sits above Timer A.
  835                                   ; That direction is why the USP park belongs to the D-side drum alone: the
  836                                   ; A-side drum - the one that can nest into a parked window - always uses
  837                                   ; the stack, so a parked USP survives. The drop must never come before
  838                                   ; the handler's LAST chip write: a nested tick re-selects the PSG.
  839                                   ;
  840                                   ; The patch offsets are load-bearing:
  841                                   ;   drum:  select immediate at +3, sample address at +8, flag mask at
  842                                   ;          _clear+3, the burst gate's address at _gate+4
  843                                   ;   sid:   select at +2 and volume at +4 inside the imm long; the partner's
  844                                   ;          whole vector at +14, past the IPL drop, patched by yx6_link
  845                                   ;   buzz:  the shape at +4
  846                                   ; -----------------------------------------------------------------------------
  847                                   
  848                                   ; One drum tick: the sample byte goes straight to the voice's volume register.
  849                                   ; The byte after the last has bit 7 set, so the same move answers "done": park
  850                                   ; the volume mid-scale against the click, stop the timer, drop the flag.
  851                                   yx6_drumA:
  852  000004EC  11FC00088800                   move.b  #8,$FFFF8800.w          ; SMC +3: select the drummed volume
  853  000004F2  11F9123456788802               move.b  $12345678,$FFFF8802.w   ; SMC +8: the next sample byte
  854  000004FA  6Bxx                           bmi.s   .ended
  855  000004FC  46FC2500                       move.w  #$2500,sr               ; pair done: the other timer may stack
  856  00000500  2F08                           move.l  a0,-(sp)                ; the stack, never the USP: this side
  857  00000502  41FAFFF0                       lea     yx6_drumA+8(pc),a0      ; nests into parked windows
  858  00000506  5290                           addq.l  #1,(a0)                 ; step the operand itself
  859  00000508  205F                           movea.l (sp)+,a0
  860  0000050A  11FC00DFFA0F                   move.b  #$DF,$FFFFFA0F.w
  861  00000510  4E73                           rte
  862                                   .ended:
  863  00000512  11FC000D8802                   move.b  #$D,$FFFF8802.w         ; middle volume: no click
  864  00000518  023800F0FA19                   andi.b  #$F0,$FFFFFA19.w        ; the sample ran out: stop Timer A
  865  0000051E  46FC2500                       move.w  #$2500,sr
  866  00000522  2F08                           move.l  a0,-(sp)
  867  00000524  41FAxxxx                       lea     yx6_drums(pc),a0
  868                                   yx6_drumA_clear:
  869  00000528  021000FF                       andi.b  #$FF,(a0)               ; SMC +3: drop the voice's drum flag
  870                                   yx6_drumA_gate:
  871  0000052C  33FC000212345678               move.w  #2,$12345678            ; SMC +4: the voice's burst write
  872  00000534  205F                           movea.l (sp)+,a0                ; comes back
  873                                   yx6_parkA:
  874  00000536  11FC00DFFA0F                   move.b  #$DF,$FFFFFA0F.w
  875  0000053C  4E73                           rte
  876                                   
  877                                   ; The SID square: each tick writes one half of the square - the volume or
  878                                   ; silence - and installs the other half as the next tick, one word into the
  879                                   ; vector. Select and data land in one move.l: the immediate's bytes hit
  880                                   ; $8800 (select) and $8802 (data) by bus layout.
  881                                   yx6_sidA_on:
  882  0000053E  21FC08000F008800               move.l  #$08000F00,$FFFF8800.w  ; SMC +2 select, +4 volume
  883  00000546  46FC2500                       move.w  #$2500,sr
  884  0000054A  21FC000000000134               move.l  #0,$134.w               ; SMC +14: the quiet half is next -
  885  00000552  11FC00DFFA0F                   move.b  #$DF,$FFFFFA0F.w        ; the whole vector, so the blob may
  886  00000558  4E73                           rte                             ; straddle a 64K boundary
  887                                   yx6_sidA_off:
  888  0000055A  21FC080000008800               move.l  #$08000000,$FFFF8800.w  ; SMC +2 select; silence
  889  00000562  46FC2500                       move.w  #$2500,sr
  890  00000566  21FC000000000134               move.l  #0,$134.w               ; SMC +14: the loud half is next
  891  0000056E  11FC00DFFA0F                   move.b  #$DF,$FFFFFA0F.w
  892  00000574  4E73                           rte
  893                                   
  894                                   ; The sync-buzzer tick: writing the shape to R13 restarts the envelope, and
  895                                   ; that restart at the timer's rate is the whole effect.
  896                                   yx6_buzzA:
  897  00000576  21FC0D0000008800               move.l  #$0D000000,$FFFF8800.w  ; SMC +4: the shape
  898  0000057E  46FC2500                       move.w  #$2500,sr
  899  00000582  11FC00DFFA0F                   move.b  #$DF,$FFFFFA0F.w
  900  00000588  4E73                           rte
  901                                   
  902                                   ; Slot 2's instances: Timer D's stop, vector and in-service bit, otherwise
  903                                   ; the A block byte for byte.
  904                                   yx6_drumD:
  905  0000058A  11FC00088800                   move.b  #8,$FFFF8800.w
  906  00000590  11F9123456788802               move.b  $12345678,$FFFF8802.w
  907  00000598  6Bxx                           bmi.s   .ended
  908  0000059A  46FC2500                       move.w  #$2500,sr               ; Timer A may nest from here on, and
  909                                           .if YX6_SUPER_HOST              ; never parks the USP itself - so
  910                                 -         move    a0,usp                  ; this side may
  911                                 -         .else
  912  0000059E  2F08                           move.l  a0,-(sp)
  913                                           .endif
  914  000005A0  41FAFFF0                       lea     yx6_drumD+8(pc),a0
  915  000005A4  5290                           addq.l  #1,(a0)
  916                                           .if YX6_SUPER_HOST
  917                                 -         move    usp,a0
  918                                 -         .else
  919  000005A6  205F                           movea.l (sp)+,a0
  920                                           .endif
  921  000005A8  11FC00EFFA11                   move.b  #$EF,$FFFFFA11.w
  922  000005AE  4E73                           rte
  923                                   .ended:
  924  000005B0  11FC000D8802                   move.b  #$D,$FFFF8802.w
  925  000005B6  023800F0FA1D                   andi.b  #$F0,$FFFFFA1D.w
  926  000005BC  46FC2500                       move.w  #$2500,sr
  927                                           .if YX6_SUPER_HOST
  928                                 -         move    a0,usp
  929                                 -         .else
  930  000005C0  2F08                           move.l  a0,-(sp)
  931                                           .endif
  932  000005C2  41FAxxxx                       lea     yx6_drums(pc),a0
  933                                   yx6_drumD_clear:
  934  000005C6  021000FF                       andi.b  #$FF,(a0)
  935                                   yx6_drumD_gate:
  936  000005CA  33FC000212345678               move.w  #2,$12345678
  937                                           .if YX6_SUPER_HOST
  938                                 -         move    usp,a0
  939                                 -         .else
  940  000005D2  205F                           movea.l (sp)+,a0
  941                                           .endif
  942                                   yx6_parkD:
  943  000005D4  11FC00EFFA11                   move.b  #$EF,$FFFFFA11.w
  944  000005DA  4E73                           rte
  945                                   
  946                                   yx6_sidD_on:
  947  000005DC  21FC08000F008800               move.l  #$08000F00,$FFFF8800.w
  948  000005E4  46FC2500                       move.w  #$2500,sr
  949  000005E8  21FC000000000110               move.l  #0,$110.w
  950  000005F0  11FC00EFFA11                   move.b  #$EF,$FFFFFA11.w
  951  000005F6  4E73                           rte
  952                                   yx6_sidD_off:
  953  000005F8  21FC080000008800               move.l  #$08000000,$FFFF8800.w
  954  00000600  46FC2500                       move.w  #$2500,sr
  955  00000604  21FC000000000110               move.l  #0,$110.w
  956  0000060C  11FC00EFFA11                   move.b  #$EF,$FFFFFA11.w
  957  00000612  4E73                           rte
  958                                   
  959                                   yx6_buzzD:
  960  00000614  21FC0D0000008800               move.l  #$0D000000,$FFFF8800.w
  961  0000061C  46FC2500                       move.w  #$2500,sr
  962  00000620  11FC00EFFA11                   move.b  #$EF,$FFFFFA11.w
  963  00000626  4E73                           rte
  964                                   
  965                                   yx6_drums:
  966  00000628  00                             dc.b    0                       ; voice bits 0-2: a drum is running
  967  00000629  00                             even
  968                                   
  969                                   ; Where the patched operands sit, measured on the A block; the D block is
  970                                   ; byte-congruent, so the same offsets serve both through SD_ISR.
  971                                   ; rmac evaluates left to right: the parentheses are load-bearing.
  972           =00000003               ISR_DRUM_SEL    equ     3
  973           =00000008               ISR_DRUM_PTR    equ     8
  974           =0000003F               ISR_CLEAR       equ     (yx6_drumA_clear-yx6_drumA)+3
  975           =00000044               ISR_GATE        equ     (yx6_drumA_gate-yx6_drumA)+4
  976           =00000052               ISR_SIDON       equ     yx6_sidA_on-yx6_drumA
  977           =00000054               ISR_SIDON_SEL   equ     ISR_SIDON+2
  978           =00000056               ISR_SID_VOL     equ     ISR_SIDON+4
  979           =00000060               ISR_SIDON_NEXT  equ     ISR_SIDON+14
  980           =0000006E               ISR_SIDOFF      equ     yx6_sidA_off-yx6_drumA
  981           =00000070               ISR_SIDOFF_SEL  equ     ISR_SIDOFF+2
  982           =0000007C               ISR_SIDOFF_NEXT equ     ISR_SIDOFF+14
  983           =0000008A               ISR_BUZZ        equ     yx6_buzzA-yx6_drumA
  984           =0000008E               ISR_BUZZ_SHAPE  equ     ISR_BUZZ+4
  985                                   
  986                                   ; -----------------------------------------------------------------------------
  987                                   ; yx6_link, from YX6_init: the run-time addresses only a loaded player knows.
  988                                   ; Each descriptor gets its ISR block and its partner, both slots' last code
  989                                   ; and count are cleared, and the SID halves get each other's address low
  990                                   ; word - the vector's high word never changes, and neither do these, so
  991                                   ; they are patched once here rather than on every SID start.
  992                                   ; -----------------------------------------------------------------------------
  993                                   yx6_link:
  994  0000062A  7402                           moveq   #2,d2                   ; every burst gate open: a previous
  995  0000062C  3F02                   .gates: move.w  d2,-(sp)                ; session's mute must not leak
  996  0000062E  7802                           moveq   #2,d4
  997  00000630  6100xxxx                       bsr     yx6_burst_gate
  998  00000634  341F                           move.w  (sp)+,d2
  999  00000636  51CAFFF4                       dbra    d2,.gates
 1000  0000063A  41FAFE88                       lea     yx6_desc1(pc),a0
 1001  0000063E  43FAFE98                       lea     yx6_desc2(pc),a1
 1002  00000642  21490010                       move.l  a1,SD_OTHER(a0)
 1003  00000646  23480010                       move.l  a0,SD_OTHER(a1)
 1004  0000064A  4250                           clr.w   (a0)                    ; E and T last, both slots
 1005  0000064C  4251                           clr.w   (a1)
 1006  0000064E  45FAFE9C                       lea     yx6_drumA(pc),a2
 1007  00000652  214A000C                       move.l  a2,SD_ISR(a0)
 1008  00000656  61xx                           bsr.s   .partners
 1009  00000658  45FAFF30                       lea     yx6_drumD(pc),a2
 1010  0000065C  234A000C                       move.l  a2,SD_ISR(a1)
 1011                                   .partners:
 1012  00000660  41EA006E                       lea     ISR_SIDOFF(a2),a0       ; each half installs the other,
 1013  00000664  25480060                       move.l  a0,ISR_SIDON_NEXT(a2)   ; as a whole vector
 1014  00000668  41EA0052                       lea     ISR_SIDON(a2),a0
 1015  0000066C  2548007C                       move.l  a0,ISR_SIDOFF_NEXT(a2)
 1016  00000670  4E75                           rts
 1017                                   
 1018                                   ; -----------------------------------------------------------------------------
 1019                                   ; yx6_slot: one slot of the effect stage - both slots, through a5.
 1020                                   ; A changed code reprograms the slot's timer from scratch, a held one
 1021                                   ; updates only the count (a running MFP timer loads it at its next reload),
 1022                                   ; a dropped one stops the timer - unless the slot ran a drum, which
 1023                                   ; finishes by itself. A held DRUM code is a trigger on EVERY frame it is
 1024                                   ; present, as the reference player starts one on each coded frame: real
 1025                                   ; dumps carry back-to-back codes whose ring bytes name different samples -
 1026                                   ; an attack, then a body - and only a full restart plays the second one.
 1027                                   ;
 1028                                   ; in: d0.b = E (never 0 with E-last also 0: the caller's gate), d1.b = T,
 1029                                   ;     a5 = the slot's descriptor, a3 = workspace, d3.l = N.
 1030                                   ; preserves d3/a3/a5; clobbers d0-d2/d4-d5, a0-a2/a4.
 1031                                   ; -----------------------------------------------------------------------------
 1032                                   yx6_slot:
 1033  00000672  B015                           cmp.b   (a5),d0
 1034  00000674  6700xxxx                       beq.w   .held
 1035  00000678  1815                           move.b  (a5),d4                 ; what the slot was doing before
 1036  0000067A  1A80                           move.b  d0,(a5)
 1037  0000067C  4A00                           tst.b   d0
 1038  0000067E  6700xxxx                       beq.w   .released
 1039                                   ; A new code: find the parameter register's ring - r8+voice carries the SID
 1040                                   ; volume, the drum number or the buzzer shape - then let the type arm its
 1041                                   ; handler; every type then (re)programs the timer the same way. The voice
 1042                                   ; stays live in d5, the parameter byte in a1, for whoever needs them.
 1043  00000682  1A00                           move.b  d0,d5
