  384  0000010C  265F                           movea.l (sp)+,a3
  385                                   
  386  0000010E  225F                           movea.l (sp)+,a1                ; the state block; a1 is recomputed
  387  00000110  23480008                       move.l  a0,YS_INPUT(a1)         ; every time round this loop
  388  00000114  234A0010                       move.l  a2,YS_LIT(a1)
  389  00000118  234C0014                       move.l  a4,YS_BOFF(a1)
