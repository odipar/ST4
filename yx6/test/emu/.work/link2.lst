  403                                   ; The cursor reaches the effect and mixer rings by fixed hops, computed once.
  404  00000146  302B0024                       move.w  YX6_N(a3),d0
  405  0000014A  C0FC0007                       mulu.w  #7,d0
  406  0000014E  27400032                       move.l  d0,YX6_R7OFF(a3)
  407  00000152  D080                           add.l   d0,d0                   ; and 14*N, from the same mulu
  408  00000154  2740002E                       move.l  d0,YX6_EFXOFF(a3)
  409                                   
  410                                   ; The burst reads register k's ring byte through an assembled-in k*N
  411                                   ; displacement - patch all fourteen now that N is known. The packer keeps
  412                                   ; N at 2520 or less, so 13*N fits the signed word. Each YX6_WRITE is ten
  413                                   ; bytes with its displacement at +6; R7 and R13 read out of line.
  414  00000158  342B0024                       move.w  YX6_N(a3),d2
  415  0000015C  7200                           moveq   #0,d1                   ; k*N, accumulated
  416  0000015E  41FAxxxx                       lea     yx6_wA+6(pc),a0
  417  00000162  7006                           moveq   #6,d0                   ; R0..R6
  418                                   .wpatchA:
  419  00000164  3081                           move.w  d1,(a0)
  420  00000166  D242                           add.w   d2,d1
  421  00000168  41E8000A                       lea     10(a0),a0
  422  0000016C  51C8FFF6                       dbra    d0,.wpatchA
  423  00000170  41FAxxxx                       lea     yx6_w7+2(pc),a0         ; R7 reads through d1
  424  00000174  3081                           move.w  d1,(a0)
  425  00000176  D242                           add.w   d2,d1
  426  00000178  41FAxxxx                       lea     yx6_wB+6(pc),a0
  427  0000017C  7004                           moveq   #4,d0                   ; R8..R12
  428                                   .wpatchB:
  429  0000017E  3081                           move.w  d1,(a0)
  430  00000180  D242                           add.w   d2,d1
  431  00000182  41E8000A                       lea     10(a0),a0
  432  00000186  51C8FFF6                       dbra    d0,.wpatchB
  433  0000018A  41FAxxxx                       lea     yx6_w13+2(pc),a0
  434  0000018E  3081                           move.w  d1,(a0)
  435  00000190  422B0036                       clr.b   YX6_PATCHES(a3)
  436  00000194  41FAxxxx                       lea     yx6_drums(pc),a0
  437  00000198  4210                           clr.b   (a0)
  438  0000019A  6100xxxx                       bsr     yx6_link                ; descriptors: pointers and last codes
  439                                   
  440                                   ; Claim Timers A and D: park our handlers on the vectors and leave both
  441                                   ; timers stopped but enabled and unmasked. Nothing is saved - the machine
  442                                   ; state is the host's, see assumption 5 in the header. bset/bclr only:
  443                                   ; Timer C's bits and the ACIA's live in the same registers.
  444  0000019E  40E7                           move.w  sr,-(sp)
  445  000001A0  007C0700                       ori.w   #$0700,sr
  446  000001A4  4238FA19                       clr.b   $FFFFFA19.w             ; Timer A stopped
  447  000001A8  023800F0FA1D                   andi.b  #$F0,$FFFFFA1D.w        ; Timer D stopped; Timer C untouched
  448  000001AE  41FAxxxx                       lea     yx6_parkA(pc),a0
  449  000001B2  21C80134                       move.l  a0,$134.w
  450  000001B6  41FAxxxx                       lea     yx6_parkD(pc),a0
  451  000001BA  21C80110                       move.l  a0,$110.w
  452  000001BE  08B80005FA0B                   bclr    #5,$FFFFFA0B.w          ; drop stale pendings
  453  000001C4  08B80004FA0D                   bclr    #4,$FFFFFA0D.w
  454  000001CA  08F80005FA07                   bset    #5,$FFFFFA07.w          ; Timer A enabled and unmasked
  455  000001D0  08F80005FA13                   bset    #5,$FFFFFA13.w
  456  000001D6  08F80004FA09                   bset    #4,$FFFFFA09.w          ; Timer D likewise
  457  000001DC  08F80004FA15                   bset    #4,$FFFFFA15.w
  458  000001E2  46DF                           move.w  (sp)+,sr
  459                                   
  460  000001E4  7000                           moveq   #0,d0
  461  000001E6  4E75                           rts
  462                                   .rejected:
  463  000001E8  70FF                           moveq   #-1,d0
  464  000001EA  4E75                           rts
