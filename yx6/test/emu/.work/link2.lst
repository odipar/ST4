       00000374  14BC0006             @         move.b  #$6,(a2)           
  663  00000378  15697FFF0002         @         move.b  $7FFF(a1),2(a2)         
  664                                   
  665  0000037E  14BC0007                       move.b  #YX6_MIXER,(a2)         ; R7 also carries the ST's I/O port
  666                                   yx6_w7:
