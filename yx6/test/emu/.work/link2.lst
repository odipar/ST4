  427                                   ; -----------------------------------------------------------------------------
  428                                   ; YX6_fill: d0.w = stream index * YX6_STATE_SIZE, d3.w = values wanted.
  429                                   ; Produces exactly that many values for one register, crossing into the loop
  430                                   ; section - and around it again - as often as it takes. Straddling matters even
  431                                   ; for one group: nothing says the loop frame falls on a group boundary.
  432                                   ; -----------------------------------------------------------------------------
  433                                   YX6_fill:
  434  00000236  48E70302                       movem.l d6-d7/a6,-(sp)          ; three registers that survive a decoder
  435  0000023A  45F30060                       lea     YX6_STATE(a3,d0.w),a2   ; call, which its own state needs
  436  0000023E  2C4B                           movea.l a3,a6                   ; ST4 clobbers a3: a6 keeps the workspace
  437  00000240  2C0A                           move.l  a2,d6
  438  00000242  7E00                           moveq   #0,d7
  439  00000244  3E03                           move.w  d3,d7                   ; values still wanted
  440                                   .piece:
  441  00000246  202A0028                       move.l  YS_LEFT(a2),d0
  442  0000024A  66xx                           bne.s   .section
  443  0000024C  6100xxxx                       bsr     YX6_start_loop          ; this section ran out: go round again
  444  00000250  202A0028                       move.l  YS_LEFT(a2),d0
  445  00000254  67xx                           beq.s   .done                   ; nothing to go round to; do not hang
  446                                   .section:
  447  00000256  B087                           cmp.l   d7,d0
  448  00000258  65xx                           bcs.s   .piece_size
  449  0000025A  2007                           move.l  d7,d0                   ; the section covers all that is wanted
  450                                   .piece_size:
  451  0000025C  91AA0028                       sub.l   d0,YS_LEFT(a2)
  452  00000260  9E80                           sub.l   d0,d7
  453  00000262  3600                           move.w  d0,d3                   ; a piece is at most C, so it fits a word
  454                                   ; The decoder's budget counts units of ST4_UNIT bytes. The packer enforces
  455                                   ; that every piece boundary - C, the loop frame, the tune length - is a whole
  456                                   ; number of units, so this shift never drops a remainder.
  457                                           .if ST4_UNIT=2
  458  00000264  E24B                           lsr.w   #1,d3
  459                                           .endif
  460                                           .if ST4_UNIT=4
  461                                 -         lsr.w   #2,d3
  462                                 -         .endif
  463                                   
  464                                   ; (a2) written out rather than YS_D1(a2): with +o3 rmac folds a zero
  465                                   ; displacement away on movem but keeps the addressing mode, and emits the
  466                                   ; instruction without its extension word. The next word becomes the
  467                                   ; displacement and the code runs off into nothing.
  468  00000266  4CD20306                       movem.l (a2),d1-d2/a0-a1
  469  0000026A  286A0014                       movea.l YS_BOFF(a2),a4
  470  0000026E  2A6A0018                       movea.l YS_WOFF(a2),a5
  471  00000272  302A001C                       move.w  YS_QUEUE(a2),d0
  472  00000276  246A0010                       movea.l YS_LIT(a2),a2           ; loaded last: a2 was the base
  473  0000027A  6100xxxx                       bsr     ST4_resume
  474  0000027E  264E                           movea.l a6,a3                   ; the decoder clobbered the workspace
  475  00000280  CD8A                           exg     a2,d6                   ; a2 = the block again, d6 = stream B
  476  00000282  B3EA0024                       cmpa.l  YS_END(a2),a1           ; YX6_save, inlined: this is the hot path
  477  00000286  66xx                           bne.s   .stored
  478  00000288  226A0020                       movea.l YS_START(a2),a1         ; the call landed on the ring end
  479                                   .stored:
  480  0000028C  48D20306                       movem.l d1-d2/a0-a1,(a2)
  481  00000290  25460010                       move.l  d6,YS_LIT(a2)
  482  00000294  254C0014                       move.l  a4,YS_BOFF(a2)
  483  00000298  254D0018                       move.l  a5,YS_WOFF(a2)
  484  0000029C  3540001C                       move.w  d0,YS_QUEUE(a2)
  485  000002A0  2C0A                           move.l  a2,d6                   ; the block pointer, back where fill keeps it
  486  000002A2  4A87                           tst.l   d7
  487  000002A4  66A0                           bne.s   .piece
  488                                   .done:
  489  000002A6  4CDF40C0                       movem.l (sp)+,d6-d7/a6
  490  000002AA  4E75                           rts
