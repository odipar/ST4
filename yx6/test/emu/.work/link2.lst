  678                                   yx6_w13:
  679  000003C0  12297FFF                       move.b  $7FFF(a1),d1            ; R13 restarts the envelope whenever it
  680  000003C4  B23C00FF                       cmp.b   #YX6_NO_ENV,d1          ; is written, so $FF means leave it be
  681  000003C8  67xx                           beq.s   .envelope_held
  682  000003CA  14BC000D                       move.b  #YX6_ENVELOPE,(a2)
  683  000003CE  15410002                       move.b  d1,2(a2)
  684                                   .envelope_held:
  685  000003D2  46DF                           move.w  (sp)+,sr
  686                                   
  687                                   ; Undo this frame's ring edits: the chip has heard the sanitized frame, and
  688                                   ; the ring must stay exact decode history for every match yet to come.
  689  000003D4  102B0036                       move.b  YX6_PATCHES(a3),d0
  690  000003D8  67xx                           beq.s   .pristine
  691  000003DA  422B0036                       clr.b   YX6_PATCHES(a3)         ; cleared only when it was used
  692  000003DE  41EB003A                       lea     YX6_PATCH_ADDR(a3),a0
  693  000003E2  43EB0037                       lea     YX6_PATCH_VAL(a3),a1
  694                                   .restore:
  695  000003E6  2458                           movea.l (a0)+,a2
  696  000003E8  1499                           move.b  (a1)+,(a2)
  697  000003EA  5300                           subq.b  #1,d0
  698  000003EC  66F8                           bne.s   .restore
  699                                   .pristine:
  700                                   
  701                                   ; Refill the stream whose turn it is. Slots 18..C-1 exist when C is larger
  702                                   ; than the stream count; they simply have nothing to do.
  703  000003EE  302B0028                       move.w  YX6_SLOT(a3),d0
  704  000003F2  B07C0012                       cmp.w   #YX6_STREAMS,d0
  705  000003F6  64xx                           bcc.s   .advance
  706  000003F8  7600                           moveq   #0,d3
  707  000003FA  362B0026                       move.w  YX6_C(a3),d3            ; a whole group
  708  000003FE  4A6B002C                       tst.w   YX6_LOOPS(a3)
  709  00000402  66xx                           bne.s   .refill                 ; a looping tune never runs out
  710  00000404  222B0018                       move.l  YX6_TOTAL(a3),d1
  711  00000408  92AB0008                       sub.l   YX6_NEXT(a3),d1         ; values still packed
  712  0000040C  6Fxx                           ble.s   .advance                ; all decoded: never call ST4 again
  713  0000040E  B283                           cmp.l   d3,d1
  714  00000410  64xx                           bcc.s   .refill
  715  00000412  2601                           move.l  d1,d3                   ; the last group is a short one
  716                                   .refill:
  717  00000414  ED48                           lsl.w   #6,d0
  718  00000416  6100FDD4                       bsr     YX6_fill
  719                                   
  720                                   .advance:
  721  0000041A  5293                           addq.l  #1,YX6_CURSOR(a3)       ; one byte along every ring
  722  0000041C  2013                           move.l  YX6_CURSOR(a3),d0
  723  0000041E  B0AB000C                       cmp.l   YX6_RINGEND(a3),d0
  724  00000422  65xx                           bcs.s   .cursor_ready
  725  00000424  26AB0010                       move.l  YX6_RINGS(a3),YX6_CURSOR(a3)
  726                                   .cursor_ready:
  727  00000428  302B0028                       move.w  YX6_SLOT(a3),d0
  728  0000042C  5240                           addq.w  #1,d0
  729  0000042E  B06B0026                       cmp.w   YX6_C(a3),d0
  730  00000432  65xx                           bcs.s   .slot_ready
  731  00000434  7000                           moveq   #0,d0                   ; a cycle ended: the groups move on
  732  00000436  7200                           moveq   #0,d1
  733  00000438  322B0026                       move.w  YX6_C(a3),d1
  734  0000043C  D3AB0008                       add.l   d1,YX6_NEXT(a3)
  735                                   .slot_ready:
  736  00000440  37400028                       move.w  d0,YX6_SLOT(a3)
  737                                   
  738                                   ; The rings hold the tune as one continuous sequence, so reaching the end of
  739                                   ; the last frame simply means the next values in them are the loop section's.
  740                                   ; The countdown follows: it reloads with the loop section's length.
  741  00000444  53AB0004                       subq.l  #1,YX6_LEFTFR(a3)
  742  00000448  66xx                           bne.s   .played
  743  0000044A  4A6B002C                       tst.w   YX6_LOOPS(a3)
  744  0000044E  67xx                           beq.s   .played                 ; zero and no loop: the next call ends
  745  00000450  276B001C0004                   move.l  YX6_LOOPLEN(a3),YX6_LEFTFR(a3)
  746  00000456  7001                           moveq   #1,d0                   ; played, and wrapped to the loop point
  747  00000458  4E75                           rts
  748                                   .played:
  749  0000045A  7000                           moveq   #0,d0
  750  0000045C  4E75                           rts
  751                                   
  752                                   ; -----------------------------------------------------------------------------
  753                                   ; YX6_stop: a0 = workspace. Quiesces what YX6_init claimed - both timers
  754                                   ; stopped, their interrupts disabled and masked, pendings dropped - then
  755                                   ; silences the three voices. It restores NOTHING: the host that saved the
  756                                   ; machine state hands it back itself, after this returns. Tone and envelope
  757                                   ; settings stay, and a fresh YX6_init starts the tune over.
  758                                   ; -----------------------------------------------------------------------------
  759                                   YX6_stop:
  760  0000045E  2648                           movea.l a0,a3
  761  00000460  40E7                           move.w  sr,-(sp)
  762  00000462  007C0700                       ori.w   #$0700,sr
  763  00000466  4238FA19                       clr.b   $FFFFFA19.w             ; both timers stopped,
  764  0000046A  023800F0FA1D                   andi.b  #$F0,$FFFFFA1D.w
  765  00000470  08B80005FA07                   bclr    #5,$FFFFFA07.w          ; disabled and masked - the claim
  766  00000476  08B80005FA13                   bclr    #5,$FFFFFA13.w          ; handed back bit by bit
  767  0000047C  08B80004FA09                   bclr    #4,$FFFFFA09.w
  768  00000482  08B80004FA15                   bclr    #4,$FFFFFA15.w
  769  00000488  08B80005FA0B                   bclr    #5,$FFFFFA0B.w          ; and no pending ticks of ours
  770  0000048E  08B80004FA0D                   bclr    #4,$FFFFFA0D.w
  771  00000494  41FAxxxx                       lea     yx6_drums(pc),a0
  772  00000498  4210                           clr.b   (a0)
  773  0000049A  7402                           moveq   #2,d2                   ; every burst gate open again
  774  0000049C  3F02                   .gates: move.w  d2,-(sp)
  775  0000049E  7802                           moveq   #2,d4
  776  000004A0  6100xxxx                       bsr     yx6_burst_gate
  777  000004A4  341F                           move.w  (sp)+,d2
  778  000004A6  51CAFFF4                       dbra    d2,.gates
  779                                   ; The silence stays inside the mask: selecting a register and writing it are
  780                                   ; two bus cycles, and a polite host's system interrupts - about to get their
  781                                   ; state back - use the chip too.
  782  000004AA  41F9FFFF8800                   lea     YX6_PSG,a0
  783  000004B0  7008                           moveq   #8,d0                   ; R8, R9, R10 are the voice volumes
  784                                   .silence:
  785  000004B2  1080                           move.b  d0,(a0)
  786  000004B4  42280002                       clr.b   2(a0)
  787  000004B8  5200                           addq.b  #1,d0
  788  000004BA  B03C000B                       cmp.b   #11,d0
  789  000004BE  66F2                           bne.s   .silence
  790  000004C0  46DF                           move.w  (sp)+,sr
  791  000004C2  4E75                           rts
