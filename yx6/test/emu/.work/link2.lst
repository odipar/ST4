  492                                   ; -----------------------------------------------------------------------------
  493                                   ; YX6_start_loop: a2 = state block. Starts this register's loop stream over -
  494                                   ; a fresh decoder, reading from the top of the loop section, still writing
  495                                   ; where the last one stopped. ST4_init wants the ring start so that its packed
  496                                   ; metadata comes out right; the write pointer is restored from the block, which
  497                                   ; is why it is stored rather than held in a register.
  498                                   ; -----------------------------------------------------------------------------
  499                                   ; It runs inside YX6_fill, which guarantees d6 = the state block and a6 = the
  500                                   ; workspace - the two anchors that survive the decoder call.
  501                                   YX6_start_loop:
  502  000002AC  200A                           move.l  a2,d0
  503  000002AE  908B                           sub.l   a3,d0
  504  000002B0  907C0060                       sub.w   #YX6_STATE,d0
  505  000002B4  E848                           lsr.w   #4,d0                   ; k * 64 becomes k * 4, a table index
  506  000002B6  206B0014                       movea.l YX6_FILE(a3),a0
  507  000002BA  2030006A                       move.l  YH_LOOP_TABLE(a0,d0.w),d0
  508  000002BE  67xx                           beq.s   .no_loop                ; this tune has no loop section
  509  000002C0  D1C0                           adda.l  d0,a0                   ; the loop section's ST4 container
  510  000002C2  226A0020                       movea.l YS_START(a2),a1         ; read before a2 becomes stream B
  511  000002C6  2448                           movea.l a0,a2
  512  000002C8  D5E80008                       adda.l  8(a0),a2                ; stream B
  513  000002CC  2848                           movea.l a0,a4
  514  000002CE  D9E8000C                       adda.l  12(a0),a4               ; stream C
  515  000002D2  2A48                           movea.l a0,a5
  516  000002D4  DBE80010                       adda.l  16(a0),a5               ; stream D
  517  000002D8  41E80014                       lea     20(a0),a0               ; stream A
  518  000002DC  7600                           moveq   #0,d3
  519  000002DE  362B0024                       move.w  YX6_N(a3),d3
  520  000002E2  6100xxxx                       bsr     ST4_init
  521  000002E6  264E                           movea.l a6,a3                   ; the decoder clobbered the workspace
  522  000002E8  CD8A                           exg     a2,d6                   ; a2 = the block again, d6 = stream B
  523  000002EA  25480008                       move.l  a0,YS_INPUT(a2)
  524  000002EE  25460010                       move.l  d6,YS_LIT(a2)
  525  000002F2  254C0014                       move.l  a4,YS_BOFF(a2)
  526  000002F6  254D0018                       move.l  a5,YS_WOFF(a2)
  527  000002FA  3540001C                       move.w  d0,YS_QUEUE(a2)
  528  000002FE  2481                           move.l  d1,YS_D1(a2)
  529  00000300  25420004                       move.l  d2,YS_D2(a2)
  530  00000304  256B001C0028                   move.l  YX6_LOOPLEN(a3),YS_LEFT(a2)
  531  0000030A  2C0A                           move.l  a2,d6                   ; the block pointer, as fill keeps it
  532                                   .no_loop:
  533  0000030C  4E75                           rts
