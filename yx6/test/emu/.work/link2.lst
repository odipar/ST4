  536                                   ; YX6_play: a0 = workspace. One frame: write fourteen registers, refill one.
  537                                   ; -----------------------------------------------------------------------------
  538                                   YX6_play:
  539  0000030E  2648                           movea.l a0,a3
  540  00000310  4AAB0004                       tst.l   YX6_LEFTFR(a3)
  541  00000314  66xx                           bne.s   .frame
  542  00000316  70FF                           moveq   #-1,d0                  ; past the last frame of a tune that
  543  00000318  4E75                           rts                             ; does not loop: write nothing
  544                                   
  545                                   .frame:
  546  0000031A  7600                           moveq   #0,d3
  547  0000031C  362B0024                       move.w  YX6_N(a3),d3            ; one ring to the next
  548  00000320  6100xxxx                       bsr     YX6_effects             ; may rewrite this frame's ring bytes
  549  00000324  2253                           movea.l YX6_CURSOR(a3),a1       ; the same offset in all fourteen
  550  00000326  45F9FFFF8800                   lea     YX6_PSG,a2              ; register rings
  551                                   
  552                                   ; Selecting a register and writing it are two bus cycles. An interrupt that
  553                                   ; uses the sound chip in between - TOS has several, its floppy motor timeout
  554                                   ; among them - would leave this write going to whatever register it selected,
  555                                   ; so the burst runs masked. Cheap: about 24 cycles for the whole frame.
  556  0000032C  40E7                           move.w  sr,-(sp)
  557  0000032E  007C0700                       ori.w   #$0700,sr
