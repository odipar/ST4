    1           =00000002               ST4_UNIT    equ     2
    2                                           include "YX6.S"
    1                                   ; -----------------------------------------------------------------------------
    2                                   ; YX6.S - streaming YM chiptune player for the plain 68000 (Atari ST)
    3                                   ;
    4                                   ; By Robbert van Dalen. Plays a .yx6 file: fourteen YM2149 register streams,
    5                                   ; each packed as its own embedded ST4 container and decoded through its own
    6                                   ; small ring by ST4_wrap.S. Written by Claude (Anthropic's Claude Code) under
    7                                   ; Robbert's direction, based on ZX1 v1.5 by Einar Saukas and inspired by Steve
    8                                   ; Clarets' MinYMiser. Use it freely, including commercially, as long as your
    9                                   ; documentation says you used ZX1 through ST4 (see LICENSE).
   10                                   ;
   11                                   ; It plays the fourteen standard sound registers, and loops. The YM6 special
   12                                   ; effects - SID voice, digidrum, sinus-SID, sync-buzzer - are not played, and
   13                                   ; the yx6 packer has already masked their bits out of the register values.
   14                                   ;
   15                                   ; REQUIRES ST4_wrap.S, built for the SAME unit size the tune was packed with
   16                                   ; (yx6 -kK; byte units unless the packer was told otherwise). Include both, in
   17                                   ; either order, with the unit size defined first:
   18                                   ;
   19                                   ;       ST4_UNIT    equ     1
   20                                   ;               include "YX6.S"
   21                                   ;               include "ST4_wrap.S"
   22                                   ;
   23                                   ; YX6 calls ST4_init and ST4_resume by label, and YX6_init checks every
   24                                   ; section's ST4 signature against this build's unit size - a tune packed for
   25                                   ; a different one is rejected, not garbled.
   26                                   ;
   27                                   ; -----------------------------------------------------------------------------
   28                                   ; THE DESIGN, in one paragraph. A tune is O frames long. Each of the fourteen
   29                                   ; registers gets its own ring of N bytes and its own saved decoder state, and
   30                                   ; is decoded C values at a time (C = 16 by default). On every VBL the player
   31                                   ; uses one value from each of the fourteen rings and refills exactly one
   32                                   ; register - register k on the VBL where the frame number modulo C is k. With
   33                                   ; C >= 14 every register is refilled once per C frames, one refill per VBL, so
   34                                   ; the work per frame is flat: fourteen register writes plus one ST4_resume of
   35                                   ; C bytes. Since C divides N and a call never reaches the ring end, ST4_wrap.S
   36                                   ; is the decoder that fits: the player counts the calls itself and wraps the
   37                                   ; write pointer when it lands on the ring end.
   38                                   ;
   39                                   ; LOOPING. A packed stream can only be restarted from its beginning, so the packer
   40                                   ; splits every register at the loop frame L: an intro stream for frames [0, L)
   41                                   ; and a loop stream for [L, O). When a register's section runs out mid-refill
   42                                   ; the player starts its loop stream over - a fresh decoder writing on into the
   43                                   ; same ring - so the rings always hold one continuous sequence of values and
   44                                   ; the read side never learns that anything happened. Nothing requires L to fall
   45                                   ; on a group boundary: a refill that straddles the split simply decodes two
   46                                   ; pieces. A tune that loops from frame 0 has no intro streams at all.
   47                                   ;
   48                                   ; -----------------------------------------------------------------------------
   49                                   ; USING IT
   50                                   ;
   51                                   ;       lea     song,a0                 ; the .yx6 file, loaded anywhere
   52                                   ;       lea     workspace,a1            ; even address, YX6_SIZE bytes
   53                                   ;       bsr     YX6_init                ; d0 = 0 when the file was accepted
   54                                   ;       tst.l   d0
   55                                   ;       bne     bad_file
   56                                   ;   vbl:                                ; once per frame, in supervisor mode
   57                                   ;       lea     workspace,a0
   58                                   ;       bsr     YX6_play                ; d0 = 0 played, 1 wrapped, -1 ended
   59                                   ;       ...
   60                                   ;       bsr     YX6_stop                ; silence the three voices
   61                                   ;
   62                                   ; The workspace holds the player's own fields, the eighteen decoder states and
   63                                   ; the eighteen rings, so its size depends on the ring size in the file:
   64                                   ;
   65                                   ;   YX6_SIZE = YX6_FIXED + 18 * N       ; 1248 + 18 * N bytes
   66                                   ;
   67                                   ; For the default 960-byte rings that is 18528 bytes. A program that knows N
   68                                   ; at build time can reserve it with
   69                                   ;
   70                                   ;       ds.b    YX6_FIXED+(YX6_STREAMS*960)
   71                                   ;
   72                                   ; where the parentheses matter: rmac evaluates expressions left to right.
   73                                   ;
   74                                   ; CALLS AND REGISTERS
   75                                   ;
   76                                   ;   YX6_init   in   a0 = .yx6 file, at an even address, a1 = workspace
   77                                   ;              out  d0 = 0 accepted, -1 not a v4 yx6 file with 18 streams
   78                                   ;                        packed at this build's unit size
   79                                   ;              Takes over MFP Timers A and D for the effect slots: vectors,
   80                                   ;              control and data registers, enable and mask bits - all saved
   81                                   ;              and restored by YX6_stop. Timer B stays free for rasters,
   82                                   ;              Timer C stays the system's. Pair every init with a stop
   83                                   ;   YX6_play   in   a0 = workspace
   84                                   ;              out  d0 = 0 played a frame
   85                                   ;                   d0 = 1 played a frame, and that frame ended the tune: the
   86                                   ;                          next one is the loop frame L
   87                                   ;                   d0 = -1 the tune is over and nothing was written, which
   88                                   ;                          only a tune packed with -o can report
   89                                   ;   YX6_stop   in   a0 = workspace: the MFP state to hand back
   90                                   ;   CLOBBERED  d0-d5, a0-a5. d6, d7 and a6 survive, as with ST4 - whose
   91                                   ;              decoder state spans a4 and a5, which is why they no longer do.
   92                                   ;
   93                                   ; YX6_play writes to the sound chip at $FFFF8800, so it must run in supervisor
   94                                   ; mode - which a VBL handler already does. It masks interrupts around the
   95                                   ; fourteen writes, because selecting a register and writing it are two bus
   96                                   ; cycles and TOS's own handlers use the chip too. Beyond that it performs no
   97                                   ; side effect: no interrupt setup, no memory allocation, nothing outside the
   98                                   ; workspace.
   99                                   ;
  100                                   ; ASSUMPTIONS (unchecked beyond the magic, version and stream count):
  101                                   ;
  102                                   ;   1. the file comes from the yx6 packer, which enforces C >= 14, N mod C = 0,
  103                                   ;      N >= 2C, offsets that stay inside the ring, and - at ST4_UNIT above 1 -
  104                                   ;      a tune length, loop frame and C that are whole units, so every budget
  105                                   ;      this player passes to the decoder divides cleanly
  106                                   ;   2. the workspace is at an even address and large enough for the file's N
  107                                   ;   3. YX6_play is called once per frame and never after it returns -1.
  108                                   ;      Calling it again is harmless - it returns -1 and writes nothing - which
  109                                   ;      is what keeps ST4_wrap's "never call the decoder again" rule intact
  110                                   ;   4. a looping tune plays for as long as you keep calling: d0 = 1 marks each
  111                                   ;      time round, and YX6_init is only needed to start again from frame 0
  112                                   ; -----------------------------------------------------------------------------
  113                                   
  114           =00000012               YX6_STREAMS     equ     18              ; R0..R13, then E1 T1 E2 T2: the two
  115                                                                           ; effect slots' control and timer-count
  116                                                                           ; streams, decoded like any register
  117           =0000000E               YX6_REGISTERS   equ     14              ; the streams the burst writes
  118           =00000040               YX6_STATE_SIZE  equ     64              ; per stream, so the index is a shift
  119                                                                           ; both ways: *64 in, /16 back to *4
  120                                   
  121                                   ; Workspace layout. Counters that a frame touches are kept in the form the
  122                                   ; frame wants them in: a pointer to walk, and a countdown to test against zero.
  123           =00000000               YX6_CURSOR      equ     0               ; long  this frame's byte in ring 0
  124           =00000004               YX6_LEFTFR      equ     4               ; long  frames before the tune ends
  125           =00000008               YX6_NEXT        equ     8               ; long  values decoded so far
  126           =0000000C               YX6_RINGEND     equ     12              ; long  one past ring 0, where it wraps
  127           =00000010               YX6_RINGS       equ     16              ; long  base of the ring area
  128           =00000014               YX6_FILE        equ     20              ; long  the .yx6 file
  129           =00000018               YX6_TOTAL       equ     24              ; long  O, the tune length in frames
  130           =0000001C               YX6_LOOPLEN     equ     28              ; long  O - L, zero when it does not loop
  131           =00000020               YX6_LOOP        equ     32              ; long  L, read at init to split sections
  132           =00000024               YX6_N           equ     36              ; word  ring size N
  133           =00000026               YX6_C           equ     38              ; word  values per call C
  134           =00000028               YX6_SLOT        equ     40              ; word  refill slot, 0..C-1
  135           =0000002A               YX6_INDEX       equ     42              ; word  stream index, during init only
  136           =0000002C               YX6_LOOPS       equ     44              ; word  nonzero when the tune loops
  137           =0000002E               YX6_EFXOFF      equ     46              ; long  14*N: the cursor's ring to E1's
  138           =00000032               YX6_R7OFF       equ     50              ; long  7*N: the cursor's ring to R7's
  139           =00000036               YX6_E1LAST      equ     54              ; byte  slot 1's control byte last frame
  140           =00000037               YX6_E2LAST      equ     55              ; byte  slot 2's
  141           =00000038               YX6_T1LAST      equ     56              ; byte  the count each timer last got:
  142           =00000039               YX6_T2LAST      equ     57              ; a held effect reloads its data
  143                                                                           ; register only when the count CHANGES,
  144                                                                           ; because a write that lands while the
  145                                                                           ; counter passes 01 loads an
  146                                                                           ; indeterminate value - pitch glitches
  147                                   ; The MFP state YX6_init takes over and YX6_stop hands back: both timer
  148                                   ; vectors, both control registers, both data registers, and which of the four
  149                                   ; enable/mask bits were set (bit 0 IERA5, 1 IMRA5, 2 IERB4, 3 IMRB4).
  150           =0000003A               YX6_OLDTA       equ     58              ; long  vector $134, Timer A
  151           =0000003E               YX6_OLDTD       equ     62              ; long  vector $110, Timer D
  152           =00000042               YX6_OLDTACR     equ     66              ; byte
  153           =00000043               YX6_OLDTCDCR    equ     67              ; byte
  154           =00000044               YX6_OLDTADR     equ     68              ; byte
  155           =00000045               YX6_OLDTDDR     equ     69              ; byte
  156           =00000046               YX6_OLDMFP      equ     70              ; byte  the four enable/mask bits
  157                                                                           ; (71 pads the longs below even)
  158           =00000048               YX6_PARM1       equ     72              ; long  (8+voice)*N: the cursor's ring
  159           =0000004C               YX6_PARM2       equ     76              ; long  to each slot's parameter byte
  160                                   ; The sanitize log. The effect stage edits ring bytes so the burst plays a
  161                                   ; sanitized frame - but the ring is decode history, and a later match may
  162                                   ; copy from any byte of it. So every edit is recorded here and undone right
  163                                   ; after the burst: the chip sees the edit, the ring never keeps it.
  164           =00000050               YX6_PATCHES     equ     80              ; byte  how many edits this frame, 0..3
  165           =00000051               YX6_PATCH_VAL   equ     81              ; 3 bytes: the originals
  166           =00000054               YX6_PATCH_ADDR  equ     84              ; 3 longs: where they go back
  167           =00000060               YX6_STATE       equ     96              ; 18 decoder states, from an even base
  168                                   ; rmac evaluates left to right, so the parentheses here are load-bearing:
  169                                   ; without them this reads as (YX6_STATE+YX6_STREAMS)*YX6_STATE_SIZE.
  170           =000004E0               YX6_FIXED       equ     YX6_STATE+(YX6_STREAMS*YX6_STATE_SIZE)
  171                                   
  172                                   ; One saved ST4_wrap state, plus the ring bounds the wrap check needs. The
  173                                   ; first four longs are in movem order - d1, d2, then a0, a1 - so that much of
  174                                   ; the decoder state loads and stores in one instruction; the three extra
  175                                   ; stream pointers ST4 carries (literals, byte offsets, word offsets) follow.
  176           =00000000               YS_D1           equ     0               ; long  d1, -ring.low : remaining
  177           =00000004               YS_D2           equ     4               ; long  d2, N : signed offset
  178           =00000008               YS_INPUT        equ     8               ; long  a0, stream A position
  179           =0000000C               YS_WRITE        equ     12              ; long  a1, write pointer
  180           =00000010               YS_LIT          equ     16              ; long  a2, stream B position
  181           =00000014               YS_BOFF         equ     20              ; long  a4, stream C position
  182           =00000018               YS_WOFF         equ     24              ; long  a5, stream D position
  183           =0000001C               YS_QUEUE        equ     28              ; word  d0, bit queue
  184           =00000020               YS_START        equ     32              ; long  this stream's ring
  185           =00000024               YS_END          equ     36              ; long  one past its last byte
  186           =00000028               YS_LEFT         equ     40              ; long  values left in the current section
  187                                   ; The movem block starts at the top of the state, so the two movems address it
  188                                   ; as plain (a2) - see the note where they are used.
  189                                   
  190                                   ; The .yx6 header, as written by the packer.
  191           =00000000               YH_MAGIC        equ     0
  192           =00000004               YH_VERSION      equ     4
  193           =00000006               YH_FLAGS        equ     6
  194           =00000008               YH_FRAMES       equ     8
  195           =0000000C               YH_PLAYER_HZ    equ     12
  196           =0000000E               YH_STREAM_COUNT equ     14
  197           =00000010               YH_RING         equ     16
  198           =00000012               YH_CHUNK        equ     18
  199           =00000014               YH_LOOP         equ     20
  200           =00000018               YH_CLOCK        equ     24
  201           =0000001C               YH_DRUMS        equ     28              ; long: the drum table, 0 when none
  202           =00000020               YH_DRUMCOUNT    equ     32              ; word
  203           =00000022               YH_INTRO_TABLE  equ     34              ; 18 offsets: the frames before the loop
  204           =0000006A               YH_LOOP_TABLE   equ     106             ; 18 offsets: the frames from L on
  205                                   
  206           =59583621               YX6_MAGIC       equ     $59583621       ; 'YX6!'
  207           =00000004               YX6_VERSION     equ     4               ; 4: effect streams and the drum table
  208           =00000001               YX6_FLAG_LOOPS  equ     1               ; header flag: the tune loops
  209           =FFFF8800               YX6_PSG         equ     $FFFF8800       ; select/read at +0, write at +2
  210           =000000FF               YX6_NO_ENV      equ     $FF             ; R13 value meaning "leave it alone"
  211           =000000C0               YX6_PORTS       equ     $C0             ; R7 bits the ST needs as outputs
  212           =00000007               YX6_MIXER       equ     7
  213           =0000000D               YX6_ENVELOPE    equ     13
  214                                   
  215                                   ; -----------------------------------------------------------------------------
  216                                   ; YX6_WRITE: send one register's value straight from its ring to the sound
  217                                   ; chip, then step a1 on to the next register's ring.
  218                                   ;
  219                                   ; Two moves and an add, with the register number assembled in as an immediate:
  220                                   ; nothing is tested, nothing is counted, and the value never passes through a
  221                                   ; data register. Registers 7 and 13 need their values touched, so they are
  222                                   ; written out of line rather than through this macro.
  223                                   ;
  224                                   ; Skipping a register whose value has not changed was measured and dropped: a
  225                                   ; sound-chip access on an ST costs about 1.5 cycles more than a RAM one, so the
  226                                   ; compare that would save the write costs about as much as the write.
  227                                   ; -----------------------------------------------------------------------------
  228                                           .macro YX6_WRITE number
  229                                 .         move.b  #\number,(a2)           ; select
  230                                 .         move.b  (a1),2(a2)              ; and write
  231                                 .         adda.l  d3,a1
  232                                 .         .endm
  233                                   
  234                                   ; Jump table: bra.w keeps 4-byte slots for a program that loads YX6 as a blob.
  235  00000000  6000xxxx                               bra.w   YX6_init
  236  00000004  6000xxxx                               bra.w   YX6_play
  237  00000008  6000xxxx                               bra.w   YX6_stop
  238                                   
  239                                   ; -----------------------------------------------------------------------------
  240                                   ; YX6_init: a0 = .yx6 file, a1 = workspace. Sets up fourteen decoders and
  241                                   ; decodes each register's first group, so frame 0 can be played immediately.
  242                                   ; -----------------------------------------------------------------------------
  243                                   YX6_init:
  244  0000000C  2649                           movea.l a1,a3                   ; a3 is the workspace throughout
  245  0000000E  27480014                       move.l  a0,YX6_FILE(a3)
  246  00000012  0C9059583621                   cmp.l   #YX6_MAGIC,YH_MAGIC(a0)
  247  00000018  6600xxxx                       bne     .rejected
  248  0000001C  0C6800040004                   cmp.w   #YX6_VERSION,YH_VERSION(a0)
  249  00000022  6600xxxx                       bne     .rejected
  250  00000026  0C680012000E                   cmp.w   #YX6_STREAMS,YH_STREAM_COUNT(a0)
  251  0000002C  6600xxxx                       bne     .rejected
  252                                   
  253  00000030  276800080018                   move.l  YH_FRAMES(a0),YX6_TOTAL(a3)
  254  00000036  276800140020                   move.l  YH_LOOP(a0),YX6_LOOP(a3)
  255  0000003C  376800100024                   move.w  YH_RING(a0),YX6_N(a3)
  256  00000042  376800120026                   move.w  YH_CHUNK(a0),YX6_C(a3)
  257  00000048  30280006                       move.w  YH_FLAGS(a0),d0
  258  0000004C  C07C0001                       and.w   #YX6_FLAG_LOOPS,d0
  259  00000050  3740002C                       move.w  d0,YX6_LOOPS(a3)
  260  00000054  276800080004                   move.l  YH_FRAMES(a0),YX6_LEFTFR(a3)
  261  0000005A  426B0028                       clr.w   YX6_SLOT(a3)
  262  0000005E  43EB04E0                       lea     YX6_FIXED(a3),a1        ; the rings follow the decoder states
  263  00000062  27490010                       move.l  a1,YX6_RINGS(a3)
  264  00000066  2689                           move.l  a1,YX6_CURSOR(a3)       ; frame 0 is the first byte of ring 0
  265  00000068  7000                           moveq   #0,d0
  266  0000006A  30280010                       move.w  YH_RING(a0),d0
  267  0000006E  D089                           add.l   a1,d0
  268  00000070  2740000C                       move.l  d0,YX6_RINGEND(a3)      ; where the cursor goes back to the top
  269                                   
  270  00000074  202B0018                       move.l  YX6_TOTAL(a3),d0        ; the loop section is O - L frames long,
  271  00000078  90AB0020                       sub.l   YX6_LOOP(a3),d0         ; and empty when the tune plays once
  272  0000007C  4A6B002C                       tst.w   YX6_LOOPS(a3)
  273  00000080  66xx                           bne.s   .loop_length
  274  00000082  7000                           moveq   #0,d0
  275                                   .loop_length:
  276  00000084  2740001C                       move.l  d0,YX6_LOOPLEN(a3)
  277                                   
  278  00000088  7200                           moveq   #0,d1                   ; the first group is C values, or the
  279  0000008A  322B0026                       move.w  YX6_C(a3),d1            ; whole tune when that is shorter and
  280  0000008E  4A6B002C                       tst.w   YX6_LOOPS(a3)           ; there is no loop to carry on into
  281  00000092  66xx                           bne.s   .first_group
  282  00000094  202B0018                       move.l  YX6_TOTAL(a3),d0
  283  00000098  B081                           cmp.l   d1,d0
  284  0000009A  64xx                           bcc.s   .first_group
  285  0000009C  2200                           move.l  d0,d1
  286                                   .first_group:
  287  0000009E  27410008                       move.l  d1,YX6_NEXT(a3)         ; values decoded once init is done
  288                                   
  289  000000A2  426B002A                       clr.w   YX6_INDEX(a3)           ; the loop counter lives here: every
  290                                   .stream:                                ; register is state during the calls
  291  000000A6  302B002A                       move.w  YX6_INDEX(a3),d0
  292  000000AA  ED48                           lsl.w   #6,d0                   ; * YX6_STATE_SIZE
  293  000000AC  45F30060                       lea     YX6_STATE(a3,d0.w),a2
  294  000000B0  7600                           moveq   #0,d3
  295  000000B2  362B0024                       move.w  YX6_N(a3),d3
  296  000000B6  302B002A                       move.w  YX6_INDEX(a3),d0
  297  000000BA  C0C3                           mulu.w  d3,d0                   ; this stream's ring is the k'th
  298  000000BC  226B0010                       movea.l YX6_RINGS(a3),a1
  299  000000C0  D3C0                           adda.l  d0,a1
  300  000000C2  25490020                       move.l  a1,YS_START(a2)
  301  000000C6  2549000C                       move.l  a1,YS_WRITE(a2)
  302  000000CA  2009                           move.l  a1,d0
  303  000000CC  D083                           add.l   d3,d0
  304  000000CE  25400024                       move.l  d0,YS_END(a2)
  305                                   
  306                                   ; A tune that loops from frame 0 has no intro streams, so its registers start
  307                                   ; on the loop section - which is then the whole tune. The load of L comes
  308                                   ; last because it is the branch condition: a move to a data register writes
  309                                   ; the flags, a lesson the original version of this choice taught by always
  310                                   ; picking the intro table and leaning on the section-exhausted path to
  311                                   ; recover. The signature check below ended that arrangement.
  312  000000D2  383C0022                       move.w  #YH_INTRO_TABLE,d4
  313  000000D6  202B0020                       move.l  YX6_LOOP(a3),d0
  314  000000DA  66xx                           bne.s   .section                ; L != 0: the intro covers [0, L)
  315  000000DC  383C006A                       move.w  #YH_LOOP_TABLE,d4
  316  000000E0  202B001C                       move.l  YX6_LOOPLEN(a3),d0
  317                                   .section:
  318  000000E4  25400028                       move.l  d0,YS_LEFT(a2)          ; values before this stream runs out
  319                                   
  320  000000E8  302B002A                       move.w  YX6_INDEX(a3),d0
  321  000000EC  E548                           lsl.w   #2,d0                   ; the tables hold long offsets
  322  000000EE  D044                           add.w   d4,d0
  323  000000F0  206B0014                       movea.l YX6_FILE(a3),a0
  324  000000F4  20300000                       move.l  0(a0,d0.w),d0
  325  000000F8  D1C0                           adda.l  d0,a0                   ; the section's ST4 container
  326  000000FA  0C90xxxxxxxx                   cmp.l   #ST4_SIGNATURE,(a0)     ; magic, version and unit in one compare:
  327  00000100  6600xxxx                       bne     .rejected               ; a tune packed for another unit size
  328                                   
  329                                   ; Open the container: stream A begins where its header ends, and B, C and D
  330                                   ; sit at the header-relative offsets it records - ST4.S documents exactly this
  331                                   ; sequence. The state block goes to the stack; ST4_init clobbers a3, so the
  332                                   ; workspace pointer does too.
  333  00000104  2F0A                           move.l  a2,-(sp)
  334  00000106  2448                           movea.l a0,a2
  335  00000108  D5E80008                       adda.l  8(a0),a2                ; stream B, the literals
  336  0000010C  2848                           movea.l a0,a4
  337  0000010E  D9E8000C                       adda.l  12(a0),a4               ; stream C, the byte offsets
  338  00000112  2A48                           movea.l a0,a5
  339  00000114  DBE80010                       adda.l  16(a0),a5               ; stream D, the word offsets
  340  00000118  41E80014                       lea     20(a0),a0               ; stream A, the bits
  341  0000011C  7600                           moveq   #0,d3
  342  0000011E  362B0024                       move.w  YX6_N(a3),d3            ; N, also ST4_init's argument
  343  00000122  2F0B                           move.l  a3,-(sp)
  344  00000124  6100xxxx                       bsr     ST4_init
  345  00000128  265F                           movea.l (sp)+,a3
  346                                   
  347  0000012A  225F                           movea.l (sp)+,a1                ; the state block; a1 is recomputed
  348  0000012C  23480008                       move.l  a0,YS_INPUT(a1)         ; every time round this loop
  349  00000130  234A0010                       move.l  a2,YS_LIT(a1)
  350  00000134  234C0014                       move.l  a4,YS_BOFF(a1)
  351  00000138  234D0018                       move.l  a5,YS_WOFF(a1)
