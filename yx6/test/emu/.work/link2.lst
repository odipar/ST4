  724  00000506  1010                           move.b  (a0),d0                 ; E2
  725  00000508  D1C3                           adda.l  d3,a0
  726  0000050A  1210                           move.b  (a0),d1                 ; T2
  727  0000050C  6100xxxx                       bsr     yx6_slot2
  728                                   
