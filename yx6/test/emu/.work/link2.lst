  531                                   ; -----------------------------------------------------------------------------
  532                                   ; YX6_start_loop: a2 = state block. Starts this register's loop stream over -
  533                                   ; a fresh decoder, reading from the top of the loop section, still writing
  534                                   ; where the last one stopped. ST4_init wants the ring start so that its packed
  535                                   ; metadata comes out right; the write pointer is restored from the block, which
  536                                   ; is why it is stored rather than held in a register.
  537                                   ; -----------------------------------------------------------------------------
  538                                   ; It runs inside YX6_fill, which guarantees d6 = the state block and a6 = the
  539                                   ; workspace - the two anchors that survive the decoder call.
  540                                   YX6_start_loop:
  541  00000262  200A                           move.l  a2,d0
  542  00000264  908B                           sub.l   a3,d0
  543  00000266  907C0046                       sub.w   #YX6_STATE,d0
  544  0000026A  E848                           lsr.w   #4,d0                   ; k * 64 becomes k * 4, a table index
  545  0000026C  206B0014                       movea.l YX6_FILE(a3),a0
  546  00000270  2030006A                       move.l  YH_LOOP_TABLE(a0,d0.w),d0
  547  00000274  67xx                           beq.s   .no_loop                ; this tune has no loop section
  548  00000276  D1C0                           adda.l  d0,a0                   ; the loop section's ST4 container
  549  00000278  226A0020                       movea.l YS_START(a2),a1         ; read before a2 becomes stream B
  550  0000027C  61xx                           bsr.s   yx6_open
  551  0000027E  264E                           movea.l a6,a3                   ; the decoder clobbered the workspace
  552  00000280  CD8A                           exg     a2,d6                   ; a2 = the block again, d6 = stream B
  553  00000282  25480008                       move.l  a0,YS_INPUT(a2)
  554  00000286  25460010                       move.l  d6,YS_LIT(a2)
  555  0000028A  254C0014                       move.l  a4,YS_BOFF(a2)
  556  0000028E  254D0018                       move.l  a5,YS_WOFF(a2)
  557  00000292  3540001C                       move.w  d0,YS_QUEUE(a2)
  558  00000296  2481                           move.l  d1,YS_D1(a2)
  559  00000298  25420004                       move.l  d2,YS_D2(a2)
  560  0000029C  256B001C0028                   move.l  YX6_LOOPLEN(a3),YS_LEFT(a2)
  561  000002A2  2C0A                           move.l  a2,d6                   ; the block pointer, as fill keeps it
  562                                   .no_loop:
  563  000002A4  4E75                           rts
