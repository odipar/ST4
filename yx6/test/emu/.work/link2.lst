 1187                                   ; -----------------------------------------------------------------------------
 1188                                   ; yx6_drum_start: read the sample number from the drummed voice's ring byte
 1189                                   ; and silence that byte - it is a number, not a volume - flag the voice for
 1190                                   ; the mixer pass, then arm the drum routine: its select register, its sample
 1191                                   ; address, and the flag-clearing mask, all patched into its own operands.
 1192                                   ; If the other slot holds a SID on this same voice, the drum takes the
 1193                                   ; volume register for itself, as the reference player's drum override does:
 1194                                   ; stop that SID's timer and clear its last code, so the slot retries every
 1195                                   ; frame - suppressed while the flag is up - and restarts the SID by itself
 1196                                   ; the frame after the drum ends.
 1197                                   ; Called from the new-code path AND the held retrigger, which has neither
 1198                                   ; the voice nor the parameter pointer at hand - so it derives its own.
 1199                                   ; in: d0.b = E, a5 = the descriptor, SD_PARM set; out: a0 = the handler;
 1200                                   ; keeps d0/d1/d3/a5.
 1201                                   ; -----------------------------------------------------------------------------
 1202                                   yx6_drum_start:
 1203                                   ; The slot may be replacing something. An old SID's burst gate reopens (its
 1204                                   ; timer is about to be re-aimed). An old drum on ANOTHER voice was cut off
 1205                                   ; mid-sample: the marker that would have dropped its flag and reopened its
 1206                                   ; gate will never run, so do both here.
 1207  000007CA  B800                           cmp.b   d0,d4
 1208  000007CC  67xx                           beq.s   .no_old
 1209  000007CE  4A04                           tst.b   d4
 1210  000007D0  67xx                           beq.s   .no_old
 1211  000007D2  1404                           move.b  d4,d2
 1212  000007D4  C43C00C0                       and.b   #$C0,d2
 1213  000007D8  67xx                           beq.s   .old_sid
 1214  000007DA  B43C0040                       cmp.b   #$40,d2
 1215  000007DE  66xx                           bne.s   .no_old                 ; a buzzer holds no register
 1216  000007E0  1404                           move.b  d4,d2                   ; an old drum: same voice keeps its
 1217  000007E2  B102                           eor.b   d0,d2                   ; flag and gate, another voice was
 1218  000007E4  C43C0030                       and.b   #$30,d2                 ; orphaned
 1219  000007E8  67xx                           beq.s   .no_old
 1220  000007EA  1404                           move.b  d4,d2
 1221  000007EC  E80A                           lsr.b   #4,d2
 1222  000007EE  C47C0003                       and.w   #3,d2
 1223  000007F2  5342                           subq.w  #1,d2
 1224  000007F4  7801                           moveq   #1,d4                   ; (the old code is spent now)
 1225  000007F6  E52C                           lsl.b   d2,d4
 1226  000007F8  4604                           not.b   d4
 1227  000007FA  41FAFE2C                       lea     yx6_drums(pc),a0
 1228  000007FE  C910                           and.b   d4,(a0)                 ; the orphan's flag drops
 1229  00000800  7802                           moveq   #2,d4
 1230  00000802  6100xxxx                       bsr     yx6_burst_gate          ; and its burst write returns
 1231  00000806  60xx                           bra.s   .no_old
 1232                                   .old_sid:
 1233  00000808  6100FF9E                       bsr     yx6_burst_open_old
 1234                                   .no_old:
 1235  0000080C  2053                           movea.l YX6_CURSOR(a3),a0
 1236  0000080E  D1ED0008                       adda.l  SD_PARM(a5),a0
