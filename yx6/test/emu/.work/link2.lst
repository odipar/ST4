 1241  0000081C  1A00                           move.b  d0,d5
 1242  0000081E  E80D                           lsr.b   #4,d5
 1243  00000820  CA7C0003                       and.w   #3,d5
 1244  00000824  5345                           subq.w  #1,d5                   ; the voice, for flag and select
 1245  00000826  7401                           moveq   #1,d2
 1246  00000828  EB2A                           lsl.b   d5,d2
 1247  0000082A  41FAFDFC                       lea     yx6_drums(pc),a0
 1248  0000082E  8510                           or.b    d2,(a0)                 ; the mixer pass forces this voice off
 1249  00000830  4602                           not.b   d2
