 1050                                   .held:                                  ; E != 0 here: the caller's gate
 1051  00000698  1A00                           move.b  d0,d5
 1052  0000069A  CA3C00C0                       and.b   #$C0,d5
 1053  0000069E  BA3C0040                       cmp.b   #$40,d5
 1054  000006A2  67B2                           beq.s   .drum                   ; a held drum code triggers again
 1055  000006A4  B22D0001                       cmp.b   SD_TLAST(a5),d1         ; reload only a CHANGED count: a write
 1056  000006A8  67xx                           beq.s   .track                  ; meeting the counter at 01 is
 1057  000006AA  1B410001                       move.b  d1,SD_TLAST(a5)         ; indeterminate, so do not roll dice
 1058  000006AE  346D0004                       movea.w SD_DATA(a5),a2          ; fifty times a second
 1059  000006B2  1481                           move.b  d1,(a2)
 1060                                   .track:
 1061                                   ; The level-held effects track their parameter every frame: the SID volume
 1062                                   ; and the buzzer shape follow the voice's ring byte, as the reference player
 1063                                   ; re-reads them.
 1064  000006B4  2053                           movea.l YX6_CURSOR(a3),a0
 1065  000006B6  D1ED0008                       adda.l  SD_PARM(a5),a0
 1066  000006BA  1810                           move.b  (a0),d4
 1067  000006BC  C83C000F                       and.b   #15,d4
 1068  000006C0  206D000C                       movea.l SD_ISR(a5),a0
