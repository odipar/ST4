  996  00000772  6100FDB4                       bsr     yx6_borrow              ; the ring gets this byte back
  997  00000776  7800                           moveq   #0,d4
  998  00000778  1810                           move.b  (a0),d4
  999  0000077A  4210                           clr.b   (a0)
 1000  0000077C  1A00                           move.b  d0,d5
 1001  0000077E  E80D                           lsr.b   #4,d5
 1002  00000780  CA7C0003                       and.w   #3,d5
 1003  00000784  5345                           subq.w  #1,d5
 1004  00000786  7401                           moveq   #1,d2
 1005  00000788  EB2A                           lsl.b   d5,d2
 1006  0000078A  41FAxxxx                       lea     yx6_drums(pc),a0
 1007  0000078E  8510                           or.b    d2,(a0)
 1008  00000790  4602                           not.b   d2
 1009  00000792  41FAxxxx                       lea     yx6_drumD_clear+3(pc),a0
 1010  00000796  1082                           move.b  d2,(a0)
 1011  00000798  142B0036                       move.b  YX6_E1LAST(a3),d2       ; a SID on this voice: the drum takes
 1012  0000079C  C43C00C0                       and.b   #$C0,d2                 ; it - see yx6_drum_start1
 1013  000007A0  66xx                           bne.s   .keep
 1014  000007A2  142B0036                       move.b  YX6_E1LAST(a3),d2
 1015  000007A6  B102                           eor.b   d0,d2
 1016  000007A8  C43C0030                       and.b   #$30,d2
 1017  000007AC  66xx                           bne.s   .keep
 1018  000007AE  4238FA19                       clr.b   $FFFFFA19.w
 1019  000007B2  422B0036                       clr.b   YX6_E1LAST(a3)
 1020                                   .keep:
 1021  000007B6  3405                           move.w  d5,d2
 1022  000007B8  5042                           addq.w  #8,d2
 1023  000007BA  41FAxxxx                       lea     yx6_drumD+3(pc),a0
 1024  000007BE  1082                           move.b  d2,(a0)
 1025  000007C0  3404                           move.w  d4,d2
 1026  000007C2  E54C                           lsl.w   #2,d4
 1027  000007C4  D442                           add.w   d2,d2
 1028  000007C6  D842                           add.w   d2,d4
 1029  000007C8  206B0014                       movea.l YX6_FILE(a3),a0
 1030  000007CC  2428001C                       move.l  YH_DRUMS(a0),d2
 1031  000007D0  D1C2                           adda.l  d2,a0
 1032  000007D2  24304000                       move.l  0(a0,d4.w),d2
 1033  000007D6  D4AB0014                       add.l   YX6_FILE(a3),d2
 1034  000007DA  41FAxxxx                       lea     yx6_drumD+8(pc),a0
 1035  000007DE  2082                           move.l  d2,(a0)
 1036  000007E0  41FAxxxx                       lea     yx6_drumD(pc),a0
 1037  000007E4  4E75                           rts
 1038                                   
 1039                                   ; A SID starts: the two half-period routines get the voice's volume register
 1040                                   ; as their select, the loud half gets the volume nibble, and each gets the
 1041                                   ; other's address low word to install as the next tick - both live in this
 1042                                   ; code, so the vector's high word never changes.
 1043                                   ; in: d0.b = E, the slot's PARM set; out: a0 = the loud half; keeps d0/d1/d3.
 1044                                   yx6_sid_start1:
 1045  000007E6  1A00                           move.b  d0,d5
 1046  000007E8  E80D                           lsr.b   #4,d5
 1047  000007EA  CA7C0003                       and.w   #3,d5
 1048  000007EE  5345                           subq.w  #1,d5
 1049  000007F0  3805                           move.w  d5,d4
 1050  000007F2  5044                           addq.w  #8,d4                   ; the voice's volume register
 1051  000007F4  41FAxxxx                       lea     yx6_sidA_on+2(pc),a0
 1052  000007F8  1084                           move.b  d4,(a0)
 1053  000007FA  41FAxxxx                       lea     yx6_sidA_off+2(pc),a0
 1054  000007FE  1084                           move.b  d4,(a0)
 1055  00000800  2053                           movea.l YX6_CURSOR(a3),a0
 1056  00000802  D1EB0048                       adda.l  YX6_PARM1(a3),a0
 1057  00000806  1810                           move.b  (a0),d4
 1058  00000808  C83C000F                       and.b   #15,d4
 1059  0000080C  41FAxxxx                       lea     yx6_sidA_on+4(pc),a0    ; the loud half's volume
 1060  00000810  1084                           move.b  d4,(a0)
 1061  00000812  41FAxxxx                       lea     yx6_sidA_off(pc),a0     ; each half installs the other
 1062  00000816  2808                           move.l  a0,d4
 1063  00000818  43FAxxxx                       lea     yx6_sidA_on+10(pc),a1
 1064  0000081C  3284                           move.w  d4,(a1)
 1065  0000081E  41FAxxxx                       lea     yx6_sidA_on(pc),a0
 1066  00000822  2808                           move.l  a0,d4
 1067  00000824  43FAxxxx                       lea     yx6_sidA_off+10(pc),a1
 1068  00000828  3284                           move.w  d4,(a1)
 1069  0000082A  4E75                           rts
 1070                                   
 1071                                   yx6_sid_start2:
 1072  0000082C  1A00                           move.b  d0,d5
 1073  0000082E  E80D                           lsr.b   #4,d5
 1074  00000830  CA7C0003                       and.w   #3,d5
 1075  00000834  5345                           subq.w  #1,d5
 1076  00000836  3805                           move.w  d5,d4
 1077  00000838  5044                           addq.w  #8,d4
 1078  0000083A  41FAxxxx                       lea     yx6_sidD_on+2(pc),a0
 1079  0000083E  1084                           move.b  d4,(a0)
 1080  00000840  41FAxxxx                       lea     yx6_sidD_off+2(pc),a0
 1081  00000844  1084                           move.b  d4,(a0)
 1082  00000846  2053                           movea.l YX6_CURSOR(a3),a0
 1083  00000848  D1EB004C                       adda.l  YX6_PARM2(a3),a0
 1084  0000084C  1810                           move.b  (a0),d4
 1085  0000084E  C83C000F                       and.b   #15,d4
 1086  00000852  41FAxxxx                       lea     yx6_sidD_on+4(pc),a0
 1087  00000856  1084                           move.b  d4,(a0)
 1088  00000858  41FAxxxx                       lea     yx6_sidD_off(pc),a0
 1089  0000085C  2808                           move.l  a0,d4
 1090  0000085E  43FAxxxx                       lea     yx6_sidD_on+10(pc),a1
 1091  00000862  3284                           move.w  d4,(a1)
 1092  00000864  41FAxxxx                       lea     yx6_sidD_on(pc),a0
 1093  00000868  2808                           move.l  a0,d4
 1094  0000086A  43FAxxxx                       lea     yx6_sidD_off+10(pc),a1
 1095  0000086E  3284                           move.w  d4,(a1)
 1096  00000870  4E75                           rts
 1097                                   
 1098                                   ; A buzzer starts: the shape nibble from the parameter byte goes into the
 1099                                   ; tick's immediate; writing it to R13 every tick IS the effect.
 1100                                   yx6_buzz_start1:
 1101  00000872  2053                           movea.l YX6_CURSOR(a3),a0
 1102  00000874  D1EB0048                       adda.l  YX6_PARM1(a3),a0
 1103  00000878  1810                           move.b  (a0),d4
 1104  0000087A  C83C000F                       and.b   #15,d4
 1105  0000087E  41FAxxxx                       lea     yx6_buzzA+4(pc),a0
 1106  00000882  1084                           move.b  d4,(a0)
 1107  00000884  41FAxxxx                       lea     yx6_buzzA(pc),a0
 1108  00000888  4E75                           rts
 1109                                   
 1110                                   yx6_buzz_start2:
 1111  0000088A  2053                           movea.l YX6_CURSOR(a3),a0
 1112  0000088C  D1EB004C                       adda.l  YX6_PARM2(a3),a0
 1113  00000890  1810                           move.b  (a0),d4
 1114  00000892  C83C000F                       and.b   #15,d4
 1115  00000896  41FAxxxx                       lea     yx6_buzzD+4(pc),a0
 1116  0000089A  1084                           move.b  d4,(a0)
 1117  0000089C  41FAxxxx                       lea     yx6_buzzD(pc),a0
 1118  000008A0  4E75                           rts
 1119                                   
 1120                                   ; -----------------------------------------------------------------------------
 1121                                   ; The tick handlers, in maxYMiser's shipping forms: the PSG select and write
 1122                                   ; in as few instructions as the bus allows, patched immediates instead of
 1123                                   ; state, software end-of-interrupt as TOS runs the MFP. All MFP interrupts
 1124                                   ; arrive at 68000 level 6, so these never nest, and every patched operand is
 1125                                   ; addressed pc-relatively so the player stays loadable anywhere - which also
 1126                                   ; means it must run from RAM, where a demo lives anyway.
 1127                                   ;
 1128                                   ; The patch offsets are load-bearing:
 1129                                   ;   drum:  select immediate at +3, sample address at +8, flag mask at _clear+3
 1130                                   ;   sid:   select at +2 and volume at +4 inside the imm long; the partner's
 1131                                   ;          address low word at +10
 1132                                   ;   buzz:  the shape at +4
 1133                                   ; -----------------------------------------------------------------------------
 1134                                   yx6_parkA:
 1135  000008A2  08B80005FA0F                   bclr    #5,$FFFFFA0F.w
 1136  000008A8  4E73                           rte
 1137                                   yx6_parkD:
 1138  000008AA  08B80004FA11                   bclr    #4,$FFFFFA11.w
 1139  000008B0  4E73                           rte
 1140                                   
 1141                                   ; One drum tick: the sample byte goes straight to the voice's volume register.
 1142                                   ; The byte after the last has bit 7 set, so the same move answers "done": park
 1143                                   ; the volume mid-scale against the click, stop the timer, drop the flag.
 1144                                   yx6_drumA:
 1145  000008B2  11FC00088800                   move.b  #8,$FFFF8800.w          ; SMC +3: select the drummed volume
 1146  000008B8  11F9123456788802               move.b  $12345678,$FFFF8802.w   ; SMC +8: the next sample byte
 1147  000008C0  6Bxx                           bmi.s   .ended
 1148  000008C2  2F08                           move.l  a0,-(sp)
 1149  000008C4  41FAFFF4                       lea     yx6_drumA+8(pc),a0
 1150  000008C8  5290                           addq.l  #1,(a0)                 ; step the operand itself
 1151  000008CA  205F                           movea.l (sp)+,a0
 1152  000008CC  08B80005FA0F                   bclr    #5,$FFFFFA0F.w
 1153  000008D2  4E73                           rte
 1154                                   .ended:
 1155  000008D4  11FC000D8802                   move.b  #$D,$FFFF8802.w         ; middle volume: no click
 1156  000008DA  4238FA19                       clr.b   $FFFFFA19.w             ; the sample ran out: stop Timer A
 1157  000008DE  2F08                           move.l  a0,-(sp)
 1158  000008E0  41FAxxxx                       lea     yx6_drums(pc),a0
 1159                                   yx6_drumA_clear:
 1160  000008E4  021000FF                       andi.b  #$FF,(a0)               ; SMC +3: drop the voice's drum flag
 1161  000008E8  205F                           movea.l (sp)+,a0
 1162  000008EA  08B80005FA0F                   bclr    #5,$FFFFFA0F.w
 1163  000008F0  4E73                           rte
 1164                                   
 1165                                   yx6_drumD:
 1166  000008F2  11FC00088800                   move.b  #8,$FFFF8800.w
 1167  000008F8  11F9123456788802               move.b  $12345678,$FFFF8802.w
 1168  00000900  6Bxx                           bmi.s   .ended
 1169  00000902  2F08                           move.l  a0,-(sp)
 1170  00000904  41FAFFF4                       lea     yx6_drumD+8(pc),a0
 1171  00000908  5290                           addq.l  #1,(a0)
 1172  0000090A  205F                           movea.l (sp)+,a0
 1173  0000090C  08B80004FA11                   bclr    #4,$FFFFFA11.w
 1174  00000912  4E73                           rte
 1175                                   .ended:
 1176  00000914  11FC000D8802                   move.b  #$D,$FFFF8802.w
 1177  0000091A  023800F0FA1D                   andi.b  #$F0,$FFFFFA1D.w
 1178  00000920  2F08                           move.l  a0,-(sp)
 1179  00000922  41FAxxxx                       lea     yx6_drums(pc),a0
 1180                                   yx6_drumD_clear:
 1181  00000926  021000FF                       andi.b  #$FF,(a0)
 1182  0000092A  205F                           movea.l (sp)+,a0
 1183  0000092C  08B80004FA11                   bclr    #4,$FFFFFA11.w
 1184  00000932  4E73                           rte
 1185                                   
 1186                                   ; The SID square: each tick writes one half of the square - the volume or
 1187                                   ; silence - and installs the other half as the next tick, one word into the
 1188                                   ; vector. Select and data land in one move.l: the immediate's bytes hit
 1189                                   ; $8800 (select) and $8802 (data) by bus layout.
 1190                                   yx6_sidA_on:
 1191  00000934  21FC08000F008800               move.l  #$08000F00,$FFFF8800.w  ; SMC +2 select, +4 volume
 1192  0000093C  31FC00000136                   move.w  #0,$136.w               ; SMC +10: the quiet half is next
 1193  00000942  08B80005FA0F                   bclr    #5,$FFFFFA0F.w
 1194  00000948  4E73                           rte
 1195                                   yx6_sidA_off:
 1196  0000094A  21FC080000008800               move.l  #$08000000,$FFFF8800.w  ; SMC +2 select; silence
 1197  00000952  31FC00000136                   move.w  #0,$136.w               ; SMC +10: the loud half is next
 1198  00000958  08B80005FA0F                   bclr    #5,$FFFFFA0F.w
 1199  0000095E  4E73                           rte
 1200                                   
 1201                                   yx6_sidD_on:
 1202  00000960  21FC08000F008800               move.l  #$08000F00,$FFFF8800.w
 1203  00000968  31FC00000112                   move.w  #0,$112.w
 1204  0000096E  08B80004FA11                   bclr    #4,$FFFFFA11.w
 1205  00000974  4E73                           rte
 1206                                   yx6_sidD_off:
 1207  00000976  21FC080000008800               move.l  #$08000000,$FFFF8800.w
 1208  0000097E  31FC00000112                   move.w  #0,$112.w
 1209  00000984  08B80004FA11                   bclr    #4,$FFFFFA11.w
 1210  0000098A  4E73                           rte
 1211                                   
 1212                                   ; The sync-buzzer tick: writing the shape to R13 restarts the envelope, and
 1213                                   ; that restart at the timer's rate is the whole effect.
 1214                                   yx6_buzzA:
 1215  0000098C  21FC0D0000008800               move.l  #$0D000000,$FFFF8800.w  ; SMC +4: the shape
 1216  00000994  08B80005FA0F                   bclr    #5,$FFFFFA0F.w
 1217  0000099A  4E73                           rte
 1218                                   yx6_buzzD:
 1219  0000099C  21FC0D0000008800               move.l  #$0D000000,$FFFF8800.w
 1220  000009A4  08B80004FA11                   bclr    #4,$FFFFFA11.w
 1221  000009AA  4E73                           rte
 1222                                   
 1223                                   yx6_drums:
 1224  000009AC  00                             dc.b    0                       ; voice bits 0-2: a drum is running
 1225  000009AD  00                             even
    3                                           include "ST4_wrap.S"
    1                                   ; -----------------------------------------------------------------------------
    2                                   ; ST4_wrap.S - ST4: counted-wrap ring decompressor for the Atari ST (68000)
    3                                   ;
    4                                   ; By Robbert van Dalen, based on ZX1 v1.5 by Einar Saukas and on ST1_wrap.S,
    5                                   ; which this follows instruction for instruction wherever the format allows.
    6                                   ; Written by Claude (Anthropic's Claude Code) under Robbert's direction. Use it
    7                                   ; freely, including commercially, as long as your documentation says you used
    8                                   ; ZX1 through ST4 (see LICENSE).
    9                                   ;
   10                                   ; ST4_wrap is ST1_wrap with ST4's three streams and units: the literal payload
   11                                   ; comes from stream B in a2 and the offsets from stream C in a4 (bytes) or D in
   12                                   ; a5 (words), lengths and budgets count units of ST4_UNIT bytes, and the copy
   13                                   ; moves a unit at a time. With the offsets gone, stream A holds nothing but
   14                                   ; bits, so the queue refills a word at a time. Set the unit size before
   15                                   ; including:
   16                                   ;
   17                                   ;       ST4_UNIT    equ     4
   18                                   ;               include "ST4_wrap.S"
   19                                   ;
   20                                   ; !!! LIKE ST1_wrap, THIS HAS NO DONE STATE !!!
   21                                   ; The caller must know the exact output size O in units, make exactly
   22                                   ; T = ceil(O/C) decode calls, and never call again.
   23                                   ;
   24                                   ; The ring is N BYTES and must be a whole number of units; the caller resets a1
   25                                   ; to the ring start after every F = N/(C*UNIT) calls. Budgets and remaining
   26                                   ; counts are units; offsets, positions and N are bytes - which is what keeps
   27                                   ; the wrap arithmetic identical to ST1_wrap's.
   28                                   ;
   29                                   ; The copy engine runs two ladders. Match segments of at most sixteen units -
   30                                   ; measured to be four of every five segments a small-budget streamer makes,
   31                                   ; with the whole-chunk segment the most common of all - take a counter-free
   32                                   ; ladder that falls straight into the match epilogue: no full-pass shift, no
   33                                   ; loop counter, no post-copy kind test. Literals and longer segments take the
   34                                   ; classic counted ladder. And there is no first-call test: ST4_init seeds the
   35                                   ; bit queue with one virtual 0 flag ($4000), so a fresh state decodes itself
   36                                   ; through a zero-unit match segment and reads that flag as "begin literals"
   37                                   ; exactly where the old entry branch went.
   38                                   ;
   39                                   ; The container is ST4.S's: twenty bytes of header - signature, O, and where
   40                                   ; streams B, C and D begin - then A, B, C and D in order. See ST4.S for the
   41                                   ; eight instructions that open one.
   42                                   ;
   43                                   ; THE STATE IS YOUR REGISTERS:
   44                                   ;
   45                                   ;   a0.l  position in stream A          a1.l  write pointer
   46                                   ;   a2.l  position in stream B          a4.l  stream C, the byte offsets
   47                                   ;   a5.l  stream D, the word offsets    d0.w  bit queue ($8000 empty)
   48                                   ;   d1.l  -ring_start.low : units remaining
   49                                   ;   d2.l  N : signed byte offset (+lastOffset*UNIT literals, - during a match)
   50                                   ;
   51                                   ;   resume in    d3.w   this call's budget in UNITS
   52                                   ;   CLOBBERED    d3.w d4.l d5.l a3.l
   53                                   ;   untouched    d6 d7 a6
   54                                   ;
   55                                   ; ASSUMPTIONS (unchecked; violating them is undefined behaviour):
   56                                   ;
   57                                   ;   1. THE RING SIZE N IS A MULTIPLE OF ST4_UNIT, and the ring starts on a unit
   58                                   ;      boundary - as does the destination. A wide move would fault on an odd
   59                                   ;      address, and the caller's wrap has to land on a unit
   60                                   ;   2. N mod (C * ST4_UNIT) = 0, so F = N/(C*UNIT) calls fill the ring exactly
   61                                   ;   3. no offset exceeds 32512 BYTES - the packer clamps -m to that
   62                                   ;   4. no operation is longer than 65535 units - compress with -l65535
   63                                   ;   5. the caller knows O and makes exactly T = ceil(O/C) calls, as ST1_wrap
   64                                   ;   6. streams A and D start on even addresses, and A holds an even number of
   65                                   ;      bytes: the bit queue is refilled with a move.w, and so is a word offset
   66                                   ;
   67                                   ; Compress with st4 -k<UNIT> -m<ring/UNIT> -l65535.
   68                                   ; -----------------------------------------------------------------------------
   69                                   
   70                                   ; The asset's signature for this build: 'S4', format version 4, and the unit
   71                                   ; size this decoder was assembled for. One cmp.l against a file's first long
   72                                   ; proves all three at once.
   73           =53340402               ST4_SIGNATURE   equ     $53340400+ST4_UNIT
   74                                   
   75                                   ; One unit copied, at the width this build was made for.
   76                                           .macro ST4_MOVE
   77                                 .         .if ST4_UNIT=4
   78                                 .         move.l  (a3)+,(a1)+
   79                                 .         .endif
   80                                 .         .if ST4_UNIT=2
   81                                 .         move.w  (a3)+,(a1)+
   82                                 .         .endif
   83                                 .         .if ST4_UNIT=1
   84                                 .         move.b  (a3)+,(a1)+
   85                                 .         .endif
   86                                 .         .endm
   87                                   
   88                                   ; Jump table: bra.w keeps 4-byte slots (base+0/4). A counted ring has no
   89                                   ; one-shot entry; the caller drains it through ST4_resume.
   90  000009AE  6000xxxx                               bra.w   ST4_init
   91  000009B2  6000xxxx                               bra.w   ST4_resume
   92                                   
   93                                   ; ST4_init: a0 = A, a1 = first ring byte, a2 = B, a4 = C, a5 = D,
   94                                   ; d3.w = N.
   95                                   ; Packs -ring_start.low/N above the common state; writes no memory.
   96                                   ; Java: the Decompressor constructor / reset().
   97                                   ST4_init:
   98  000009B6  7200                           moveq   #0,d1
   99  000009B8  9249                           sub.w   a1,d1                   ; -ring_start.low, exact modulo 65536
  100  000009BA  4841                           swap    d1                      ; pack it high; remaining = 0
  101                                   ; The initial offset has to land in the low word after the swap, so it starts
  102                                   ; in the high half. moveq would put -1 there whatever the unit size, which is
  103                                   ; a byte short at k=2 and three at k=4 - and only shows up on a stream whose
  104                                   ; first match reuses INITIAL_OFFSET.
  105  000009BC  243CFFFE0000                   move.l  #(-ST4_UNIT)<<16,d2
  106  000009C2  3403                           move.w  d3,d2                   ; N lives below it for now
  107  000009C4  4842                           swap    d2                      ; N above, -INITIAL_OFFSET*UNIT below
  108                                   ; One virtual 0 flag, then the empty sentinel. The first resume call runs a
  109                                   ; zero-unit match segment through the normal path - remaining is zero, so
  110                                   ; n = 0 and the ladder is entered at its end - and lands in match_transition,
  111                                   ; which shifts $4000 into $8000: the flag reads as "begin literals" and the
  112                                   ; queue is the empty sentinel the old first call started from. That is what
  113                                   ; lets ST4_resume skip a first-call test on every call.
  114  000009C6  303C4000                       move.w  #$4000,d0
  115  000009CA  4E75                           rts
  116                                   
  117                                   source_wrapped:
  118  000009CC  2A02                           move.l  d2,d5
  119  000009CE  4245                           clr.w   d5
  120  000009D0  4845                           swap    d5                      ; zero-extend N from d2.high
  121  000009D2  D7C5                           adda.l  d5,a3                   ; raw source + N, back into the ring
  122  000009D4  60xx                           bra.s   copy
  123                                   
  124                                   ; ST4_resume: a0/a1/d0/d1/d2 = state and d3.w = this call's budget.
  125                                   ; Continuing calls emit d3 bytes; the final call may be shorter. The caller
  126                                   ; knows the final span from O; [old a1 .. new a1) is fresh output.
  127                                   ST4_resume:
  128  000009D6  3803                           move.w  d3,d4                   ; seed n from the budget; a fresh state
  129                                   segment:                                ; runs one 0-unit match segment and
  130  000009D8  B841                           cmp.w   d1,d4                   ; reads the seeded flag afterwards.
  131  000009DA  63xx                           bls.s   budget_fits             ; n = min(budget, remaining)
  132  000009DC  3801                           move.w  d1,d4
