 1045  00000686  CA7C0003                       and.w   #3,d5
 1046  0000068A  5345                           subq.w  #1,d5                   ; the voice, 0..2
 1047  0000068C  3405                           move.w  d5,d2
 1048  0000068E  5042                           addq.w  #8,d2
 1049  00000690  C4EB0024                       mulu.w  YX6_N(a3),d2
 1050  00000694  2B420008                       move.l  d2,SD_PARM(a5)
 1051  00000698  2253                           movea.l YX6_CURSOR(a3),a1
