 1252  0000083A  286D0010                       movea.l SD_OTHER(a5),a4         ; a SID on this voice in the other
 1253  0000083E  1414                           move.b  (a4),d2                 ; slot: the drum takes the register
 1254  00000840  C43C00C0                       and.b   #$C0,d2
 1255  00000844  66xx                           bne.s   .keep
 1256  00000846  1414                           move.b  (a4),d2
 1257  00000848  B102                           eor.b   d0,d2
 1258  0000084A  C43C0030                       and.b   #$30,d2
 1259  0000084E  66xx                           bne.s   .keep
 1260  00000850  306C0002                       movea.w SD_CTRL(a4),a0
 1261  00000854  021000F0                       andi.b  #$F0,(a0)               ; stop the other slot's SID
 1262  00000858  4214                           clr.b   (a4)                    ; and let it retry every frame
 1263                                   .keep:
 1264  0000085A  3405                           move.w  d5,d2
 1265  0000085C  5042                           addq.w  #8,d2                   ; the voice's volume register
 1266  0000085E  13420003                       move.b  d2,ISR_DRUM_SEL(a1)     ; the tick's select immediate
 1267  00000862  D844                           add.w   d4,d4                   ; a drum table entry is six bytes:
 1268  00000864  3404                           move.w  d4,d2                   ; 6n = 2n + 4n
 1269  00000866  D844                           add.w   d4,d4
 1270  00000868  D842                           add.w   d2,d4
 1271  0000086A  246B0014                       movea.l YX6_FILE(a3),a2
 1272  0000086E  204A                           movea.l a2,a0
 1273  00000870  D1E8001C                       adda.l  YH_DRUMS(a0),a0
 1274  00000874  24304000                       move.l  0(a0,d4.w),d2           ; the sample's offset in the file
 1275  00000878  D48A                           add.l   a2,d2
 1276  0000087A  23420008                       move.l  d2,ISR_DRUM_PTR(a1)     ; the tick reads through its operand
