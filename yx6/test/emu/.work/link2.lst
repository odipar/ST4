  566                                   ; -----------------------------------------------------------------------------
  567                                   ; yx6_open: a0 = an ST4 container. Points the four stream registers at its
  568                                   ; streams - A begins where the header ends, B, C and D sit at the recorded
  569                                   ; header-relative offsets, exactly as ST4.S documents - and tail-calls
  570                                   ; ST4_init: its rts returns to yx6_open's caller with the decoder registers
  571                                   ; as ST4_init leaves them. ST4_init clobbers a3; callers restore it
  572                                   ; themselves, init from the stack and the loop restart from a6.
  573                                   ; -----------------------------------------------------------------------------
  574                                   yx6_open:
  575  000002A6  2448                           movea.l a0,a2
  576  000002A8  D5E80008                       adda.l  8(a0),a2                ; stream B, the literals
  577  000002AC  2848                           movea.l a0,a4
  578  000002AE  D9E8000C                       adda.l  12(a0),a4               ; stream C, the byte offsets
  579  000002B2  2A48                           movea.l a0,a5
  580  000002B4  DBE80010                       adda.l  16(a0),a5               ; stream D, the word offsets
  581  000002B8  41E80014                       lea     20(a0),a0               ; stream A, the bits
  582  000002BC  7600                           moveq   #0,d3
  583  000002BE  362B0024                       move.w  YX6_N(a3),d3            ; N, ST4_init's argument
  584  000002C2  6000xxxx                       bra     ST4_init
  585                                   
  586                                   ; -----------------------------------------------------------------------------
  587                                   ; YX6_play: a0 = workspace. One frame: run the effect stage, write fourteen
  588                                   ; registers, undo the stage's ring edits, refill one stream.
  589                                   ; -----------------------------------------------------------------------------
  590                                   YX6_play:
  591  000002C6  2648                           movea.l a0,a3
  592  000002C8  4AAB0004                       tst.l   YX6_LEFTFR(a3)
  593  000002CC  66xx                           bne.s   .frame
  594  000002CE  70FF                           moveq   #-1,d0                  ; past the last frame of a tune that
  595  000002D0  4E75                           rts                             ; does not loop: write nothing
  596                                   
  597                                   .frame:
  598  000002D2  7600                           moveq   #0,d3
  599  000002D4  362B0024                       move.w  YX6_N(a3),d3            ; one ring to the next
  600                                   
  601                                   ; The effect stage, inlined: it runs BEFORE the burst so it may rewrite this
  602                                   ; frame's ring bytes. Each slot is gated on E | E-last: a slot that has, and
  603                                   ; had, nothing to do costs one test - the common frame. A slot machine call
  604                                   ; therefore always means something changed, holds, or just ended; yx6_slot's
  605                                   ; held path leans on that (E is never 0 there).
  606  000002D8  2053                           movea.l YX6_CURSOR(a3),a0
  607  000002DA  D1EB002E                       adda.l  YX6_EFXOFF(a3),a0       ; ring E1, at this frame's offset
  608  000002DE  4BFAxxxx                       lea     yx6_desc1(pc),a5
  609  000002E2  1010                           move.b  (a0),d0                 ; E1 | its last code: zero is idle
  610  000002E4  8015                           or.b    (a5),d0
  611  000002E6  67xx                           beq.s   .slot1_idle
  612  000002E8  1010                           move.b  (a0),d0                 ; the real E1
  613  000002EA  D1C3                           adda.l  d3,a0
  614  000002EC  1210                           move.b  (a0),d1                 ; T1
  615  000002EE  D1C3                           adda.l  d3,a0
  616  000002F0  2F08                           move.l  a0,-(sp)                ; ring E2's byte, for after slot 1
  617  000002F2  6100xxxx                       bsr     yx6_slot
  618  000002F6  205F                           movea.l (sp)+,a0
  619  000002F8  60xx                           bra.s   .slot2
  620                                   .slot1_idle:
  621  000002FA  D1C3                           adda.l  d3,a0
  622  000002FC  D1C3                           adda.l  d3,a0
  623                                   .slot2:
  624  000002FE  4BFAxxxx                       lea     yx6_desc2(pc),a5
  625  00000302  1010                           move.b  (a0),d0                 ; E2, the same gate
  626  00000304  8015                           or.b    (a5),d0
  627  00000306  67xx                           beq.s   .effects_done
  628  00000308  1010                           move.b  (a0),d0
  629  0000030A  D1C3                           adda.l  d3,a0
  630  0000030C  1210                           move.b  (a0),d1                 ; T2
  631  0000030E  6100xxxx                       bsr     yx6_slot
  632                                   .effects_done:
  633                                   
  634                                   ; While a drum runs its voice leaves the mixer, as the original replay
  635                                   ; routines had it: force the tone and noise bits in this frame's R7.
  636  00000312  103Axxxx                       move.b  yx6_drums(pc),d0
  637  00000316  67xx                           beq.s   .mixer_ok
  638  00000318  1200                           move.b  d0,d1
  639  0000031A  E709                           lsl.b   #3,d1
  640  0000031C  8200                           or.b    d0,d1                   ; the voice's tone and noise disables
  641  0000031E  2053                           movea.l YX6_CURSOR(a3),a0
  642  00000320  D1EB0032                       adda.l  YX6_R7OFF(a3),a0
  643  00000324  6100xxxx                       bsr     yx6_borrow              ; the ring gets this byte back
  644  00000328  8310                           or.b    d1,(a0)
  645                                   .mixer_ok:
  646  0000032A  2253                           movea.l YX6_CURSOR(a3),a1       ; the cursor: every register's ring
  647  0000032C  45F9FFFF8800                   lea     YX6_PSG,a2              ; byte is a patched k*N above it
  648                                   
  649                                   ; Selecting a register and writing it are two bus cycles. An interrupt that
  650                                   ; uses the sound chip in between - TOS has several, its floppy motor timeout
  651                                   ; among them - would leave this write going to whatever register it selected,
  652                                   ; so the burst runs masked. Cheap: about 24 cycles for the whole frame.
  653  00000332  40E7                           move.w  sr,-(sp)
  654  00000334  007C0700                       ori.w   #$0700,sr
  655                                   
