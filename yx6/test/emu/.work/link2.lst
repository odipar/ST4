 1076                                   
 1077                                   ; -----------------------------------------------------------------------------
 1078                                   ; yx6_drum_start: read the sample number from the drummed voice's ring byte
 1079                                   ; and silence that byte - it is a number, not a volume - flag the voice for
 1080                                   ; the mixer pass, then arm the drum routine: its select register, its sample
 1081                                   ; address, and the flag-clearing mask, all patched into its own operands.
 1082                                   ; If the other slot holds a SID on this same voice, the drum takes the
 1083                                   ; volume register for itself, as the reference player's drum override does:
 1084                                   ; stop that SID's timer and clear its last code, so the slot retries every
 1085                                   ; frame - suppressed while the flag is up - and restarts the SID by itself
 1086                                   ; the frame after the drum ends.
 1087                                   ; Called from the new-code path AND the held retrigger, which has neither
 1088                                   ; the voice nor the parameter pointer at hand - so it derives its own.
 1089                                   ; in: d0.b = E, a5 = the descriptor, SD_PARM set; out: a0 = the handler;
 1090                                   ; keeps d0/d1/d3/a5.
 1091                                   ; -----------------------------------------------------------------------------
 1092                                   yx6_drum_start:
 1093  000006D4  2053                           movea.l YX6_CURSOR(a3),a0
 1094  000006D6  D1ED0008                       adda.l  SD_PARM(a5),a0
 1095  000006DA  6100xxxx                       bsr     yx6_borrow              ; the ring gets this byte back
 1096  000006DE  7800                           moveq   #0,d4
 1097  000006E0  1810                           move.b  (a0),d4                 ; the sample number, validated at pack
 1098  000006E2  4210                           clr.b   (a0)                    ; sanitize: silence, not a number
 1099  000006E4  1A00                           move.b  d0,d5
 1100  000006E6  E80D                           lsr.b   #4,d5
 1101  000006E8  CA7C0003                       and.w   #3,d5
 1102  000006EC  5345                           subq.w  #1,d5                   ; the voice, for flag and select
 1103  000006EE  7401                           moveq   #1,d2
 1104  000006F0  EB2A                           lsl.b   d5,d2
 1105  000006F2  41FAFEAA                       lea     yx6_drums(pc),a0
 1106  000006F6  8510                           or.b    d2,(a0)                 ; the mixer pass forces this voice off
 1107  000006F8  4602                           not.b   d2
 1108  000006FA  226D000C                       movea.l SD_ISR(a5),a1
 1109  000006FE  13420037                       move.b  d2,ISR_CLEAR(a1)        ; the end tick drops the same flag
 1110  00000702  286D0010                       movea.l SD_OTHER(a5),a4         ; a SID on this voice in the other
 1111  00000706  1414                           move.b  (a4),d2                 ; slot: the drum takes the register
 1112  00000708  C43C00C0                       and.b   #$C0,d2
 1113  0000070C  66xx                           bne.s   .keep
 1114  0000070E  1414                           move.b  (a4),d2
 1115  00000710  B102                           eor.b   d0,d2
 1116  00000712  C43C0030                       and.b   #$30,d2
 1117  00000716  66xx                           bne.s   .keep
 1118  00000718  306C0002                       movea.w SD_CTRL(a4),a0
 1119  0000071C  021000F0                       andi.b  #$F0,(a0)               ; stop the other slot's SID
 1120  00000720  4214                           clr.b   (a4)                    ; and let it retry every frame
 1121                                   .keep:
 1122  00000722  3405                           move.w  d5,d2
 1123  00000724  5042                           addq.w  #8,d2                   ; the voice's volume register
 1124  00000726  13420003                       move.b  d2,ISR_DRUM_SEL(a1)     ; the tick's select immediate
 1125  0000072A  D844                           add.w   d4,d4                   ; a drum table entry is six bytes:
 1126  0000072C  3404                           move.w  d4,d2                   ; 6n = 2n + 4n
 1127  0000072E  D844                           add.w   d4,d4
 1128  00000730  D842                           add.w   d2,d4
 1129  00000732  246B0014                       movea.l YX6_FILE(a3),a2
 1130  00000736  204A                           movea.l a2,a0
 1131  00000738  D1E8001C                       adda.l  YH_DRUMS(a0),a0
 1132  0000073C  24304000                       move.l  0(a0,d4.w),d2           ; the sample's offset in the file
 1133  00000740  D48A                           add.l   a2,d2
 1134  00000742  23420008                       move.l  d2,ISR_DRUM_PTR(a1)     ; the tick reads through its operand
 1135  00000746  2049                           movea.l a1,a0                   ; the handler is the block base
 1136  00000748  4E75                           rts
 1137                                   
 1138                                   ; Records a ring byte about to be edited, for the restore after the burst.
 1139                                   ; in: a0 = the byte; clobbers d2.
 1140                                   yx6_borrow:
 1141  0000074A  7400                           moveq   #0,d2
 1142  0000074C  142B0036                       move.b  YX6_PATCHES(a3),d2
 1143  00000750  522B0036                       addq.b  #1,YX6_PATCHES(a3)
 1144  00000754  17902037                       move.b  (a0),YX6_PATCH_VAL(a3,d2.w)
 1145  00000758  D442                           add.w   d2,d2
 1146  0000075A  D442                           add.w   d2,d2
 1147  0000075C  2788203A                       move.l  a0,YX6_PATCH_ADDR(a3,d2.w)
 1148  00000760  4E75                           rts
    3                                           include "ST4_wrap.S"
    1                                   ; -----------------------------------------------------------------------------
    2                                   ; ST4_wrap.S - ST4: counted-wrap ring decompressor for the Atari ST (68000)
    3                                   ;
    4                                   ; By Robbert van Dalen, based on ZX1 v1.5 by Einar Saukas and on ST1_wrap.S,
    5                                   ; which this follows instruction for instruction wherever the format allows.
    6                                   ; Written by Claude (Anthropic's Claude Code) under Robbert's direction. Use it
    7                                   ; freely, including commercially, as long as your documentation says you used
    8                                   ; ZX1 through ST4 (see LICENSE).
    9                                   ;
   10                                   ; ST4_wrap is ST1_wrap with ST4's three streams and units: the literal payload
   11                                   ; comes from stream B in a2 and the offsets from stream C in a4 (bytes) or D in
   12                                   ; a5 (words), lengths and budgets count units of ST4_UNIT bytes, and the copy
   13                                   ; moves a unit at a time. With the offsets gone, stream A holds nothing but
   14                                   ; bits, so the queue refills a word at a time. Set the unit size before
   15                                   ; including:
   16                                   ;
   17                                   ;       ST4_UNIT    equ     4
   18                                   ;               include "ST4_wrap.S"
   19                                   ;
   20                                   ; !!! LIKE ST1_wrap, THIS HAS NO DONE STATE !!!
   21                                   ; The caller must know the exact output size O in units, make exactly
   22                                   ; T = ceil(O/C) decode calls, and never call again.
   23                                   ;
   24                                   ; The ring is N BYTES and must be a whole number of units; the caller resets a1
   25                                   ; to the ring start after every F = N/(C*UNIT) calls. Budgets and remaining
   26                                   ; counts are units; offsets, positions and N are bytes - which is what keeps
   27                                   ; the wrap arithmetic identical to ST1_wrap's.
   28                                   ;
   29                                   ; The copy engine runs two ladders. Match segments of at most sixteen units -
   30                                   ; measured to be four of every five segments a small-budget streamer makes,
   31                                   ; with the whole-chunk segment the most common of all - take a counter-free
   32                                   ; ladder that falls straight into the match epilogue: no full-pass shift, no
   33                                   ; loop counter, no post-copy kind test. Literals and longer segments take the
   34                                   ; classic counted ladder. And there is no first-call test: ST4_init seeds the
   35                                   ; bit queue with one virtual 0 flag ($4000), so a fresh state decodes itself
   36                                   ; through a zero-unit match segment and reads that flag as "begin literals"
   37                                   ; exactly where the old entry branch went.
   38                                   ;
   39                                   ; The container is ST4.S's: twenty bytes of header - signature, O, and where
   40                                   ; streams B, C and D begin - then A, B, C and D in order. See ST4.S for the
   41                                   ; eight instructions that open one.
   42                                   ;
   43                                   ; THE STATE IS YOUR REGISTERS:
   44                                   ;
   45                                   ;   a0.l  position in stream A          a1.l  write pointer
   46                                   ;   a2.l  position in stream B          a4.l  stream C, the byte offsets
   47                                   ;   a5.l  stream D, the word offsets    d0.w  bit queue ($8000 empty)
   48                                   ;   d1.l  -ring_start.low : units remaining
   49                                   ;   d2.l  N : signed byte offset (+lastOffset*UNIT literals, - during a match)
   50                                   ;
   51                                   ;   resume in    d3.w   this call's budget in UNITS
   52                                   ;   CLOBBERED    d3.w d4.l d5.l a3.l
   53                                   ;   untouched    d6 d7 a6
   54                                   ;
   55                                   ; ASSUMPTIONS (unchecked; violating them is undefined behaviour):
   56                                   ;
   57                                   ;   1. THE RING SIZE N IS A MULTIPLE OF ST4_UNIT, and the ring starts on a unit
   58                                   ;      boundary - as does the destination. A wide move would fault on an odd
   59                                   ;      address, and the caller's wrap has to land on a unit
   60                                   ;   2. N mod (C * ST4_UNIT) = 0, so F = N/(C*UNIT) calls fill the ring exactly
   61                                   ;   3. no offset exceeds 32512 BYTES - the packer clamps -m to that
   62                                   ;   4. no operation is longer than 65535 units - compress with -l65535
   63                                   ;   5. the caller knows O and makes exactly T = ceil(O/C) calls, as ST1_wrap
   64                                   ;   6. streams A and D start on even addresses, and A holds an even number of
   65                                   ;      bytes: the bit queue is refilled with a move.w, and so is a word offset
   66                                   ;
   67                                   ; Compress with st4 -k<UNIT> -m<ring/UNIT> -l65535.
   68                                   ; -----------------------------------------------------------------------------
   69                                   
   70                                   ; The asset's signature for this build: 'S4', format version 4, and the unit
   71                                   ; size this decoder was assembled for. One cmp.l against a file's first long
   72                                   ; proves all three at once.
   73           =53340402               ST4_SIGNATURE   equ     $53340400+ST4_UNIT
   74                                   
   75                                   ; One unit copied, at the width this build was made for.
   76                                           .macro ST4_MOVE
   77                                 .         .if ST4_UNIT=4
   78                                 .         move.l  (a3)+,(a1)+
   79                                 .         .endif
   80                                 .         .if ST4_UNIT=2
   81                                 .         move.w  (a3)+,(a1)+
   82                                 .         .endif
   83                                 .         .if ST4_UNIT=1
   84                                 .         move.b  (a3)+,(a1)+
   85                                 .         .endif
   86                                 .         .endm
   87                                   
   88                                   ; Jump table: bra.w keeps 4-byte slots (base+0/4). A counted ring has no
   89                                   ; one-shot entry; the caller drains it through ST4_resume.
   90  00000762  6000xxxx                               bra.w   ST4_init
   91  00000766  6000xxxx                               bra.w   ST4_resume
   92                                   
   93                                   ; ST4_init: a0 = A, a1 = first ring byte, a2 = B, a4 = C, a5 = D,
   94                                   ; d3.w = N.
   95                                   ; Packs -ring_start.low/N above the common state; writes no memory.
   96                                   ; Java: the Decompressor constructor / reset().
   97                                   ST4_init:
   98  0000076A  7200                           moveq   #0,d1
   99  0000076C  9249                           sub.w   a1,d1                   ; -ring_start.low, exact modulo 65536
  100  0000076E  4841                           swap    d1                      ; pack it high; remaining = 0
  101                                   ; The initial offset has to land in the low word after the swap, so it starts
  102                                   ; in the high half. moveq would put -1 there whatever the unit size, which is
  103                                   ; a byte short at k=2 and three at k=4 - and only shows up on a stream whose
  104                                   ; first match reuses INITIAL_OFFSET.
  105  00000770  243CFFFE0000                   move.l  #(-ST4_UNIT)<<16,d2
  106  00000776  3403                           move.w  d3,d2                   ; N lives below it for now
  107  00000778  4842                           swap    d2                      ; N above, -INITIAL_OFFSET*UNIT below
  108                                   ; One virtual 0 flag, then the empty sentinel. The first resume call runs a
  109                                   ; zero-unit match segment through the normal path - remaining is zero, so
  110                                   ; n = 0 and the ladder is entered at its end - and lands in match_transition,
  111                                   ; which shifts $4000 into $8000: the flag reads as "begin literals" and the
  112                                   ; queue is the empty sentinel the old first call started from. That is what
  113                                   ; lets ST4_resume skip a first-call test on every call.
  114  0000077A  303C4000                       move.w  #$4000,d0
  115  0000077E  4E75                           rts
  116                                   
  117                                   source_wrapped:
  118  00000780  2A02                           move.l  d2,d5
  119  00000782  4245                           clr.w   d5
  120  00000784  4845                           swap    d5                      ; zero-extend N from d2.high
  121  00000786  D7C5                           adda.l  d5,a3                   ; raw source + N, back into the ring
  122  00000788  60xx                           bra.s   copy
  123                                   
  124                                   ; ST4_resume: a0/a1/d0/d1/d2 = state and d3.w = this call's budget.
  125                                   ; Continuing calls emit d3 bytes; the final call may be shorter. The caller
  126                                   ; knows the final span from O; [old a1 .. new a1) is fresh output.
  127                                   ST4_resume:
  128  0000078A  3803                           move.w  d3,d4                   ; seed n from the budget; a fresh state
  129                                   segment:                                ; runs one 0-unit match segment and
  130  0000078C  B841                           cmp.w   d1,d4                   ; reads the seeded flag afterwards.
  131  0000078E  63xx                           bls.s   budget_fits             ; n = min(budget, remaining)
  132  00000790  3801                           move.w  d1,d4
  133                                   budget_fits:
  134  00000792  4A42                           tst.w   d2                      ; positive lastOffset means LITERALS
  135  00000794  6Axx                           bpl.s   literal_source
  136                                   ; MATCH: derive the source and split a segment that crosses the ring end.
  137  00000796  2649                           movea.l a1,a3                   ; raw source = dst + -lastOffset*UNIT
  138  00000798  D6C2                           adda.w  d2,a3                   ; which is why the offset is kept scaled
  139  0000079A  2A01                           move.l  d1,d5
  140  0000079C  4845                           swap    d5                      ; d5.w = -ring_start.low
  141  0000079E  DA49                           add.w   a1,d5                   ; d5.w = destination position
  142  000007A0  DA42                           add.w   d2,d5                   ; add -offset; carry means unwrapped
  143  000007A2  65xx                           bcs.s   copy                    ; unwrapped source cannot cross before dst
  144  000007A4  4445                           neg.w   d5                      ; wrapped: room = offset - position
  145                                   ; The room is bytes and the segment is units, so bring them to the same scale.
  146                                   ; Both are whole units - offsets and positions are - so the shift is exact.
  147                                           .if ST4_UNIT=2
  148  000007A6  E24D                           lsr.w   #1,d5
  149                                           .endif
  150                                           .if ST4_UNIT=4
  151                                 -         lsr.w   #2,d5              ; one shift, not two: 10 cycles, not 16
  152                                 -         .endif
  153  000007A8  BA44                           cmp.w   d4,d5                   ; source units before the ring end
  154  000007AA  64D4                           bcc.s   source_wrapped
  155  000007AC  3805                           move.w  d5,d4                   ; stop this segment at the source wrap
  156  000007AE  60D0                           bra.s   source_wrapped
  157                                   
  158                                   copy:                                   ; MATCH copies only reach this entry
  159  000007B0  9244                           sub.w   d4,d1                   ; consume n from the operation
  160  000007B2  9644                           sub.w   d4,d3                   ; and from this call's budget
  161  000007B4  B87C0011                       cmp.w   #17,d4
  162  000007B8  64xx                           bcc.s   copy_slow               ; n >= 17: the counted ladder
  163  000007BA  D844                           add.w   d4,d4
  164  000007BC  4444                           neg.w   d4                      ; d4 = -2n is the dispatch index itself,
  165  000007BE  4EFB40xx                       jmp     fast_end(pc,d4.w)       ; and $ffxx for byte_offset afterwards
  166                                   fast_ladder:
  167                                   ; Sixteen unit moves: entry at fast_end-2k copies k units.
  168                                           .rept   16
  169                                 #         ST4_MOVE
