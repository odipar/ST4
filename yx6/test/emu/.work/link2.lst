  610  000003FC  92AB0008                       sub.l   YX6_NEXT(a3),d1         ; values still packed
  611  00000400  6Fxx                           ble.s   .advance                ; all decoded: never call ST4 again
  612  00000402  B283                           cmp.l   d3,d1
  613  00000404  64xx                           bcc.s   .refill
  614  00000406  2601                           move.l  d1,d3                   ; the last group is a short one
  615                                   .refill:
