  466                                   ; -----------------------------------------------------------------------------
  467                                   ; YX6_fill: d0.w = stream index * YX6_STATE_SIZE, d3.w = values wanted.
  468                                   ; Produces exactly that many values for one register, crossing into the loop
  469                                   ; section - and around it again - as often as it takes. Straddling matters even
  470                                   ; for one group: nothing says the loop frame falls on a group boundary.
  471                                   ; -----------------------------------------------------------------------------
  472                                   YX6_fill:
  473  000001EC  48E70302                       movem.l d6-d7/a6,-(sp)          ; three registers that survive a decoder
  474  000001F0  45F30046                       lea     YX6_STATE(a3,d0.w),a2   ; call, which its own state needs
  475  000001F4  2C4B                           movea.l a3,a6                   ; ST4 clobbers a3: a6 keeps the workspace
  476  000001F6  2C0A                           move.l  a2,d6
  477  000001F8  7E00                           moveq   #0,d7
  478  000001FA  3E03                           move.w  d3,d7                   ; values still wanted
  479                                   .piece:
  480  000001FC  202A0028                       move.l  YS_LEFT(a2),d0
  481  00000200  66xx                           bne.s   .section
  482  00000202  6100xxxx                       bsr     YX6_start_loop          ; this section ran out: go round again
  483  00000206  202A0028                       move.l  YS_LEFT(a2),d0
  484  0000020A  67xx                           beq.s   .done                   ; nothing to go round to; do not hang
  485                                   .section:
  486  0000020C  B087                           cmp.l   d7,d0
  487  0000020E  65xx                           bcs.s   .piece_size
  488  00000210  2007                           move.l  d7,d0                   ; the section covers all that is wanted
  489                                   .piece_size:
  490  00000212  91AA0028                       sub.l   d0,YS_LEFT(a2)
  491  00000216  9E80                           sub.l   d0,d7
  492  00000218  3600                           move.w  d0,d3                   ; a piece is at most C, so it fits a word
  493                                   ; The decoder's budget counts units of ST4_UNIT bytes. The packer enforces
  494                                   ; that every piece boundary - C, the loop frame, the tune length - is a whole
  495                                   ; number of units, so this shift never drops a remainder.
  496                                           .if ST4_UNIT=2
  497  0000021A  E24B                           lsr.w   #1,d3
  498                                           .endif
  499                                           .if ST4_UNIT=4
  500                                 -         lsr.w   #2,d3
  501                                 -         .endif
  502                                   
  503                                   ; (a2) written out rather than YS_D1(a2): with +o3 rmac folds a zero
  504                                   ; displacement away on movem but keeps the addressing mode, and emits the
  505                                   ; instruction without its extension word. The next word becomes the
  506                                   ; displacement and the code runs off into nothing.
  507  0000021C  4CD20306                       movem.l (a2),d1-d2/a0-a1
  508  00000220  286A0014                       movea.l YS_BOFF(a2),a4
  509  00000224  2A6A0018                       movea.l YS_WOFF(a2),a5
  510  00000228  302A001C                       move.w  YS_QUEUE(a2),d0
  511  0000022C  246A0010                       movea.l YS_LIT(a2),a2           ; loaded last: a2 was the base
  512  00000230  6100xxxx                       bsr     ST4_resume
  513  00000234  264E                           movea.l a6,a3                   ; the decoder clobbered the workspace
  514  00000236  CD8A                           exg     a2,d6                   ; a2 = the block again, d6 = stream B
  515  00000238  B3EA0024                       cmpa.l  YS_END(a2),a1           ; YX6_save, inlined: this is the hot path
  516  0000023C  66xx                           bne.s   .stored
  517  0000023E  226A0020                       movea.l YS_START(a2),a1         ; the call landed on the ring end
  518                                   .stored:
  519  00000242  48D20306                       movem.l d1-d2/a0-a1,(a2)
  520  00000246  25460010                       move.l  d6,YS_LIT(a2)
  521  0000024A  254C0014                       move.l  a4,YS_BOFF(a2)
  522  0000024E  254D0018                       move.l  a5,YS_WOFF(a2)
  523  00000252  3540001C                       move.w  d0,YS_QUEUE(a2)
  524  00000256  2C0A                           move.l  a2,d6                   ; the block pointer, back where fill keeps it
  525  00000258  4A87                           tst.l   d7
  526  0000025A  66A0                           bne.s   .piece
  527                                   .done:
  528  0000025C  4CDF40C0                       movem.l (sp)+,d6-d7/a6
  529  00000260  4E75                           rts
