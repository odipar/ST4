  602  000003E2  302B0028                       move.w  YX6_SLOT(a3),d0
  603  000003E6  B07C0012                       cmp.w   #YX6_STREAMS,d0
  604  000003EA  64xx                           bcc.s   .advance
  605  000003EC  7600                           moveq   #0,d3
