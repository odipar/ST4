  118  000008DE  2A02                           move.l  d2,d5
  119  000008E0  4245                           clr.w   d5
  120  000008E2  4845                           swap    d5                      ; zero-extend N from d2.high
  121  000008E4  D7C5                           adda.l  d5,a3                   ; raw source + N, back into the ring
