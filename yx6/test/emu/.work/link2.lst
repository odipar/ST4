 1053  0000069C  1400                           move.b  d0,d2                   ; (d4 still holds the OLD code, for
 1054  0000069E  C43C00C0                       and.b   #$C0,d2                 ; the retune test below)
 1055  000006A2  67xx                           beq.s   .sid
