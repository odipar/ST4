  579  000003BA  1211                           move.b  (a1),d1                 ; R13 restarts the envelope whenever it
  580  000003BC  B23C00FF                       cmp.b   #YX6_NO_ENV,d1          ; is written, so $FF means leave it be
  581  000003C0  67xx                           beq.s   .envelope_held
  582  000003C2  14BC000D                       move.b  #YX6_ENVELOPE,(a2)
