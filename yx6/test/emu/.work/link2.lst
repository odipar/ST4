  937                                   ; A drum starts: read the sample number from the drummed voice's ring byte
  938                                   ; and silence that byte - it is a number, not a volume - flag the voice for
  939                                   ; the mixer pass, then arm the drum routine: its select register, its sample
  940                                   ; address, and the flag-clearing mask, all patched into its own operands.
  941                                   ; in: d0.b = E, the slot's PARM set; out: a0 = the handler; keeps d0/d1/d3.
  942                                   yx6_drum_start1:
  943  000006F0  2053                           movea.l YX6_CURSOR(a3),a0
  944  000006F2  D1EB0048                       adda.l  YX6_PARM1(a3),a0
  945  000006F6  6100FE30                       bsr     yx6_borrow              ; the ring gets this byte back
  946  000006FA  7800                           moveq   #0,d4
  947  000006FC  1810                           move.b  (a0),d4                 ; the sample number, validated at pack
  948  000006FE  4210                           clr.b   (a0)                    ; sanitize: silence, not a number
  949  00000700  1A00                           move.b  d0,d5
  950  00000702  E80D                           lsr.b   #4,d5
  951  00000704  CA7C0003                       and.w   #3,d5
  952  00000708  5345                           subq.w  #1,d5                   ; the voice again, for flag and select
  953  0000070A  7401                           moveq   #1,d2
  954  0000070C  EB2A                           lsl.b   d5,d2
  955  0000070E  41FAxxxx                       lea     yx6_drums(pc),a0
  956  00000712  8510                           or.b    d2,(a0)                 ; the mixer pass forces this voice off
  957  00000714  4602                           not.b   d2
  958  00000716  41FAxxxx                       lea     yx6_drumA_clear+3(pc),a0
  959  0000071A  1082                           move.b  d2,(a0)                 ; the end tick drops the same flag
  960                                   ; If the other slot holds a SID on this same voice, the drum takes the
  961                                   ; volume register for itself, as the reference player's drum override does:
  962                                   ; stop that SID's timer and clear its last code, so the slot retries every
  963                                   ; frame - suppressed while the flag is up - and restarts the SID by itself
  964                                   ; the frame after the drum ends.
  965  0000071C  142B0037                       move.b  YX6_E2LAST(a3),d2
  966  00000720  C43C00C0                       and.b   #$C0,d2
  967  00000724  66xx                           bne.s   .keep
