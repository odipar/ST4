    1           =00000001               ST4_UNIT    equ     1
    2                                           include "YX6.S"
    1                                   ; -----------------------------------------------------------------------------
    2                                   ; YX6.S - streaming YM chiptune player for the plain 68000 (Atari ST)
    3                                   ;
    4                                   ; By Robbert van Dalen. Plays a .yx6 file: fourteen YM2149 register streams,
    5                                   ; each packed as its own embedded ST4 container and decoded through its own
    6                                   ; small ring by ST4_wrap.S. Written by Claude (Anthropic's Claude Code) under
    7                                   ; Robbert's direction, based on ZX1 v1.5 by Einar Saukas and inspired by Steve
    8                                   ; Clarets' MinYMiser. Use it freely, including commercially, as long as your
    9                                   ; documentation says you used ZX1 through ST4 (see LICENSE).
   10                                   ;
   11                                   ; It plays the fourteen standard sound registers, and loops. The YM6 special
   12                                   ; effects - SID voice, digidrum, sinus-SID, sync-buzzer - are not played, and
   13                                   ; the yx6 packer has already masked their bits out of the register values.
   14                                   ;
   15                                   ; REQUIRES ST4_wrap.S, built for byte units. Include both, in either order,
   16                                   ; with the unit size defined first:
   17                                   ;
   18                                   ;       ST4_UNIT    equ     1
   19                                   ;               include "YX6.S"
   20                                   ;               include "ST4_wrap.S"
   21                                   ;
   22                                   ; YX6 calls ST4_init and ST4_resume by label.
   23                                   ;
   24                                   ; -----------------------------------------------------------------------------
   25                                   ; THE DESIGN, in one paragraph. A tune is O frames long. Each of the fourteen
   26                                   ; registers gets its own ring of N bytes and its own saved decoder state, and
   27                                   ; is decoded C values at a time (C = 16 by default). On every VBL the player
   28                                   ; uses one value from each of the fourteen rings and refills exactly one
   29                                   ; register - register k on the VBL where the frame number modulo C is k. With
   30                                   ; C >= 14 every register is refilled once per C frames, one refill per VBL, so
   31                                   ; the work per frame is flat: fourteen register writes plus one ST4_resume of
   32                                   ; C bytes. Since C divides N and a call never reaches the ring end, ST4_wrap.S
   33                                   ; is the decoder that fits: the player counts the calls itself and wraps the
   34                                   ; write pointer when it lands on the ring end.
   35                                   ;
   36                                   ; LOOPING. A packed stream can only be restarted from its beginning, so the packer
   37                                   ; splits every register at the loop frame L: an intro stream for frames [0, L)
   38                                   ; and a loop stream for [L, O). When a register's section runs out mid-refill
   39                                   ; the player starts its loop stream over - a fresh decoder writing on into the
   40                                   ; same ring - so the rings always hold one continuous sequence of values and
   41                                   ; the read side never learns that anything happened. Nothing requires L to fall
   42                                   ; on a group boundary: a refill that straddles the split simply decodes two
   43                                   ; pieces. A tune that loops from frame 0 has no intro streams at all.
   44                                   ;
   45                                   ; -----------------------------------------------------------------------------
   46                                   ; USING IT
   47                                   ;
   48                                   ;       lea     song,a0                 ; the .yx6 file, loaded anywhere
   49                                   ;       lea     workspace,a1            ; even address, YX6_SIZE bytes
   50                                   ;       bsr     YX6_init                ; d0 = 0 when the file was accepted
   51                                   ;       tst.l   d0
   52                                   ;       bne     bad_file
   53                                   ;   vbl:                                ; once per frame, in supervisor mode
   54                                   ;       lea     workspace,a0
   55                                   ;       bsr     YX6_play                ; d0 = 0 played, 1 wrapped, -1 ended
   56                                   ;       ...
   57                                   ;       bsr     YX6_stop                ; silence the three voices
   58                                   ;
   59                                   ; The workspace holds the player's own fields, the fourteen decoder states and
   60                                   ; the fourteen rings, so its size depends on the ring size in the file:
   61                                   ;
   62                                   ;   YX6_SIZE = YX6_FIXED + 14 * N       ; 944 + 14 * N bytes
   63                                   ;
   64                                   ; For the default 1024-byte rings that is 15280 bytes. A program that knows N
   65                                   ; at build time can reserve it with
   66                                   ;
   67                                   ;       ds.b    YX6_FIXED+(YX6_STREAMS*1024)
   68                                   ;
   69                                   ; where the parentheses matter: rmac evaluates expressions left to right.
   70                                   ;
   71                                   ; CALLS AND REGISTERS
   72                                   ;
   73                                   ;   YX6_init   in   a0 = .yx6 file, at an even address, a1 = workspace
   74                                   ;              out  d0 = 0 accepted, -1 not a v3 yx6 file with 14 streams
   75                                   ;   YX6_play   in   a0 = workspace
   76                                   ;              out  d0 = 0 played a frame
   77                                   ;                   d0 = 1 played a frame, and that frame ended the tune: the
   78                                   ;                          next one is the loop frame L
   79                                   ;                   d0 = -1 the tune is over and nothing was written, which
   80                                   ;                          only a tune packed with -o can report
   81                                   ;   YX6_stop   in   -
   82                                   ;   CLOBBERED  d0-d5, a0-a5. d6, d7 and a6 survive, as with ST4 - whose
   83                                   ;              decoder state spans a4 and a5, which is why they no longer do.
   84                                   ;
   85                                   ; YX6_play writes to the sound chip at $FFFF8800, so it must run in supervisor
   86                                   ; mode - which a VBL handler already does. It masks interrupts around the
   87                                   ; fourteen writes, because selecting a register and writing it are two bus
   88                                   ; cycles and TOS's own handlers use the chip too. Beyond that it performs no
   89                                   ; side effect: no interrupt setup, no memory allocation, nothing outside the
   90                                   ; workspace.
   91                                   ;
   92                                   ; ASSUMPTIONS (unchecked beyond the magic, version and stream count):
   93                                   ;
   94                                   ;   1. the file comes from the yx6 packer, which enforces C >= 14, N mod C = 0,
   95                                   ;      N >= 2C and offsets that stay inside the ring
   96                                   ;   2. the workspace is at an even address and large enough for the file's N
   97                                   ;   3. YX6_play is called once per frame and never after it returns -1.
   98                                   ;      Calling it again is harmless - it returns -1 and writes nothing - which
   99                                   ;      is what keeps ST4_wrap's "never call the decoder again" rule intact
  100                                   ;   4. a looping tune plays for as long as you keep calling: d0 = 1 marks each
  101                                   ;      time round, and YX6_init is only needed to start again from frame 0
  102                                   ; -----------------------------------------------------------------------------
  103                                   
  104           =0000000E               YX6_STREAMS     equ     14              ; R0..R13; R14/R15 are I/O ports
  105           =00000040               YX6_STATE_SIZE  equ     64              ; per stream, so the index is a shift
  106                                                                           ; both ways: *64 in, /16 back to *4
  107                                   
  108                                   ; Workspace layout. Counters that a frame touches are kept in the form the
  109                                   ; frame wants them in: a pointer to walk, and a countdown to test against zero.
  110           =00000000               YX6_CURSOR      equ     0               ; long  this frame's byte in ring 0
  111           =00000004               YX6_LEFTFR      equ     4               ; long  frames before the tune ends
  112           =00000008               YX6_NEXT        equ     8               ; long  values decoded so far
  113           =0000000C               YX6_RINGEND     equ     12              ; long  one past ring 0, where it wraps
  114           =00000010               YX6_RINGS       equ     16              ; long  base of the ring area
  115           =00000014               YX6_FILE        equ     20              ; long  the .yx6 file
  116           =00000018               YX6_TOTAL       equ     24              ; long  O, the tune length in frames
  117           =0000001C               YX6_LOOPLEN     equ     28              ; long  O - L, zero when it does not loop
  118           =00000020               YX6_LOOP        equ     32              ; long  L, read at init to split sections
  119           =00000024               YX6_N           equ     36              ; word  ring size N
  120           =00000026               YX6_C           equ     38              ; word  values per call C
  121           =00000028               YX6_SLOT        equ     40              ; word  refill slot, 0..C-1
  122           =0000002A               YX6_INDEX       equ     42              ; word  stream index, during init only
  123           =0000002C               YX6_LOOPS       equ     44              ; word  nonzero when the tune loops
  124           =00000030               YX6_STATE       equ     48              ; 14 decoder states
  125                                   ; rmac evaluates left to right, so the parentheses here are load-bearing:
  126                                   ; without them this reads as (YX6_STATE+YX6_STREAMS)*YX6_STATE_SIZE.
  127           =000003B0               YX6_FIXED       equ     YX6_STATE+(YX6_STREAMS*YX6_STATE_SIZE)
  128                                   
  129                                   ; One saved ST4_wrap state, plus the ring bounds the wrap check needs. The
  130                                   ; first four longs are in movem order - d1, d2, then a0, a1 - so that much of
  131                                   ; the decoder state loads and stores in one instruction; the three extra
  132                                   ; stream pointers ST4 carries (literals, byte offsets, word offsets) follow.
  133           =00000000               YS_D1           equ     0               ; long  d1, -ring.low : remaining
  134           =00000004               YS_D2           equ     4               ; long  d2, N : signed offset
  135           =00000008               YS_INPUT        equ     8               ; long  a0, stream A position
  136           =0000000C               YS_WRITE        equ     12              ; long  a1, write pointer
  137           =00000010               YS_LIT          equ     16              ; long  a2, stream B position
  138           =00000014               YS_BOFF         equ     20              ; long  a4, stream C position
  139           =00000018               YS_WOFF         equ     24              ; long  a5, stream D position
  140           =0000001C               YS_QUEUE        equ     28              ; word  d0, bit queue
  141           =00000020               YS_START        equ     32              ; long  this stream's ring
  142           =00000024               YS_END          equ     36              ; long  one past its last byte
  143           =00000028               YS_LEFT         equ     40              ; long  values left in the current section
  144                                   ; The movem block starts at the top of the state, so the two movems address it
  145                                   ; as plain (a2) - see the note where they are used.
  146                                   
  147                                   ; The .yx6 header, as written by the packer.
  148           =00000000               YH_MAGIC        equ     0
  149           =00000004               YH_VERSION      equ     4
  150           =00000006               YH_FLAGS        equ     6
  151           =00000008               YH_FRAMES       equ     8
  152           =0000000C               YH_PLAYER_HZ    equ     12
  153           =0000000E               YH_STREAM_COUNT equ     14
  154           =00000010               YH_RING         equ     16
  155           =00000012               YH_CHUNK        equ     18
  156           =00000014               YH_LOOP         equ     20
  157           =00000018               YH_CLOCK        equ     24
  158           =0000001C               YH_INTRO_TABLE  equ     28              ; 14 offsets: the frames before the loop
  159           =00000054               YH_LOOP_TABLE   equ     84              ; 14 offsets: the frames from L on
  160                                   
  161           =59583621               YX6_MAGIC       equ     $59583621       ; 'YX6!'
  162           =00000003               YX6_VERSION     equ     3               ; 3: the sections are ST4 containers
  163           =00000001               YX6_FLAG_LOOPS  equ     1               ; header flag: the tune loops
  164           =FFFF8800               YX6_PSG         equ     $FFFF8800       ; select/read at +0, write at +2
  165           =000000FF               YX6_NO_ENV      equ     $FF             ; R13 value meaning "leave it alone"
  166           =000000C0               YX6_PORTS       equ     $C0             ; R7 bits the ST needs as outputs
  167           =00000007               YX6_MIXER       equ     7
  168           =0000000D               YX6_ENVELOPE    equ     13
  169                                   
  170                                   ; -----------------------------------------------------------------------------
  171                                   ; YX6_WRITE: send one register's value straight from its ring to the sound
  172                                   ; chip, then step a1 on to the next register's ring.
  173                                   ;
  174                                   ; Two moves and an add, with the register number assembled in as an immediate:
  175                                   ; nothing is tested, nothing is counted, and the value never passes through a
  176                                   ; data register. Registers 7 and 13 need their values touched, so they are
  177                                   ; written out of line rather than through this macro.
  178                                   ;
  179                                   ; Skipping a register whose value has not changed was measured and dropped: a
  180                                   ; sound-chip access on an ST costs about 1.5 cycles more than a RAM one, so the
  181                                   ; compare that would save the write costs about as much as the write.
  182                                   ; -----------------------------------------------------------------------------
  183                                           .macro YX6_WRITE number
  184                                 .         move.b  #\number,(a2)           ; select
  185                                 .         move.b  (a1),2(a2)              ; and write
  186                                 .         adda.l  d3,a1
  187                                 .         .endm
  188                                   
  189                                   ; Jump table: bra.w keeps 4-byte slots for a program that loads YX6 as a blob.
  190  00000000  6000xxxx                               bra.w   YX6_init
  191  00000004  6000xxxx                               bra.w   YX6_play
  192  00000008  6000xxxx                               bra.w   YX6_stop
  193                                   
  194                                   ; -----------------------------------------------------------------------------
  195                                   ; YX6_init: a0 = .yx6 file, a1 = workspace. Sets up fourteen decoders and
  196                                   ; decodes each register's first group, so frame 0 can be played immediately.
  197                                   ; -----------------------------------------------------------------------------
  198                                   YX6_init:
  199  0000000C  2649                           movea.l a1,a3                   ; a3 is the workspace throughout
  200  0000000E  27480014                       move.l  a0,YX6_FILE(a3)
  201  00000012  0C9059583621                   cmp.l   #YX6_MAGIC,YH_MAGIC(a0)
  202  00000018  6600xxxx                       bne     .rejected
  203  0000001C  0C6800030004                   cmp.w   #YX6_VERSION,YH_VERSION(a0)
  204  00000022  6600xxxx                       bne     .rejected
  205  00000026  0C68000E000E                   cmp.w   #YX6_STREAMS,YH_STREAM_COUNT(a0)
  206  0000002C  6600xxxx                       bne     .rejected
  207                                   
  208  00000030  276800080018                   move.l  YH_FRAMES(a0),YX6_TOTAL(a3)
  209  00000036  276800140020                   move.l  YH_LOOP(a0),YX6_LOOP(a3)
  210  0000003C  376800100024                   move.w  YH_RING(a0),YX6_N(a3)
  211  00000042  376800120026                   move.w  YH_CHUNK(a0),YX6_C(a3)
  212  00000048  30280006                       move.w  YH_FLAGS(a0),d0
  213  0000004C  C07C0001                       and.w   #YX6_FLAG_LOOPS,d0
  214  00000050  3740002C                       move.w  d0,YX6_LOOPS(a3)
  215  00000054  276800080004                   move.l  YH_FRAMES(a0),YX6_LEFTFR(a3)
  216  0000005A  426B0028                       clr.w   YX6_SLOT(a3)
  217  0000005E  43EB03B0                       lea     YX6_FIXED(a3),a1        ; the rings follow the decoder states
  218  00000062  27490010                       move.l  a1,YX6_RINGS(a3)
  219  00000066  2689                           move.l  a1,YX6_CURSOR(a3)       ; frame 0 is the first byte of ring 0
  220  00000068  7000                           moveq   #0,d0
  221  0000006A  30280010                       move.w  YH_RING(a0),d0
  222  0000006E  D089                           add.l   a1,d0
  223  00000070  2740000C                       move.l  d0,YX6_RINGEND(a3)      ; where the cursor goes back to the top
  224                                   
  225  00000074  202B0018                       move.l  YX6_TOTAL(a3),d0        ; the loop section is O - L frames long,
  226  00000078  90AB0020                       sub.l   YX6_LOOP(a3),d0         ; and empty when the tune plays once
  227  0000007C  4A6B002C                       tst.w   YX6_LOOPS(a3)
  228  00000080  66xx                           bne.s   .loop_length
  229  00000082  7000                           moveq   #0,d0
  230                                   .loop_length:
  231  00000084  2740001C                       move.l  d0,YX6_LOOPLEN(a3)
  232                                   
  233  00000088  7200                           moveq   #0,d1                   ; the first group is C values, or the
  234  0000008A  322B0026                       move.w  YX6_C(a3),d1            ; whole tune when that is shorter and
  235  0000008E  4A6B002C                       tst.w   YX6_LOOPS(a3)           ; there is no loop to carry on into
  236  00000092  66xx                           bne.s   .first_group
  237  00000094  202B0018                       move.l  YX6_TOTAL(a3),d0
  238  00000098  B081                           cmp.l   d1,d0
  239  0000009A  64xx                           bcc.s   .first_group
  240  0000009C  2200                           move.l  d0,d1
  241                                   .first_group:
  242  0000009E  27410008                       move.l  d1,YX6_NEXT(a3)         ; values decoded once init is done
  243                                   
  244  000000A2  426B002A                       clr.w   YX6_INDEX(a3)           ; the loop counter lives here: every
  245                                   .stream:                                ; register is state during the calls
  246  000000A6  302B002A                       move.w  YX6_INDEX(a3),d0
  247  000000AA  ED48                           lsl.w   #6,d0                   ; * YX6_STATE_SIZE
  248  000000AC  45F30030                       lea     YX6_STATE(a3,d0.w),a2
  249  000000B0  7600                           moveq   #0,d3
  250  000000B2  362B0024                       move.w  YX6_N(a3),d3
  251  000000B6  302B002A                       move.w  YX6_INDEX(a3),d0
  252  000000BA  C0C3                           mulu.w  d3,d0                   ; this stream's ring is the k'th
  253  000000BC  226B0010                       movea.l YX6_RINGS(a3),a1
  254  000000C0  D3C0                           adda.l  d0,a1
  255  000000C2  25490020                       move.l  a1,YS_START(a2)
  256  000000C6  2549000C                       move.l  a1,YS_WRITE(a2)
  257  000000CA  2009                           move.l  a1,d0
  258  000000CC  D083                           add.l   d3,d0
  259  000000CE  25400024                       move.l  d0,YS_END(a2)
  260                                   
  261                                   ; A tune that loops from frame 0 has no intro streams, so its registers start
  262                                   ; on the loop section - which is then the whole tune.
  263  000000D2  202B0020                       move.l  YX6_LOOP(a3),d0
  264  000000D6  383C001C                       move.w  #YH_INTRO_TABLE,d4
  265  000000DA  66xx                           bne.s   .section
  266  000000DC  202B001C                       move.l  YX6_LOOPLEN(a3),d0
  267  000000E0  383C0054                       move.w  #YH_LOOP_TABLE,d4
  268                                   .section:
  269  000000E4  25400028                       move.l  d0,YS_LEFT(a2)          ; values before this stream runs out
  270                                   
  271  000000E8  302B002A                       move.w  YX6_INDEX(a3),d0
  272  000000EC  E548                           lsl.w   #2,d0                   ; the tables hold long offsets
  273  000000EE  D044                           add.w   d4,d0
  274  000000F0  206B0014                       movea.l YX6_FILE(a3),a0
  275  000000F4  20300000                       move.l  0(a0,d0.w),d0
  276  000000F8  D1C0                           adda.l  d0,a0                   ; the section's ST4 container
  277                                   
  278                                   ; Open the container: stream A begins where its header ends, and B, C and D
  279                                   ; sit at the header-relative offsets it records - ST4.S documents exactly this
  280                                   ; sequence. The state block goes to the stack; ST4_init clobbers a3, so the
  281                                   ; workspace pointer does too.
  282  000000FA  2F0A                           move.l  a2,-(sp)
  283  000000FC  2448                           movea.l a0,a2
  284  000000FE  D5E80008                       adda.l  8(a0),a2                ; stream B, the literals
  285  00000102  2848                           movea.l a0,a4
  286  00000104  D9E8000C                       adda.l  12(a0),a4               ; stream C, the byte offsets
  287  00000108  2A48                           movea.l a0,a5
  288  0000010A  DBE80010                       adda.l  16(a0),a5               ; stream D, the word offsets
  289  0000010E  41E80014                       lea     20(a0),a0               ; stream A, the bits
  290  00000112  7600                           moveq   #0,d3
  291  00000114  362B0024                       move.w  YX6_N(a3),d3            ; N, also ST4_init's argument
  292  00000118  2F0B                           move.l  a3,-(sp)
  293  0000011A  6100xxxx                       bsr     ST4_init
  294  0000011E  265F                           movea.l (sp)+,a3
  295                                   
  296  00000120  225F                           movea.l (sp)+,a1                ; the state block; a1 is recomputed
  297  00000122  23480008                       move.l  a0,YS_INPUT(a1)         ; every time round this loop
  298  00000126  234A0010                       move.l  a2,YS_LIT(a1)
  299  0000012A  234C0014                       move.l  a4,YS_BOFF(a1)
  300  0000012E  234D0018                       move.l  a5,YS_WOFF(a1)
  301  00000132  3340001C                       move.w  d0,YS_QUEUE(a1)
  302  00000136  2281                           move.l  d1,YS_D1(a1)
  303  00000138  23420004                       move.l  d2,YS_D2(a1)
  304                                   
  305  0000013C  302B002A                       move.w  YX6_INDEX(a3),d0        ; and its first group
  306  00000140  ED48                           lsl.w   #6,d0
  307  00000142  362B000A                       move.w  YX6_NEXT+2(a3),d3       ; C, or fewer: both fit a word
  308  00000146  6100xxxx                       bsr     YX6_fill
  309  0000014A  526B002A                       addq.w  #1,YX6_INDEX(a3)
  310  0000014E  0C6B000E002A                   cmp.w   #YX6_STREAMS,YX6_INDEX(a3)
  311  00000154  6600FF50                       bne     .stream
  312                                   
  313  00000158  7000                           moveq   #0,d0
  314  0000015A  4E75                           rts
  315                                   .rejected:
  316  0000015C  70FF                           moveq   #-1,d0
  317  0000015E  4E75                           rts
  318                                   
  319                                   ; -----------------------------------------------------------------------------
  320                                   ; YX6_fill: d0.w = stream index * YX6_STATE_SIZE, d3.w = values wanted.
  321                                   ; Produces exactly that many values for one register, crossing into the loop
  322                                   ; section - and around it again - as often as it takes. Straddling matters even
  323                                   ; for one group: nothing says the loop frame falls on a group boundary.
  324                                   ; -----------------------------------------------------------------------------
  325                                   YX6_fill:
  326  00000160  48E70302                       movem.l d6-d7/a6,-(sp)          ; three registers that survive a decoder
  327  00000164  45F30030                       lea     YX6_STATE(a3,d0.w),a2   ; call, which its own state needs
  328  00000168  2C4B                           movea.l a3,a6                   ; ST4 clobbers a3: a6 keeps the workspace
  329  0000016A  2C0A                           move.l  a2,d6
  330  0000016C  7E00                           moveq   #0,d7
  331  0000016E  3E03                           move.w  d3,d7                   ; values still wanted
  332                                   .piece:
  333  00000170  202A0028                       move.l  YS_LEFT(a2),d0
  334  00000174  66xx                           bne.s   .section
  335  00000176  6100xxxx                       bsr     YX6_start_loop          ; this section ran out: go round again
  336  0000017A  202A0028                       move.l  YS_LEFT(a2),d0
  337  0000017E  67xx                           beq.s   .done                   ; nothing to go round to; do not hang
  338                                   .section:
  339  00000180  B087                           cmp.l   d7,d0
  340  00000182  65xx                           bcs.s   .piece_size
  341  00000184  2007                           move.l  d7,d0                   ; the section covers all that is wanted
  342                                   .piece_size:
  343  00000186  91AA0028                       sub.l   d0,YS_LEFT(a2)
  344  0000018A  9E80                           sub.l   d0,d7
  345  0000018C  3600                           move.w  d0,d3                   ; a piece is at most C, so it fits a word
  346                                   
  347                                   ; (a2) written out rather than YS_D1(a2): with +o3 rmac folds a zero
  348                                   ; displacement away on movem but keeps the addressing mode, and emits the
  349                                   ; instruction without its extension word. The next word becomes the
  350                                   ; displacement and the code runs off into nothing.
  351  0000018E  4CD20306                       movem.l (a2),d1-d2/a0-a1
  352  00000192  286A0014                       movea.l YS_BOFF(a2),a4
  353  00000196  2A6A0018                       movea.l YS_WOFF(a2),a5
  354  0000019A  302A001C                       move.w  YS_QUEUE(a2),d0
  355  0000019E  246A0010                       movea.l YS_LIT(a2),a2           ; loaded last: a2 was the base
  356  000001A2  6100xxxx                       bsr     ST4_resume
  357  000001A6  264E                           movea.l a6,a3                   ; the decoder clobbered the workspace
  358  000001A8  CD8A                           exg     a2,d6                   ; a2 = the block again, d6 = stream B
  359  000001AA  B3EA0024                       cmpa.l  YS_END(a2),a1           ; YX6_save, inlined: this is the hot path
  360  000001AE  66xx                           bne.s   .stored
  361  000001B0  226A0020                       movea.l YS_START(a2),a1         ; the call landed on the ring end
  362                                   .stored:
  363  000001B4  48D20306                       movem.l d1-d2/a0-a1,(a2)
  364  000001B8  25460010                       move.l  d6,YS_LIT(a2)
  365  000001BC  254C0014                       move.l  a4,YS_BOFF(a2)
  366  000001C0  254D0018                       move.l  a5,YS_WOFF(a2)
  367  000001C4  3540001C                       move.w  d0,YS_QUEUE(a2)
  368  000001C8  2C0A                           move.l  a2,d6                   ; the block pointer, back where fill keeps it
  369  000001CA  4A87                           tst.l   d7
  370  000001CC  66A2                           bne.s   .piece
  371                                   .done:
  372  000001CE  4CDF40C0                       movem.l (sp)+,d6-d7/a6
  373  000001D2  4E75                           rts
  374                                   
  375                                   ; -----------------------------------------------------------------------------
  376                                   ; YX6_start_loop: a2 = state block. Starts this register's loop stream over -
  377                                   ; a fresh decoder, reading from the top of the loop section, still writing
  378                                   ; where the last one stopped. ST4_init wants the ring start so that its packed
  379                                   ; metadata comes out right; the write pointer is restored from the block, which
  380                                   ; is why it is stored rather than held in a register.
  381                                   ; -----------------------------------------------------------------------------
  382                                   ; It runs inside YX6_fill, which guarantees d6 = the state block and a6 = the
  383                                   ; workspace - the two anchors that survive the decoder call.
  384                                   YX6_start_loop:
  385  000001D4  200A                           move.l  a2,d0
  386  000001D6  908B                           sub.l   a3,d0
  387  000001D8  907C0030                       sub.w   #YX6_STATE,d0
  388  000001DC  E848                           lsr.w   #4,d0                   ; k * 64 becomes k * 4, a table index
  389  000001DE  206B0014                       movea.l YX6_FILE(a3),a0
  390  000001E2  20300054                       move.l  YH_LOOP_TABLE(a0,d0.w),d0
  391  000001E6  67xx                           beq.s   .no_loop                ; this tune has no loop section
  392  000001E8  D1C0                           adda.l  d0,a0                   ; the loop section's ST4 container
  393  000001EA  226A0020                       movea.l YS_START(a2),a1         ; read before a2 becomes stream B
  394  000001EE  2448                           movea.l a0,a2
  395  000001F0  D5E80008                       adda.l  8(a0),a2                ; stream B
  396  000001F4  2848                           movea.l a0,a4
  397  000001F6  D9E8000C                       adda.l  12(a0),a4               ; stream C
  398  000001FA  2A48                           movea.l a0,a5
  399  000001FC  DBE80010                       adda.l  16(a0),a5               ; stream D
  400  00000200  41E80014                       lea     20(a0),a0               ; stream A
  401  00000204  7600                           moveq   #0,d3
  402  00000206  362B0024                       move.w  YX6_N(a3),d3
  403  0000020A  6100xxxx                       bsr     ST4_init
  404  0000020E  264E                           movea.l a6,a3                   ; the decoder clobbered the workspace
  405  00000210  CD8A                           exg     a2,d6                   ; a2 = the block again, d6 = stream B
  406  00000212  25480008                       move.l  a0,YS_INPUT(a2)
  407  00000216  25460010                       move.l  d6,YS_LIT(a2)
  408  0000021A  254C0014                       move.l  a4,YS_BOFF(a2)
  409  0000021E  254D0018                       move.l  a5,YS_WOFF(a2)
  410  00000222  3540001C                       move.w  d0,YS_QUEUE(a2)
  411  00000226  2481                           move.l  d1,YS_D1(a2)
  412  00000228  25420004                       move.l  d2,YS_D2(a2)
  413  0000022C  256B001C0028                   move.l  YX6_LOOPLEN(a3),YS_LEFT(a2)
  414  00000232  2C0A                           move.l  a2,d6                   ; the block pointer, as fill keeps it
  415                                   .no_loop:
  416  00000234  4E75                           rts
  417                                   
  418                                   ; -----------------------------------------------------------------------------
  419                                   ; YX6_play: a0 = workspace. One frame: write fourteen registers, refill one.
  420                                   ; -----------------------------------------------------------------------------
  421                                   YX6_play:
  422  00000236  2648                           movea.l a0,a3
  423  00000238  4AAB0004                       tst.l   YX6_LEFTFR(a3)
  424  0000023C  66xx                           bne.s   .frame
  425  0000023E  70FF                           moveq   #-1,d0                  ; past the last frame of a tune that
  426  00000240  4E75                           rts                             ; does not loop: write nothing
  427                                   
  428                                   .frame:                                 ; the same offset in all fourteen rings
  429  00000242  2253                           movea.l YX6_CURSOR(a3),a1
  430  00000244  7600                           moveq   #0,d3
  431  00000246  362B0024                       move.w  YX6_N(a3),d3            ; one ring to the next
  432  0000024A  45F9FFFF8800                   lea     YX6_PSG,a2
  433                                   
  434                                   ; Selecting a register and writing it are two bus cycles. An interrupt that
  435                                   ; uses the sound chip in between - TOS has several, its floppy motor timeout
  436                                   ; among them - would leave this write going to whatever register it selected,
  437                                   ; so the burst runs masked. Cheap: about 24 cycles for the whole frame.
  438  00000250  40E7                           move.w  sr,-(sp)
  439  00000252  007C0700                       ori.w   #$0700,sr
  440                                   
                                                YX6_WRITE 0                     ; channel A period, fine and coarse
       00000256  14BC0000             @         move.b  #$0,(a2)           
       0000025A  15510002             @         move.b  (a1),2(a2)              
  441  0000025E  D3C3                 @         adda.l  d3,a1
                                                YX6_WRITE 1
       00000260  14BC0001             @         move.b  #$1,(a2)           
       00000264  15510002             @         move.b  (a1),2(a2)              
  442  00000268  D3C3                 @         adda.l  d3,a1
                                                YX6_WRITE 2                     ; channel B
       0000026A  14BC0002             @         move.b  #$2,(a2)           
       0000026E  15510002             @         move.b  (a1),2(a2)              
  443  00000272  D3C3                 @         adda.l  d3,a1
                                                YX6_WRITE 3
       00000274  14BC0003             @         move.b  #$3,(a2)           
       00000278  15510002             @         move.b  (a1),2(a2)              
  444  0000027C  D3C3                 @         adda.l  d3,a1
                                                YX6_WRITE 4                     ; channel C
       0000027E  14BC0004             @         move.b  #$4,(a2)           
       00000282  15510002             @         move.b  (a1),2(a2)              
  445  00000286  D3C3                 @         adda.l  d3,a1
                                                YX6_WRITE 5
       00000288  14BC0005             @         move.b  #$5,(a2)           
       0000028C  15510002             @         move.b  (a1),2(a2)              
  446  00000290  D3C3                 @         adda.l  d3,a1
                                                YX6_WRITE 6                     ; noise period
       00000292  14BC0006             @         move.b  #$6,(a2)           
       00000296  15510002             @         move.b  (a1),2(a2)              
  447  0000029A  D3C3                 @         adda.l  d3,a1
  448                                   
  449  0000029C  14BC0007                       move.b  #YX6_MIXER,(a2)         ; R7 also carries the ST's I/O port
  450  000002A0  1211                           move.b  (a1),d1                 ; directions, which port A needs kept
  451  000002A2  823C00C0                       or.b    #YX6_PORTS,d1           ; as outputs for the floppy select
  452  000002A6  15410002                       move.b  d1,2(a2)
  453  000002AA  D3C3                           adda.l  d3,a1
  454                                   
                                                YX6_WRITE 8                     ; the three volumes
       000002AC  14BC0008             @         move.b  #$8,(a2)           
       000002B0  15510002             @         move.b  (a1),2(a2)              
  455  000002B4  D3C3                 @         adda.l  d3,a1
                                                YX6_WRITE 9
       000002B6  14BC0009             @         move.b  #$9,(a2)           
       000002BA  15510002             @         move.b  (a1),2(a2)              
  456  000002BE  D3C3                 @         adda.l  d3,a1
                                                YX6_WRITE 10
       000002C0  14BC000A             @         move.b  #$A,(a2)           
       000002C4  15510002             @         move.b  (a1),2(a2)              
  457  000002C8  D3C3                 @         adda.l  d3,a1
                                                YX6_WRITE 11                    ; envelope period
       000002CA  14BC000B             @         move.b  #$B,(a2)           
       000002CE  15510002             @         move.b  (a1),2(a2)              
  458  000002D2  D3C3                 @         adda.l  d3,a1
                                                YX6_WRITE 12
       000002D4  14BC000C             @         move.b  #$C,(a2)           
       000002D8  15510002             @         move.b  (a1),2(a2)              
  459  000002DC  D3C3                 @         adda.l  d3,a1
  460                                   
  461  000002DE  1211                           move.b  (a1),d1                 ; R13 restarts the envelope whenever it
  462  000002E0  B23C00FF                       cmp.b   #YX6_NO_ENV,d1          ; is written, so $FF means leave it be
  463  000002E4  67xx                           beq.s   .envelope_held
  464  000002E6  14BC000D                       move.b  #YX6_ENVELOPE,(a2)
  465  000002EA  15410002                       move.b  d1,2(a2)
  466                                   .envelope_held:
  467  000002EE  46DF                           move.w  (sp)+,sr
  468                                   
  469                                   ; Refill the register whose turn it is. Slots 14..C-1 exist when C is larger
  470                                   ; than the register count; they simply have nothing to do.
  471  000002F0  302B0028                       move.w  YX6_SLOT(a3),d0
  472  000002F4  B07C000E                       cmp.w   #YX6_STREAMS,d0
  473  000002F8  64xx                           bcc.s   .advance
  474  000002FA  7600                           moveq   #0,d3
  475  000002FC  362B0026                       move.w  YX6_C(a3),d3            ; a whole group
  476  00000300  4A6B002C                       tst.w   YX6_LOOPS(a3)
  477  00000304  66xx                           bne.s   .refill                 ; a looping tune never runs out
  478  00000306  222B0018                       move.l  YX6_TOTAL(a3),d1
  479  0000030A  92AB0008                       sub.l   YX6_NEXT(a3),d1         ; values still packed
  480  0000030E  6Fxx                           ble.s   .advance                ; all decoded: never call ST4 again
  481  00000310  B283                           cmp.l   d3,d1
  482  00000312  64xx                           bcc.s   .refill
  483  00000314  2601                           move.l  d1,d3                   ; the last group is a short one
  484                                   .refill:
  485  00000316  ED48                           lsl.w   #6,d0
  486  00000318  6100FE46                       bsr     YX6_fill
  487                                   
  488                                   .advance:
  489  0000031C  5293                           addq.l  #1,YX6_CURSOR(a3)       ; one byte along every ring
  490  0000031E  2013                           move.l  YX6_CURSOR(a3),d0
  491  00000320  B0AB000C                       cmp.l   YX6_RINGEND(a3),d0
  492  00000324  65xx                           bcs.s   .cursor_ready
  493  00000326  26AB0010                       move.l  YX6_RINGS(a3),YX6_CURSOR(a3)
  494                                   .cursor_ready:
  495  0000032A  302B0028                       move.w  YX6_SLOT(a3),d0
  496  0000032E  5240                           addq.w  #1,d0
  497  00000330  B06B0026                       cmp.w   YX6_C(a3),d0
  498  00000334  65xx                           bcs.s   .slot_ready
  499  00000336  7000                           moveq   #0,d0                   ; a cycle ended: the groups move on
  500  00000338  7200                           moveq   #0,d1
  501  0000033A  322B0026                       move.w  YX6_C(a3),d1
  502  0000033E  D3AB0008                       add.l   d1,YX6_NEXT(a3)
  503                                   .slot_ready:
  504  00000342  37400028                       move.w  d0,YX6_SLOT(a3)
  505                                   
  506                                   ; The rings hold the tune as one continuous sequence, so reaching the end of
  507                                   ; the last frame simply means the next values in them are the loop section's.
  508                                   ; The countdown follows: it reloads with the loop section's length.
  509  00000346  53AB0004                       subq.l  #1,YX6_LEFTFR(a3)
  510  0000034A  66xx                           bne.s   .played
  511  0000034C  4A6B002C                       tst.w   YX6_LOOPS(a3)
  512  00000350  67xx                           beq.s   .played                 ; zero and no loop: the next call ends
  513  00000352  276B001C0004                   move.l  YX6_LOOPLEN(a3),YX6_LEFTFR(a3)
  514  00000358  7001                           moveq   #1,d0                   ; played, and wrapped to the loop point
  515  0000035A  4E75                           rts
  516                                   .played:
  517  0000035C  7000                           moveq   #0,d0
  518  0000035E  4E75                           rts
  519                                   
  520                                   ; -----------------------------------------------------------------------------
  521                                   ; YX6_stop: silence the three voices. Leaves the tone and envelope settings
  522                                   ; alone, so a later YX6_play picks up where it left off.
  523                                   ; -----------------------------------------------------------------------------
  524                                   YX6_stop:
  525  00000360  41F9FFFF8800                   lea     YX6_PSG,a0
  526  00000366  7008                           moveq   #8,d0                   ; R8, R9, R10 are the voice volumes
  527                                   .silence:
  528  00000368  1080                           move.b  d0,(a0)
  529  0000036A  42280002                       clr.b   2(a0)
  530  0000036E  5200                           addq.b  #1,d0
  531  00000370  B03C000B                       cmp.b   #11,d0
  532  00000374  66F2                           bne.s   .silence
  533  00000376  4E75                           rts
    3                                           include "ST4_wrap.S"
    1                                   ; -----------------------------------------------------------------------------
    2                                   ; ST4_wrap.S - ST4: counted-wrap ring decompressor for the Atari ST (68000)
    3                                   ;
    4                                   ; By Robbert van Dalen, based on ZX1 v1.5 by Einar Saukas and on ST1_wrap.S,
    5                                   ; which this follows instruction for instruction wherever the format allows.
    6                                   ; Written by Claude (Anthropic's Claude Code) under Robbert's direction. Use it
    7                                   ; freely, including commercially, as long as your documentation says you used
    8                                   ; ZX1 through ST4 (see LICENSE).
    9                                   ;
   10                                   ; ST4_wrap is ST1_wrap with ST4's three streams and units: the literal payload
   11                                   ; comes from stream B in a2 and the offsets from stream C in a4 (bytes) or D in
   12                                   ; a5 (words), lengths and budgets count units of ST4_UNIT bytes, and the copy
   13                                   ; moves a unit at a time. With the offsets gone, stream A holds nothing but
   14                                   ; bits, so the queue refills a word at a time. Set the unit size before
   15                                   ; including:
   16                                   ;
   17                                   ;       ST4_UNIT    equ     4
   18                                   ;               include "ST4_wrap.S"
   19                                   ;
   20                                   ; !!! LIKE ST1_wrap, THIS HAS NO DONE STATE !!!
   21                                   ; The caller must know the exact output size O in units, make exactly
   22                                   ; T = ceil(O/C) decode calls, and never call again.
   23                                   ;
   24                                   ; The ring is N BYTES and must be a whole number of units; the caller resets a1
   25                                   ; to the ring start after every F = N/(C*UNIT) calls. Budgets and remaining
   26                                   ; counts are units; offsets, positions and N are bytes - which is what keeps
   27                                   ; the wrap arithmetic identical to ST1_wrap's.
   28                                   ;
   29                                   ; The container is ST4.S's: twenty bytes of header - signature, O, and where
   30                                   ; streams B, C and D begin - then A, B, C and D in order. See ST4.S for the
   31                                   ; eight instructions that open one.
   32                                   ;
   33                                   ; THE STATE IS YOUR REGISTERS:
   34                                   ;
   35                                   ;   a0.l  position in stream A          a1.l  write pointer
   36                                   ;   a2.l  position in stream B          a4.l  stream C, the byte offsets
   37                                   ;   a5.l  stream D, the word offsets    d0.w  bit queue ($8000 empty)
   38                                   ;   d1.l  -ring_start.low : units remaining
   39                                   ;   d2.l  N : signed byte offset (+lastOffset*UNIT literals, - during a match)
   40                                   ;
   41                                   ;   resume in    d3.w   this call's budget in UNITS
   42                                   ;   CLOBBERED    d3.w d4.l d5.l a3.l
   43                                   ;   untouched    d6 d7 a6
   44                                   ;
   45                                   ; ASSUMPTIONS (unchecked; violating them is undefined behaviour):
   46                                   ;
   47                                   ;   1. THE RING SIZE N IS A MULTIPLE OF ST4_UNIT, and the ring starts on a unit
   48                                   ;      boundary - as does the destination. A wide move would fault on an odd
   49                                   ;      address, and the caller's wrap has to land on a unit
   50                                   ;   2. N mod (C * ST4_UNIT) = 0, so F = N/(C*UNIT) calls fill the ring exactly
   51                                   ;   3. no offset exceeds 32512 BYTES - the packer clamps -m to that
   52                                   ;   4. no operation is longer than 65535 units - compress with -l65535
   53                                   ;   5. the caller knows O and makes exactly T = ceil(O/C) calls, as ST1_wrap
   54                                   ;   6. streams A and D start on even addresses, and A holds an even number of
   55                                   ;      bytes: the bit queue is refilled with a move.w, and so is a word offset
   56                                   ;
   57                                   ; Compress with st4 -k<UNIT> -m<ring/UNIT> -l65535.
   58                                   ; -----------------------------------------------------------------------------
   59                                   
   60                                   ; The asset's signature for this build: 'S4', format version 4, and the unit
   61                                   ; size this decoder was assembled for. One cmp.l against a file's first long
   62                                   ; proves all three at once.
   63           =53340401               ST4_SIGNATURE   equ     $53340400+ST4_UNIT
   64                                   
   65                                   ; One unit copied, at the width this build was made for.
   66                                           .macro ST4_MOVE
   67                                 .         .if ST4_UNIT=4
   68                                 .         move.l  (a3)+,(a1)+
   69                                 .         .endif
   70                                 .         .if ST4_UNIT=2
   71                                 .         move.w  (a3)+,(a1)+
   72                                 .         .endif
   73                                 .         .if ST4_UNIT=1
   74                                 .         move.b  (a3)+,(a1)+
   75                                 .         .endif
   76                                 .         .endm
   77                                   
   78                                   ; Jump table: bra.w keeps 4-byte slots (base+0/4). A counted ring has no
   79                                   ; one-shot entry; the caller drains it through ST4_resume.
   80  00000378  6000xxxx                               bra.w   ST4_init
   81  0000037C  6000xxxx                               bra.w   ST4_resume
   82                                   
   83                                   ; ST4_init: a0 = A, a1 = first ring byte, a2 = B, a4 = C, a5 = D,
   84                                   ; d3.w = N.
   85                                   ; Packs -ring_start.low/N above the common state; writes no memory.
   86                                   ; Java: the Decompressor constructor / reset().
   87                                   ST4_init:
   88  00000380  7200                           moveq   #0,d1
   89  00000382  9249                           sub.w   a1,d1                   ; -ring_start.low, exact modulo 65536
   90  00000384  4841                           swap    d1                      ; pack it high; remaining = 0
   91                                   ; The initial offset has to land in the low word after the swap, so it starts
   92                                   ; in the high half. moveq would put -1 there whatever the unit size, which is
   93                                   ; a byte short at k=2 and three at k=4 - and only shows up on a stream whose
   94                                   ; first match reuses INITIAL_OFFSET.
   95  00000386  243CFFFF0000                   move.l  #(-ST4_UNIT)<<16,d2
   96  0000038C  3403                           move.w  d3,d2                   ; N lives below it for now
   97  0000038E  4842                           swap    d2                      ; N above, -INITIAL_OFFSET*UNIT below
   98  00000390  303C8000                       move.w  #$8000,d0               ; an empty bit queue: $8000 is the sentinel
   99  00000394  4E75                           rts
  100                                   
  101                                   source_wrapped:
  102  00000396  2A02                           move.l  d2,d5
  103  00000398  4245                           clr.w   d5
  104  0000039A  4845                           swap    d5                      ; zero-extend N from d2.high
  105  0000039C  D7C5                           adda.l  d5,a3                   ; raw source + N, back into the ring
  106  0000039E  60xx                           bra.s   copy
  107                                   
  108                                   ; ST4_resume: a0/a1/d0/d1/d2 = state and d3.w = this call's budget.
  109                                   ; Continuing calls emit d3 bytes; the final call may be shorter. The caller
  110                                   ; knows the final span from O; [old a1 .. new a1) is fresh output.
  111                                   ST4_resume:
  112  000003A0  4A41                           tst.w   d1                      ; only the first legal call has zero
  113  000003A2  67xx                           beq.s   begin_literals
  114  000003A4  3803                           move.w  d3,d4                   ; seed n from the nonzero budget
  115                                   segment:                                ; d1.w remaining >= 1, d3 budget >= 1
  116  000003A6  B841                           cmp.w   d1,d4                   ; n = min(budget, remaining)
  117  000003A8  63xx                           bls.s   budget_fits
  118  000003AA  3801                           move.w  d1,d4
  119                                   budget_fits:
  120  000003AC  4A42                           tst.w   d2                      ; positive lastOffset means LITERALS
  121  000003AE  6Axx                           bpl.s   literal_source
  122                                   ; MATCH: derive the source and split a segment that crosses the ring end.
  123  000003B0  2649                           movea.l a1,a3                   ; raw source = dst + -lastOffset*UNIT
  124  000003B2  D6C2                           adda.w  d2,a3                   ; which is why the offset is kept scaled
  125  000003B4  2A01                           move.l  d1,d5
  126  000003B6  4845                           swap    d5                      ; d5.w = -ring_start.low
  127  000003B8  DA49                           add.w   a1,d5                   ; d5.w = destination position
  128  000003BA  DA42                           add.w   d2,d5                   ; add -offset; carry means unwrapped
  129  000003BC  65xx                           bcs.s   copy                    ; unwrapped source cannot cross before dst
  130  000003BE  4445                           neg.w   d5                      ; wrapped: room = offset - position
  131                                   ; The room is bytes and the segment is units, so bring them to the same scale.
  132                                   ; Both are whole units - offsets and positions are - so the shift is exact.
  133                                           .if ST4_UNIT>1
  134                                 -         lsr.w   #1,d5
  135                                 -         .endif
  136                                           .if ST4_UNIT>2
  137                                 -         lsr.w   #1,d5
  138                                 -         .endif
  139  000003C0  BA44                           cmp.w   d4,d5                   ; source units before the ring end
  140  000003C2  64D2                           bcc.s   source_wrapped
  141  000003C4  3805                           move.w  d5,d4                   ; stop this segment at the source wrap
  142  000003C6  60CE                           bra.s   source_wrapped
  143                                   literal_source:
  144  000003C8  264A                           movea.l a2,a3                   ; literals copy from stream B
  145                                   copy:                                   ; Java: writeByte(...) - n moves total:
  146  000003CA  9244                           sub.w   d4,d1                   ; consume n from the operation
  147  000003CC  9644                           sub.w   d4,d3                   ; and from this call's budget
