  245  00000450  60CE                           bra.s   get_gamma
  246                                   
  247                                   class_refill:
  248  00000452  3018                           move.w  (a0)+,d0
  249  00000454  D140                           addx.w  d0,d0
  250  00000456  60EE                           bra.s   class_read
