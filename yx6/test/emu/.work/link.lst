  199                                   
  200                                   ; get_gamma: interlaced Elias gamma in d1.w; d4.w is the 0/1 length seed.
  201                                   ; Gammas are odd-length and each is followed by one flag bit, so a gamma always
  202                                   ; starts at an even position and the queue - which empties every 16 bits, also
  203                                   ; even - can only run out on a continuation bit. Data and transition reads need
  204                                   ; no refill check; 16 is even like 8, so the word queue inherits the argument.
  205                                   get_gamma:
  206  00000420  5241                           addq.w  #1,d1
  207  00000422  D040                           add.w   d0,d0                   ; first continuation bit
  208  00000424  67xx                           beq.s   gamma_refill
  209  00000426  64xx                           bcc.s   gamma_done
  210                                   gamma_loop:
  211  00000428  D040                           add.w   d0,d0                   ; data bit: never a refill
  212  0000042A  D341                           addx.w  d1,d1                   ; value = value*2 + bit
  213  0000042C  D040                           add.w   d0,d0                   ; continuation bit
  214  0000042E  67xx                           beq.s   gamma_refill
  215  00000430  65F6                           bcs.s   gamma_loop
  216                                   gamma_done:
  217  00000432  D244                           add.w   d4,d1                   ; +1 only for a new-offset match
  218  00000434  60E0                           bra.s   resume_fresh
  219                                   gamma_refill:
  220  00000436  3018                           move.w  (a0)+,d0
  221  00000438  D140                           addx.w  d0,d0
  222  0000043A  65EC                           bcs.s   gamma_loop
  223  0000043C  60F4                           bra.s   gamma_done
  224                                   
  225                                   match_transition:                       ; remaining == 0: parse after a match
  226  0000043E  D040                           add.w   d0,d0
  227  00000440  64DA                           bcc.s   begin_literals
  228                                   
  229                                   new_offset:                             ; Java: beginMatchFromNewOffset/readOffset
  230                                   ; Two class bits: the first says byte or word, the second picks a byte offset's
  231                                   ; 256-unit bank or, for a word, marks the end of the stream. That first bit is
  232                                   ; the only read here that can need a refill. Every operation is an even number
  233                                   ; of bits, so flags and gamma data bits all land on odd positions and the queue
  234                                   ; - which empties every 16 bits - can never run out on one; the bit immediately
  235                                   ; after a flag is the one exception, and it is checked.
  236  00000442  D040                           add.w   d0,d0                   ; class bit 1: set means a byte offset
  237  00000444  67xx                           beq.s   class_refill
  238                                   class_read:
  239  00000446  65xx                           bcs.s   byte_offset
  240  00000448  D040                           add.w   d0,d0                   ; class bit 2: set means end of stream
  241  0000044A  65CE                           bcs.s   resume_return
  242  0000044C  341D                           move.w  (a5)+,d2                ; -lastOffset*UNIT, stored ready to use
