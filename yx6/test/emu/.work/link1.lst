       00000342  14BC0000             @         move.b  #$0,(a2)           
       00000346  15510002             @         move.b  (a1),2(a2)              
  638  0000034A  D3C3                 @         adda.l  d3,a1
                                                YX6_WRITE 1
       0000034C  14BC0001             @         move.b  #$1,(a2)           
       00000350  15510002             @         move.b  (a1),2(a2)              
  639  00000354  D3C3                 @         adda.l  d3,a1
                                                YX6_WRITE 2                     ; channel B
       00000356  14BC0002             @         move.b  #$2,(a2)           
