 1122  00000754  4E75                           rts
 1123                                   
 1124                                   ; -----------------------------------------------------------------------------
 1125                                   ; yx6_drum_start: read the sample number from the drummed voice's ring byte
 1126                                   ; and silence that byte - it is a number, not a volume - flag the voice for
 1127                                   ; the mixer pass, then arm the drum routine: its select register, its sample
 1128                                   ; address, and the flag-clearing mask, all patched into its own operands.
 1129                                   ; If the other slot holds a SID on this same voice, the drum takes the
 1130                                   ; volume register for itself, as the reference player's drum override does:
 1131                                   ; stop that SID's timer and clear its last code, so the slot retries every
 1132                                   ; frame - suppressed while the flag is up - and restarts the SID by itself
 1133                                   ; the frame after the drum ends.
 1134                                   ; Called from the new-code path AND the held retrigger, which has neither
 1135                                   ; the voice nor the parameter pointer at hand - so it derives its own.
 1136                                   ; in: d0.b = E, a5 = the descriptor, SD_PARM set; out: a0 = the handler;
 1137                                   ; keeps d0/d1/d3/a5.
 1138                                   ; -----------------------------------------------------------------------------
 1139                                   yx6_drum_start:
 1140  00000756  2053                           movea.l YX6_CURSOR(a3),a0
 1141  00000758  D1ED0008                       adda.l  SD_PARM(a5),a0
 1142  0000075C  6100xxxx                       bsr     yx6_borrow              ; the ring gets this byte back
 1143  00000760  7800                           moveq   #0,d4
 1144  00000762  1810                           move.b  (a0),d4                 ; the sample number, validated at pack
 1145  00000764  4210                           clr.b   (a0)                    ; sanitize: silence, not a number
 1146  00000766  1A00                           move.b  d0,d5
 1147  00000768  E80D                           lsr.b   #4,d5
 1148  0000076A  CA7C0003                       and.w   #3,d5
 1149  0000076E  5345                           subq.w  #1,d5                   ; the voice, for flag and select
 1150  00000770  7401                           moveq   #1,d2
 1151  00000772  EB2A                           lsl.b   d5,d2
 1152  00000774  41FAFEAA                       lea     yx6_drums(pc),a0
 1153  00000778  8510                           or.b    d2,(a0)                 ; the mixer pass forces this voice off
 1154  0000077A  4602                           not.b   d2
 1155  0000077C  226D000C                       movea.l SD_ISR(a5),a1
 1156  00000780  13420037                       move.b  d2,ISR_CLEAR(a1)        ; the end tick drops the same flag
 1157  00000784  286D0010                       movea.l SD_OTHER(a5),a4         ; a SID on this voice in the other
 1158  00000788  1414                           move.b  (a4),d2                 ; slot: the drum takes the register
 1159  0000078A  C43C00C0                       and.b   #$C0,d2
 1160  0000078E  66xx                           bne.s   .keep
 1161  00000790  1414                           move.b  (a4),d2
 1162  00000792  B102                           eor.b   d0,d2
 1163  00000794  C43C0030                       and.b   #$30,d2
 1164  00000798  66xx                           bne.s   .keep
 1165  0000079A  306C0002                       movea.w SD_CTRL(a4),a0
 1166  0000079E  021000F0                       andi.b  #$F0,(a0)               ; stop the other slot's SID
 1167  000007A2  4214                           clr.b   (a4)                    ; and let it retry every frame
 1168                                   .keep:
 1169  000007A4  3405                           move.w  d5,d2
 1170  000007A6  5042                           addq.w  #8,d2                   ; the voice's volume register
 1171  000007A8  13420003                       move.b  d2,ISR_DRUM_SEL(a1)     ; the tick's select immediate
 1172  000007AC  D844                           add.w   d4,d4                   ; a drum table entry is six bytes:
 1173  000007AE  3404                           move.w  d4,d2                   ; 6n = 2n + 4n
 1174  000007B0  D844                           add.w   d4,d4
 1175  000007B2  D842                           add.w   d2,d4
 1176  000007B4  246B0014                       movea.l YX6_FILE(a3),a2
 1177  000007B8  204A                           movea.l a2,a0
 1178  000007BA  D1E8001C                       adda.l  YH_DRUMS(a0),a0
 1179  000007BE  24304000                       move.l  0(a0,d4.w),d2           ; the sample's offset in the file
 1180  000007C2  D48A                           add.l   a2,d2
 1181  000007C4  23420008                       move.l  d2,ISR_DRUM_PTR(a1)     ; the tick reads through its operand
 1182  000007C8  2049                           movea.l a1,a0                   ; the handler is the block base
 1183  000007CA  4E75                           rts
 1184                                   
 1185                                   ; Records a ring byte about to be edited, for the restore after the burst.
 1186                                   ; in: a0 = the byte; clobbers d2.
 1187                                   yx6_borrow:
 1188  000007CC  7400                           moveq   #0,d2
 1189  000007CE  142B0043                       move.b  YX6_PATCHES(a3),d2
 1190  000007D2  522B0043                       addq.b  #1,YX6_PATCHES(a3)
 1191  000007D6  17902044                       move.b  (a0),YX6_PATCH_VAL(a3,d2.w)
 1192  000007DA  D442                           add.w   d2,d2
 1193  000007DC  D442                           add.w   d2,d2
 1194  000007DE  27882048                       move.l  a0,YX6_PATCH_ADDR(a3,d2.w)
 1195  000007E2  4E75                           rts
    3                                           include "ST4_wrap.S"
    1                                   ; -----------------------------------------------------------------------------
    2                                   ; ST4_wrap.S - ST4: counted-wrap ring decompressor for the Atari ST (68000)
    3                                   ;
    4                                   ; By Robbert van Dalen, based on ZX1 v1.5 by Einar Saukas and on ST1_wrap.S,
    5                                   ; which this follows instruction for instruction wherever the format allows.
    6                                   ; Written by Claude (Anthropic's Claude Code) under Robbert's direction. Use it
    7                                   ; freely, including commercially, as long as your documentation says you used
    8                                   ; ZX1 through ST4 (see LICENSE).
    9                                   ;
   10                                   ; ST4_wrap is ST1_wrap with ST4's three streams and units: the literal payload
   11                                   ; comes from stream B in a2 and the offsets from stream C in a4 (bytes) or D in
   12                                   ; a5 (words), lengths and budgets count units of ST4_UNIT bytes, and the copy
   13                                   ; moves a unit at a time. With the offsets gone, stream A holds nothing but
   14                                   ; bits, so the queue refills a word at a time. Set the unit size before
   15                                   ; including:
   16                                   ;
   17                                   ;       ST4_UNIT    equ     4
   18                                   ;               include "ST4_wrap.S"
   19                                   ;
   20                                   ; !!! LIKE ST1_wrap, THIS HAS NO DONE STATE !!!
   21                                   ; The caller must know the exact output size O in units, make exactly
   22                                   ; T = ceil(O/C) decode calls, and never call again.
   23                                   ;
   24                                   ; The ring is N BYTES and must be a whole number of units; the caller resets a1
   25                                   ; to the ring start after every F = N/(C*UNIT) calls. Budgets and remaining
   26                                   ; counts are units; offsets, positions and N are bytes - which is what keeps
   27                                   ; the wrap arithmetic identical to ST1_wrap's.
   28                                   ;
   29                                   ; The copy engine runs two ladders. Match segments of at most sixteen units -
   30                                   ; measured to be four of every five segments a small-budget streamer makes,
   31                                   ; with the whole-chunk segment the most common of all - take a counter-free
   32                                   ; ladder that falls straight into the match epilogue: no full-pass shift, no
   33                                   ; loop counter, no post-copy kind test. Literals and longer segments take the
   34                                   ; classic counted ladder. And there is no first-call test: ST4_init seeds the
   35                                   ; bit queue with one virtual 0 flag ($4000), so a fresh state decodes itself
   36                                   ; through a zero-unit match segment and reads that flag as "begin literals"
   37                                   ; exactly where the old entry branch went.
   38                                   ;
   39                                   ; The container is ST4.S's: twenty bytes of header - signature, O, and where
   40                                   ; streams B, C and D begin - then A, B, C and D in order. See ST4.S for the
   41                                   ; eight instructions that open one.
   42                                   ;
   43                                   ; THE STATE IS YOUR REGISTERS:
   44                                   ;
   45                                   ;   a0.l  position in stream A          a1.l  write pointer
   46                                   ;   a2.l  position in stream B          a4.l  stream C, the byte offsets
   47                                   ;   a5.l  stream D, the word offsets    d0.w  bit queue ($8000 empty)
   48                                   ;   d1.l  -ring_start.low : units remaining
   49                                   ;   d2.l  N : signed byte offset (+lastOffset*UNIT literals, - during a match)
   50                                   ;
   51                                   ;   resume in    d3.w   this call's budget in UNITS
   52                                   ;   CLOBBERED    d3.w d4.l d5.l a3.l
   53                                   ;   untouched    d6 d7 a6
   54                                   ;
   55                                   ; ASSUMPTIONS (unchecked; violating them is undefined behaviour):
   56                                   ;
   57                                   ;   1. THE RING SIZE N IS A MULTIPLE OF ST4_UNIT, and the ring starts on a unit
   58                                   ;      boundary - as does the destination. A wide move would fault on an odd
   59                                   ;      address, and the caller's wrap has to land on a unit
   60                                   ;   2. N mod (C * ST4_UNIT) = 0, so F = N/(C*UNIT) calls fill the ring exactly
   61                                   ;   3. no offset exceeds 32512 BYTES - the packer clamps -m to that
   62                                   ;   4. no operation is longer than 65535 units - compress with -l65535
   63                                   ;   5. the caller knows O and makes exactly T = ceil(O/C) calls, as ST1_wrap
   64                                   ;   6. streams A and D start on even addresses, and A holds an even number of
   65                                   ;      bytes: the bit queue is refilled with a move.w, and so is a word offset
   66                                   ;
   67                                   ; Compress with st4 -k<UNIT> -m<ring/UNIT> -l65535.
   68                                   ; -----------------------------------------------------------------------------
   69                                   
   70                                   ; The asset's signature for this build: 'S4', format version 4, and the unit
   71                                   ; size this decoder was assembled for. One cmp.l against a file's first long
   72                                   ; proves all three at once.
   73           =53340401               ST4_SIGNATURE   equ     $53340400+ST4_UNIT
   74                                   
   75                                   ; One unit copied, at the width this build was made for.
   76                                           .macro ST4_MOVE
   77                                 .         .if ST4_UNIT=4
   78                                 .         move.l  (a3)+,(a1)+
   79                                 .         .endif
   80                                 .         .if ST4_UNIT=2
   81                                 .         move.w  (a3)+,(a1)+
   82                                 .         .endif
   83                                 .         .if ST4_UNIT=1
   84                                 .         move.b  (a3)+,(a1)+
   85                                 .         .endif
   86                                 .         .endm
   87                                   
   88                                   ; Jump table: bra.w keeps 4-byte slots (base+0/4). A counted ring has no
   89                                   ; one-shot entry; the caller drains it through ST4_resume.
   90  000007E4  6000xxxx                               bra.w   ST4_init
   91  000007E8  6000xxxx                               bra.w   ST4_resume
   92                                   
   93                                   ; ST4_init: a0 = A, a1 = first ring byte, a2 = B, a4 = C, a5 = D,
   94                                   ; d3.w = N.
   95                                   ; Packs -ring_start.low/N above the common state; writes no memory.
   96                                   ; Java: the Decompressor constructor / reset().
   97                                   ST4_init:
   98  000007EC  7200                           moveq   #0,d1
   99  000007EE  9249                           sub.w   a1,d1                   ; -ring_start.low, exact modulo 65536
  100  000007F0  4841                           swap    d1                      ; pack it high; remaining = 0
  101                                   ; The initial offset has to land in the low word after the swap, so it starts
  102                                   ; in the high half. moveq would put -1 there whatever the unit size, which is
  103                                   ; a byte short at k=2 and three at k=4 - and only shows up on a stream whose
  104                                   ; first match reuses INITIAL_OFFSET.
  105  000007F2  243CFFFF0000                   move.l  #(-ST4_UNIT)<<16,d2
  106  000007F8  3403                           move.w  d3,d2                   ; N lives below it for now
  107  000007FA  4842                           swap    d2                      ; N above, -INITIAL_OFFSET*UNIT below
  108                                   ; One virtual 0 flag, then the empty sentinel. The first resume call runs a
  109                                   ; zero-unit match segment through the normal path - remaining is zero, so
  110                                   ; n = 0 and the ladder is entered at its end - and lands in match_transition,
  111                                   ; which shifts $4000 into $8000: the flag reads as "begin literals" and the
  112                                   ; queue is the empty sentinel the old first call started from. That is what
  113                                   ; lets ST4_resume skip a first-call test on every call.
  114  000007FC  303C4000                       move.w  #$4000,d0
  115  00000800  4E75                           rts
  116                                   
  117                                   source_wrapped:
  118  00000802  2A02                           move.l  d2,d5
  119  00000804  4245                           clr.w   d5
  120  00000806  4845                           swap    d5                      ; zero-extend N from d2.high
  121  00000808  D7C5                           adda.l  d5,a3                   ; raw source + N, back into the ring
  122  0000080A  60xx                           bra.s   copy
  123                                   
  124                                   ; ST4_resume: a0/a1/d0/d1/d2 = state and d3.w = this call's budget.
  125                                   ; Continuing calls emit d3 bytes; the final call may be shorter. The caller
  126                                   ; knows the final span from O; [old a1 .. new a1) is fresh output.
  127                                   ST4_resume:
  128  0000080C  3803                           move.w  d3,d4                   ; seed n from the budget; a fresh state
  129                                   segment:                                ; runs one 0-unit match segment and
  130  0000080E  B841                           cmp.w   d1,d4                   ; reads the seeded flag afterwards.
  131  00000810  63xx                           bls.s   budget_fits             ; n = min(budget, remaining)
  132  00000812  3801                           move.w  d1,d4
  133                                   budget_fits:
  134  00000814  4A42                           tst.w   d2                      ; positive lastOffset means LITERALS
  135  00000816  6Axx                           bpl.s   literal_source
  136                                   ; MATCH: derive the source and split a segment that crosses the ring end.
  137  00000818  2649                           movea.l a1,a3                   ; raw source = dst + -lastOffset*UNIT
  138  0000081A  D6C2                           adda.w  d2,a3                   ; which is why the offset is kept scaled
  139  0000081C  2A01                           move.l  d1,d5
  140  0000081E  4845                           swap    d5                      ; d5.w = -ring_start.low
  141  00000820  DA49                           add.w   a1,d5                   ; d5.w = destination position
  142  00000822  DA42                           add.w   d2,d5                   ; add -offset; carry means unwrapped
  143  00000824  65xx                           bcs.s   copy                    ; unwrapped source cannot cross before dst
  144  00000826  4445                           neg.w   d5                      ; wrapped: room = offset - position
  145                                   ; The room is bytes and the segment is units, so bring them to the same scale.
  146                                   ; Both are whole units - offsets and positions are - so the shift is exact.
  147                                           .if ST4_UNIT=2
  148                                 -         lsr.w   #1,d5
  149                                 -         .endif
  150                                           .if ST4_UNIT=4
  151                                 -         lsr.w   #2,d5              ; one shift, not two: 10 cycles, not 16
  152                                 -         .endif
  153  00000828  BA44                           cmp.w   d4,d5                   ; source units before the ring end
  154  0000082A  64D6                           bcc.s   source_wrapped
  155  0000082C  3805                           move.w  d5,d4                   ; stop this segment at the source wrap
  156  0000082E  60D2                           bra.s   source_wrapped
  157                                   
  158                                   copy:                                   ; MATCH copies only reach this entry
  159  00000830  9244                           sub.w   d4,d1                   ; consume n from the operation
  160  00000832  9644                           sub.w   d4,d3                   ; and from this call's budget
  161  00000834  B87C0011                       cmp.w   #17,d4
  162  00000838  64xx                           bcc.s   copy_slow               ; n >= 17: the counted ladder
  163  0000083A  D844                           add.w   d4,d4
  164  0000083C  4444                           neg.w   d4                      ; d4 = -2n is the dispatch index itself,
  165  0000083E  4EFB40xx                       jmp     fast_end(pc,d4.w)       ; and $ffxx for byte_offset afterwards
  166                                   fast_ladder:
  167                                   ; Sixteen unit moves: entry at fast_end-2k copies k units.
  168                                           .rept   16
  169                                 #         ST4_MOVE
                                      #         .endr
                                      #         ST4_MOVE
                                      @         .if ST4_UNIT=4
                                      -         move.l  (a3)+,(a1)+
                                      -         .endif
                                      @         .if ST4_UNIT=2
                                      -         move.w  (a3)+,(a1)+
                                      -         .endif
                                      @         .if ST4_UNIT=1
       00000842  12DB                 @         move.b  (a3)+,(a1)+
                                      @         .endif
                                      #         ST4_MOVE
                                      @         .if ST4_UNIT=4
                                      -         move.l  (a3)+,(a1)+
                                      -         .endif
                                      @         .if ST4_UNIT=2
                                      -         move.w  (a3)+,(a1)+
                                      -         .endif
                                      @         .if ST4_UNIT=1
       00000844  12DB                 @         move.b  (a3)+,(a1)+
                                      @         .endif
                                      #         ST4_MOVE
                                      @         .if ST4_UNIT=4
                                      -         move.l  (a3)+,(a1)+
                                      -         .endif
                                      @         .if ST4_UNIT=2
