  522                                   ; -----------------------------------------------------------------------------
  523                                   ; YX6_start_loop: a2 = state block. Starts this register's loop stream over -
  524                                   ; a fresh decoder, reading from the top of the loop section, still writing
  525                                   ; where the last one stopped. ST4_init wants the ring start so that its packed
  526                                   ; metadata comes out right; the write pointer is restored from the block, which
  527                                   ; is why it is stored rather than held in a register.
  528                                   ; -----------------------------------------------------------------------------
  529                                   ; It runs inside YX6_fill, which guarantees d6 = the state block and a6 = the
  530                                   ; workspace - the two anchors that survive the decoder call.
  531                                   YX6_start_loop:
  532  00000260  200A                           move.l  a2,d0
  533  00000262  908B                           sub.l   a3,d0
  534  00000264  907C0046                       sub.w   #YX6_STATE,d0
  535  00000268  E848                           lsr.w   #4,d0                   ; k * 64 becomes k * 4, a table index
  536  0000026A  206B0014                       movea.l YX6_FILE(a3),a0
  537  0000026E  2030006A                       move.l  YH_LOOP_TABLE(a0,d0.w),d0
  538  00000272  67xx                           beq.s   .no_loop                ; this tune has no loop section
  539  00000274  D1C0                           adda.l  d0,a0                   ; the loop section's ST4 container
  540  00000276  226A0020                       movea.l YS_START(a2),a1         ; read before a2 becomes stream B
  541  0000027A  61xx                           bsr.s   yx6_open
  542  0000027C  264E                           movea.l a6,a3                   ; the decoder clobbered the workspace
  543  0000027E  CD8A                           exg     a2,d6                   ; a2 = the block again, d6 = stream B
  544  00000280  25480008                       move.l  a0,YS_INPUT(a2)
  545  00000284  25460010                       move.l  d6,YS_LIT(a2)
  546  00000288  254C0014                       move.l  a4,YS_BOFF(a2)
  547  0000028C  254D0018                       move.l  a5,YS_WOFF(a2)
  548  00000290  3540001C                       move.w  d0,YS_QUEUE(a2)
  549  00000294  2481                           move.l  d1,YS_D1(a2)
  550  00000296  25420004                       move.l  d2,YS_D2(a2)
  551  0000029A  256B001C0028                   move.l  YX6_LOOPLEN(a3),YS_LEFT(a2)
  552  000002A0  2C0A                           move.l  a2,d6                   ; the block pointer, as fill keeps it
  553                                   .no_loop:
  554  000002A2  4E75                           rts
