  457                                   ; -----------------------------------------------------------------------------
  458                                   ; YX6_fill: d0.w = stream index * YX6_STATE_SIZE, d3.w = values wanted.
  459                                   ; Produces exactly that many values for one register, crossing into the loop
  460                                   ; section - and around it again - as often as it takes. Straddling matters even
  461                                   ; for one group: nothing says the loop frame falls on a group boundary.
  462                                   ; -----------------------------------------------------------------------------
  463                                   YX6_fill:
  464  000001EC  48E70302                       movem.l d6-d7/a6,-(sp)          ; three registers that survive a decoder
  465  000001F0  45F30046                       lea     YX6_STATE(a3,d0.w),a2   ; call, which its own state needs
  466  000001F4  2C4B                           movea.l a3,a6                   ; ST4 clobbers a3: a6 keeps the workspace
  467  000001F6  2C0A                           move.l  a2,d6
  468  000001F8  7E00                           moveq   #0,d7
  469  000001FA  3E03                           move.w  d3,d7                   ; values still wanted
  470                                   .piece:
  471  000001FC  202A0028                       move.l  YS_LEFT(a2),d0
  472  00000200  66xx                           bne.s   .section
  473  00000202  6100xxxx                       bsr     YX6_start_loop          ; this section ran out: go round again
  474  00000206  202A0028                       move.l  YS_LEFT(a2),d0
  475  0000020A  67xx                           beq.s   .done                   ; nothing to go round to; do not hang
  476                                   .section:
  477  0000020C  B087                           cmp.l   d7,d0
  478  0000020E  65xx                           bcs.s   .piece_size
  479  00000210  2007                           move.l  d7,d0                   ; the section covers all that is wanted
  480                                   .piece_size:
  481  00000212  91AA0028                       sub.l   d0,YS_LEFT(a2)
  482  00000216  9E80                           sub.l   d0,d7
  483  00000218  3600                           move.w  d0,d3                   ; a piece is at most C, so it fits a word
  484                                   ; The decoder's budget counts units of ST4_UNIT bytes. The packer enforces
  485                                   ; that every piece boundary - C, the loop frame, the tune length - is a whole
  486                                   ; number of units, so this shift never drops a remainder.
  487                                           .if ST4_UNIT=2
  488                                 -         lsr.w   #1,d3
  489                                 -         .endif
  490                                           .if ST4_UNIT=4
  491                                 -         lsr.w   #2,d3
  492                                 -         .endif
  493                                   
  494                                   ; (a2) written out rather than YS_D1(a2): with +o3 rmac folds a zero
  495                                   ; displacement away on movem but keeps the addressing mode, and emits the
  496                                   ; instruction without its extension word. The next word becomes the
  497                                   ; displacement and the code runs off into nothing.
  498  0000021A  4CD20306                       movem.l (a2),d1-d2/a0-a1
  499  0000021E  286A0014                       movea.l YS_BOFF(a2),a4
  500  00000222  2A6A0018                       movea.l YS_WOFF(a2),a5
  501  00000226  302A001C                       move.w  YS_QUEUE(a2),d0
  502  0000022A  246A0010                       movea.l YS_LIT(a2),a2           ; loaded last: a2 was the base
  503  0000022E  6100xxxx                       bsr     ST4_resume
  504  00000232  264E                           movea.l a6,a3                   ; the decoder clobbered the workspace
  505  00000234  CD8A                           exg     a2,d6                   ; a2 = the block again, d6 = stream B
  506  00000236  B3EA0024                       cmpa.l  YS_END(a2),a1           ; YX6_save, inlined: this is the hot path
  507  0000023A  66xx                           bne.s   .stored
  508  0000023C  226A0020                       movea.l YS_START(a2),a1         ; the call landed on the ring end
  509                                   .stored:
  510  00000240  48D20306                       movem.l d1-d2/a0-a1,(a2)
  511  00000244  25460010                       move.l  d6,YS_LIT(a2)
  512  00000248  254C0014                       move.l  a4,YS_BOFF(a2)
  513  0000024C  254D0018                       move.l  a5,YS_WOFF(a2)
  514  00000250  3540001C                       move.w  d0,YS_QUEUE(a2)
  515  00000254  2C0A                           move.l  a2,d6                   ; the block pointer, back where fill keeps it
  516  00000256  4A87                           tst.l   d7
  517  00000258  66A2                           bne.s   .piece
  518                                   .done:
  519  0000025A  4CDF40C0                       movem.l (sp)+,d6-d7/a6
  520  0000025E  4E75                           rts
