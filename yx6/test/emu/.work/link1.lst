  678                                   ; the ring must stay exact decode history for every match yet to come.
  679  000003D2  102B0036                       move.b  YX6_PATCHES(a3),d0
  680  000003D6  67xx                           beq.s   .pristine
  681  000003D8  422B0036                       clr.b   YX6_PATCHES(a3)         ; cleared only when it was used
  682  000003DC  41EB003A                       lea     YX6_PATCH_ADDR(a3),a0
  683  000003E0  43EB0037                       lea     YX6_PATCH_VAL(a3),a1
  684                                   .restore:
  685  000003E4  2458                           movea.l (a0)+,a2
  686  000003E6  1499                           move.b  (a1)+,(a2)
  687  000003E8  5300                           subq.b  #1,d0
  688  000003EA  66F8                           bne.s   .restore
  689                                   .pristine:
  690                                   
  691                                   ; Refill the stream whose turn it is. Slots 18..C-1 exist when C is larger
  692                                   ; than the stream count; they simply have nothing to do.
  693  000003EC  302B0028                       move.w  YX6_SLOT(a3),d0
  694  000003F0  B07C0012                       cmp.w   #YX6_STREAMS,d0
  695  000003F4  64xx                           bcc.s   .advance
  696  000003F6  7600                           moveq   #0,d3
  697  000003F8  362B0026                       move.w  YX6_C(a3),d3            ; a whole group
  698  000003FC  4A6B002C                       tst.w   YX6_LOOPS(a3)
  699  00000400  66xx                           bne.s   .refill                 ; a looping tune never runs out
  700  00000402  222B0018                       move.l  YX6_TOTAL(a3),d1
  701  00000406  92AB0008                       sub.l   YX6_NEXT(a3),d1         ; values still packed
  702  0000040A  6Fxx                           ble.s   .advance                ; all decoded: never call ST4 again
  703  0000040C  B283                           cmp.l   d3,d1
  704  0000040E  64xx                           bcc.s   .refill
  705  00000410  2601                           move.l  d1,d3                   ; the last group is a short one
  706                                   .refill:
  707  00000412  ED48                           lsl.w   #6,d0
  708  00000414  6100FDD6                       bsr     YX6_fill
  709                                   
  710                                   .advance:
  711  00000418  5293                           addq.l  #1,YX6_CURSOR(a3)       ; one byte along every ring
  712  0000041A  2013                           move.l  YX6_CURSOR(a3),d0
  713  0000041C  B0AB000C                       cmp.l   YX6_RINGEND(a3),d0
  714  00000420  65xx                           bcs.s   .cursor_ready
  715  00000422  26AB0010                       move.l  YX6_RINGS(a3),YX6_CURSOR(a3)
  716                                   .cursor_ready:
  717  00000426  302B0028                       move.w  YX6_SLOT(a3),d0
  718  0000042A  5240                           addq.w  #1,d0
  719  0000042C  B06B0026                       cmp.w   YX6_C(a3),d0
  720  00000430  65xx                           bcs.s   .slot_ready
  721  00000432  7000                           moveq   #0,d0                   ; a cycle ended: the groups move on
  722  00000434  7200                           moveq   #0,d1
  723  00000436  322B0026                       move.w  YX6_C(a3),d1
  724  0000043A  D3AB0008                       add.l   d1,YX6_NEXT(a3)
  725                                   .slot_ready:
  726  0000043E  37400028                       move.w  d0,YX6_SLOT(a3)
  727                                   
  728                                   ; The rings hold the tune as one continuous sequence, so reaching the end of
  729                                   ; the last frame simply means the next values in them are the loop section's.
  730                                   ; The countdown follows: it reloads with the loop section's length.
  731  00000442  53AB0004                       subq.l  #1,YX6_LEFTFR(a3)
  732  00000446  66xx                           bne.s   .played
  733  00000448  4A6B002C                       tst.w   YX6_LOOPS(a3)
  734  0000044C  67xx                           beq.s   .played                 ; zero and no loop: the next call ends
  735  0000044E  276B001C0004                   move.l  YX6_LOOPLEN(a3),YX6_LEFTFR(a3)
  736  00000454  7001                           moveq   #1,d0                   ; played, and wrapped to the loop point
  737  00000456  4E75                           rts
  738                                   .played:
  739  00000458  7000                           moveq   #0,d0
  740  0000045A  4E75                           rts
  741                                   
  742                                   ; -----------------------------------------------------------------------------
  743                                   ; YX6_stop: a0 = workspace. Quiesces what YX6_init claimed - both timers
  744                                   ; stopped, their interrupts disabled and masked, pendings dropped - then
  745                                   ; silences the three voices. It restores NOTHING: the host that saved the
  746                                   ; machine state hands it back itself, after this returns. Tone and envelope
  747                                   ; settings stay, and a fresh YX6_init starts the tune over.
  748                                   ; -----------------------------------------------------------------------------
  749                                   YX6_stop:
  750  0000045C  2648                           movea.l a0,a3
  751  0000045E  40E7                           move.w  sr,-(sp)
  752  00000460  007C0700                       ori.w   #$0700,sr
  753  00000464  4238FA19                       clr.b   $FFFFFA19.w             ; both timers stopped,
  754  00000468  023800F0FA1D                   andi.b  #$F0,$FFFFFA1D.w
  755  0000046E  08B80005FA07                   bclr    #5,$FFFFFA07.w          ; disabled and masked - the claim
  756  00000474  08B80005FA13                   bclr    #5,$FFFFFA13.w          ; handed back bit by bit
  757  0000047A  08B80004FA09                   bclr    #4,$FFFFFA09.w
  758  00000480  08B80004FA15                   bclr    #4,$FFFFFA15.w
  759  00000486  08B80005FA0B                   bclr    #5,$FFFFFA0B.w          ; and no pending ticks of ours
  760  0000048C  08B80004FA0D                   bclr    #4,$FFFFFA0D.w
  761  00000492  41FAxxxx                       lea     yx6_drums(pc),a0
  762  00000496  4210                           clr.b   (a0)
  763                                   ; The silence stays inside the mask: selecting a register and writing it are
  764                                   ; two bus cycles, and a polite host's system interrupts - about to get their
  765                                   ; state back - use the chip too.
  766  00000498  41F9FFFF8800                   lea     YX6_PSG,a0
  767  0000049E  7008                           moveq   #8,d0                   ; R8, R9, R10 are the voice volumes
  768                                   .silence:
  769  000004A0  1080                           move.b  d0,(a0)
  770  000004A2  42280002                       clr.b   2(a0)
  771  000004A6  5200                           addq.b  #1,d0
  772  000004A8  B03C000B                       cmp.b   #11,d0
  773  000004AC  66F2                           bne.s   .silence
  774  000004AE  46DF                           move.w  (sp)+,sr
  775  000004B0  4E75                           rts
  776                                   
  777                                   ; -----------------------------------------------------------------------------
  778                                   ; The effect machinery. The per-frame stage lives inlined in YX6_play; what
  779                                   ; follows is everything it drives: the two slot descriptors, the tick
  780                                   ; handlers, and the one slot machine that serves both timers.
  781                                   ; -----------------------------------------------------------------------------
  782                                   
  783                                   ; The slot descriptors - see the SD_ equates. Slot 1 owns Timer A, slot 2
  784                                   ; Timer D, whose control nibble is shared with Timer C and only ever changed
  785                                   ; read-modify-write; the slot machine uses that form for both, which on
  786                                   ; Timer A writes the same values a clear would.
  787                                           even
  788                                   yx6_desc1:
  789  000004B2  0000                           dc.b    0,0                     ; E last, T last
  790  000004B4  FA19FA1F0134                   dc.w    $FA19,$FA1F,$0134       ; control, data, vector
  791  000004BA  00000000                       dc.l    0                       ; PARM, set per effect
  792  000004BE  0000000000000000               dc.l    0,0                     ; ISR block, other slot: yx6_link
  793                                   yx6_desc2:
  794  000004C6  0000                           dc.b    0,0
  795  000004C8  FA1DFA250110                   dc.w    $FA1D,$FA25,$0110
  796  000004CE  00000000                       dc.l    0
  797  000004D2  0000000000000000               dc.l    0,0
  798                                   
  799                                   ; -----------------------------------------------------------------------------
  800                                   ; The tick handlers, in maxYMiser's shipping forms: the PSG select and write
  801                                   ; in as few instructions as the bus allows, patched immediates instead of
  802                                   ; state, software end-of-interrupt as TOS runs the MFP - written as an
  803                                   ; immediate byte, since the in-service registers ignore written ones. All
  804                                   ; MFP interrupts arrive at 68000 level 6, so these never nest, and every
  805                                   ; patched operand is addressed pc-relatively so the player stays loadable
  806                                   ; anywhere - which also means it must run from RAM, where a demo lives.
  807                                   ;
  808                                   ; The two slots' handlers are the same text twice, and MUST stay
  809                                   ; byte-congruent: the slot machine and yx6_drum_start reach every patched
  810                                   ; operand through ISR_ offsets measured on the A block. The rig checks the
  811                                   ; congruence from the symbol table. The park entries - where YX6_init aims
  812                                   ; the vectors while no effect runs - are the handlers' own tails.
  813                                   ;
  814                                   ; The patch offsets are load-bearing:
  815                                   ;   drum:  select immediate at +3, sample address at +8, flag mask at _clear+3
  816                                   ;   sid:   select at +2 and volume at +4 inside the imm long; the partner's
  817                                   ;          address low word at +10, patched once by yx6_link
  818                                   ;   buzz:  the shape at +4
  819                                   ; The SID vector swap patches the vector's LOW word only, so the two halves
  820                                   ; of a block must share their address high word: keep the player inside one
  821                                   ; 64K segment - anywhere a program smaller than 64K naturally loads.
  822                                   ; -----------------------------------------------------------------------------
  823                                   
  824                                   ; One drum tick: the sample byte goes straight to the voice's volume register.
  825                                   ; The byte after the last has bit 7 set, so the same move answers "done": park
  826                                   ; the volume mid-scale against the click, stop the timer, drop the flag.
  827                                   yx6_drumA:
  828  000004DA  11FC00088800                   move.b  #8,$FFFF8800.w          ; SMC +3: select the drummed volume
  829  000004E0  11F9123456788802               move.b  $12345678,$FFFF8802.w   ; SMC +8: the next sample byte
  830  000004E8  6Bxx                           bmi.s   .ended
  831                                           .if YX6_SUPER_HOST
  832                                 -         move    a0,usp                  ; the USP is the host's spare register
  833                                 -         .else
  834  000004EA  2F08                           move.l  a0,-(sp)
  835                                           .endif
  836  000004EC  41FAFFF4                       lea     yx6_drumA+8(pc),a0
  837  000004F0  5290                           addq.l  #1,(a0)                 ; step the operand itself
  838                                           .if YX6_SUPER_HOST
  839                                 -         move    usp,a0
  840                                 -         .else
  841  000004F2  205F                           movea.l (sp)+,a0
  842                                           .endif
  843  000004F4  11FC00DFFA0F                   move.b  #$DF,$FFFFFA0F.w
  844  000004FA  4E73                           rte
  845                                   .ended:
  846  000004FC  11FC000D8802                   move.b  #$D,$FFFF8802.w         ; middle volume: no click
  847  00000502  023800F0FA19                   andi.b  #$F0,$FFFFFA19.w        ; the sample ran out: stop Timer A
  848                                           .if YX6_SUPER_HOST
  849                                 -         move    a0,usp
  850                                 -         .else
  851  00000508  2F08                           move.l  a0,-(sp)
  852                                           .endif
  853  0000050A  41FAxxxx                       lea     yx6_drums(pc),a0
  854                                   yx6_drumA_clear:
  855  0000050E  021000FF                       andi.b  #$FF,(a0)               ; SMC +3: drop the voice's drum flag
  856                                           .if YX6_SUPER_HOST
  857                                 -         move    usp,a0
  858                                 -         .else
  859  00000512  205F                           movea.l (sp)+,a0
  860                                           .endif
  861                                   yx6_parkA:
  862  00000514  11FC00DFFA0F                   move.b  #$DF,$FFFFFA0F.w
  863  0000051A  4E73                           rte
  864                                   
  865                                   ; The SID square: each tick writes one half of the square - the volume or
  866                                   ; silence - and installs the other half as the next tick, one word into the
  867                                   ; vector. Select and data land in one move.l: the immediate's bytes hit
  868                                   ; $8800 (select) and $8802 (data) by bus layout.
  869                                   yx6_sidA_on:
  870  0000051C  21FC08000F008800               move.l  #$08000F00,$FFFF8800.w  ; SMC +2 select, +4 volume
  871  00000524  31FC00000136                   move.w  #0,$136.w               ; SMC +10: the quiet half is next
  872  0000052A  11FC00DFFA0F                   move.b  #$DF,$FFFFFA0F.w
  873  00000530  4E73                           rte
  874                                   yx6_sidA_off:
  875  00000532  21FC080000008800               move.l  #$08000000,$FFFF8800.w  ; SMC +2 select; silence
  876  0000053A  31FC00000136                   move.w  #0,$136.w               ; SMC +10: the loud half is next
  877  00000540  11FC00DFFA0F                   move.b  #$DF,$FFFFFA0F.w
  878  00000546  4E73                           rte
  879                                   
  880                                   ; The sync-buzzer tick: writing the shape to R13 restarts the envelope, and
  881                                   ; that restart at the timer's rate is the whole effect.
  882                                   yx6_buzzA:
  883  00000548  21FC0D0000008800               move.l  #$0D000000,$FFFF8800.w  ; SMC +4: the shape
  884  00000550  11FC00DFFA0F                   move.b  #$DF,$FFFFFA0F.w
  885  00000556  4E73                           rte
  886                                   
  887                                   ; Slot 2's instances: Timer D's stop, vector and in-service bit, otherwise
  888                                   ; the A block byte for byte.
  889                                   yx6_drumD:
  890  00000558  11FC00088800                   move.b  #8,$FFFF8800.w
  891  0000055E  11F9123456788802               move.b  $12345678,$FFFF8802.w
  892  00000566  6Bxx                           bmi.s   .ended
  893                                           .if YX6_SUPER_HOST
  894                                 -         move    a0,usp
  895                                 -         .else
  896  00000568  2F08                           move.l  a0,-(sp)
  897                                           .endif
  898  0000056A  41FAFFF4                       lea     yx6_drumD+8(pc),a0
  899  0000056E  5290                           addq.l  #1,(a0)
  900                                           .if YX6_SUPER_HOST
  901                                 -         move    usp,a0
  902                                 -         .else
  903  00000570  205F                           movea.l (sp)+,a0
  904                                           .endif
  905  00000572  11FC00EFFA11                   move.b  #$EF,$FFFFFA11.w
  906  00000578  4E73                           rte
  907                                   .ended:
  908  0000057A  11FC000D8802                   move.b  #$D,$FFFF8802.w
  909  00000580  023800F0FA1D                   andi.b  #$F0,$FFFFFA1D.w
  910                                           .if YX6_SUPER_HOST
  911                                 -         move    a0,usp
  912                                 -         .else
  913  00000586  2F08                           move.l  a0,-(sp)
  914                                           .endif
  915  00000588  41FAxxxx                       lea     yx6_drums(pc),a0
  916                                   yx6_drumD_clear:
  917  0000058C  021000FF                       andi.b  #$FF,(a0)
  918                                           .if YX6_SUPER_HOST
  919                                 -         move    usp,a0
  920                                 -         .else
  921  00000590  205F                           movea.l (sp)+,a0
  922                                           .endif
  923                                   yx6_parkD:
  924  00000592  11FC00EFFA11                   move.b  #$EF,$FFFFFA11.w
  925  00000598  4E73                           rte
  926                                   
  927                                   yx6_sidD_on:
  928  0000059A  21FC08000F008800               move.l  #$08000F00,$FFFF8800.w
  929  000005A2  31FC00000112                   move.w  #0,$112.w
  930  000005A8  11FC00EFFA11                   move.b  #$EF,$FFFFFA11.w
  931  000005AE  4E73                           rte
  932                                   yx6_sidD_off:
  933  000005B0  21FC080000008800               move.l  #$08000000,$FFFF8800.w
  934  000005B8  31FC00000112                   move.w  #0,$112.w
  935  000005BE  11FC00EFFA11                   move.b  #$EF,$FFFFFA11.w
  936  000005C4  4E73                           rte
  937                                   
  938                                   yx6_buzzD:
  939  000005C6  21FC0D0000008800               move.l  #$0D000000,$FFFF8800.w
  940  000005CE  11FC00EFFA11                   move.b  #$EF,$FFFFFA11.w
  941  000005D4  4E73                           rte
  942                                   
  943                                   yx6_drums:
  944  000005D6  00                             dc.b    0                       ; voice bits 0-2: a drum is running
  945  000005D7  00                             even
  946                                   
  947                                   ; Where the patched operands sit, measured on the A block; the D block is
  948                                   ; byte-congruent, so the same offsets serve both through SD_ISR.
  949                                   ; rmac evaluates left to right: the parentheses are load-bearing.
  950           =00000003               ISR_DRUM_SEL    equ     3
  951           =00000008               ISR_DRUM_PTR    equ     8
  952           =00000037               ISR_CLEAR       equ     (yx6_drumA_clear-yx6_drumA)+3
  953           =00000042               ISR_SIDON       equ     yx6_sidA_on-yx6_drumA
  954           =00000044               ISR_SIDON_SEL   equ     ISR_SIDON+2
  955           =00000046               ISR_SID_VOL     equ     ISR_SIDON+4
  956           =0000004C               ISR_SIDON_NEXT  equ     ISR_SIDON+10
  957           =00000058               ISR_SIDOFF      equ     yx6_sidA_off-yx6_drumA
  958           =0000005A               ISR_SIDOFF_SEL  equ     ISR_SIDOFF+2
  959           =00000062               ISR_SIDOFF_NEXT equ     ISR_SIDOFF+10
  960           =0000006E               ISR_BUZZ        equ     yx6_buzzA-yx6_drumA
  961           =00000072               ISR_BUZZ_SHAPE  equ     ISR_BUZZ+4
  962                                   
  963                                   ; -----------------------------------------------------------------------------
  964                                   ; yx6_link, from YX6_init: the run-time addresses only a loaded player knows.
  965                                   ; Each descriptor gets its ISR block and its partner, both slots' last code
  966                                   ; and count are cleared, and the SID halves get each other's address low
  967                                   ; word - the vector's high word never changes, and neither do these, so
  968                                   ; they are patched once here rather than on every SID start.
  969                                   ; -----------------------------------------------------------------------------
  970                                   yx6_link:
  971  000005D8  41FAFED8                       lea     yx6_desc1(pc),a0
  972  000005DC  43FAFEE8                       lea     yx6_desc2(pc),a1
  973  000005E0  21490010                       move.l  a1,SD_OTHER(a0)
  974  000005E4  23480010                       move.l  a0,SD_OTHER(a1)
  975  000005E8  4250                           clr.w   (a0)                    ; E and T last, both slots
  976  000005EA  4251                           clr.w   (a1)
  977  000005EC  45FAFEEC                       lea     yx6_drumA(pc),a2
  978  000005F0  214A000C                       move.l  a2,SD_ISR(a0)
  979  000005F4  61xx                           bsr.s   .partners
  980  000005F6  45FAFF60                       lea     yx6_drumD(pc),a2
  981  000005FA  234A000C                       move.l  a2,SD_ISR(a1)
  982                                   .partners:
  983  000005FE  41EA0058                       lea     ISR_SIDOFF(a2),a0       ; each half installs the other
  984  00000602  2008                           move.l  a0,d0
  985  00000604  3540004C                       move.w  d0,ISR_SIDON_NEXT(a2)
  986  00000608  41EA0042                       lea     ISR_SIDON(a2),a0
  987  0000060C  2008                           move.l  a0,d0
  988  0000060E  35400062                       move.w  d0,ISR_SIDOFF_NEXT(a2)
  989  00000612  4E75                           rts
  990                                   
  991                                   ; -----------------------------------------------------------------------------
  992                                   ; yx6_slot: one slot of the effect stage - both slots, through a5.
  993                                   ; A changed code reprograms the slot's timer from scratch, a held one
  994                                   ; updates only the count (a running MFP timer loads it at its next reload),
  995                                   ; a dropped one stops the timer - unless the slot ran a drum, which
  996                                   ; finishes by itself. A held DRUM code is a trigger on EVERY frame it is
  997                                   ; present, as the reference player starts one on each coded frame: real
  998                                   ; dumps carry back-to-back codes whose ring bytes name different samples -
  999                                   ; an attack, then a body - and only a full restart plays the second one.
 1000                                   ;
 1001                                   ; in: d0.b = E (never 0 with E-last also 0: the caller's gate), d1.b = T,
 1002                                   ;     a5 = the slot's descriptor, a3 = workspace, d3.l = N.
 1003                                   ; preserves d3/a3/a5; clobbers d0-d2/d4-d5, a0-a2/a4.
 1004                                   ; -----------------------------------------------------------------------------
 1005                                   yx6_slot:
 1006  00000614  B015                           cmp.b   (a5),d0
 1007  00000616  6700xxxx                       beq.w   .held
 1008  0000061A  1815                           move.b  (a5),d4                 ; what the slot was doing before
 1009  0000061C  1A80                           move.b  d0,(a5)
 1010  0000061E  4A00                           tst.b   d0
 1011  00000620  6700xxxx                       beq.w   .released
 1012                                   ; A new code: find the parameter register's ring - r8+voice carries the SID
 1013                                   ; volume, the drum number or the buzzer shape - then let the type arm its
 1014                                   ; handler; every type then (re)programs the timer the same way. The voice
 1015                                   ; stays live in d5, the parameter byte in a1, for whoever needs them.
 1016  00000624  1A00                           move.b  d0,d5
 1017  00000626  E80D                           lsr.b   #4,d5
 1018  00000628  CA7C0003                       and.w   #3,d5
 1019  0000062C  5345                           subq.w  #1,d5                   ; the voice, 0..2
 1020  0000062E  3805                           move.w  d5,d4
 1021  00000630  5044                           addq.w  #8,d4
 1022  00000632  C8EB0024                       mulu.w  YX6_N(a3),d4
 1023  00000636  2B440008                       move.l  d4,SD_PARM(a5)
 1024  0000063A  2253                           movea.l YX6_CURSOR(a3),a1
 1025  0000063C  D3C4                           adda.l  d4,a1                   ; a1 = the slot's parameter byte
 1026  0000063E  1400                           move.b  d0,d2
 1027  00000640  C43C00C0                       and.b   #$C0,d2
 1028  00000644  67xx                           beq.s   .sid
 1029  00000646  B43C0040                       cmp.b   #$40,d2
 1030  0000064A  67xx                           beq.s   .drum
 1031  0000064C  1811                           move.b  (a1),d4                 ; $C0, the buzzer ($80 never packs):
 1032  0000064E  C83C000F                       and.b   #15,d4                  ; the shape rides the tick's immediate
 1033  00000652  206D000C                       movea.l SD_ISR(a5),a0
 1034  00000656  11440072                       move.b  d4,ISR_BUZZ_SHAPE(a0)
 1035  0000065A  41E8006E                       lea     ISR_BUZZ(a0),a0
 1036  0000065E  60xx                           bra.s   .armed
 1037                                   .sid:
 1038                                   ; While a drum owns this voice, its volume register is the drum's alone: the
 1039                                   ; SID stays un-armed and the cleared last-code makes every following frame
 1040                                   ; retry, so it comes back by itself the frame after the drum ends. That is
 1041                                   ; the reference player's priority, where the drum overrides the volume.
 1042  00000660  7801                           moveq   #1,d4
 1043  00000662  EB2C                           lsl.b   d5,d4
 1044  00000664  C83AFF70                       and.b   yx6_drums(pc),d4
 1045  00000668  67xx                           beq.s   .sid_free
 1046  0000066A  4215                           clr.b   (a5)
