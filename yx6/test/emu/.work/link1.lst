  449                                   ; -----------------------------------------------------------------------------
  450                                   ; YX6_fill: d0.w = stream index * YX6_STATE_SIZE, d3.w = values wanted.
  451                                   ; Produces exactly that many values for one register, crossing into the loop
  452                                   ; section - and around it again - as often as it takes. Straddling matters even
  453                                   ; for one group: nothing says the loop frame falls on a group boundary.
  454                                   ; -----------------------------------------------------------------------------
  455                                   YX6_fill:
  456  000001F8  48E70302                       movem.l d6-d7/a6,-(sp)          ; three registers that survive a decoder
  457  000001FC  45F30058                       lea     YX6_STATE(a3,d0.w),a2   ; call, which its own state needs
  458  00000200  2C4B                           movea.l a3,a6                   ; ST4 clobbers a3: a6 keeps the workspace
  459  00000202  2C0A                           move.l  a2,d6
  460  00000204  7E00                           moveq   #0,d7
  461  00000206  3E03                           move.w  d3,d7                   ; values still wanted
  462                                   .piece:
  463  00000208  202A0028                       move.l  YS_LEFT(a2),d0
  464  0000020C  66xx                           bne.s   .section
  465  0000020E  6100xxxx                       bsr     YX6_start_loop          ; this section ran out: go round again
  466  00000212  202A0028                       move.l  YS_LEFT(a2),d0
  467  00000216  67xx                           beq.s   .done                   ; nothing to go round to; do not hang
  468                                   .section:
  469  00000218  B087                           cmp.l   d7,d0
  470  0000021A  65xx                           bcs.s   .piece_size
  471  0000021C  2007                           move.l  d7,d0                   ; the section covers all that is wanted
  472                                   .piece_size:
  473  0000021E  91AA0028                       sub.l   d0,YS_LEFT(a2)
  474  00000222  9E80                           sub.l   d0,d7
  475  00000224  3600                           move.w  d0,d3                   ; a piece is at most C, so it fits a word
  476                                   ; The decoder's budget counts units of ST4_UNIT bytes. The packer enforces
  477                                   ; that every piece boundary - C, the loop frame, the tune length - is a whole
  478                                   ; number of units, so this shift never drops a remainder.
  479                                           .if ST4_UNIT=2
  480                                 -         lsr.w   #1,d3
  481                                 -         .endif
  482                                           .if ST4_UNIT=4
  483                                 -         lsr.w   #2,d3
  484                                 -         .endif
  485                                   
  486                                   ; (a2) written out rather than YS_D1(a2): with +o3 rmac folds a zero
  487                                   ; displacement away on movem but keeps the addressing mode, and emits the
  488                                   ; instruction without its extension word. The next word becomes the
  489                                   ; displacement and the code runs off into nothing.
  490  00000226  4CD20306                       movem.l (a2),d1-d2/a0-a1
  491  0000022A  286A0014                       movea.l YS_BOFF(a2),a4
  492  0000022E  2A6A0018                       movea.l YS_WOFF(a2),a5
  493  00000232  302A001C                       move.w  YS_QUEUE(a2),d0
  494  00000236  246A0010                       movea.l YS_LIT(a2),a2           ; loaded last: a2 was the base
  495  0000023A  6100xxxx                       bsr     ST4_resume
  496  0000023E  264E                           movea.l a6,a3                   ; the decoder clobbered the workspace
  497  00000240  CD8A                           exg     a2,d6                   ; a2 = the block again, d6 = stream B
  498  00000242  B3EA0024                       cmpa.l  YS_END(a2),a1           ; YX6_save, inlined: this is the hot path
  499  00000246  66xx                           bne.s   .stored
  500  00000248  226A0020                       movea.l YS_START(a2),a1         ; the call landed on the ring end
  501                                   .stored:
  502  0000024C  48D20306                       movem.l d1-d2/a0-a1,(a2)
  503  00000250  25460010                       move.l  d6,YS_LIT(a2)
  504  00000254  254C0014                       move.l  a4,YS_BOFF(a2)
  505  00000258  254D0018                       move.l  a5,YS_WOFF(a2)
  506  0000025C  3540001C                       move.w  d0,YS_QUEUE(a2)
  507  00000260  2C0A                           move.l  a2,d6                   ; the block pointer, back where fill keeps it
  508  00000262  4A87                           tst.l   d7
  509  00000264  66A2                           bne.s   .piece
  510                                   .done:
  511  00000266  4CDF40C0                       movem.l (sp)+,d6-d7/a6
  512  0000026A  4E75                           rts
  513                                   
  514                                   ; -----------------------------------------------------------------------------
  515                                   ; YX6_start_loop: a2 = state block. Starts this register's loop stream over -
  516                                   ; a fresh decoder, reading from the top of the loop section, still writing
  517                                   ; where the last one stopped. ST4_init wants the ring start so that its packed
  518                                   ; metadata comes out right; the write pointer is restored from the block, which
  519                                   ; is why it is stored rather than held in a register.
  520                                   ; -----------------------------------------------------------------------------
  521                                   ; It runs inside YX6_fill, which guarantees d6 = the state block and a6 = the
  522                                   ; workspace - the two anchors that survive the decoder call.
  523                                   YX6_start_loop:
  524  0000026C  200A                           move.l  a2,d0
  525  0000026E  908B                           sub.l   a3,d0
  526  00000270  907C0058                       sub.w   #YX6_STATE,d0
  527  00000274  E848                           lsr.w   #4,d0                   ; k * 64 becomes k * 4, a table index
  528  00000276  206B0014                       movea.l YX6_FILE(a3),a0
  529  0000027A  2030006A                       move.l  YH_LOOP_TABLE(a0,d0.w),d0
  530  0000027E  67xx                           beq.s   .no_loop                ; this tune has no loop section
  531  00000280  D1C0                           adda.l  d0,a0                   ; the loop section's ST4 container
  532  00000282  226A0020                       movea.l YS_START(a2),a1         ; read before a2 becomes stream B
  533  00000286  61xx                           bsr.s   yx6_open
  534  00000288  264E                           movea.l a6,a3                   ; the decoder clobbered the workspace
  535  0000028A  CD8A                           exg     a2,d6                   ; a2 = the block again, d6 = stream B
  536  0000028C  25480008                       move.l  a0,YS_INPUT(a2)
  537  00000290  25460010                       move.l  d6,YS_LIT(a2)
  538  00000294  254C0014                       move.l  a4,YS_BOFF(a2)
  539  00000298  254D0018                       move.l  a5,YS_WOFF(a2)
  540  0000029C  3540001C                       move.w  d0,YS_QUEUE(a2)
  541  000002A0  2481                           move.l  d1,YS_D1(a2)
  542  000002A2  25420004                       move.l  d2,YS_D2(a2)
  543  000002A6  256B001C0028                   move.l  YX6_LOOPLEN(a3),YS_LEFT(a2)
  544  000002AC  2C0A                           move.l  a2,d6                   ; the block pointer, as fill keeps it
  545                                   .no_loop:
  546  000002AE  4E75                           rts
  547                                   
  548                                   ; -----------------------------------------------------------------------------
  549                                   ; yx6_open: a0 = an ST4 container. Points the four stream registers at its
  550                                   ; streams - A begins where the header ends, B, C and D sit at the recorded
  551                                   ; header-relative offsets, exactly as ST4.S documents - and tail-calls
  552                                   ; ST4_init: its rts returns to yx6_open's caller with the decoder registers
  553                                   ; as ST4_init leaves them. ST4_init clobbers a3; callers restore it
  554                                   ; themselves, init from the stack and the loop restart from a6.
  555                                   ; -----------------------------------------------------------------------------
  556                                   yx6_open:
  557  000002B0  2448                           movea.l a0,a2
  558  000002B2  D5E80008                       adda.l  8(a0),a2                ; stream B, the literals
  559  000002B6  2848                           movea.l a0,a4
  560  000002B8  D9E8000C                       adda.l  12(a0),a4               ; stream C, the byte offsets
  561  000002BC  2A48                           movea.l a0,a5
  562  000002BE  DBE80010                       adda.l  16(a0),a5               ; stream D, the word offsets
  563  000002C2  41E80014                       lea     20(a0),a0               ; stream A, the bits
  564  000002C6  7600                           moveq   #0,d3
  565  000002C8  362B0024                       move.w  YX6_N(a3),d3            ; N, ST4_init's argument
  566  000002CC  6000xxxx                       bra     ST4_init
  567                                   
  568                                   ; -----------------------------------------------------------------------------
  569                                   ; YX6_play: a0 = workspace. One frame: run the effect stage, write fourteen
  570                                   ; registers, undo the stage's ring edits, refill one stream.
  571                                   ; -----------------------------------------------------------------------------
  572                                   YX6_play:
  573  000002D0  2648                           movea.l a0,a3
  574  000002D2  4AAB0004                       tst.l   YX6_LEFTFR(a3)
  575  000002D6  66xx                           bne.s   .frame
  576  000002D8  70FF                           moveq   #-1,d0                  ; past the last frame of a tune that
  577  000002DA  4E75                           rts                             ; does not loop: write nothing
  578                                   
  579                                   .frame:
  580  000002DC  7600                           moveq   #0,d3
  581  000002DE  362B0024                       move.w  YX6_N(a3),d3            ; one ring to the next
  582                                   
  583                                   ; The effect stage, inlined: it runs BEFORE the burst so it may rewrite this
  584                                   ; frame's ring bytes. Each slot is gated on E | E-last: a slot that has, and
  585                                   ; had, nothing to do costs one test - the common frame. A slot machine call
  586                                   ; therefore always means something changed, holds, or just ended; yx6_slot's
  587                                   ; held path leans on that (E is never 0 there).
  588  000002E2  2053                           movea.l YX6_CURSOR(a3),a0
  589  000002E4  D1EB002E                       adda.l  YX6_EFXOFF(a3),a0       ; ring E1, at this frame's offset
  590  000002E8  4BFAxxxx                       lea     yx6_desc1(pc),a5
  591  000002EC  1010                           move.b  (a0),d0                 ; E1 | its last code: zero is idle
  592  000002EE  8015                           or.b    (a5),d0
  593  000002F0  67xx                           beq.s   .slot1_idle
  594  000002F2  1010                           move.b  (a0),d0                 ; the real E1
  595  000002F4  D1C3                           adda.l  d3,a0
  596  000002F6  1210                           move.b  (a0),d1                 ; T1
  597  000002F8  D1C3                           adda.l  d3,a0
  598  000002FA  2F08                           move.l  a0,-(sp)                ; ring E2's byte, for after slot 1
  599  000002FC  6100xxxx                       bsr     yx6_slot
  600  00000300  205F                           movea.l (sp)+,a0
  601  00000302  60xx                           bra.s   .slot2
  602                                   .slot1_idle:
  603  00000304  D1C3                           adda.l  d3,a0
  604  00000306  D1C3                           adda.l  d3,a0
  605                                   .slot2:
  606  00000308  4BFAxxxx                       lea     yx6_desc2(pc),a5
  607  0000030C  1010                           move.b  (a0),d0                 ; E2, the same gate
  608  0000030E  8015                           or.b    (a5),d0
  609  00000310  67xx                           beq.s   .effects_done
  610  00000312  1010                           move.b  (a0),d0
  611  00000314  D1C3                           adda.l  d3,a0
  612  00000316  1210                           move.b  (a0),d1                 ; T2
  613  00000318  6100xxxx                       bsr     yx6_slot
  614                                   .effects_done:
  615                                   
  616                                   ; While a drum runs its voice leaves the mixer, as the original replay
  617                                   ; routines had it: force the tone and noise bits in this frame's R7.
  618  0000031C  103Axxxx                       move.b  yx6_drums(pc),d0
  619  00000320  67xx                           beq.s   .mixer_ok
  620  00000322  1200                           move.b  d0,d1
  621  00000324  E709                           lsl.b   #3,d1
  622  00000326  8200                           or.b    d0,d1                   ; the voice's tone and noise disables
  623  00000328  2053                           movea.l YX6_CURSOR(a3),a0
  624  0000032A  D1EB0032                       adda.l  YX6_R7OFF(a3),a0
  625  0000032E  6100xxxx                       bsr     yx6_borrow              ; the ring gets this byte back
  626  00000332  8310                           or.b    d1,(a0)
  627                                   .mixer_ok:
  628  00000334  2253                           movea.l YX6_CURSOR(a3),a1       ; the same offset in all fourteen
  629  00000336  45F9FFFF8800                   lea     YX6_PSG,a2              ; register rings
  630                                   
  631                                   ; Selecting a register and writing it are two bus cycles. An interrupt that
  632                                   ; uses the sound chip in between - TOS has several, its floppy motor timeout
  633                                   ; among them - would leave this write going to whatever register it selected,
  634                                   ; so the burst runs masked. Cheap: about 24 cycles for the whole frame.
  635  0000033C  40E7                           move.w  sr,-(sp)
  636  0000033E  007C0700                       ori.w   #$0700,sr
  637                                   
