  668                                   yx6_w13:
  669  000003BE  12297FFF                       move.b  $7FFF(a1),d1            ; R13 restarts the envelope whenever it
  670  000003C2  B23C00FF                       cmp.b   #YX6_NO_ENV,d1          ; is written, so $FF means leave it be
  671  000003C6  67xx                           beq.s   .envelope_held
  672  000003C8  14BC000D                       move.b  #YX6_ENVELOPE,(a2)
  673  000003CC  15410002                       move.b  d1,2(a2)
  674                                   .envelope_held:
  675  000003D0  46DF                           move.w  (sp)+,sr
