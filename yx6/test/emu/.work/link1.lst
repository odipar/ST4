  438  000001DC  08F80005FA13                   bset    #5,$FFFFFA13.w
  439  000001E2  08F80004FA09                   bset    #4,$FFFFFA09.w          ; Timer D likewise
  440  000001E8  08F80004FA15                   bset    #4,$FFFFFA15.w
  441  000001EE  46DF                           move.w  (sp)+,sr
  442                                   
  443  000001F0  7000                           moveq   #0,d0
