                                                YX6_WRITE 4                     ; channel C
       0000036A  14BC0004             @         move.b  #$4,(a2)           
       0000036E  15510002             @         move.b  (a1),2(a2)              
  642  00000372  D3C3                 @         adda.l  d3,a1
                                                YX6_WRITE 5
       00000374  14BC0005             @         move.b  #$5,(a2)           
       00000378  15510002             @         move.b  (a1),2(a2)              
  643  0000037C  D3C3                 @         adda.l  d3,a1
                                                YX6_WRITE 6                     ; noise period
       0000037E  14BC0006             @         move.b  #$6,(a2)           
       00000382  15510002             @         move.b  (a1),2(a2)              
  644  00000386  D3C3                 @         adda.l  d3,a1
  645                                   
  646  00000388  14BC0007                       move.b  #YX6_MIXER,(a2)         ; R7 also carries the ST's I/O port
  647  0000038C  1211                           move.b  (a1),d1                 ; directions, which port A needs kept
  648  0000038E  823C00C0                       or.b    #YX6_PORTS,d1           ; as outputs for the floppy select
  649  00000392  15410002                       move.b  d1,2(a2)
  650  00000396  D3C3                           adda.l  d3,a1
