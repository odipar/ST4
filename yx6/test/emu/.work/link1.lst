  556                                   ; -----------------------------------------------------------------------------
  557                                   ; yx6_open: a0 = an ST4 container. Points the four stream registers at its
  558                                   ; streams - A begins where the header ends, B, C and D sit at the recorded
  559                                   ; header-relative offsets, exactly as ST4.S documents - and tail-calls
  560                                   ; ST4_init: its rts returns to yx6_open's caller with the decoder registers
  561                                   ; as ST4_init leaves them. ST4_init clobbers a3; callers restore it
  562                                   ; themselves, init from the stack and the loop restart from a6.
  563                                   ; -----------------------------------------------------------------------------
  564                                   yx6_open:
  565  000002A4  2448                           movea.l a0,a2
  566  000002A6  D5E80008                       adda.l  8(a0),a2                ; stream B, the literals
  567  000002AA  2848                           movea.l a0,a4
  568  000002AC  D9E8000C                       adda.l  12(a0),a4               ; stream C, the byte offsets
  569  000002B0  2A48                           movea.l a0,a5
  570  000002B2  DBE80010                       adda.l  16(a0),a5               ; stream D, the word offsets
  571  000002B6  41E80014                       lea     20(a0),a0               ; stream A, the bits
  572  000002BA  7600                           moveq   #0,d3
  573  000002BC  362B0024                       move.w  YX6_N(a3),d3            ; N, ST4_init's argument
  574  000002C0  6000xxxx                       bra     ST4_init
  575                                   
  576                                   ; -----------------------------------------------------------------------------
  577                                   ; YX6_play: a0 = workspace. One frame: run the effect stage, write fourteen
  578                                   ; registers, undo the stage's ring edits, refill one stream.
  579                                   ; -----------------------------------------------------------------------------
  580                                   YX6_play:
  581  000002C4  2648                           movea.l a0,a3
  582  000002C6  4AAB0004                       tst.l   YX6_LEFTFR(a3)
  583  000002CA  66xx                           bne.s   .frame
  584  000002CC  70FF                           moveq   #-1,d0                  ; past the last frame of a tune that
  585  000002CE  4E75                           rts                             ; does not loop: write nothing
  586                                   
  587                                   .frame:
  588  000002D0  7600                           moveq   #0,d3
  589  000002D2  362B0024                       move.w  YX6_N(a3),d3            ; one ring to the next
  590                                   
  591                                   ; The effect stage, inlined: it runs BEFORE the burst so it may rewrite this
  592                                   ; frame's ring bytes. Each slot is gated on E | E-last: a slot that has, and
  593                                   ; had, nothing to do costs one test - the common frame. A slot machine call
  594                                   ; therefore always means something changed, holds, or just ended; yx6_slot's
  595                                   ; held path leans on that (E is never 0 there).
  596  000002D6  2053                           movea.l YX6_CURSOR(a3),a0
  597  000002D8  D1EB002E                       adda.l  YX6_EFXOFF(a3),a0       ; ring E1, at this frame's offset
  598  000002DC  4BFAxxxx                       lea     yx6_desc1(pc),a5
  599  000002E0  1010                           move.b  (a0),d0                 ; E1 | its last code: zero is idle
  600  000002E2  8015                           or.b    (a5),d0
  601  000002E4  67xx                           beq.s   .slot1_idle
  602  000002E6  1010                           move.b  (a0),d0                 ; the real E1
  603  000002E8  D1C3                           adda.l  d3,a0
  604  000002EA  1210                           move.b  (a0),d1                 ; T1
  605  000002EC  D1C3                           adda.l  d3,a0
  606  000002EE  2F08                           move.l  a0,-(sp)                ; ring E2's byte, for after slot 1
  607  000002F0  6100xxxx                       bsr     yx6_slot
  608  000002F4  205F                           movea.l (sp)+,a0
  609  000002F6  60xx                           bra.s   .slot2
  610                                   .slot1_idle:
  611  000002F8  D1C3                           adda.l  d3,a0
  612  000002FA  D1C3                           adda.l  d3,a0
  613                                   .slot2:
  614  000002FC  4BFAxxxx                       lea     yx6_desc2(pc),a5
  615  00000300  1010                           move.b  (a0),d0                 ; E2, the same gate
  616  00000302  8015                           or.b    (a5),d0
  617  00000304  67xx                           beq.s   .effects_done
  618  00000306  1010                           move.b  (a0),d0
  619  00000308  D1C3                           adda.l  d3,a0
  620  0000030A  1210                           move.b  (a0),d1                 ; T2
  621  0000030C  6100xxxx                       bsr     yx6_slot
  622                                   .effects_done:
  623                                   
  624                                   ; While a drum runs its voice leaves the mixer, as the original replay
  625                                   ; routines had it: force the tone and noise bits in this frame's R7.
  626  00000310  103Axxxx                       move.b  yx6_drums(pc),d0
  627  00000314  67xx                           beq.s   .mixer_ok
  628  00000316  1200                           move.b  d0,d1
  629  00000318  E709                           lsl.b   #3,d1
  630  0000031A  8200                           or.b    d0,d1                   ; the voice's tone and noise disables
  631  0000031C  2053                           movea.l YX6_CURSOR(a3),a0
  632  0000031E  D1EB0032                       adda.l  YX6_R7OFF(a3),a0
  633  00000322  6100xxxx                       bsr     yx6_borrow              ; the ring gets this byte back
  634  00000326  8310                           or.b    d1,(a0)
  635                                   .mixer_ok:
  636  00000328  2253                           movea.l YX6_CURSOR(a3),a1       ; the cursor: every register's ring
  637  0000032A  45F9FFFF8800                   lea     YX6_PSG,a2              ; byte is a patched k*N above it
  638                                   
  639                                   ; Selecting a register and writing it are two bus cycles. An interrupt that
  640                                   ; uses the sound chip in between - TOS has several, its floppy motor timeout
  641                                   ; among them - would leave this write going to whatever register it selected,
  642                                   ; so the burst runs masked. Cheap: about 24 cycles for the whole frame.
  643  00000330  40E7                           move.w  sr,-(sp)
  644  00000332  007C0700                       ori.w   #$0700,sr
  645                                   
  646                                   yx6_wA:
                                                YX6_WRITE 0                     ; channel A period, fine and coarse
       00000336  14BC0000             @         move.b  #$0,(a2)           
  647  0000033A  15697FFF0002         @         move.b  $7FFF(a1),2(a2)         
                                                YX6_WRITE 1
       00000340  14BC0001             @         move.b  #$1,(a2)           
  648  00000344  15697FFF0002         @         move.b  $7FFF(a1),2(a2)         
