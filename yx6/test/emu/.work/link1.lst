  394                                   ; The cursor reaches the effect and mixer rings by fixed hops, computed once.
  395  00000146  302B0024                       move.w  YX6_N(a3),d0
  396  0000014A  C0FC0007                       mulu.w  #7,d0
  397  0000014E  27400032                       move.l  d0,YX6_R7OFF(a3)
  398  00000152  D080                           add.l   d0,d0                   ; and 14*N, from the same mulu
  399  00000154  2740002E                       move.l  d0,YX6_EFXOFF(a3)
  400                                   
  401                                   ; The burst reads register k's ring byte through an assembled-in k*N
  402                                   ; displacement - patch all fourteen now that N is known. The packer keeps
  403                                   ; N at 2520 or less, so 13*N fits the signed word. Each YX6_WRITE is ten
  404                                   ; bytes with its displacement at +6; R7 and R13 read out of line.
  405  00000158  342B0024                       move.w  YX6_N(a3),d2
  406  0000015C  7200                           moveq   #0,d1                   ; k*N, accumulated
  407  0000015E  41FAxxxx                       lea     yx6_wA+6(pc),a0
  408  00000162  7006                           moveq   #6,d0                   ; R0..R6
  409                                   .wpatchA:
  410  00000164  3081                           move.w  d1,(a0)
  411  00000166  D242                           add.w   d2,d1
  412  00000168  41E8000A                       lea     10(a0),a0
  413  0000016C  51C8FFF6                       dbra    d0,.wpatchA
  414  00000170  41FAxxxx                       lea     yx6_w7+2(pc),a0         ; R7 reads through d1
  415  00000174  3081                           move.w  d1,(a0)
  416  00000176  D242                           add.w   d2,d1
  417  00000178  41FAxxxx                       lea     yx6_wB+6(pc),a0
  418  0000017C  7004                           moveq   #4,d0                   ; R8..R12
  419                                   .wpatchB:
  420  0000017E  3081                           move.w  d1,(a0)
  421  00000180  D242                           add.w   d2,d1
  422  00000182  41E8000A                       lea     10(a0),a0
  423  00000186  51C8FFF6                       dbra    d0,.wpatchB
  424  0000018A  41FAxxxx                       lea     yx6_w13+2(pc),a0
  425  0000018E  3081                           move.w  d1,(a0)
  426  00000190  422B0036                       clr.b   YX6_PATCHES(a3)
  427  00000194  41FAxxxx                       lea     yx6_drums(pc),a0
  428  00000198  4210                           clr.b   (a0)
  429  0000019A  6100xxxx                       bsr     yx6_link                ; descriptors: pointers and last codes
  430                                   
  431                                   ; Claim Timers A and D: park our handlers on the vectors and leave both
  432                                   ; timers stopped but enabled and unmasked. Nothing is saved - the machine
  433                                   ; state is the host's, see assumption 5 in the header. bset/bclr only:
  434                                   ; Timer C's bits and the ACIA's live in the same registers.
  435  0000019E  40E7                           move.w  sr,-(sp)
  436  000001A0  007C0700                       ori.w   #$0700,sr
  437  000001A4  4238FA19                       clr.b   $FFFFFA19.w             ; Timer A stopped
  438  000001A8  023800F0FA1D                   andi.b  #$F0,$FFFFFA1D.w        ; Timer D stopped; Timer C untouched
  439  000001AE  41FAxxxx                       lea     yx6_parkA(pc),a0
  440  000001B2  21C80134                       move.l  a0,$134.w
  441  000001B6  41FAxxxx                       lea     yx6_parkD(pc),a0
  442  000001BA  21C80110                       move.l  a0,$110.w
  443  000001BE  08B80005FA0B                   bclr    #5,$FFFFFA0B.w          ; drop stale pendings
  444  000001C4  08B80004FA0D                   bclr    #4,$FFFFFA0D.w
  445  000001CA  08F80005FA07                   bset    #5,$FFFFFA07.w          ; Timer A enabled and unmasked
  446  000001D0  08F80005FA13                   bset    #5,$FFFFFA13.w
  447  000001D6  08F80004FA09                   bset    #4,$FFFFFA09.w          ; Timer D likewise
  448  000001DC  08F80004FA15                   bset    #4,$FFFFFA15.w
  449  000001E2  46DF                           move.w  (sp)+,sr
  450                                   
  451  000001E4  7000                           moveq   #0,d0
  452  000001E6  4E75                           rts
  453                                   .rejected:
  454  000001E8  70FF                           moveq   #-1,d0
  455  000001EA  4E75                           rts
