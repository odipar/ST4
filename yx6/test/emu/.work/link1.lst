    1           =00000001               ST4_UNIT    equ     1
    2                                           include "YX6.S"
    1                                   ; -----------------------------------------------------------------------------
    2                                   ; YX6.S - streaming YM chiptune player for the plain 68000 (Atari ST)
    3                                   ;
    4                                   ; By Robbert van Dalen. Plays a .yx6 file: eighteen streams - the fourteen
    5                                   ; YM2149 registers plus each effect slot's control byte and timer count -
    6                                   ; every one packed as its own embedded ST4 container and decoded through its
    7                                   ; own small ring by ST4_wrap.S. Written by Claude (Anthropic's Claude Code)
    8                                   ; under Robbert's direction, based on ZX1 v1.5 by Einar Saukas and inspired
    9                                   ; by Steve Clarets' MinYMiser. Use it freely, including commercially, as long
   10                                   ; as your documentation says you used ZX1 through ST4 (see LICENSE).
   11                                   ;
   12                                   ; It plays the fourteen standard sound registers, loops, and plays the YM
   13                                   ; special effects - digidrums, SID voices, the sync-buzzer - on MFP Timers
   14                                   ; A and D. Sinus-SID, which no player has ever implemented, is dropped at
   15                                   ; pack time. EFFECTS.md, next to this file, holds the design.
   16                                   ;
   17                                   ; REQUIRES ST4_wrap.S, built for the SAME unit size the tune was packed with
   18                                   ; (yx6 -kK; byte units unless the packer was told otherwise). Include both, in
   19                                   ; either order, with the unit size defined first:
   20                                   ;
   21                                   ;       ST4_UNIT    equ     1
   22                                   ;               include "YX6.S"
   23                                   ;               include "ST4_wrap.S"
   24                                   ;
   25                                   ; YX6 calls ST4_init and ST4_resume by label, and YX6_init checks every
   26                                   ; section's ST4 signature against this build's unit size - a tune packed for
   27                                   ; a different one is rejected, not garbled.
   28                                   ;
   29                                   ; -----------------------------------------------------------------------------
   30                                   ; THE DESIGN, in one paragraph. A tune is O frames long. Each of the eighteen
   31                                   ; streams gets its own ring of N bytes and its own saved decoder state, and
   32                                   ; is decoded C values at a time (C = 24 by default). On every VBL the player
   33                                   ; uses one value from each of the eighteen rings and refills exactly one
   34                                   ; stream - stream k on the VBL where the frame number modulo C is k. With
   35                                   ; C >= 18 every stream is refilled once per C frames, one refill per VBL, so
   36                                   ; the work per frame is flat: the effect stage, fourteen register writes and
   37                                   ; one ST4_resume of C bytes. Since C divides N and a call never reaches the
   38                                   ; ring end, ST4_wrap.S is the decoder that fits: the player counts the calls
   39                                   ; itself and wraps the write pointer when it lands on the ring end.
   40                                   ;
   41                                   ; EFFECTS. The last four rings carry each slot's effect code and timer count,
   42                                   ; one value per frame like everything else. Before the burst the effect stage
   43                                   ; pops them and programs Timers A and D, whose tick handlers - digidrum, SID
   44                                   ; square, sync-buzzer - write the sound chip between frames. A drum start
   45                                   ; also edits this frame's ring bytes (the sample number, the mixer); every
   46                                   ; such edit is logged and undone right after the burst, because a ring is
   47                                   ; decode history that later matches copy from.
   48                                   ;
   49                                   ; LOOPING. A packed stream can only be restarted from its beginning, so the packer
   50                                   ; splits every register at the loop frame L: an intro stream for frames [0, L)
   51                                   ; and a loop stream for [L, O). When a register's section runs out mid-refill
   52                                   ; the player starts its loop stream over - a fresh decoder writing on into the
   53                                   ; same ring - so the rings always hold one continuous sequence of values and
   54                                   ; the read side never learns that anything happened. Nothing requires L to fall
   55                                   ; on a group boundary: a refill that straddles the split simply decodes two
   56                                   ; pieces. A tune that loops from frame 0 has no intro streams at all.
   57                                   ;
   58                                   ; -----------------------------------------------------------------------------
   59                                   ; USING IT
   60                                   ;
   61                                   ;       lea     song,a0                 ; the .yx6 file, loaded anywhere
   62                                   ;       lea     workspace,a1            ; even address, YX6_SIZE bytes
   63                                   ;       bsr     YX6_init                ; d0 = 0 when the file was accepted
   64                                   ;       tst.l   d0
   65                                   ;       bne     bad_file
   66                                   ;   vbl:                                ; once per frame, in supervisor mode
   67                                   ;       lea     workspace,a0
   68                                   ;       bsr     YX6_play                ; d0 = 0 played, 1 wrapped, -1 ended
   69                                   ;       ...
   70                                   ;       lea     workspace,a0
   71                                   ;       bsr     YX6_stop                ; chip quiet, timers handed back
   72                                   ;
   73                                   ; The workspace holds the player's own fields, the eighteen decoder states and
   74                                   ; the eighteen rings, so its size depends on the ring size in the file:
   75                                   ;
   76                                   ;   YX6_SIZE = YX6_FIXED + 18 * N       ; 1240 + 18 * N bytes
   77                                   ;
   78                                   ; For the default 960-byte rings that is 18520 bytes. A program that knows N
   79                                   ; at build time can reserve it with
   80                                   ;
   81                                   ;       ds.b    YX6_FIXED+(YX6_STREAMS*960)
   82                                   ;
   83                                   ; where the parentheses matter: rmac evaluates expressions left to right.
   84                                   ;
   85                                   ; CALLS AND REGISTERS
   86                                   ;
   87                                   ;   YX6_init   in   a0 = .yx6 file, at an even address, a1 = workspace
   88                                   ;              out  d0 = 0 accepted, -1 not a v4 yx6 file with 18 streams
   89                                   ;                        packed at this build's unit size
   90                                   ;              Takes over MFP Timers A and D for the effect slots: vectors,
   91                                   ;              control and data registers, enable and mask bits - all saved
   92                                   ;              and restored by YX6_stop. Timer B stays free for rasters,
   93                                   ;              Timer C stays the system's. Pair every init with a stop
   94                                   ;   YX6_play   in   a0 = workspace
   95                                   ;              out  d0 = 0 played a frame
   96                                   ;                   d0 = 1 played a frame, and that frame ended the tune: the
   97                                   ;                          next one is the loop frame L
   98                                   ;                   d0 = -1 the tune is over and nothing was written, which
   99                                   ;                          only a tune packed with -o can report
  100                                   ;   YX6_stop   in   a0 = workspace: the MFP state to hand back
  101                                   ;   CLOBBERED  d0-d5, a0-a5. d6, d7 and a6 survive, as with ST4 - whose
  102                                   ;              decoder state spans a4 and a5, which is why they no longer do.
  103                                   ;
  104                                   ; YX6_play writes to the sound chip at $FFFF8800, so it must run in supervisor
  105                                   ; mode - which a VBL handler already does. It masks interrupts around the
  106                                   ; fourteen writes, because selecting a register and writing it are two bus
  107                                   ; cycles and TOS's own handlers use the chip too. Its effect stage programs
  108                                   ; the two timers YX6_init claimed, vectors included, and beyond those it
  109                                   ; performs no side effect: no memory allocation, nothing outside the
  110                                   ; workspace, the chip and the claimed timers.
  111                                   ;
  112                                   ; ASSUMPTIONS (unchecked beyond the magic, version and stream count):
  113                                   ;
  114                                   ;   1. the file comes from the yx6 packer, which enforces C >= 18, N mod C = 0,
  115                                   ;      N >= 2C, offsets that stay inside the ring, and - at ST4_UNIT above 1 -
  116                                   ;      a tune length, loop frame and C that are whole units, so every budget
  117                                   ;      this player passes to the decoder divides cleanly
  118                                   ;   2. the workspace is at an even address and large enough for the file's N
  119                                   ;   3. YX6_play is called once per frame and never after it returns -1.
  120                                   ;      Calling it again is harmless - it returns -1 and writes nothing - which
  121                                   ;      is what keeps ST4_wrap's "never call the decoder again" rule intact
  122                                   ;   4. a looping tune plays for as long as you keep calling: d0 = 1 marks each
  123                                   ;      time round, and YX6_init is only needed to start again from frame 0
  124                                   ; -----------------------------------------------------------------------------
  125                                   
  126                                   ; A host that never runs user-mode code while the player is live - a demo
  127                                   ; under its own takeover, say - may define YX6_SUPER_HOST equ 1 before
  128                                   ; including this file: the drum tick then parks a0 in the then-unused USP
  129                                   ; (4 cycles each way instead of 12 through the stack). The park restores a0
  130                                   ; but not the USP, so YX6_init saves the USP and YX6_stop hands it back -
  131                                   ; the host's only obligation is that nothing runs in user mode between the
  132                                   ; two. Default off, because a program that hooks the VBL from user mode has
  133                                   ; a live USP at every tick.
  134                                           .if ^^defined YX6_SUPER_HOST
  135                                 -         .else
  136           =00000000               YX6_SUPER_HOST  equ     0
  137                                           .endif
  138                                   
  139           =00000012               YX6_STREAMS     equ     18              ; R0..R13, then E1 T1 E2 T2: the two
  140                                                                           ; effect slots' control and timer-count
  141                                                                           ; streams, decoded like any register
  142           =0000000E               YX6_REGISTERS   equ     14              ; the streams the burst writes
  143           =00000040               YX6_STATE_SIZE  equ     64              ; per stream, so the index is a shift
  144                                                                           ; both ways: *64 in, /16 back to *4
  145                                   
  146                                   ; Workspace layout. Counters that a frame touches are kept in the form the
  147                                   ; frame wants them in: a pointer to walk, and a countdown to test against zero.
  148           =00000000               YX6_CURSOR      equ     0               ; long  this frame's byte in ring 0
  149           =00000004               YX6_LEFTFR      equ     4               ; long  frames before the tune ends
  150           =00000008               YX6_NEXT        equ     8               ; long  values decoded so far
  151           =0000000C               YX6_RINGEND     equ     12              ; long  one past ring 0, where it wraps
  152           =00000010               YX6_RINGS       equ     16              ; long  base of the ring area
  153           =00000014               YX6_FILE        equ     20              ; long  the .yx6 file
  154           =00000018               YX6_TOTAL       equ     24              ; long  O, the tune length in frames
  155           =0000001C               YX6_LOOPLEN     equ     28              ; long  O - L, zero when it does not loop
  156           =00000020               YX6_LOOP        equ     32              ; long  L, read at init to split sections
  157           =00000024               YX6_N           equ     36              ; word  ring size N
  158           =00000026               YX6_C           equ     38              ; word  values per call C
  159           =00000028               YX6_SLOT        equ     40              ; word  refill slot, 0..C-1
  160           =0000002A               YX6_INDEX       equ     42              ; word  stream index, during init only
  161           =0000002C               YX6_LOOPS       equ     44              ; word  nonzero when the tune loops
  162           =0000002E               YX6_EFXOFF      equ     46              ; long  14*N: the cursor's ring to E1's
  163           =00000032               YX6_R7OFF       equ     50              ; long  7*N: the cursor's ring to R7's
  164                                   ; The MFP state YX6_init takes over and YX6_stop hands back: both timer
  165                                   ; vectors, both control registers, both data registers, and which of the four
  166                                   ; enable/mask bits were set (bit 0 IERA5, 1 IMRA5, 2 IERB4, 3 IMRB4).
  167           =00000036               YX6_OLDTA       equ     54              ; long  vector $134, Timer A
  168           =0000003A               YX6_OLDTD       equ     58              ; long  vector $110, Timer D
  169           =0000003E               YX6_OLDTACR     equ     62              ; byte
  170           =0000003F               YX6_OLDTCDCR    equ     63              ; byte
  171           =00000040               YX6_OLDTADR     equ     64              ; byte
  172           =00000041               YX6_OLDTDDR     equ     65              ; byte
  173           =00000042               YX6_OLDMFP      equ     66              ; byte  the four enable/mask bits
  174                                   ; The sanitize log. The effect stage edits ring bytes so the burst plays a
  175                                   ; sanitized frame - but the ring is decode history, and a later match may
  176                                   ; copy from any byte of it. So every edit is recorded here and undone right
  177                                   ; after the burst: the chip sees the edit, the ring never keeps it.
  178           =00000043               YX6_PATCHES     equ     67              ; byte  how many edits this frame, 0..3
  179           =00000044               YX6_PATCH_VAL   equ     68              ; 3 bytes: the originals
  180                                                                           ; (71 pads the longs below even)
  181           =00000048               YX6_PATCH_ADDR  equ     72              ; 3 longs: where they go back
  182           =00000054               YX6_OLDUSP      equ     84              ; long  the USP across the session: a
  183                                                                           ; YX6_SUPER_HOST drum tick parks a0
  184                                                                           ; there, so init borrows it and stop
  185                                                                           ; hands it back - saved in every build
  186           =00000058               YX6_STATE       equ     88              ; 18 decoder states, from an even base
  187                                   
  188                                   ; Each effect slot's own state - its code and count from last frame, its
  189                                   ; parameter ring offset, its timer and its handlers - lives in a descriptor
  190                                   ; in the code blob (yx6_desc1/2 below), so ONE slot machine serves both
  191                                   ; slots. The hardware addresses are words: movea.w sign-extends $FAxx to
  192                                   ; $FFFFFAxx. The two run-time pointers are filled in by YX6_init.
  193           =00000000               SD_ELAST        equ     0               ; byte  the slot's code last frame
  194           =00000001               SD_TLAST        equ     1               ; byte  the count its timer last got:
  195                                                                           ; a held effect reloads its data
  196                                                                           ; register only when the count CHANGES,
  197                                                                           ; because a write that lands while the
  198                                                                           ; counter passes 01 loads an
  199                                                                           ; indeterminate value - pitch glitches
  200           =00000002               SD_CTRL         equ     2               ; word  timer control register
  201           =00000004               SD_DATA         equ     4               ; word  timer data register
  202           =00000006               SD_VEC          equ     6               ; word  timer vector
  203           =00000008               SD_PARM         equ     8               ; long  (8+voice)*N: the cursor's ring
  204                                                                           ;       to the slot's parameter byte
  205           =0000000C               SD_ISR          equ     12              ; long  the slot's tick handlers
  206           =00000010               SD_OTHER        equ     16              ; long  the other slot's descriptor
  207                                   ; rmac evaluates left to right, so the parentheses here are load-bearing:
  208                                   ; without them this reads as (YX6_STATE+YX6_STREAMS)*YX6_STATE_SIZE.
  209           =000004D8               YX6_FIXED       equ     YX6_STATE+(YX6_STREAMS*YX6_STATE_SIZE)
  210                                   
  211                                   ; One saved ST4_wrap state, plus the ring bounds the wrap check needs. The
  212                                   ; first four longs are in movem order - d1, d2, then a0, a1 - so that much of
  213                                   ; the decoder state loads and stores in one instruction; the three extra
  214                                   ; stream pointers ST4 carries (literals, byte offsets, word offsets) follow.
  215           =00000000               YS_D1           equ     0               ; long  d1, -ring.low : remaining
  216           =00000004               YS_D2           equ     4               ; long  d2, N : signed offset
  217           =00000008               YS_INPUT        equ     8               ; long  a0, stream A position
  218           =0000000C               YS_WRITE        equ     12              ; long  a1, write pointer
  219           =00000010               YS_LIT          equ     16              ; long  a2, stream B position
  220           =00000014               YS_BOFF         equ     20              ; long  a4, stream C position
  221           =00000018               YS_WOFF         equ     24              ; long  a5, stream D position
  222           =0000001C               YS_QUEUE        equ     28              ; word  d0, bit queue
  223           =00000020               YS_START        equ     32              ; long  this stream's ring
  224           =00000024               YS_END          equ     36              ; long  one past its last byte
  225           =00000028               YS_LEFT         equ     40              ; long  values left in the current section
  226                                   ; The movem block starts at the top of the state, so the two movems address it
  227                                   ; as plain (a2) - see the note where they are used.
  228                                   
  229                                   ; The .yx6 header, as written by the packer.
  230           =00000000               YH_MAGIC        equ     0
  231           =00000004               YH_VERSION      equ     4
  232           =00000006               YH_FLAGS        equ     6
  233           =00000008               YH_FRAMES       equ     8
  234           =0000000C               YH_PLAYER_HZ    equ     12
  235           =0000000E               YH_STREAM_COUNT equ     14
  236           =00000010               YH_RING         equ     16
  237           =00000012               YH_CHUNK        equ     18
  238           =00000014               YH_LOOP         equ     20
  239           =00000018               YH_CLOCK        equ     24
  240           =0000001C               YH_DRUMS        equ     28              ; long: the drum table, 0 when none
  241           =00000020               YH_DRUMCOUNT    equ     32              ; word
  242           =00000022               YH_INTRO_TABLE  equ     34              ; 18 offsets: the frames before the loop
  243           =0000006A               YH_LOOP_TABLE   equ     106             ; 18 offsets: the frames from L on
  244                                   
  245           =59583621               YX6_MAGIC       equ     $59583621       ; 'YX6!'
  246           =00000004               YX6_VERSION     equ     4               ; 4: effect streams and the drum table
  247           =00000001               YX6_FLAG_LOOPS  equ     1               ; header flag: the tune loops
  248           =FFFF8800               YX6_PSG         equ     $FFFF8800       ; select/read at +0, write at +2
  249           =000000FF               YX6_NO_ENV      equ     $FF             ; R13 value meaning "leave it alone"
  250           =000000C0               YX6_PORTS       equ     $C0             ; R7 bits the ST needs as outputs
  251           =00000007               YX6_MIXER       equ     7
  252           =0000000D               YX6_ENVELOPE    equ     13
  253                                   
  254                                   ; -----------------------------------------------------------------------------
  255                                   ; YX6_WRITE: send one register's value straight from its ring to the sound
  256                                   ; chip, then step a1 on to the next register's ring.
  257                                   ;
  258                                   ; Two moves and an add, with the register number assembled in as an immediate:
  259                                   ; nothing is tested, nothing is counted, and the value never passes through a
  260                                   ; data register. Registers 7 and 13 need their values touched, so they are
  261                                   ; written out of line rather than through this macro.
  262                                   ;
  263                                   ; Skipping a register whose value has not changed was measured and dropped: a
  264                                   ; sound-chip access on an ST costs about 1.5 cycles more than a RAM one, so the
  265                                   ; compare that would save the write costs about as much as the write.
  266                                   ; -----------------------------------------------------------------------------
  267                                           .macro YX6_WRITE number
  268                                 .         move.b  #\number,(a2)           ; select
  269                                 .         move.b  (a1),2(a2)              ; and write
  270                                 .         adda.l  d3,a1
  271                                 .         .endm
  272                                   
  273                                   ; Jump table: bra.w keeps 4-byte slots for a program that loads YX6 as a blob.
  274  00000000  6000xxxx                               bra.w   YX6_init
  275  00000004  6000xxxx                               bra.w   YX6_play
  276  00000008  6000xxxx                               bra.w   YX6_stop
  277                                   
  278                                   ; -----------------------------------------------------------------------------
  279                                   ; YX6_init: a0 = .yx6 file, a1 = workspace. Sets up eighteen decoders, decodes
  280                                   ; each stream's first group so frame 0 can be played immediately, and takes
  281                                   ; over MFP Timers A and D for the effect slots.
  282                                   ; -----------------------------------------------------------------------------
  283                                   YX6_init:
  284  0000000C  2649                           movea.l a1,a3                   ; a3 is the workspace throughout
  285  0000000E  27480014                       move.l  a0,YX6_FILE(a3)
  286  00000012  0C9059583621                   cmp.l   #YX6_MAGIC,YH_MAGIC(a0)
  287  00000018  6600xxxx                       bne     .rejected
  288  0000001C  0C6800040004                   cmp.w   #YX6_VERSION,YH_VERSION(a0)
  289  00000022  6600xxxx                       bne     .rejected
  290  00000026  0C680012000E                   cmp.w   #YX6_STREAMS,YH_STREAM_COUNT(a0)
  291  0000002C  6600xxxx                       bne     .rejected
  292                                   
  293  00000030  276800080018                   move.l  YH_FRAMES(a0),YX6_TOTAL(a3)
  294  00000036  276800140020                   move.l  YH_LOOP(a0),YX6_LOOP(a3)
  295  0000003C  376800100024                   move.w  YH_RING(a0),YX6_N(a3)
  296  00000042  376800120026                   move.w  YH_CHUNK(a0),YX6_C(a3)
  297  00000048  30280006                       move.w  YH_FLAGS(a0),d0
  298  0000004C  C07C0001                       and.w   #YX6_FLAG_LOOPS,d0
  299  00000050  3740002C                       move.w  d0,YX6_LOOPS(a3)
  300  00000054  276800080004                   move.l  YH_FRAMES(a0),YX6_LEFTFR(a3)
  301  0000005A  426B0028                       clr.w   YX6_SLOT(a3)
  302  0000005E  43EB04D8                       lea     YX6_FIXED(a3),a1        ; the rings follow the decoder states
  303  00000062  27490010                       move.l  a1,YX6_RINGS(a3)
  304  00000066  2689                           move.l  a1,YX6_CURSOR(a3)       ; frame 0 is the first byte of ring 0
  305  00000068  7000                           moveq   #0,d0
  306  0000006A  30280010                       move.w  YH_RING(a0),d0
  307  0000006E  D089                           add.l   a1,d0
  308  00000070  2740000C                       move.l  d0,YX6_RINGEND(a3)      ; where the cursor goes back to the top
  309                                   
  310  00000074  202B0018                       move.l  YX6_TOTAL(a3),d0        ; the loop section is O - L frames long,
  311  00000078  90AB0020                       sub.l   YX6_LOOP(a3),d0         ; and empty when the tune plays once
  312  0000007C  4A6B002C                       tst.w   YX6_LOOPS(a3)
  313  00000080  66xx                           bne.s   .loop_length
  314  00000082  7000                           moveq   #0,d0
  315                                   .loop_length:
  316  00000084  2740001C                       move.l  d0,YX6_LOOPLEN(a3)
  317                                   
  318  00000088  7200                           moveq   #0,d1                   ; the first group is C values, or the
  319  0000008A  322B0026                       move.w  YX6_C(a3),d1            ; whole tune when that is shorter and
  320  0000008E  4A6B002C                       tst.w   YX6_LOOPS(a3)           ; there is no loop to carry on into
  321  00000092  66xx                           bne.s   .first_group
  322  00000094  202B0018                       move.l  YX6_TOTAL(a3),d0
  323  00000098  B081                           cmp.l   d1,d0
  324  0000009A  64xx                           bcc.s   .first_group
  325  0000009C  2200                           move.l  d0,d1
  326                                   .first_group:
  327  0000009E  27410008                       move.l  d1,YX6_NEXT(a3)         ; values decoded once init is done
  328                                   
  329  000000A2  426B002A                       clr.w   YX6_INDEX(a3)           ; the loop counter lives here: every
  330                                   .stream:                                ; register is state during the calls
  331  000000A6  302B002A                       move.w  YX6_INDEX(a3),d0
  332  000000AA  ED48                           lsl.w   #6,d0                   ; * YX6_STATE_SIZE
  333  000000AC  45F30058                       lea     YX6_STATE(a3,d0.w),a2
  334  000000B0  7600                           moveq   #0,d3
  335  000000B2  362B0024                       move.w  YX6_N(a3),d3
  336  000000B6  302B002A                       move.w  YX6_INDEX(a3),d0
  337  000000BA  C0C3                           mulu.w  d3,d0                   ; this stream's ring is the k'th
  338  000000BC  226B0010                       movea.l YX6_RINGS(a3),a1
  339  000000C0  D3C0                           adda.l  d0,a1
  340  000000C2  25490020                       move.l  a1,YS_START(a2)
  341  000000C6  2549000C                       move.l  a1,YS_WRITE(a2)
  342  000000CA  2009                           move.l  a1,d0
  343  000000CC  D083                           add.l   d3,d0
  344  000000CE  25400024                       move.l  d0,YS_END(a2)
  345                                   
  346                                   ; A tune that loops from frame 0 has no intro streams, so its registers start
  347                                   ; on the loop section - which is then the whole tune. The load of L comes
  348                                   ; last because it is the branch condition: a move to a data register writes
  349                                   ; the flags, a lesson the original version of this choice taught by always
  350                                   ; picking the intro table and leaning on the section-exhausted path to
  351                                   ; recover. The signature check below ended that arrangement.
  352  000000D2  383C0022                       move.w  #YH_INTRO_TABLE,d4
  353  000000D6  202B0020                       move.l  YX6_LOOP(a3),d0
  354  000000DA  66xx                           bne.s   .section                ; L != 0: the intro covers [0, L)
  355  000000DC  383C006A                       move.w  #YH_LOOP_TABLE,d4
  356  000000E0  202B001C                       move.l  YX6_LOOPLEN(a3),d0
  357                                   .section:
  358  000000E4  25400028                       move.l  d0,YS_LEFT(a2)          ; values before this stream runs out
  359                                   
  360  000000E8  302B002A                       move.w  YX6_INDEX(a3),d0
