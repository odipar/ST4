  731                                   ; -----------------------------------------------------------------------------
  732                                   ; YX6_stop: a0 = workspace. Hands the MFP back exactly as YX6_init found it -
  733                                   ; timers quiesced first, vectors, data, control and the four enable/mask bits
  734                                   ; restored, pendings dropped - then silences the three voices. Tone and
  735                                   ; envelope settings stay, and a fresh YX6_init starts the tune over.
  736                                   ; -----------------------------------------------------------------------------
  737                                   YX6_stop:
  738  00000466  2648                           movea.l a0,a3
  739  00000468  40E7                           move.w  sr,-(sp)
  740  0000046A  007C0700                       ori.w   #$0700,sr
  741  0000046E  4238FA19                       clr.b   $FFFFFA19.w             ; quiesce before handing back
  742  00000472  023800F0FA1D                   andi.b  #$F0,$FFFFFA1D.w
  743  00000478  21EB00360134                   move.l  YX6_OLDTA(a3),$134.w
  744  0000047E  21EB003A0110                   move.l  YX6_OLDTD(a3),$110.w
  745  00000484  11EB0040FA1F                   move.b  YX6_OLDTADR(a3),$FFFFFA1F.w
  746  0000048A  11EB0041FA25                   move.b  YX6_OLDTDDR(a3),$FFFFFA25.w
  747  00000490  11EB003EFA19                   move.b  YX6_OLDTACR(a3),$FFFFFA19.w
  748  00000496  102B003F                       move.b  YX6_OLDTCDCR(a3),d0     ; only Timer D's nibble is ours
  749  0000049A  C03C000F                       and.b   #$0F,d0
  750  0000049E  8138FA1D                       or.b    d0,$FFFFFA1D.w
  751  000004A2  206B0054                       movea.l YX6_OLDUSP(a3),a0       ; the USP, as init found it
  752  000004A6  4E60                           move    a0,usp
  753  000004A8  102B0042                       move.b  YX6_OLDMFP(a3),d0       ; re-clear what init found clear,
  754  000004AC  41FAxxxx                       lea     yx6_mfpbits(pc),a0      ; through the same table init read
  755  000004B0  7403                           moveq   #3,d2
  756                                   .mfpbit:
  757  000004B2  3258                           movea.w (a0)+,a1
  758  000004B4  3218                           move.w  (a0)+,d1
  759  000004B6  0500                           btst    d2,d0
  760  000004B8  66xx                           bne.s   .mfpkeep
  761  000004BA  0391                           bclr    d1,(a1)
  762                                   .mfpkeep:
  763  000004BC  51CAFFF4                       dbra    d2,.mfpbit
  764  000004C0  08B80005FA0B                   bclr    #5,$FFFFFA0B.w          ; and no pending ticks of ours
  765  000004C6  08B80004FA0D                   bclr    #4,$FFFFFA0D.w
  766  000004CC  41FAxxxx                       lea     yx6_drums(pc),a0
  767  000004D0  4210                           clr.b   (a0)
  768                                   ; The silence stays inside the mask: selecting a register and writing it are
  769                                   ; two bus cycles, and the system interrupts just handed back use the chip.
  770  000004D2  41F9FFFF8800                   lea     YX6_PSG,a0
  771  000004D8  7008                           moveq   #8,d0                   ; R8, R9, R10 are the voice volumes
  772                                   .silence:
  773  000004DA  1080                           move.b  d0,(a0)
  774  000004DC  42280002                       clr.b   2(a0)
  775  000004E0  5200                           addq.b  #1,d0
  776  000004E2  B03C000B                       cmp.b   #11,d0
  777  000004E6  66F2                           bne.s   .silence
  778  000004E8  46DF                           move.w  (sp)+,sr
  779  000004EA  4E75                           rts
  780                                   
  781                                   ; -----------------------------------------------------------------------------
  782                                   ; The effect machinery. The per-frame stage lives inlined in YX6_play; what
  783                                   ; follows is everything it drives: the two slot descriptors, the tick
  784                                   ; handlers, and the one slot machine that serves both timers.
  785                                   ; -----------------------------------------------------------------------------
  786                                   
  787                                   ; The four enable/mask bits YX6_init borrows and YX6_stop hands back, as
  788                                   ; {register, bit} rows. Walked with a 3..0 countdown, so the OLDMFP encoding
  789                                   ; reads: bit 0 IERA5, bit 1 IMRA5, bit 2 IERB4, bit 3 IMRB4.
  790                                   yx6_mfpbits:
  791  000004EC  FA150004                       dc.w    $FA15,4                 ; IMRB, Timer D's mask
  792  000004F0  FA090004                       dc.w    $FA09,4                 ; IERB, its enable
  793  000004F4  FA130005                       dc.w    $FA13,5                 ; IMRA, Timer A's mask
  794  000004F8  FA070005                       dc.w    $FA07,5                 ; IERA, its enable
  795                                   
  796                                   ; The slot descriptors - see the SD_ equates. Slot 1 owns Timer A, slot 2
  797                                   ; Timer D, whose control nibble is shared with Timer C and only ever changed
  798                                   ; read-modify-write; the slot machine uses that form for both, which on
  799                                   ; Timer A writes the same values a clear would.
  800                                           even
  801                                   yx6_desc1:
  802  000004FC  0000                           dc.b    0,0                     ; E last, T last
  803  000004FE  FA19FA1F0134                   dc.w    $FA19,$FA1F,$0134       ; control, data, vector
  804  00000504  00000000                       dc.l    0                       ; PARM, set per effect
  805  00000508  0000000000000000               dc.l    0,0                     ; ISR block, other slot: yx6_link
  806                                   yx6_desc2:
  807  00000510  0000                           dc.b    0,0
  808  00000512  FA1DFA250110                   dc.w    $FA1D,$FA25,$0110
  809  00000518  00000000                       dc.l    0
  810  0000051C  0000000000000000               dc.l    0,0
  811                                   
  812                                   ; -----------------------------------------------------------------------------
  813                                   ; The tick handlers, in maxYMiser's shipping forms: the PSG select and write
  814                                   ; in as few instructions as the bus allows, patched immediates instead of
  815                                   ; state, software end-of-interrupt as TOS runs the MFP - written as an
  816                                   ; immediate byte, since the in-service registers ignore written ones. All
  817                                   ; MFP interrupts arrive at 68000 level 6, so these never nest, and every
  818                                   ; patched operand is addressed pc-relatively so the player stays loadable
  819                                   ; anywhere - which also means it must run from RAM, where a demo lives.
  820                                   ;
  821                                   ; The two slots' handlers are the same text twice, and MUST stay
  822                                   ; byte-congruent: the slot machine and yx6_drum_start reach every patched
  823                                   ; operand through ISR_ offsets measured on the A block. The rig checks the
  824                                   ; congruence from the symbol table. The park entries - where YX6_init aims
  825                                   ; the vectors while no effect runs - are the handlers' own tails.
  826                                   ;
  827                                   ; The patch offsets are load-bearing:
  828                                   ;   drum:  select immediate at +3, sample address at +8, flag mask at _clear+3
  829                                   ;   sid:   select at +2 and volume at +4 inside the imm long; the partner's
  830                                   ;          address low word at +10, patched once by yx6_link
  831                                   ;   buzz:  the shape at +4
  832                                   ; The SID vector swap patches the vector's LOW word only, so the two halves
  833                                   ; of a block must share their address high word: keep the player inside one
  834                                   ; 64K segment - anywhere a program smaller than 64K naturally loads.
  835                                   ; -----------------------------------------------------------------------------
  836                                   
  837                                   ; One drum tick: the sample byte goes straight to the voice's volume register.
  838                                   ; The byte after the last has bit 7 set, so the same move answers "done": park
  839                                   ; the volume mid-scale against the click, stop the timer, drop the flag.
  840                                   yx6_drumA:
  841  00000524  11FC00088800                   move.b  #8,$FFFF8800.w          ; SMC +3: select the drummed volume
  842  0000052A  11F9123456788802               move.b  $12345678,$FFFF8802.w   ; SMC +8: the next sample byte
  843  00000532  6Bxx                           bmi.s   .ended
  844                                           .if YX6_SUPER_HOST
  845                                 -         move    a0,usp                  ; the USP is the host's spare register
  846                                 -         .else
  847  00000534  2F08                           move.l  a0,-(sp)
  848                                           .endif
  849  00000536  41FAFFF4                       lea     yx6_drumA+8(pc),a0
  850  0000053A  5290                           addq.l  #1,(a0)                 ; step the operand itself
  851                                           .if YX6_SUPER_HOST
  852                                 -         move    usp,a0
  853                                 -         .else
  854  0000053C  205F                           movea.l (sp)+,a0
  855                                           .endif
  856  0000053E  11FC00DFFA0F                   move.b  #$DF,$FFFFFA0F.w
  857  00000544  4E73                           rte
  858                                   .ended:
  859  00000546  11FC000D8802                   move.b  #$D,$FFFF8802.w         ; middle volume: no click
  860  0000054C  023800F0FA19                   andi.b  #$F0,$FFFFFA19.w        ; the sample ran out: stop Timer A
  861                                           .if YX6_SUPER_HOST
  862                                 -         move    a0,usp
  863                                 -         .else
  864  00000552  2F08                           move.l  a0,-(sp)
  865                                           .endif
  866  00000554  41FAxxxx                       lea     yx6_drums(pc),a0
  867                                   yx6_drumA_clear:
  868  00000558  021000FF                       andi.b  #$FF,(a0)               ; SMC +3: drop the voice's drum flag
  869                                           .if YX6_SUPER_HOST
  870                                 -         move    usp,a0
  871                                 -         .else
  872  0000055C  205F                           movea.l (sp)+,a0
  873                                           .endif
  874                                   yx6_parkA:
  875  0000055E  11FC00DFFA0F                   move.b  #$DF,$FFFFFA0F.w
  876  00000564  4E73                           rte
  877                                   
  878                                   ; The SID square: each tick writes one half of the square - the volume or
  879                                   ; silence - and installs the other half as the next tick, one word into the
  880                                   ; vector. Select and data land in one move.l: the immediate's bytes hit
  881                                   ; $8800 (select) and $8802 (data) by bus layout.
  882                                   yx6_sidA_on:
  883  00000566  21FC08000F008800               move.l  #$08000F00,$FFFF8800.w  ; SMC +2 select, +4 volume
  884  0000056E  31FC00000136                   move.w  #0,$136.w               ; SMC +10: the quiet half is next
  885  00000574  11FC00DFFA0F                   move.b  #$DF,$FFFFFA0F.w
  886  0000057A  4E73                           rte
  887                                   yx6_sidA_off:
  888  0000057C  21FC080000008800               move.l  #$08000000,$FFFF8800.w  ; SMC +2 select; silence
  889  00000584  31FC00000136                   move.w  #0,$136.w               ; SMC +10: the loud half is next
  890  0000058A  11FC00DFFA0F                   move.b  #$DF,$FFFFFA0F.w
  891  00000590  4E73                           rte
  892                                   
  893                                   ; The sync-buzzer tick: writing the shape to R13 restarts the envelope, and
  894                                   ; that restart at the timer's rate is the whole effect.
  895                                   yx6_buzzA:
  896  00000592  21FC0D0000008800               move.l  #$0D000000,$FFFF8800.w  ; SMC +4: the shape
  897  0000059A  11FC00DFFA0F                   move.b  #$DF,$FFFFFA0F.w
  898  000005A0  4E73                           rte
  899                                   
  900                                   ; Slot 2's instances: Timer D's stop, vector and in-service bit, otherwise
  901                                   ; the A block byte for byte.
  902                                   yx6_drumD:
  903  000005A2  11FC00088800                   move.b  #8,$FFFF8800.w
  904  000005A8  11F9123456788802               move.b  $12345678,$FFFF8802.w
  905  000005B0  6Bxx                           bmi.s   .ended
  906                                           .if YX6_SUPER_HOST
  907                                 -         move    a0,usp
  908                                 -         .else
  909  000005B2  2F08                           move.l  a0,-(sp)
  910                                           .endif
  911  000005B4  41FAFFF4                       lea     yx6_drumD+8(pc),a0
  912  000005B8  5290                           addq.l  #1,(a0)
  913                                           .if YX6_SUPER_HOST
  914                                 -         move    usp,a0
  915                                 -         .else
  916  000005BA  205F                           movea.l (sp)+,a0
  917                                           .endif
  918  000005BC  11FC00EFFA11                   move.b  #$EF,$FFFFFA11.w
  919  000005C2  4E73                           rte
  920                                   .ended:
  921  000005C4  11FC000D8802                   move.b  #$D,$FFFF8802.w
  922  000005CA  023800F0FA1D                   andi.b  #$F0,$FFFFFA1D.w
  923                                           .if YX6_SUPER_HOST
  924                                 -         move    a0,usp
  925                                 -         .else
  926  000005D0  2F08                           move.l  a0,-(sp)
  927                                           .endif
  928  000005D2  41FAxxxx                       lea     yx6_drums(pc),a0
  929                                   yx6_drumD_clear:
  930  000005D6  021000FF                       andi.b  #$FF,(a0)
  931                                           .if YX6_SUPER_HOST
  932                                 -         move    usp,a0
  933                                 -         .else
  934  000005DA  205F                           movea.l (sp)+,a0
  935                                           .endif
  936                                   yx6_parkD:
  937  000005DC  11FC00EFFA11                   move.b  #$EF,$FFFFFA11.w
  938  000005E2  4E73                           rte
  939                                   
  940                                   yx6_sidD_on:
  941  000005E4  21FC08000F008800               move.l  #$08000F00,$FFFF8800.w
  942  000005EC  31FC00000112                   move.w  #0,$112.w
  943  000005F2  11FC00EFFA11                   move.b  #$EF,$FFFFFA11.w
  944  000005F8  4E73                           rte
  945                                   yx6_sidD_off:
  946  000005FA  21FC080000008800               move.l  #$08000000,$FFFF8800.w
  947  00000602  31FC00000112                   move.w  #0,$112.w
  948  00000608  11FC00EFFA11                   move.b  #$EF,$FFFFFA11.w
  949  0000060E  4E73                           rte
  950                                   
  951                                   yx6_buzzD:
  952  00000610  21FC0D0000008800               move.l  #$0D000000,$FFFF8800.w
  953  00000618  11FC00EFFA11                   move.b  #$EF,$FFFFFA11.w
  954  0000061E  4E73                           rte
  955                                   
  956                                   yx6_drums:
  957  00000620  00                             dc.b    0                       ; voice bits 0-2: a drum is running
  958  00000621  00                             even
  959                                   
  960                                   ; Where the patched operands sit, measured on the A block; the D block is
  961                                   ; byte-congruent, so the same offsets serve both through SD_ISR.
  962                                   ; rmac evaluates left to right: the parentheses are load-bearing.
  963           =00000003               ISR_DRUM_SEL    equ     3
  964           =00000008               ISR_DRUM_PTR    equ     8
  965           =00000037               ISR_CLEAR       equ     (yx6_drumA_clear-yx6_drumA)+3
  966           =00000042               ISR_SIDON       equ     yx6_sidA_on-yx6_drumA
  967           =00000044               ISR_SIDON_SEL   equ     ISR_SIDON+2
  968           =00000046               ISR_SID_VOL     equ     ISR_SIDON+4
  969           =0000004C               ISR_SIDON_NEXT  equ     ISR_SIDON+10
  970           =00000058               ISR_SIDOFF      equ     yx6_sidA_off-yx6_drumA
  971           =0000005A               ISR_SIDOFF_SEL  equ     ISR_SIDOFF+2
  972           =00000062               ISR_SIDOFF_NEXT equ     ISR_SIDOFF+10
  973           =0000006E               ISR_BUZZ        equ     yx6_buzzA-yx6_drumA
  974           =00000072               ISR_BUZZ_SHAPE  equ     ISR_BUZZ+4
  975                                   
  976                                   ; -----------------------------------------------------------------------------
  977                                   ; yx6_link, from YX6_init: the run-time addresses only a loaded player knows.
  978                                   ; Each descriptor gets its ISR block and its partner, both slots' last code
  979                                   ; and count are cleared, and the SID halves get each other's address low
  980                                   ; word - the vector's high word never changes, and neither do these, so
  981                                   ; they are patched once here rather than on every SID start.
  982                                   ; -----------------------------------------------------------------------------
  983                                   yx6_link:
  984  00000622  41FAFED8                       lea     yx6_desc1(pc),a0
  985  00000626  43FAFEE8                       lea     yx6_desc2(pc),a1
  986  0000062A  21490010                       move.l  a1,SD_OTHER(a0)
  987  0000062E  23480010                       move.l  a0,SD_OTHER(a1)
  988  00000632  4250                           clr.w   (a0)                    ; E and T last, both slots
  989  00000634  4251                           clr.w   (a1)
  990  00000636  45FAFEEC                       lea     yx6_drumA(pc),a2
  991  0000063A  214A000C                       move.l  a2,SD_ISR(a0)
  992  0000063E  61xx                           bsr.s   .partners
  993  00000640  45FAFF60                       lea     yx6_drumD(pc),a2
  994  00000644  234A000C                       move.l  a2,SD_ISR(a1)
  995                                   .partners:
  996  00000648  41EA0058                       lea     ISR_SIDOFF(a2),a0       ; each half installs the other
  997  0000064C  2008                           move.l  a0,d0
  998  0000064E  3540004C                       move.w  d0,ISR_SIDON_NEXT(a2)
  999  00000652  41EA0042                       lea     ISR_SIDON(a2),a0
 1000  00000656  2008                           move.l  a0,d0
 1001  00000658  35400062                       move.w  d0,ISR_SIDOFF_NEXT(a2)
 1002  0000065C  4E75                           rts
 1003                                   
 1004                                   ; -----------------------------------------------------------------------------
 1005                                   ; yx6_slot: one slot of the effect stage - both slots, through a5.
 1006                                   ; A changed code reprograms the slot's timer from scratch, a held one
 1007                                   ; updates only the count (a running MFP timer loads it at its next reload),
 1008                                   ; a dropped one stops the timer - unless the slot ran a drum, which
 1009                                   ; finishes by itself. A held DRUM code is a trigger on EVERY frame it is
 1010                                   ; present, as the reference player starts one on each coded frame: real
 1011                                   ; dumps carry back-to-back codes whose ring bytes name different samples -
 1012                                   ; an attack, then a body - and only a full restart plays the second one.
 1013                                   ;
 1014                                   ; in: d0.b = E (never 0 with E-last also 0: the caller's gate), d1.b = T,
 1015                                   ;     a5 = the slot's descriptor, a3 = workspace, d3.l = N.
 1016                                   ; preserves d3/a3/a5; clobbers d0-d2/d4-d5, a0-a2/a4.
 1017                                   ; -----------------------------------------------------------------------------
 1018                                   yx6_slot:
 1019  0000065E  B015                           cmp.b   (a5),d0
 1020  00000660  6700xxxx                       beq.w   .held
 1021  00000664  1815                           move.b  (a5),d4                 ; what the slot was doing before
 1022  00000666  1A80                           move.b  d0,(a5)
 1023  00000668  4A00                           tst.b   d0
 1024  0000066A  6700xxxx                       beq.w   .released
 1025                                   ; A new code: find the parameter register's ring - r8+voice carries the SID
 1026                                   ; volume, the drum number or the buzzer shape - then let the type arm its
 1027                                   ; handler; every type then (re)programs the timer the same way. The voice
 1028                                   ; stays live in d5, the parameter byte in a1, for whoever needs them.
 1029  0000066E  1A00                           move.b  d0,d5
 1030  00000670  E80D                           lsr.b   #4,d5
 1031  00000672  CA7C0003                       and.w   #3,d5
 1032  00000676  5345                           subq.w  #1,d5                   ; the voice, 0..2
 1033  00000678  3805                           move.w  d5,d4
 1034  0000067A  5044                           addq.w  #8,d4
 1035  0000067C  C8EB0024                       mulu.w  YX6_N(a3),d4
 1036  00000680  2B440008                       move.l  d4,SD_PARM(a5)
 1037  00000684  2253                           movea.l YX6_CURSOR(a3),a1
 1038  00000686  D3C4                           adda.l  d4,a1                   ; a1 = the slot's parameter byte
 1039  00000688  1400                           move.b  d0,d2
 1040  0000068A  C43C00C0                       and.b   #$C0,d2
 1041  0000068E  67xx                           beq.s   .sid
 1042  00000690  B43C0040                       cmp.b   #$40,d2
 1043  00000694  67xx                           beq.s   .drum
 1044  00000696  1811                           move.b  (a1),d4                 ; $C0, the buzzer ($80 never packs):
 1045  00000698  C83C000F                       and.b   #15,d4                  ; the shape rides the tick's immediate
 1046  0000069C  206D000C                       movea.l SD_ISR(a5),a0
 1047  000006A0  11440072                       move.b  d4,ISR_BUZZ_SHAPE(a0)
 1048  000006A4  41E8006E                       lea     ISR_BUZZ(a0),a0
 1049  000006A8  60xx                           bra.s   .armed
 1050                                   .sid:
 1051                                   ; While a drum owns this voice, its volume register is the drum's alone: the
 1052                                   ; SID stays un-armed and the cleared last-code makes every following frame
 1053                                   ; retry, so it comes back by itself the frame after the drum ends. That is
 1054                                   ; the reference player's priority, where the drum overrides the volume.
 1055  000006AA  7801                           moveq   #1,d4
 1056  000006AC  EB2C                           lsl.b   d5,d4
 1057  000006AE  C83AFF70                       and.b   yx6_drums(pc),d4
 1058  000006B2  67xx                           beq.s   .sid_free
 1059  000006B4  4215                           clr.b   (a5)
 1060  000006B6  4E75                           rts
 1061                                   .sid_free:
 1062  000006B8  3805                           move.w  d5,d4                   ; the SID start: the voice's volume
 1063  000006BA  5044                           addq.w  #8,d4                   ; register into both halves' selects
 1064  000006BC  206D000C                       movea.l SD_ISR(a5),a0
 1065  000006C0  11440044                       move.b  d4,ISR_SIDON_SEL(a0)
 1066  000006C4  1144005A                       move.b  d4,ISR_SIDOFF_SEL(a0)
 1067  000006C8  1811                           move.b  (a1),d4
 1068  000006CA  C83C000F                       and.b   #15,d4
 1069  000006CE  11440046                       move.b  d4,ISR_SID_VOL(a0)      ; the loud half's volume
 1070  000006D2  41E80042                       lea     ISR_SIDON(a0),a0
 1071  000006D6  60xx                           bra.s   .armed
 1072                                   .drum:
 1073  000006D8  6100xxxx                       bsr     yx6_drum_start
 1074                                   .armed:
 1075  000006DC  1B410001                       move.b  d1,SD_TLAST(a5)
 1076  000006E0  326D0002                       movea.w SD_CTRL(a5),a1
 1077  000006E4  346D0006                       movea.w SD_VEC(a5),a2
 1078  000006E8  40E7                           move.w  sr,-(sp)
 1079  000006EA  007C0700                       ori.w   #$0700,sr
 1080  000006EE  021100F0                       andi.b  #$F0,(a1)               ; stop, then vector, count, prescaler
 1081  000006F2  2488                           move.l  a0,(a2)
 1082  000006F4  346D0004                       movea.w SD_DATA(a5),a2
 1083  000006F8  1481                           move.b  d1,(a2)
 1084  000006FA  1A00                           move.b  d0,d5
 1085  000006FC  CA3C0007                       and.b   #7,d5
 1086  00000700  8B11                           or.b    d5,(a1)
 1087  00000702  46DF                           move.w  (sp)+,sr
 1088  00000704  4E75                           rts
 1089                                   .released:
 1090  00000706  C83C00C0                       and.b   #$C0,d4                 ; the level dropped: stop the timer -
 1091  0000070A  B83C0040                       cmp.b   #$40,d4                 ; unless a drum is finishing by itself
 1092  0000070E  67xx                           beq.s   .out
 1093  00000710  326D0002                       movea.w SD_CTRL(a5),a1
 1094  00000714  021100F0                       andi.b  #$F0,(a1)
 1095                                   .out:
 1096  00000718  4E75                           rts
 1097                                   .held:                                  ; E != 0 here: the caller's gate
 1098  0000071A  1A00                           move.b  d0,d5
 1099  0000071C  CA3C00C0                       and.b   #$C0,d5
 1100  00000720  BA3C0040                       cmp.b   #$40,d5
 1101  00000724  67B2                           beq.s   .drum                   ; a held drum code triggers again
 1102  00000726  B22D0001                       cmp.b   SD_TLAST(a5),d1         ; reload only a CHANGED count: a write
 1103  0000072A  67xx                           beq.s   .track                  ; meeting the counter at 01 is
 1104  0000072C  1B410001                       move.b  d1,SD_TLAST(a5)         ; indeterminate, so do not roll dice
 1105  00000730  346D0004                       movea.w SD_DATA(a5),a2          ; fifty times a second
 1106  00000734  1481                           move.b  d1,(a2)
 1107                                   .track:
 1108                                   ; The level-held effects track their parameter every frame: the SID volume
 1109                                   ; and the buzzer shape follow the voice's ring byte, as the reference player
 1110                                   ; re-reads them.
 1111  00000736  2053                           movea.l YX6_CURSOR(a3),a0
 1112  00000738  D1ED0008                       adda.l  SD_PARM(a5),a0
 1113  0000073C  1810                           move.b  (a0),d4
 1114  0000073E  C83C000F                       and.b   #15,d4
 1115  00000742  206D000C                       movea.l SD_ISR(a5),a0
