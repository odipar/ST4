    1           =00000001               ST4_UNIT    equ     1
    2                                           include "YX6.S"
    1                                   ; -----------------------------------------------------------------------------
    2                                   ; YX6.S - streaming YM chiptune player for the plain 68000 (Atari ST)
    3                                   ;
    4                                   ; By Robbert van Dalen. Plays a .yx6 file: eighteen streams - the fourteen
    5                                   ; YM2149 registers plus each effect slot's control byte and timer count -
    6                                   ; every one packed as its own embedded ST4 container and decoded through its
    7                                   ; own small ring by ST4_wrap.S. Written by Claude (Anthropic's Claude Code)
    8                                   ; under Robbert's direction, based on ZX1 v1.5 by Einar Saukas and inspired
    9                                   ; by Steve Clarets' MinYMiser. Use it freely, including commercially, as long
   10                                   ; as your documentation says you used ZX1 through ST4 (see LICENSE).
   11                                   ;
   12                                   ; It plays the fourteen standard sound registers, loops, and plays the YM
   13                                   ; special effects - digidrums, SID voices, the sync-buzzer - on MFP Timers
   14                                   ; A and D. Sinus-SID, which no player has ever implemented, is dropped at
   15                                   ; pack time. EFFECTS.md, next to this file, holds the design.
   16                                   ;
   17                                   ; REQUIRES ST4_wrap.S, built for the SAME unit size the tune was packed with
   18                                   ; (yx6 -kK; byte units unless the packer was told otherwise). Include both, in
   19                                   ; either order, with the unit size defined first:
   20                                   ;
   21                                   ;       ST4_UNIT    equ     1
   22                                   ;               include "YX6.S"
   23                                   ;               include "ST4_wrap.S"
   24                                   ;
   25                                   ; YX6 calls ST4_init and ST4_resume by label, and YX6_init checks every
   26                                   ; section's ST4 signature against this build's unit size - a tune packed for
   27                                   ; a different one is rejected, not garbled.
   28                                   ;
   29                                   ; -----------------------------------------------------------------------------
   30                                   ; THE DESIGN, in one paragraph. A tune is O frames long. Each of the eighteen
   31                                   ; streams gets its own ring of N bytes and its own saved decoder state, and
   32                                   ; is decoded C values at a time (C = 24 by default). On every VBL the player
   33                                   ; uses one value from each of the eighteen rings and refills exactly one
   34                                   ; stream - stream k on the VBL where the frame number modulo C is k. With
   35                                   ; C >= 18 every stream is refilled once per C frames, one refill per VBL, so
   36                                   ; the work per frame is flat: the effect stage, fourteen register writes and
   37                                   ; one ST4_resume of C bytes. Since C divides N and a call never reaches the
   38                                   ; ring end, ST4_wrap.S is the decoder that fits: the player counts the calls
   39                                   ; itself and wraps the write pointer when it lands on the ring end.
   40                                   ;
   41                                   ; EFFECTS. The last four rings carry each slot's effect code and timer count,
   42                                   ; one value per frame like everything else. Before the burst the effect stage
   43                                   ; pops them and programs Timers A and D, whose tick handlers - digidrum, SID
   44                                   ; square, sync-buzzer - write the sound chip between frames. A drum start
   45                                   ; also edits this frame's ring bytes (the sample number, the mixer); every
   46                                   ; such edit is logged and undone right after the burst, because a ring is
   47                                   ; decode history that later matches copy from.
   48                                   ;
   49                                   ; LOOPING. A packed stream can only be restarted from its beginning, so the packer
   50                                   ; splits every register at the loop frame L: an intro stream for frames [0, L)
   51                                   ; and a loop stream for [L, O). When a register's section runs out mid-refill
   52                                   ; the player starts its loop stream over - a fresh decoder writing on into the
   53                                   ; same ring - so the rings always hold one continuous sequence of values and
   54                                   ; the read side never learns that anything happened. Nothing requires L to fall
   55                                   ; on a group boundary: a refill that straddles the split simply decodes two
   56                                   ; pieces. A tune that loops from frame 0 has no intro streams at all.
   57                                   ;
   58                                   ; -----------------------------------------------------------------------------
   59                                   ; USING IT
   60                                   ;
   61                                   ;       lea     song,a0                 ; the .yx6 file, loaded anywhere
   62                                   ;       lea     workspace,a1            ; even address, YX6_SIZE bytes
   63                                   ;       bsr     YX6_init                ; d0 = 0 when the file was accepted
   64                                   ;       tst.l   d0
   65                                   ;       bne     bad_file
   66                                   ;   vbl:                                ; once per frame, in supervisor mode
   67                                   ;       lea     workspace,a0
   68                                   ;       bsr     YX6_play                ; d0 = 0 played, 1 wrapped, -1 ended
   69                                   ;       ...
   70                                   ;       lea     workspace,a0
   71                                   ;       bsr     YX6_stop                ; chip quiet, timers stopped
   72                                   ;
   73                                   ; The workspace holds the player's own fields, the eighteen decoder states and
   74                                   ; the eighteen rings, so its size depends on the ring size in the file:
   75                                   ;
   76                                   ;   YX6_SIZE = YX6_FIXED + 18 * N       ; 1222 + 18 * N bytes
   77                                   ;
   78                                   ; For the default 960-byte rings that is 18502 bytes. A program that knows N
   79                                   ; at build time can reserve it with
   80                                   ;
   81                                   ;       ds.b    YX6_FIXED+(YX6_STREAMS*960)
   82                                   ;
   83                                   ; where the parentheses matter: rmac evaluates expressions left to right.
   84                                   ;
   85                                   ; CALLS AND REGISTERS
   86                                   ;
   87                                   ;   YX6_init   in   a0 = .yx6 file, at an even address, a1 = workspace
   88                                   ;              out  d0 = 0 accepted, -1 not a v4 yx6 file with 18 streams
   89                                   ;                        packed at this build's unit size
   90                                   ;              Claims MFP Timers A and D for the effect slots: stops them,
   91                                   ;              parks their vectors, drops stale pendings, enables and
   92                                   ;              unmasks both. It saves NOTHING - the machine state is the
   93                                   ;              host's, see assumption 5. Timer B stays free for rasters,
   94                                   ;              Timer C stays the system's. Pair every init with a stop
   95                                   ;   YX6_play   in   a0 = workspace
   96                                   ;              out  d0 = 0 played a frame
   97                                   ;                   d0 = 1 played a frame, and that frame ended the tune: the
   98                                   ;                          next one is the loop frame L
   99                                   ;                   d0 = -1 the tune is over and nothing was written, which
  100                                   ;                          only a tune packed with -o can report
  101                                   ;   YX6_stop   in   a0 = workspace
  102                                   ;              Quiesces: stops both timers, disables their interrupts,
  103                                   ;              drops pendings, silences the three voices. Restores nothing
  104                                   ;   CLOBBERED  d0-d5, a0-a5. d6, d7 and a6 survive, as with ST4 - whose
  105                                   ;              decoder state spans a4 and a5, which is why they no longer do.
  106                                   ;
  107                                   ; YX6_play writes to the sound chip at $FFFF8800, so it must run in supervisor
  108                                   ; mode - which a VBL handler already does. It masks interrupts around the
  109                                   ; fourteen writes, because selecting a register and writing it are two bus
  110                                   ; cycles and TOS's own handlers use the chip too. Its effect stage programs
  111                                   ; the two timers YX6_init claimed, vectors included, and beyond those it
  112                                   ; performs no side effect: no memory allocation, nothing outside the
  113                                   ; workspace, the chip and the claimed timers.
  114                                   ;
  115                                   ; ASSUMPTIONS (unchecked beyond the magic, version and stream count):
  116                                   ;
  117                                   ;   1. the file comes from the yx6 packer, which enforces C >= 18, N mod C = 0,
  118                                   ;      N >= 2C, N <= 2520 - the burst reads each register's ring through an
  119                                   ;      assembled-in 16-bit displacement of k*N - offsets that stay inside the
  120                                   ;      ring, and - at ST4_UNIT above 1 - a tune length, loop frame and C that
  121                                   ;      are whole units, so every budget this player passes to the decoder
  122                                   ;      divides cleanly
  123                                   ;   2. the workspace is at an even address and large enough for the file's N
  124                                   ;   3. YX6_play is called once per frame and never after it returns -1.
  125                                   ;      Calling it again is harmless - it returns -1 and writes nothing - which
  126                                   ;      is what keeps ST4_wrap's "never call the decoder again" rule intact
  127                                   ;   4. a looping tune plays for as long as you keep calling: d0 = 1 marks each
  128                                   ;      time round, and YX6_init is only needed to start again from frame 0
  129                                   ;   5. the HOST owns the machine state - the player saves and restores none
  130                                   ;      of it. A host that wants the machine back afterwards saves, around
  131                                   ;      init..stop, exactly what the player touches: the vectors $134 and
  132                                   ;      $110, TACR, TADR, TDDR, TCDCR's low (Timer D) nibble, bit 5 of IERA
  133                                   ;      and IMRA, bit 4 of IERB and IMRB - and, built with YX6_SUPER_HOST,
  134                                   ;      the USP, which the drum tick parks a0 in. A demo that has already
  135                                   ;      taken the machine over saves nothing at all. YX6_player.S is the
  136                                   ;      worked example of the polite version
  137                                   ; -----------------------------------------------------------------------------
  138                                   
  139                                   ; A host that never runs user-mode code while the player is live - a demo
  140                                   ; under its own takeover, say - may define YX6_SUPER_HOST equ 1 before
  141                                   ; including this file: the drum tick then parks a0 in the then-unused USP
  142                                   ; (4 cycles each way instead of 12 through the stack). The park restores a0
  143                                   ; but not the USP: a host that ever returns to user mode must save its USP
  144                                   ; before YX6_init and restore it after YX6_stop, with the rest of the
  145                                   ; machine state assumption 5 lists. Default off, because a program that
  146                                   ; hooks the VBL from user mode has a live USP at every tick.
  147                                           .if ^^defined YX6_SUPER_HOST
  148                                 -         .else
  149           =00000000               YX6_SUPER_HOST  equ     0
  150                                           .endif
  151                                   
  152           =00000012               YX6_STREAMS     equ     18              ; R0..R13, then E1 T1 E2 T2: the two
  153                                                                           ; effect slots' control and timer-count
  154                                                                           ; streams, decoded like any register
  155           =0000000E               YX6_REGISTERS   equ     14              ; the streams the burst writes
  156           =00000040               YX6_STATE_SIZE  equ     64              ; per stream, so the index is a shift
  157                                                                           ; both ways: *64 in, /16 back to *4
  158                                   
  159                                   ; Workspace layout. Counters that a frame touches are kept in the form the
  160                                   ; frame wants them in: a pointer to walk, and a countdown to test against zero.
  161           =00000000               YX6_CURSOR      equ     0               ; long  this frame's byte in ring 0
  162           =00000004               YX6_LEFTFR      equ     4               ; long  frames before the tune ends
  163           =00000008               YX6_NEXT        equ     8               ; long  values decoded so far
  164           =0000000C               YX6_RINGEND     equ     12              ; long  one past ring 0, where it wraps
  165           =00000010               YX6_RINGS       equ     16              ; long  base of the ring area
  166           =00000014               YX6_FILE        equ     20              ; long  the .yx6 file
  167           =00000018               YX6_TOTAL       equ     24              ; long  O, the tune length in frames
  168           =0000001C               YX6_LOOPLEN     equ     28              ; long  O - L, zero when it does not loop
  169           =00000020               YX6_LOOP        equ     32              ; long  L, read at init to split sections
  170           =00000024               YX6_N           equ     36              ; word  ring size N
  171           =00000026               YX6_C           equ     38              ; word  values per call C
  172           =00000028               YX6_SLOT        equ     40              ; word  refill slot, 0..C-1
  173           =0000002A               YX6_INDEX       equ     42              ; word  stream index, during init only
  174           =0000002C               YX6_LOOPS       equ     44              ; word  nonzero when the tune loops
  175           =0000002E               YX6_EFXOFF      equ     46              ; long  14*N: the cursor's ring to E1's
  176           =00000032               YX6_R7OFF       equ     50              ; long  7*N: the cursor's ring to R7's
  177                                   ; The sanitize log. The effect stage edits ring bytes so the burst plays a
  178                                   ; sanitized frame - but the ring is decode history, and a later match may
  179                                   ; copy from any byte of it. So every edit is recorded here and undone right
  180                                   ; after the burst: the chip sees the edit, the ring never keeps it.
  181           =00000036               YX6_PATCHES     equ     54              ; byte  how many edits this frame, 0..3
  182           =00000037               YX6_PATCH_VAL   equ     55              ; 3 bytes: the originals
  183           =0000003A               YX6_PATCH_ADDR  equ     58              ; 3 longs: where they go back
  184           =00000046               YX6_STATE       equ     70              ; 18 decoder states, from an even base
  185                                   
  186                                   ; Each effect slot's own state - its code and count from last frame, its
  187                                   ; parameter ring offset, its timer and its handlers - lives in a descriptor
  188                                   ; in the code blob (yx6_desc1/2 below), so ONE slot machine serves both
  189                                   ; slots. The hardware addresses are words: movea.w sign-extends $FAxx to
  190                                   ; $FFFFFAxx. The two run-time pointers are filled in by YX6_init.
  191           =00000000               SD_ELAST        equ     0               ; byte  the slot's code last frame
  192           =00000001               SD_TLAST        equ     1               ; byte  the count its timer last got:
  193                                                                           ; a held effect reloads its data
  194                                                                           ; register only when the count CHANGES,
  195                                                                           ; because a write that lands while the
  196                                                                           ; counter passes 01 loads an
  197                                                                           ; indeterminate value - pitch glitches
  198           =00000002               SD_CTRL         equ     2               ; word  timer control register
  199           =00000004               SD_DATA         equ     4               ; word  timer data register
  200           =00000006               SD_VEC          equ     6               ; word  timer vector
  201           =00000008               SD_PARM         equ     8               ; long  (8+voice)*N: the cursor's ring
  202                                                                           ;       to the slot's parameter byte
  203           =0000000C               SD_ISR          equ     12              ; long  the slot's tick handlers
  204           =00000010               SD_OTHER        equ     16              ; long  the other slot's descriptor
  205                                   ; rmac evaluates left to right, so the parentheses here are load-bearing:
  206                                   ; without them this reads as (YX6_STATE+YX6_STREAMS)*YX6_STATE_SIZE.
  207           =000004C6               YX6_FIXED       equ     YX6_STATE+(YX6_STREAMS*YX6_STATE_SIZE)
  208                                   
  209                                   ; One saved ST4_wrap state, plus the ring bounds the wrap check needs. The
  210                                   ; first four longs are in movem order - d1, d2, then a0, a1 - so that much of
  211                                   ; the decoder state loads and stores in one instruction; the three extra
  212                                   ; stream pointers ST4 carries (literals, byte offsets, word offsets) follow.
  213           =00000000               YS_D1           equ     0               ; long  d1, -ring.low : remaining
  214           =00000004               YS_D2           equ     4               ; long  d2, N : signed offset
  215           =00000008               YS_INPUT        equ     8               ; long  a0, stream A position
  216           =0000000C               YS_WRITE        equ     12              ; long  a1, write pointer
  217           =00000010               YS_LIT          equ     16              ; long  a2, stream B position
  218           =00000014               YS_BOFF         equ     20              ; long  a4, stream C position
  219           =00000018               YS_WOFF         equ     24              ; long  a5, stream D position
  220           =0000001C               YS_QUEUE        equ     28              ; word  d0, bit queue
  221           =00000020               YS_START        equ     32              ; long  this stream's ring
  222           =00000024               YS_END          equ     36              ; long  one past its last byte
  223           =00000028               YS_LEFT         equ     40              ; long  values left in the current section
  224                                   ; The movem block starts at the top of the state, so the two movems address it
  225                                   ; as plain (a2) - see the note where they are used.
  226                                   
  227                                   ; The .yx6 header, as written by the packer.
  228           =00000000               YH_MAGIC        equ     0
  229           =00000004               YH_VERSION      equ     4
  230           =00000006               YH_FLAGS        equ     6
  231           =00000008               YH_FRAMES       equ     8
  232           =0000000C               YH_PLAYER_HZ    equ     12
  233           =0000000E               YH_STREAM_COUNT equ     14
  234           =00000010               YH_RING         equ     16
  235           =00000012               YH_CHUNK        equ     18
  236           =00000014               YH_LOOP         equ     20
  237           =00000018               YH_CLOCK        equ     24
  238           =0000001C               YH_DRUMS        equ     28              ; long: the drum table, 0 when none
  239           =00000020               YH_DRUMCOUNT    equ     32              ; word
  240           =00000022               YH_INTRO_TABLE  equ     34              ; 18 offsets: the frames before the loop
  241           =0000006A               YH_LOOP_TABLE   equ     106             ; 18 offsets: the frames from L on
  242                                   
  243           =59583621               YX6_MAGIC       equ     $59583621       ; 'YX6!'
  244           =00000004               YX6_VERSION     equ     4               ; 4: effect streams and the drum table
  245           =00000001               YX6_FLAG_LOOPS  equ     1               ; header flag: the tune loops
  246           =FFFF8800               YX6_PSG         equ     $FFFF8800       ; select/read at +0, write at +2
  247           =000000FF               YX6_NO_ENV      equ     $FF             ; R13 value meaning "leave it alone"
  248           =000000C0               YX6_PORTS       equ     $C0             ; R7 bits the ST needs as outputs
  249           =00000007               YX6_MIXER       equ     7
  250           =0000000D               YX6_ENVELOPE    equ     13
  251                                   
  252                                   ; -----------------------------------------------------------------------------
  253                                   ; YX6_WRITE: send one register's value straight from its ring to the sound
  254                                   ; chip, then step a1 on to the next register's ring.
  255                                   ;
  256                                   ; Two moves and an add, with the register number assembled in as an immediate:
  257                                   ; nothing is tested, nothing is counted, and the value never passes through a
  258                                   ; data register. Register k's ring byte sits k*N above the cursor, and N is
  259                                   ; known at init: the displacement is patched into the instruction there,
  260                                   ; once, so the burst never steps a pointer. The $7FFF placeholder is
  261                                   ; load-bearing - a zero displacement would let rmac's +o3 fold the extension
  262                                   ; word away and shift every patch site. Registers 7 and 13 need their values
  263                                   ; touched, so they are written out of line rather than through this macro.
  264                                   ;
  265                                   ; Skipping a register whose value has not changed was measured and dropped: a
  266                                   ; sound-chip access on an ST costs about 1.5 cycles more than a RAM one, so the
  267                                   ; compare that would save the write costs about as much as the write.
  268                                   ; -----------------------------------------------------------------------------
  269                                           .macro YX6_WRITE number
  270                                 .         move.b  #\number,(a2)           ; select
  271                                 .         move.b  $7FFF(a1),2(a2)         ; and write - SMC: k*N, set at init
  272                                 .         .endm
  273                                   
  274                                   ; Jump table: bra.w keeps 4-byte slots for a program that loads YX6 as a blob.
  275  00000000  6000xxxx                               bra.w   YX6_init
  276  00000004  6000xxxx                               bra.w   YX6_play
  277  00000008  6000xxxx                               bra.w   YX6_stop
  278                                   
  279                                   ; -----------------------------------------------------------------------------
  280                                   ; YX6_init: a0 = .yx6 file, a1 = workspace. Sets up eighteen decoders, decodes
  281                                   ; each stream's first group so frame 0 can be played immediately, and takes
  282                                   ; over MFP Timers A and D for the effect slots.
  283                                   ; -----------------------------------------------------------------------------
  284                                   YX6_init:
  285  0000000C  2649                           movea.l a1,a3                   ; a3 is the workspace throughout
  286  0000000E  27480014                       move.l  a0,YX6_FILE(a3)
  287  00000012  0C9059583621                   cmp.l   #YX6_MAGIC,YH_MAGIC(a0)
  288  00000018  6600xxxx                       bne     .rejected
  289  0000001C  0C6800040004                   cmp.w   #YX6_VERSION,YH_VERSION(a0)
  290  00000022  6600xxxx                       bne     .rejected
  291  00000026  0C680012000E                   cmp.w   #YX6_STREAMS,YH_STREAM_COUNT(a0)
  292  0000002C  6600xxxx                       bne     .rejected
  293                                   
  294  00000030  276800080018                   move.l  YH_FRAMES(a0),YX6_TOTAL(a3)
  295  00000036  276800140020                   move.l  YH_LOOP(a0),YX6_LOOP(a3)
  296  0000003C  376800100024                   move.w  YH_RING(a0),YX6_N(a3)
  297  00000042  376800120026                   move.w  YH_CHUNK(a0),YX6_C(a3)
  298  00000048  30280006                       move.w  YH_FLAGS(a0),d0
  299  0000004C  C07C0001                       and.w   #YX6_FLAG_LOOPS,d0
  300  00000050  3740002C                       move.w  d0,YX6_LOOPS(a3)
  301  00000054  276800080004                   move.l  YH_FRAMES(a0),YX6_LEFTFR(a3)
  302  0000005A  426B0028                       clr.w   YX6_SLOT(a3)
  303  0000005E  43EB04C6                       lea     YX6_FIXED(a3),a1        ; the rings follow the decoder states
  304  00000062  27490010                       move.l  a1,YX6_RINGS(a3)
  305  00000066  2689                           move.l  a1,YX6_CURSOR(a3)       ; frame 0 is the first byte of ring 0
  306  00000068  7000                           moveq   #0,d0
  307  0000006A  30280010                       move.w  YH_RING(a0),d0
  308  0000006E  D089                           add.l   a1,d0
  309  00000070  2740000C                       move.l  d0,YX6_RINGEND(a3)      ; where the cursor goes back to the top
  310                                   
  311  00000074  202B0018                       move.l  YX6_TOTAL(a3),d0        ; the loop section is O - L frames long,
  312  00000078  90AB0020                       sub.l   YX6_LOOP(a3),d0         ; and empty when the tune plays once
  313  0000007C  4A6B002C                       tst.w   YX6_LOOPS(a3)
  314  00000080  66xx                           bne.s   .loop_length
  315  00000082  7000                           moveq   #0,d0
  316                                   .loop_length:
  317  00000084  2740001C                       move.l  d0,YX6_LOOPLEN(a3)
  318                                   
  319  00000088  7200                           moveq   #0,d1                   ; the first group is C values, or the
  320  0000008A  322B0026                       move.w  YX6_C(a3),d1            ; whole tune when that is shorter and
  321  0000008E  4A6B002C                       tst.w   YX6_LOOPS(a3)           ; there is no loop to carry on into
  322  00000092  66xx                           bne.s   .first_group
  323  00000094  202B0018                       move.l  YX6_TOTAL(a3),d0
  324  00000098  B081                           cmp.l   d1,d0
  325  0000009A  64xx                           bcc.s   .first_group
  326  0000009C  2200                           move.l  d0,d1
  327                                   .first_group:
  328  0000009E  27410008                       move.l  d1,YX6_NEXT(a3)         ; values decoded once init is done
  329                                   
  330  000000A2  426B002A                       clr.w   YX6_INDEX(a3)           ; the loop counter lives here: every
  331                                   .stream:                                ; register is state during the calls
  332  000000A6  302B002A                       move.w  YX6_INDEX(a3),d0
  333  000000AA  ED48                           lsl.w   #6,d0                   ; * YX6_STATE_SIZE
  334  000000AC  45F30046                       lea     YX6_STATE(a3,d0.w),a2
  335  000000B0  7600                           moveq   #0,d3
  336  000000B2  362B0024                       move.w  YX6_N(a3),d3
  337  000000B6  302B002A                       move.w  YX6_INDEX(a3),d0
  338  000000BA  C0C3                           mulu.w  d3,d0                   ; this stream's ring is the k'th
  339  000000BC  226B0010                       movea.l YX6_RINGS(a3),a1
  340  000000C0  D3C0                           adda.l  d0,a1
  341  000000C2  25490020                       move.l  a1,YS_START(a2)
  342  000000C6  2549000C                       move.l  a1,YS_WRITE(a2)
  343  000000CA  2009                           move.l  a1,d0
  344  000000CC  D083                           add.l   d3,d0
  345  000000CE  25400024                       move.l  d0,YS_END(a2)
  346                                   
  347                                   ; A tune that loops from frame 0 has no intro streams, so its registers start
  348                                   ; on the loop section - which is then the whole tune. The load of L comes
  349                                   ; last because it is the branch condition: a move to a data register writes
  350                                   ; the flags, a lesson the original version of this choice taught by always
  351                                   ; picking the intro table and leaning on the section-exhausted path to
  352                                   ; recover. The signature check below ended that arrangement.
  353  000000D2  383C0022                       move.w  #YH_INTRO_TABLE,d4
  354  000000D6  202B0020                       move.l  YX6_LOOP(a3),d0
  355  000000DA  66xx                           bne.s   .section                ; L != 0: the intro covers [0, L)
  356  000000DC  383C006A                       move.w  #YH_LOOP_TABLE,d4
  357  000000E0  202B001C                       move.l  YX6_LOOPLEN(a3),d0
  358                                   .section:
  359  000000E4  25400028                       move.l  d0,YS_LEFT(a2)          ; values before this stream runs out
  360                                   
