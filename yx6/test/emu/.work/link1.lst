  408  00000168  007C0700                       ori.w   #$0700,sr
  409  0000016C  4E68                           move    usp,a0                  ; the drum tick may park a0 in it
  410  0000016E  27480054                       move.l  a0,YX6_OLDUSP(a3)
  411  00000172  277801340036                   move.l  $134.w,YX6_OLDTA(a3)
  412  00000178  27780110003A                   move.l  $110.w,YX6_OLDTD(a3)
  413  0000017E  1778FA19003E                   move.b  $FFFFFA19.w,YX6_OLDTACR(a3)
  414  00000184  1778FA1D003F                   move.b  $FFFFFA1D.w,YX6_OLDTCDCR(a3)
  415  0000018A  1778FA1F0040                   move.b  $FFFFFA1F.w,YX6_OLDTADR(a3)
  416  00000190  1778FA250041                   move.b  $FFFFFA25.w,YX6_OLDTDDR(a3)
  417  00000196  41FAxxxx                       lea     yx6_mfpbits(pc),a0      ; which of the four enable/mask bits
  418  0000019A  7000                           moveq   #0,d0                   ; are set - the countdown numbers them
  419  0000019C  7403                           moveq   #3,d2                   ; so the encoding is unchanged:
  420                                   .mfpbit:                                ; bit 0 IERA5 .. bit 3 IMRB4
  421  0000019E  3258                           movea.w (a0)+,a1
  422  000001A0  3218                           move.w  (a0)+,d1
  423  000001A2  0311                           btst    d1,(a1)
  424  000001A4  67xx                           beq.s   .mfpoff
