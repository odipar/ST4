  657                                   
  658  000003CA  1211                           move.b  (a1),d1                 ; R13 restarts the envelope whenever it
  659  000003CC  B23C00FF                       cmp.b   #YX6_NO_ENV,d1          ; is written, so $FF means leave it be
  660  000003D0  67xx                           beq.s   .envelope_held
  661  000003D2  14BC000D                       move.b  #YX6_ENVELOPE,(a2)
  662  000003D6  15410002                       move.b  d1,2(a2)
  663                                   .envelope_held:
  664  000003DA  46DF                           move.w  (sp)+,sr
  665                                   
  666                                   ; Undo this frame's ring edits: the chip has heard the sanitized frame, and
  667                                   ; the ring must stay exact decode history for every match yet to come.
  668  000003DC  102B0043                       move.b  YX6_PATCHES(a3),d0
  669  000003E0  67xx                           beq.s   .pristine
  670  000003E2  422B0043                       clr.b   YX6_PATCHES(a3)         ; cleared only when it was used
  671  000003E6  41EB0048                       lea     YX6_PATCH_ADDR(a3),a0
  672  000003EA  43EB0044                       lea     YX6_PATCH_VAL(a3),a1
  673                                   .restore:
  674  000003EE  2458                           movea.l (a0)+,a2
  675  000003F0  1499                           move.b  (a1)+,(a2)
  676  000003F2  5300                           subq.b  #1,d0
  677  000003F4  66F8                           bne.s   .restore
  678                                   .pristine:
  679                                   
  680                                   ; Refill the stream whose turn it is. Slots 18..C-1 exist when C is larger
  681                                   ; than the stream count; they simply have nothing to do.
  682  000003F6  302B0028                       move.w  YX6_SLOT(a3),d0
  683  000003FA  B07C0012                       cmp.w   #YX6_STREAMS,d0
  684  000003FE  64xx                           bcc.s   .advance
  685  00000400  7600                           moveq   #0,d3
  686  00000402  362B0026                       move.w  YX6_C(a3),d3            ; a whole group
  687  00000406  4A6B002C                       tst.w   YX6_LOOPS(a3)
  688  0000040A  66xx                           bne.s   .refill                 ; a looping tune never runs out
  689  0000040C  222B0018                       move.l  YX6_TOTAL(a3),d1
  690  00000410  92AB0008                       sub.l   YX6_NEXT(a3),d1         ; values still packed
  691  00000414  6Fxx                           ble.s   .advance                ; all decoded: never call ST4 again
  692  00000416  B283                           cmp.l   d3,d1
  693  00000418  64xx                           bcc.s   .refill
  694  0000041A  2601                           move.l  d1,d3                   ; the last group is a short one
  695                                   .refill:
  696  0000041C  ED48                           lsl.w   #6,d0
  697  0000041E  6100FDD8                       bsr     YX6_fill
  698                                   
  699                                   .advance:
  700  00000422  5293                           addq.l  #1,YX6_CURSOR(a3)       ; one byte along every ring
  701  00000424  2013                           move.l  YX6_CURSOR(a3),d0
  702  00000426  B0AB000C                       cmp.l   YX6_RINGEND(a3),d0
  703  0000042A  65xx                           bcs.s   .cursor_ready
  704  0000042C  26AB0010                       move.l  YX6_RINGS(a3),YX6_CURSOR(a3)
  705                                   .cursor_ready:
  706  00000430  302B0028                       move.w  YX6_SLOT(a3),d0
  707  00000434  5240                           addq.w  #1,d0
  708  00000436  B06B0026                       cmp.w   YX6_C(a3),d0
  709  0000043A  65xx                           bcs.s   .slot_ready
  710  0000043C  7000                           moveq   #0,d0                   ; a cycle ended: the groups move on
  711  0000043E  7200                           moveq   #0,d1
  712  00000440  322B0026                       move.w  YX6_C(a3),d1
  713  00000444  D3AB0008                       add.l   d1,YX6_NEXT(a3)
  714                                   .slot_ready:
  715  00000448  37400028                       move.w  d0,YX6_SLOT(a3)
  716                                   
  717                                   ; The rings hold the tune as one continuous sequence, so reaching the end of
  718                                   ; the last frame simply means the next values in them are the loop section's.
  719                                   ; The countdown follows: it reloads with the loop section's length.
  720  0000044C  53AB0004                       subq.l  #1,YX6_LEFTFR(a3)
  721  00000450  66xx                           bne.s   .played
  722  00000452  4A6B002C                       tst.w   YX6_LOOPS(a3)
  723  00000456  67xx                           beq.s   .played                 ; zero and no loop: the next call ends
  724  00000458  276B001C0004                   move.l  YX6_LOOPLEN(a3),YX6_LEFTFR(a3)
  725  0000045E  7001                           moveq   #1,d0                   ; played, and wrapped to the loop point
  726  00000460  4E75                           rts
  727                                   .played:
  728  00000462  7000                           moveq   #0,d0
  729  00000464  4E75                           rts
