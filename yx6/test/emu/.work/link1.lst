 1111                                   ; -----------------------------------------------------------------------------
 1112                                   ; yx6_drum_start: read the sample number from the drummed voice's ring byte
 1113                                   ; and silence that byte - it is a number, not a volume - flag the voice for
 1114                                   ; the mixer pass, then arm the drum routine: its select register, its sample
 1115                                   ; address, and the flag-clearing mask, all patched into its own operands.
 1116                                   ; If the other slot holds a SID on this same voice, the drum takes the
 1117                                   ; volume register for itself, as the reference player's drum override does:
 1118                                   ; stop that SID's timer and clear its last code, so the slot retries every
 1119                                   ; frame - suppressed while the flag is up - and restarts the SID by itself
 1120                                   ; the frame after the drum ends.
 1121                                   ; Called from the new-code path AND the held retrigger, which has neither
 1122                                   ; the voice nor the parameter pointer at hand - so it derives its own.
 1123                                   ; in: d0.b = E, a5 = the descriptor, SD_PARM set; out: a0 = the handler;
 1124                                   ; keeps d0/d1/d3/a5.
 1125                                   ; -----------------------------------------------------------------------------
 1126                                   yx6_drum_start:
 1127  0000070C  2053                           movea.l YX6_CURSOR(a3),a0
 1128  0000070E  D1ED0008                       adda.l  SD_PARM(a5),a0
 1129  00000712  6100xxxx                       bsr     yx6_borrow              ; the ring gets this byte back
 1130  00000716  7800                           moveq   #0,d4
 1131  00000718  1810                           move.b  (a0),d4                 ; the sample number, validated at pack
 1132  0000071A  4210                           clr.b   (a0)                    ; sanitize: silence, not a number
 1133  0000071C  1A00                           move.b  d0,d5
 1134  0000071E  E80D                           lsr.b   #4,d5
 1135  00000720  CA7C0003                       and.w   #3,d5
 1136  00000724  5345                           subq.w  #1,d5                   ; the voice, for flag and select
 1137  00000726  7401                           moveq   #1,d2
 1138  00000728  EB2A                           lsl.b   d5,d2
 1139  0000072A  41FAFEAA                       lea     yx6_drums(pc),a0
 1140  0000072E  8510                           or.b    d2,(a0)                 ; the mixer pass forces this voice off
 1141  00000730  4602                           not.b   d2
 1142  00000732  226D000C                       movea.l SD_ISR(a5),a1
 1143  00000736  13420037                       move.b  d2,ISR_CLEAR(a1)        ; the end tick drops the same flag
 1144  0000073A  286D0010                       movea.l SD_OTHER(a5),a4         ; a SID on this voice in the other
 1145  0000073E  1414                           move.b  (a4),d2                 ; slot: the drum takes the register
 1146  00000740  C43C00C0                       and.b   #$C0,d2
 1147  00000744  66xx                           bne.s   .keep
 1148  00000746  1414                           move.b  (a4),d2
 1149  00000748  B102                           eor.b   d0,d2
 1150  0000074A  C43C0030                       and.b   #$30,d2
 1151  0000074E  66xx                           bne.s   .keep
 1152  00000750  306C0002                       movea.w SD_CTRL(a4),a0
 1153  00000754  021000F0                       andi.b  #$F0,(a0)               ; stop the other slot's SID
 1154  00000758  4214                           clr.b   (a4)                    ; and let it retry every frame
 1155                                   .keep:
 1156  0000075A  3405                           move.w  d5,d2
 1157  0000075C  5042                           addq.w  #8,d2                   ; the voice's volume register
 1158  0000075E  13420003                       move.b  d2,ISR_DRUM_SEL(a1)     ; the tick's select immediate
 1159  00000762  D844                           add.w   d4,d4                   ; a drum table entry is six bytes:
 1160  00000764  3404                           move.w  d4,d2                   ; 6n = 2n + 4n
 1161  00000766  D844                           add.w   d4,d4
 1162  00000768  D842                           add.w   d2,d4
 1163  0000076A  246B0014                       movea.l YX6_FILE(a3),a2
 1164  0000076E  204A                           movea.l a2,a0
 1165  00000770  D1E8001C                       adda.l  YH_DRUMS(a0),a0
 1166  00000774  24304000                       move.l  0(a0,d4.w),d2           ; the sample's offset in the file
 1167  00000778  D48A                           add.l   a2,d2
 1168  0000077A  23420008                       move.l  d2,ISR_DRUM_PTR(a1)     ; the tick reads through its operand
 1169  0000077E  2049                           movea.l a1,a0                   ; the handler is the block base
 1170  00000780  4E75                           rts
 1171                                   
