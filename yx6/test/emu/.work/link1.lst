  652  0000036C  15697FFF0002         @         move.b  $7FFF(a1),2(a2)         
                                                YX6_WRITE 6                     ; noise period
       00000372  14BC0006             @         move.b  #$6,(a2)           
  653  00000376  15697FFF0002         @         move.b  $7FFF(a1),2(a2)         
  654                                   
  655  0000037C  14BC0007                       move.b  #YX6_MIXER,(a2)         ; R7 also carries the ST's I/O port
  656                                   yx6_w7:
  657  00000380  12297FFF                       move.b  $7FFF(a1),d1            ; directions, which port A needs kept
  658  00000384  823C00C0                       or.b    #YX6_PORTS,d1           ; as outputs for the floppy select
