  541                                   ; -----------------------------------------------------------------------------
  542                                   ; YX6_stop: silence the three voices. Leaves the tone and envelope settings
  543                                   ; alone, so a later YX6_play picks up where it left off.
  544                                   ; -----------------------------------------------------------------------------
  545                                   YX6_stop:
  546  0000036A  41F9FFFF8800                   lea     YX6_PSG,a0
  547  00000370  7008                           moveq   #8,d0                   ; R8, R9, R10 are the voice volumes
  548                                   .silence:
