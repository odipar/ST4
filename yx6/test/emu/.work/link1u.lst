    1           =00000001               ST4_UNIT    equ     1
    2           =00000001               YX6_SUPER_HOST equ  1
    3                                           include "YX6.S"
    1                                   ; -----------------------------------------------------------------------------
    2                                   ; YX6.S - streaming YM chiptune player for the plain 68000 (Atari ST)
    3                                   ;
    4                                   ; By Robbert van Dalen. Plays a .yx6 file: eighteen streams - the fourteen
    5                                   ; YM2149 registers plus each effect slot's control byte and timer count -
    6                                   ; every one packed as its own embedded ST4 container and decoded through its
    7                                   ; own small ring by ST4_wrap.S. Written by Claude (Anthropic's Claude Code)
    8                                   ; under Robbert's direction, based on ZX1 v1.5 by Einar Saukas and inspired
    9                                   ; by Steve Clarets' MinYMiser. Use it freely, including commercially, as long
   10                                   ; as your documentation says you used ZX1 through ST4 (see LICENSE).
   11                                   ;
   12                                   ; It plays the fourteen standard sound registers, loops, and plays the YM
   13                                   ; special effects - digidrums, SID voices, the sync-buzzer - on MFP Timers
   14                                   ; A and D. Sinus-SID, which no player has ever implemented, is dropped at
   15                                   ; pack time. EFFECTS.md, next to this file, holds the design.
   16                                   ;
   17                                   ; REQUIRES ST4_wrap.S, built for the SAME unit size the tune was packed with
   18                                   ; (yx6 -kK; byte units unless the packer was told otherwise). Include both, in
   19                                   ; either order, with the unit size defined first:
   20                                   ;
   21                                   ;       ST4_UNIT    equ     1
   22                                   ;               include "YX6.S"
   23                                   ;               include "ST4_wrap.S"
   24                                   ;
   25                                   ; YX6 calls ST4_init and ST4_resume by label, and YX6_init checks every
   26                                   ; section's ST4 signature against this build's unit size - a tune packed for
   27                                   ; a different one is rejected, not garbled.
   28                                   ;
   29                                   ; -----------------------------------------------------------------------------
   30                                   ; THE DESIGN, in one paragraph. A tune is O frames long. Each of the eighteen
   31                                   ; streams gets its own ring of N bytes and its own saved decoder state, and
   32                                   ; is decoded C values at a time (C = 24 by default). On every VBL the player
   33                                   ; uses one value from each of the eighteen rings and refills exactly one
   34                                   ; stream - stream k on the VBL where the frame number modulo C is k. With
   35                                   ; C >= 18 every stream is refilled once per C frames, one refill per VBL, so
   36                                   ; the work per frame is flat: the effect stage, fourteen register writes and
   37                                   ; one ST4_resume of C bytes. Since C divides N and a call never reaches the
   38                                   ; ring end, ST4_wrap.S is the decoder that fits: the player counts the calls
   39                                   ; itself and wraps the write pointer when it lands on the ring end.
   40                                   ;
   41                                   ; EFFECTS. The last four rings carry each slot's effect code and timer count,
   42                                   ; one value per frame like everything else. Before the burst the effect stage
   43                                   ; pops them and programs Timers A and D, whose tick handlers - digidrum, SID
   44                                   ; square, sync-buzzer - write the sound chip between frames. A drum start
   45                                   ; also edits this frame's ring bytes (the sample number, the mixer); every
   46                                   ; such edit is logged and undone right after the burst, because a ring is
   47                                   ; decode history that later matches copy from.
   48                                   ;
   49                                   ; LOOPING. A packed stream can only be restarted from its beginning, so the packer
   50                                   ; splits every register at the loop frame L: an intro stream for frames [0, L)
   51                                   ; and a loop stream for [L, O). When a register's section runs out mid-refill
   52                                   ; the player starts its loop stream over - a fresh decoder writing on into the
   53                                   ; same ring - so the rings always hold one continuous sequence of values and
   54                                   ; the read side never learns that anything happened. Nothing requires L to fall
   55                                   ; on a group boundary: a refill that straddles the split simply decodes two
   56                                   ; pieces. A tune that loops from frame 0 has no intro streams at all.
   57                                   ;
   58                                   ; -----------------------------------------------------------------------------
   59                                   ; USING IT
   60                                   ;
   61                                   ;       lea     song,a0                 ; the .yx6 file, loaded anywhere
   62                                   ;       lea     workspace,a1            ; even address, YX6_SIZE bytes
   63                                   ;       bsr     YX6_init                ; d0 = 0 when the file was accepted
   64                                   ;       tst.l   d0
   65                                   ;       bne     bad_file
   66                                   ;   vbl:                                ; once per frame, in supervisor mode
   67                                   ;       lea     workspace,a0
   68                                   ;       bsr     YX6_play                ; d0 = 0 played, 1 wrapped, -1 ended
   69                                   ;       ...
   70                                   ;       lea     workspace,a0
   71                                   ;       bsr     YX6_stop                ; chip quiet, timers stopped
   72                                   ;
   73                                   ; The workspace holds the player's own fields, the eighteen decoder states and
   74                                   ; the eighteen rings, so its size depends on the ring size in the file:
   75                                   ;
   76                                   ;   YX6_SIZE = YX6_FIXED + 18 * N       ; 1222 + 18 * N bytes
   77                                   ;
   78                                   ; For the default 960-byte rings that is 18502 bytes. A program that knows N
   79                                   ; at build time can reserve it with
   80                                   ;
   81                                   ;       ds.b    YX6_FIXED+(YX6_STREAMS*960)
   82                                   ;
   83                                   ; where the parentheses matter: rmac evaluates expressions left to right.
   84                                   ;
   85                                   ; CALLS AND REGISTERS
   86                                   ;
   87                                   ;   YX6_init   in   a0 = .yx6 file, at an even address, a1 = workspace
   88                                   ;              out  d0 = 0 accepted, -1 not a v4 yx6 file with 18 streams
   89                                   ;                        packed at this build's unit size
   90                                   ;              Claims MFP Timers A and D for the effect slots: stops them,
   91                                   ;              parks their vectors, drops stale pendings, enables and
   92                                   ;              unmasks both. It saves NOTHING - the machine state is the
   93                                   ;              host's, see assumption 5. Timer B stays free for rasters,
   94                                   ;              Timer C stays the system's. Pair every init with a stop
   95                                   ;   YX6_play   in   a0 = workspace
   96                                   ;              out  d0 = 0 played a frame
   97                                   ;                   d0 = 1 played a frame, and that frame ended the tune: the
   98                                   ;                          next one is the loop frame L
   99                                   ;                   d0 = -1 the tune is over and nothing was written, which
  100                                   ;                          only a tune packed with -o can report
  101                                   ;   YX6_stop   in   a0 = workspace
  102                                   ;              Quiesces: stops both timers, disables their interrupts,
  103                                   ;              drops pendings, silences the three voices. Restores nothing
  104                                   ;   CLOBBERED  d0-d5, a0-a5. d6, d7 and a6 survive, as with ST4 - whose
  105                                   ;              decoder state spans a4 and a5, which is why they no longer do.
  106                                   ;
  107                                   ; YX6_play writes to the sound chip at $FFFF8800, so it must run in supervisor
  108                                   ; mode - which a VBL handler already does. It masks interrupts around the
  109                                   ; fourteen writes, because selecting a register and writing it are two bus
  110                                   ; cycles and TOS's own handlers use the chip too. Its effect stage programs
  111                                   ; the two timers YX6_init claimed, vectors included. Beyond the chip, those
  112                                   ; timers and the workspace, the player writes only ITSELF: it is
  113                                   ; self-modifying code. The slot descriptors and the tick handlers' operands
  114                                   ; live in this blob, init patches the burst's ring displacements and the
  115                                   ; run-time addresses into it, and the effect stage keeps patching as
  116                                   ; effects come and go. Three consequences: the player must run from RAM;
  117                                   ; one loaded copy is one player - two workspaces cannot share it; and it
  118                                   ; must sit inside one 64K segment, because the SID tick swaps only the low
  119                                   ; word of its vector. Every self-reference is pc-relative or patched at
  120                                   ; run time, so the blob still loads anywhere.
  121                                   ;
  122                                   ; ASSUMPTIONS (unchecked beyond the magic, version and stream count):
  123                                   ;
  124                                   ;   1. the file comes from the yx6 packer, which enforces C >= 18, N mod C = 0,
  125                                   ;      N >= 2C, N <= 2520 - the burst reads each register's ring through an
  126                                   ;      assembled-in 16-bit displacement of k*N - offsets that stay inside the
  127                                   ;      ring, and - at ST4_UNIT above 1 - a tune length, loop frame and C that
  128                                   ;      are whole units, so every budget this player passes to the decoder
  129                                   ;      divides cleanly
  130                                   ;   2. the workspace is at an even address and large enough for the file's N
  131                                   ;   3. YX6_play is called once per frame and never after it returns -1.
  132                                   ;      Calling it again is harmless - it returns -1 and writes nothing - which
  133                                   ;      is what keeps ST4_wrap's "never call the decoder again" rule intact
  134                                   ;   4. a looping tune plays for as long as you keep calling: d0 = 1 marks each
  135                                   ;      time round, and YX6_init is only needed to start again from frame 0
  136                                   ;   5. the HOST owns the machine state - the player saves and restores none
  137                                   ;      of it. A host that wants the machine back afterwards saves, around
  138                                   ;      init..stop, exactly what the player touches: the vectors $134 and
  139                                   ;      $110, TACR, TADR, TDDR, TCDCR's low (Timer D) nibble, bit 5 of IERA
  140                                   ;      and IMRA, bit 4 of IERB and IMRB - and, built with YX6_SUPER_HOST,
  141                                   ;      the USP, which the drum tick parks a0 in. A demo that has already
  142                                   ;      taken the machine over saves nothing at all. YX6_player.S is the
  143                                   ;      worked example of the polite version
  144                                   ; -----------------------------------------------------------------------------
  145                                   
  146                                   ; A host that never runs user-mode code while the player is live - a demo
  147                                   ; under its own takeover, say - may define YX6_SUPER_HOST equ 1 before
  148                                   ; including this file: the slot-2 drum tick then parks a0 in the then-unused
  149                                   ; USP (4 cycles each way instead of 12 through the stack; slot 1's drum
  150                                   ; always uses the stack, because Timer A nests into Timer D's parked
  151                                   ; windows and must never overwrite one). The park restores a0
  152                                   ; but not the USP: a host that ever returns to user mode must save its USP
  153                                   ; before YX6_init and restore it after YX6_stop, with the rest of the
  154                                   ; machine state assumption 5 lists. Default off, because a program that
  155                                   ; hooks the VBL from user mode has a live USP at every tick.
  156                                           .if ^^defined YX6_SUPER_HOST
  157                                           .else
  158                                 - YX6_SUPER_HOST  equ     0
  159                                 -         .endif
  160                                   
  161           =00000012               YX6_STREAMS     equ     18              ; R0..R13, then E1 T1 E2 T2: the two
  162                                                                           ; effect slots' control and timer-count
  163                                                                           ; streams, decoded like any register
  164           =0000000E               YX6_REGISTERS   equ     14              ; the streams the burst writes
  165           =00000040               YX6_STATE_SIZE  equ     64              ; per stream, so the index is a shift
  166                                                                           ; both ways: *64 in, /16 back to *4
  167                                   
  168                                   ; Workspace layout. Counters that a frame touches are kept in the form the
  169                                   ; frame wants them in: a pointer to walk, and a countdown to test against zero.
  170           =00000000               YX6_CURSOR      equ     0               ; long  this frame's byte in ring 0
  171           =00000004               YX6_LEFTFR      equ     4               ; long  frames before the tune ends
  172           =00000008               YX6_NEXT        equ     8               ; long  values decoded so far
  173           =0000000C               YX6_RINGEND     equ     12              ; long  one past ring 0, where it wraps
  174           =00000010               YX6_RINGS       equ     16              ; long  base of the ring area
  175           =00000014               YX6_FILE        equ     20              ; long  the .yx6 file
  176           =00000018               YX6_TOTAL       equ     24              ; long  O, the tune length in frames
  177           =0000001C               YX6_LOOPLEN     equ     28              ; long  O - L, zero when it does not loop
  178           =00000020               YX6_LOOP        equ     32              ; long  L, read at init to split sections
  179           =00000024               YX6_N           equ     36              ; word  ring size N
  180           =00000026               YX6_C           equ     38              ; word  values per call C
  181           =00000028               YX6_SLOT        equ     40              ; word  refill slot, 0..C-1
  182           =0000002A               YX6_INDEX       equ     42              ; word  stream index, during init only
  183           =0000002C               YX6_LOOPS       equ     44              ; word  nonzero when the tune loops
  184           =0000002E               YX6_EFXOFF      equ     46              ; long  14*N: the cursor's ring to E1's
  185           =00000032               YX6_R7OFF       equ     50              ; long  7*N: the cursor's ring to R7's
  186                                   ; The sanitize log. The effect stage edits ring bytes so the burst plays a
  187                                   ; sanitized frame - but the ring is decode history, and a later match may
  188                                   ; copy from any byte of it. So every edit is recorded here and undone right
  189                                   ; after the burst: the chip sees the edit, the ring never keeps it.
  190           =00000036               YX6_PATCHES     equ     54              ; byte  how many edits this frame, 0..3
  191           =00000037               YX6_PATCH_VAL   equ     55              ; 3 bytes: the originals
  192           =0000003A               YX6_PATCH_ADDR  equ     58              ; 3 longs: where they go back
  193           =00000046               YX6_STATE       equ     70              ; 18 decoder states, from an even base
  194                                   
  195                                   ; Each effect slot's own state - its code and count from last frame, its
  196                                   ; parameter ring offset, its timer and its handlers - lives in a descriptor
  197                                   ; in the code blob (yx6_desc1/2 below), so ONE slot machine serves both
  198                                   ; slots. The hardware addresses are words: movea.w sign-extends $FAxx to
  199                                   ; $FFFFFAxx. The two run-time pointers are filled in by YX6_init.
  200           =00000000               SD_ELAST        equ     0               ; byte  the slot's code last frame
  201           =00000001               SD_TLAST        equ     1               ; byte  the count its timer last got:
  202                                                                           ; a held effect reloads its data
  203                                                                           ; register only when the count CHANGES,
  204                                                                           ; because a write that lands while the
  205                                                                           ; counter passes 01 loads an
  206                                                                           ; indeterminate value - pitch glitches
  207           =00000002               SD_CTRL         equ     2               ; word  timer control register
  208           =00000004               SD_DATA         equ     4               ; word  timer data register
  209           =00000006               SD_VEC          equ     6               ; word  timer vector
  210           =00000008               SD_PARM         equ     8               ; long  (8+voice)*N: the cursor's ring
  211                                                                           ;       to the slot's parameter byte
  212           =0000000C               SD_ISR          equ     12              ; long  the slot's tick handlers
  213           =00000010               SD_OTHER        equ     16              ; long  the other slot's descriptor
  214                                   ; rmac evaluates left to right, so the parentheses here are load-bearing:
  215                                   ; without them this reads as (YX6_STATE+YX6_STREAMS)*YX6_STATE_SIZE.
  216           =000004C6               YX6_FIXED       equ     YX6_STATE+(YX6_STREAMS*YX6_STATE_SIZE)
  217                                   
  218                                   ; One saved ST4_wrap state, plus the ring bounds the wrap check needs. The
  219                                   ; first four longs are in movem order - d1, d2, then a0, a1 - so that much of
  220                                   ; the decoder state loads and stores in one instruction; the three extra
  221                                   ; stream pointers ST4 carries (literals, byte offsets, word offsets) follow.
  222           =00000000               YS_D1           equ     0               ; long  d1, -ring.low : remaining
  223           =00000004               YS_D2           equ     4               ; long  d2, N : signed offset
  224           =00000008               YS_INPUT        equ     8               ; long  a0, stream A position
  225           =0000000C               YS_WRITE        equ     12              ; long  a1, write pointer
  226           =00000010               YS_LIT          equ     16              ; long  a2, stream B position
  227           =00000014               YS_BOFF         equ     20              ; long  a4, stream C position
  228           =00000018               YS_WOFF         equ     24              ; long  a5, stream D position
  229           =0000001C               YS_QUEUE        equ     28              ; word  d0, bit queue
  230           =00000020               YS_START        equ     32              ; long  this stream's ring
  231           =00000024               YS_END          equ     36              ; long  one past its last byte
  232           =00000028               YS_LEFT         equ     40              ; long  values left in the current section
  233                                   ; The movem block starts at the top of the state, so the two movems address it
  234                                   ; as plain (a2) - see the note where they are used.
  235                                   
  236                                   ; The .yx6 header, as written by the packer.
  237           =00000000               YH_MAGIC        equ     0
  238           =00000004               YH_VERSION      equ     4
  239           =00000006               YH_FLAGS        equ     6
  240           =00000008               YH_FRAMES       equ     8
  241           =0000000C               YH_PLAYER_HZ    equ     12
  242           =0000000E               YH_STREAM_COUNT equ     14
  243           =00000010               YH_RING         equ     16
  244           =00000012               YH_CHUNK        equ     18
  245           =00000014               YH_LOOP         equ     20
  246           =00000018               YH_CLOCK        equ     24
  247           =0000001C               YH_DRUMS        equ     28              ; long: the drum table, 0 when none
  248           =00000020               YH_DRUMCOUNT    equ     32              ; word
  249           =00000022               YH_INTRO_TABLE  equ     34              ; 18 offsets: the frames before the loop
  250           =0000006A               YH_LOOP_TABLE   equ     106             ; 18 offsets: the frames from L on
  251                                   
  252           =59583621               YX6_MAGIC       equ     $59583621       ; 'YX6!'
  253           =00000004               YX6_VERSION     equ     4               ; 4: effect streams and the drum table
  254           =00000001               YX6_FLAG_LOOPS  equ     1               ; header flag: the tune loops
  255           =FFFF8800               YX6_PSG         equ     $FFFF8800       ; select/read at +0, write at +2
  256           =000000FF               YX6_NO_ENV      equ     $FF             ; R13 value meaning "leave it alone"
  257           =000000C0               YX6_PORTS       equ     $C0             ; R7 bits the ST needs as outputs
  258           =00000007               YX6_MIXER       equ     7
  259           =0000000D               YX6_ENVELOPE    equ     13
  260                                   
  261                                   ; -----------------------------------------------------------------------------
  262                                   ; YX6_WRITE: send one register's value straight from its ring to the sound
  263                                   ; chip, then step a1 on to the next register's ring.
  264                                   ;
  265                                   ; Two moves and an add, with the register number assembled in as an immediate:
  266                                   ; nothing is tested, nothing is counted, and the value never passes through a
  267                                   ; data register. Register k's ring byte sits k*N above the cursor, and N is
  268                                   ; known at init: the displacement is patched into the instruction there,
  269                                   ; once, so the burst never steps a pointer. The $7FFF placeholder is
  270                                   ; load-bearing - a zero displacement would let rmac's +o3 fold the extension
  271                                   ; word away and shift every patch site. Registers 7 and 13 need their values
  272                                   ; touched, so they are written out of line rather than through this macro.
  273                                   ;
  274                                   ; Skipping a register whose value has not changed was measured and dropped: a
  275                                   ; sound-chip access on an ST costs about 1.5 cycles more than a RAM one, so the
  276                                   ; compare that would save the write costs about as much as the write.
  277                                   ; -----------------------------------------------------------------------------
  278                                           .macro YX6_WRITE number
  279                                 .         move.b  #\number,(a2)           ; select
  280                                 .         move.b  $7FFF(a1),2(a2)         ; and write - SMC: k*N, set at init
  281                                 .         .endm
  282                                   
  283                                   ; Jump table: bra.w keeps 4-byte slots for a program that loads YX6 as a blob.
  284  00000000  6000xxxx                               bra.w   YX6_init
  285  00000004  6000xxxx                               bra.w   YX6_play
  286  00000008  6000xxxx                               bra.w   YX6_stop
  287                                   
  288                                   ; -----------------------------------------------------------------------------
  289                                   ; YX6_init: a0 = .yx6 file, a1 = workspace. Sets up eighteen decoders, decodes
  290                                   ; each stream's first group so frame 0 can be played immediately, patches the
  291                                   ; blob's run-time addresses and the burst's ring displacements, and claims
  292                                   ; MFP Timers A and D for the effect slots - saving nothing, per assumption 5.
  293                                   ; -----------------------------------------------------------------------------
  294                                   YX6_init:
  295  0000000C  2649                           movea.l a1,a3                   ; a3 is the workspace throughout
  296  0000000E  27480014                       move.l  a0,YX6_FILE(a3)
  297  00000012  0C9059583621                   cmp.l   #YX6_MAGIC,YH_MAGIC(a0)
  298  00000018  6600xxxx                       bne     .rejected
  299  0000001C  0C6800040004                   cmp.w   #YX6_VERSION,YH_VERSION(a0)
  300  00000022  6600xxxx                       bne     .rejected
  301  00000026  0C680012000E                   cmp.w   #YX6_STREAMS,YH_STREAM_COUNT(a0)
  302  0000002C  6600xxxx                       bne     .rejected
  303                                   
  304  00000030  276800080018                   move.l  YH_FRAMES(a0),YX6_TOTAL(a3)
  305  00000036  276800140020                   move.l  YH_LOOP(a0),YX6_LOOP(a3)
  306  0000003C  376800100024                   move.w  YH_RING(a0),YX6_N(a3)
  307  00000042  376800120026                   move.w  YH_CHUNK(a0),YX6_C(a3)
  308  00000048  30280006                       move.w  YH_FLAGS(a0),d0
  309  0000004C  C07C0001                       and.w   #YX6_FLAG_LOOPS,d0
  310  00000050  3740002C                       move.w  d0,YX6_LOOPS(a3)
  311  00000054  276800080004                   move.l  YH_FRAMES(a0),YX6_LEFTFR(a3)
  312  0000005A  426B0028                       clr.w   YX6_SLOT(a3)
  313  0000005E  43EB04C6                       lea     YX6_FIXED(a3),a1        ; the rings follow the decoder states
  314  00000062  27490010                       move.l  a1,YX6_RINGS(a3)
  315  00000066  2689                           move.l  a1,YX6_CURSOR(a3)       ; frame 0 is the first byte of ring 0
  316  00000068  7000                           moveq   #0,d0
  317  0000006A  30280010                       move.w  YH_RING(a0),d0
  318  0000006E  D089                           add.l   a1,d0
  319  00000070  2740000C                       move.l  d0,YX6_RINGEND(a3)      ; where the cursor goes back to the top
  320                                   
  321  00000074  202B0018                       move.l  YX6_TOTAL(a3),d0        ; the loop section is O - L frames long,
  322  00000078  90AB0020                       sub.l   YX6_LOOP(a3),d0         ; and empty when the tune plays once
  323  0000007C  4A6B002C                       tst.w   YX6_LOOPS(a3)
  324  00000080  66xx                           bne.s   .loop_length
  325  00000082  7000                           moveq   #0,d0
  326                                   .loop_length:
  327  00000084  2740001C                       move.l  d0,YX6_LOOPLEN(a3)
  328                                   
  329  00000088  7200                           moveq   #0,d1                   ; the first group is C values, or the
  330  0000008A  322B0026                       move.w  YX6_C(a3),d1            ; whole tune when that is shorter and
  331  0000008E  4A6B002C                       tst.w   YX6_LOOPS(a3)           ; there is no loop to carry on into
  332  00000092  66xx                           bne.s   .first_group
  333  00000094  202B0018                       move.l  YX6_TOTAL(a3),d0
  334  00000098  B081                           cmp.l   d1,d0
  335  0000009A  64xx                           bcc.s   .first_group
  336  0000009C  2200                           move.l  d0,d1
  337                                   .first_group:
  338  0000009E  27410008                       move.l  d1,YX6_NEXT(a3)         ; values decoded once init is done
  339                                   
  340  000000A2  426B002A                       clr.w   YX6_INDEX(a3)           ; the loop counter lives here: every
  341                                   .stream:                                ; register is state during the calls
  342  000000A6  302B002A                       move.w  YX6_INDEX(a3),d0
  343  000000AA  ED48                           lsl.w   #6,d0                   ; * YX6_STATE_SIZE
  344  000000AC  45F30046                       lea     YX6_STATE(a3,d0.w),a2
  345  000000B0  7600                           moveq   #0,d3
  346  000000B2  362B0024                       move.w  YX6_N(a3),d3
  347  000000B6  302B002A                       move.w  YX6_INDEX(a3),d0
  348  000000BA  C0C3                           mulu.w  d3,d0                   ; this stream's ring is the k'th
  349  000000BC  226B0010                       movea.l YX6_RINGS(a3),a1
  350  000000C0  D3C0                           adda.l  d0,a1
  351  000000C2  25490020                       move.l  a1,YS_START(a2)
  352  000000C6  2549000C                       move.l  a1,YS_WRITE(a2)
  353  000000CA  2009                           move.l  a1,d0
  354  000000CC  D083                           add.l   d3,d0
  355  000000CE  25400024                       move.l  d0,YS_END(a2)
  356                                   
  357                                   ; A tune that loops from frame 0 has no intro streams, so its registers start
  358                                   ; on the loop section - which is then the whole tune. The load of L comes
  359                                   ; last because it is the branch condition: a move to a data register writes
  360                                   ; the flags, a lesson the original version of this choice taught by always
  361                                   ; picking the intro table and leaning on the section-exhausted path to
  362                                   ; recover. The signature check below ended that arrangement.
  363  000000D2  383C0022                       move.w  #YH_INTRO_TABLE,d4
  364  000000D6  202B0020                       move.l  YX6_LOOP(a3),d0
  365  000000DA  66xx                           bne.s   .section                ; L != 0: the intro covers [0, L)
  366  000000DC  383C006A                       move.w  #YH_LOOP_TABLE,d4
  367  000000E0  202B001C                       move.l  YX6_LOOPLEN(a3),d0
  368                                   .section:
  369  000000E4  25400028                       move.l  d0,YS_LEFT(a2)          ; values before this stream runs out
  370                                   
  371  000000E8  302B002A                       move.w  YX6_INDEX(a3),d0
  372  000000EC  E548                           lsl.w   #2,d0                   ; the tables hold long offsets
  373  000000EE  D044                           add.w   d4,d0
  374  000000F0  206B0014                       movea.l YX6_FILE(a3),a0
  375  000000F4  20300000                       move.l  0(a0,d0.w),d0
  376  000000F8  D1C0                           adda.l  d0,a0                   ; the section's ST4 container
  377  000000FA  0C90xxxxxxxx                   cmp.l   #ST4_SIGNATURE,(a0)     ; magic, version and unit in one compare:
  378  00000100  6600xxxx                       bne     .rejected               ; a tune packed for another unit size
  379                                   
  380                                   ; Open the container. The state block goes to the stack; ST4_init clobbers
  381                                   ; a3, so the workspace pointer does too.
  382  00000104  2F0A                           move.l  a2,-(sp)
  383  00000106  2F0B                           move.l  a3,-(sp)
  384  00000108  6100xxxx                       bsr     yx6_open
  385  0000010C  265F                           movea.l (sp)+,a3
  386                                   
  387  0000010E  225F                           movea.l (sp)+,a1                ; the state block; a1 is recomputed
  388  00000110  23480008                       move.l  a0,YS_INPUT(a1)         ; every time round this loop
  389  00000114  234A0010                       move.l  a2,YS_LIT(a1)
  390  00000118  234C0014                       move.l  a4,YS_BOFF(a1)
  391  0000011C  234D0018                       move.l  a5,YS_WOFF(a1)
  392  00000120  3340001C                       move.w  d0,YS_QUEUE(a1)
  393  00000124  2281                           move.l  d1,YS_D1(a1)
  394  00000126  23420004                       move.l  d2,YS_D2(a1)
  395                                   
  396  0000012A  302B002A                       move.w  YX6_INDEX(a3),d0        ; and its first group
  397  0000012E  ED48                           lsl.w   #6,d0
  398  00000130  362B000A                       move.w  YX6_NEXT+2(a3),d3       ; C, or fewer: both fit a word
  399  00000134  6100xxxx                       bsr     YX6_fill
  400  00000138  526B002A                       addq.w  #1,YX6_INDEX(a3)
  401  0000013C  0C6B0012002A                   cmp.w   #YX6_STREAMS,YX6_INDEX(a3)
  402  00000142  6600FF62                       bne     .stream
  403                                   
  404                                   ; The cursor reaches the effect and mixer rings by fixed hops, computed once.
  405  00000146  302B0024                       move.w  YX6_N(a3),d0
  406  0000014A  C0FC0007                       mulu.w  #7,d0
  407  0000014E  27400032                       move.l  d0,YX6_R7OFF(a3)
  408  00000152  D080                           add.l   d0,d0                   ; and 14*N, from the same mulu
  409  00000154  2740002E                       move.l  d0,YX6_EFXOFF(a3)
  410                                   
  411                                   ; The burst reads register k's ring byte through an assembled-in k*N
  412                                   ; displacement - patch all fourteen now that N is known. The packer keeps
  413                                   ; N at 2520 or less, so 13*N fits the signed word. Each YX6_WRITE is ten
  414                                   ; bytes with its displacement at +6; R7 and R13 read out of line.
  415  00000158  342B0024                       move.w  YX6_N(a3),d2
  416  0000015C  7200                           moveq   #0,d1                   ; k*N, accumulated
  417  0000015E  41FAxxxx                       lea     yx6_wA+6(pc),a0
  418  00000162  7006                           moveq   #6,d0                   ; R0..R6
  419                                   .wpatchA:
  420  00000164  3081                           move.w  d1,(a0)
  421  00000166  D242                           add.w   d2,d1
  422  00000168  41E8000A                       lea     10(a0),a0
  423  0000016C  51C8FFF6                       dbra    d0,.wpatchA
  424  00000170  41FAxxxx                       lea     yx6_w7+2(pc),a0         ; R7 reads through d1
  425  00000174  3081                           move.w  d1,(a0)
  426  00000176  D242                           add.w   d2,d1
  427  00000178  41FAxxxx                       lea     yx6_wB+6(pc),a0
  428  0000017C  7004                           moveq   #4,d0                   ; R8..R12
  429                                   .wpatchB:
  430  0000017E  3081                           move.w  d1,(a0)
  431  00000180  D242                           add.w   d2,d1
  432  00000182  41E8000A                       lea     10(a0),a0
  433  00000186  51C8FFF6                       dbra    d0,.wpatchB
  434  0000018A  41FAxxxx                       lea     yx6_w13+2(pc),a0
  435  0000018E  3081                           move.w  d1,(a0)
  436  00000190  422B0036                       clr.b   YX6_PATCHES(a3)
  437  00000194  41FAxxxx                       lea     yx6_drums(pc),a0
  438  00000198  4210                           clr.b   (a0)
  439  0000019A  6100xxxx                       bsr     yx6_link                ; descriptors: pointers and last codes
  440                                   
  441                                   ; Claim Timers A and D: park our handlers on the vectors and leave both
  442                                   ; timers stopped but enabled and unmasked. Nothing is saved - the machine
  443                                   ; state is the host's, see assumption 5 in the header. bset/bclr only:
  444                                   ; Timer C's bits and the ACIA's live in the same registers.
  445  0000019E  40E7                           move.w  sr,-(sp)
  446  000001A0  007C0700                       ori.w   #$0700,sr
  447  000001A4  4238FA19                       clr.b   $FFFFFA19.w             ; Timer A stopped
  448  000001A8  023800F0FA1D                   andi.b  #$F0,$FFFFFA1D.w        ; Timer D stopped; Timer C untouched
  449  000001AE  41FAxxxx                       lea     yx6_parkA(pc),a0
  450  000001B2  21C80134                       move.l  a0,$134.w
  451  000001B6  41FAxxxx                       lea     yx6_parkD(pc),a0
  452  000001BA  21C80110                       move.l  a0,$110.w
  453  000001BE  08B80005FA0B                   bclr    #5,$FFFFFA0B.w          ; drop stale pendings
  454  000001C4  08B80004FA0D                   bclr    #4,$FFFFFA0D.w
  455  000001CA  08F80005FA07                   bset    #5,$FFFFFA07.w          ; Timer A enabled and unmasked
  456  000001D0  08F80005FA13                   bset    #5,$FFFFFA13.w
  457  000001D6  08F80004FA09                   bset    #4,$FFFFFA09.w          ; Timer D likewise
  458  000001DC  08F80004FA15                   bset    #4,$FFFFFA15.w
  459  000001E2  46DF                           move.w  (sp)+,sr
  460                                   
  461  000001E4  7000                           moveq   #0,d0
  462  000001E6  4E75                           rts
  463                                   .rejected:
  464  000001E8  70FF                           moveq   #-1,d0
  465  000001EA  4E75                           rts
