  467                                   ; -----------------------------------------------------------------------------
  468                                   ; YX6_fill: d0.w = stream index * YX6_STATE_SIZE, d3.w = values wanted.
  469                                   ; Produces exactly that many values for one register, crossing into the loop
  470                                   ; section - and around it again - as often as it takes. Straddling matters even
  471                                   ; for one group: nothing says the loop frame falls on a group boundary.
  472                                   ; -----------------------------------------------------------------------------
  473                                   YX6_fill:
  474  000001EC  48E70302                       movem.l d6-d7/a6,-(sp)          ; three registers that survive a decoder
  475  000001F0  45F30046                       lea     YX6_STATE(a3,d0.w),a2   ; call, which its own state needs
  476  000001F4  2C4B                           movea.l a3,a6                   ; ST4 clobbers a3: a6 keeps the workspace
  477  000001F6  2C0A                           move.l  a2,d6
  478  000001F8  7E00                           moveq   #0,d7
  479  000001FA  3E03                           move.w  d3,d7                   ; values still wanted
  480                                   .piece:
  481  000001FC  202A0028                       move.l  YS_LEFT(a2),d0
  482  00000200  66xx                           bne.s   .section
  483  00000202  6100xxxx                       bsr     YX6_start_loop          ; this section ran out: go round again
  484  00000206  202A0028                       move.l  YS_LEFT(a2),d0
  485  0000020A  67xx                           beq.s   .done                   ; nothing to go round to; do not hang
  486                                   .section:
  487  0000020C  B087                           cmp.l   d7,d0
  488  0000020E  65xx                           bcs.s   .piece_size
  489  00000210  2007                           move.l  d7,d0                   ; the section covers all that is wanted
  490                                   .piece_size:
  491  00000212  91AA0028                       sub.l   d0,YS_LEFT(a2)
  492  00000216  9E80                           sub.l   d0,d7
  493  00000218  3600                           move.w  d0,d3                   ; a piece is at most C, so it fits a word
  494                                   ; The decoder's budget counts units of ST4_UNIT bytes. The packer enforces
  495                                   ; that every piece boundary - C, the loop frame, the tune length - is a whole
  496                                   ; number of units, so this shift never drops a remainder.
  497                                           .if ST4_UNIT=2
  498                                 -         lsr.w   #1,d3
  499                                 -         .endif
  500                                           .if ST4_UNIT=4
  501                                 -         lsr.w   #2,d3
  502                                 -         .endif
  503                                   
  504                                   ; (a2) written out rather than YS_D1(a2): with +o3 rmac folds a zero
  505                                   ; displacement away on movem but keeps the addressing mode, and emits the
  506                                   ; instruction without its extension word. The next word becomes the
  507                                   ; displacement and the code runs off into nothing.
  508  0000021A  4CD20306                       movem.l (a2),d1-d2/a0-a1
  509  0000021E  286A0014                       movea.l YS_BOFF(a2),a4
  510  00000222  2A6A0018                       movea.l YS_WOFF(a2),a5
  511  00000226  302A001C                       move.w  YS_QUEUE(a2),d0
  512  0000022A  246A0010                       movea.l YS_LIT(a2),a2           ; loaded last: a2 was the base
  513  0000022E  6100xxxx                       bsr     ST4_resume
  514  00000232  264E                           movea.l a6,a3                   ; the decoder clobbered the workspace
  515  00000234  CD8A                           exg     a2,d6                   ; a2 = the block again, d6 = stream B
  516  00000236  B3EA0024                       cmpa.l  YS_END(a2),a1           ; YX6_save, inlined: this is the hot path
  517  0000023A  66xx                           bne.s   .stored
  518  0000023C  226A0020                       movea.l YS_START(a2),a1         ; the call landed on the ring end
  519                                   .stored:
  520  00000240  48D20306                       movem.l d1-d2/a0-a1,(a2)
  521  00000244  25460010                       move.l  d6,YS_LIT(a2)
  522  00000248  254C0014                       move.l  a4,YS_BOFF(a2)
  523  0000024C  254D0018                       move.l  a5,YS_WOFF(a2)
  524  00000250  3540001C                       move.w  d0,YS_QUEUE(a2)
  525  00000254  2C0A                           move.l  a2,d6                   ; the block pointer, back where fill keeps it
  526  00000256  4A87                           tst.l   d7
  527  00000258  66A2                           bne.s   .piece
  528                                   .done:
  529  0000025A  4CDF40C0                       movem.l (sp)+,d6-d7/a6
  530  0000025E  4E75                           rts
  531                                   
  532                                   ; -----------------------------------------------------------------------------
  533                                   ; YX6_start_loop: a2 = state block. Starts this register's loop stream over -
  534                                   ; a fresh decoder, reading from the top of the loop section, still writing
  535                                   ; where the last one stopped. ST4_init wants the ring start so that its packed
  536                                   ; metadata comes out right; the write pointer is restored from the block, which
  537                                   ; is why it is stored rather than held in a register.
  538                                   ; -----------------------------------------------------------------------------
  539                                   ; It runs inside YX6_fill, which guarantees d6 = the state block and a6 = the
  540                                   ; workspace - the two anchors that survive the decoder call.
  541                                   YX6_start_loop:
  542  00000260  200A                           move.l  a2,d0
  543  00000262  908B                           sub.l   a3,d0
  544  00000264  907C0046                       sub.w   #YX6_STATE,d0
  545  00000268  E848                           lsr.w   #4,d0                   ; k * 64 becomes k * 4, a table index
  546  0000026A  206B0014                       movea.l YX6_FILE(a3),a0
  547  0000026E  2030006A                       move.l  YH_LOOP_TABLE(a0,d0.w),d0
  548  00000272  67xx                           beq.s   .no_loop                ; this tune has no loop section
  549  00000274  D1C0                           adda.l  d0,a0                   ; the loop section's ST4 container
  550  00000276  226A0020                       movea.l YS_START(a2),a1         ; read before a2 becomes stream B
  551  0000027A  61xx                           bsr.s   yx6_open
  552  0000027C  264E                           movea.l a6,a3                   ; the decoder clobbered the workspace
  553  0000027E  CD8A                           exg     a2,d6                   ; a2 = the block again, d6 = stream B
  554  00000280  25480008                       move.l  a0,YS_INPUT(a2)
  555  00000284  25460010                       move.l  d6,YS_LIT(a2)
  556  00000288  254C0014                       move.l  a4,YS_BOFF(a2)
  557  0000028C  254D0018                       move.l  a5,YS_WOFF(a2)
  558  00000290  3540001C                       move.w  d0,YS_QUEUE(a2)
  559  00000294  2481                           move.l  d1,YS_D1(a2)
  560  00000296  25420004                       move.l  d2,YS_D2(a2)
  561  0000029A  256B001C0028                   move.l  YX6_LOOPLEN(a3),YS_LEFT(a2)
  562  000002A0  2C0A                           move.l  a2,d6                   ; the block pointer, as fill keeps it
  563                                   .no_loop:
  564  000002A2  4E75                           rts
