       00000372  14BC0006             @         move.b  #$6,(a2)           
  663  00000376  15697FFF0002         @         move.b  $7FFF(a1),2(a2)         
  664                                   
  665  0000037C  14BC0007                       move.b  #YX6_MIXER,(a2)         ; R7 also carries the ST's I/O port
  666                                   yx6_w7:
  667  00000380  12297FFF                       move.b  $7FFF(a1),d1            ; directions, which port A needs kept
