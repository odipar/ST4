  678                                   yx6_w13:
  679  000003BE  12297FFF                       move.b  $7FFF(a1),d1            ; R13 restarts the envelope whenever it
  680  000003C2  B23C00FF                       cmp.b   #YX6_NO_ENV,d1          ; is written, so $FF means leave it be
  681  000003C6  67xx                           beq.s   .envelope_held
  682  000003C8  14BC000D                       move.b  #YX6_ENVELOPE,(a2)
  683  000003CC  15410002                       move.b  d1,2(a2)
  684                                   .envelope_held:
  685  000003D0  46DF                           move.w  (sp)+,sr
  686                                   
  687                                   ; Undo this frame's ring edits: the chip has heard the sanitized frame, and
  688                                   ; the ring must stay exact decode history for every match yet to come.
  689  000003D2  102B0036                       move.b  YX6_PATCHES(a3),d0
  690  000003D6  67xx                           beq.s   .pristine
  691  000003D8  422B0036                       clr.b   YX6_PATCHES(a3)         ; cleared only when it was used
  692  000003DC  41EB003A                       lea     YX6_PATCH_ADDR(a3),a0
  693  000003E0  43EB0037                       lea     YX6_PATCH_VAL(a3),a1
  694                                   .restore:
  695  000003E4  2458                           movea.l (a0)+,a2
  696  000003E6  1499                           move.b  (a1)+,(a2)
  697  000003E8  5300                           subq.b  #1,d0
  698  000003EA  66F8                           bne.s   .restore
  699                                   .pristine:
  700                                   
  701                                   ; Refill the stream whose turn it is. Slots 18..C-1 exist when C is larger
  702                                   ; than the stream count; they simply have nothing to do.
  703  000003EC  302B0028                       move.w  YX6_SLOT(a3),d0
  704  000003F0  B07C0012                       cmp.w   #YX6_STREAMS,d0
  705  000003F4  64xx                           bcc.s   .advance
  706  000003F6  7600                           moveq   #0,d3
  707  000003F8  362B0026                       move.w  YX6_C(a3),d3            ; a whole group
  708  000003FC  4A6B002C                       tst.w   YX6_LOOPS(a3)
  709  00000400  66xx                           bne.s   .refill                 ; a looping tune never runs out
  710  00000402  222B0018                       move.l  YX6_TOTAL(a3),d1
  711  00000406  92AB0008                       sub.l   YX6_NEXT(a3),d1         ; values still packed
  712  0000040A  6Fxx                           ble.s   .advance                ; all decoded: never call ST4 again
  713  0000040C  B283                           cmp.l   d3,d1
  714  0000040E  64xx                           bcc.s   .refill
  715  00000410  2601                           move.l  d1,d3                   ; the last group is a short one
  716                                   .refill:
  717  00000412  ED48                           lsl.w   #6,d0
  718  00000414  6100FDD6                       bsr     YX6_fill
  719                                   
  720                                   .advance:
  721  00000418  5293                           addq.l  #1,YX6_CURSOR(a3)       ; one byte along every ring
  722  0000041A  2013                           move.l  YX6_CURSOR(a3),d0
  723  0000041C  B0AB000C                       cmp.l   YX6_RINGEND(a3),d0
  724  00000420  65xx                           bcs.s   .cursor_ready
  725  00000422  26AB0010                       move.l  YX6_RINGS(a3),YX6_CURSOR(a3)
  726                                   .cursor_ready:
  727  00000426  302B0028                       move.w  YX6_SLOT(a3),d0
  728  0000042A  5240                           addq.w  #1,d0
  729  0000042C  B06B0026                       cmp.w   YX6_C(a3),d0
  730  00000430  65xx                           bcs.s   .slot_ready
  731  00000432  7000                           moveq   #0,d0                   ; a cycle ended: the groups move on
  732  00000434  7200                           moveq   #0,d1
  733  00000436  322B0026                       move.w  YX6_C(a3),d1
  734  0000043A  D3AB0008                       add.l   d1,YX6_NEXT(a3)
  735                                   .slot_ready:
  736  0000043E  37400028                       move.w  d0,YX6_SLOT(a3)
  737                                   
  738                                   ; The rings hold the tune as one continuous sequence, so reaching the end of
  739                                   ; the last frame simply means the next values in them are the loop section's.
  740                                   ; The countdown follows: it reloads with the loop section's length.
  741  00000442  53AB0004                       subq.l  #1,YX6_LEFTFR(a3)
  742  00000446  66xx                           bne.s   .played
  743  00000448  4A6B002C                       tst.w   YX6_LOOPS(a3)
  744  0000044C  67xx                           beq.s   .played                 ; zero and no loop: the next call ends
  745  0000044E  276B001C0004                   move.l  YX6_LOOPLEN(a3),YX6_LEFTFR(a3)
  746  00000454  7001                           moveq   #1,d0                   ; played, and wrapped to the loop point
  747  00000456  4E75                           rts
  748                                   .played:
  749  00000458  7000                           moveq   #0,d0
  750  0000045A  4E75                           rts
  751                                   
  752                                   ; -----------------------------------------------------------------------------
  753                                   ; YX6_stop: a0 = workspace. Quiesces what YX6_init claimed - both timers
  754                                   ; stopped, their interrupts disabled and masked, pendings dropped - then
  755                                   ; silences the three voices. It restores NOTHING: the host that saved the
  756                                   ; machine state hands it back itself, after this returns. Tone and envelope
  757                                   ; settings stay, and a fresh YX6_init starts the tune over.
  758                                   ; -----------------------------------------------------------------------------
  759                                   YX6_stop:
  760  0000045C  2648                           movea.l a0,a3
  761  0000045E  40E7                           move.w  sr,-(sp)
  762  00000460  007C0700                       ori.w   #$0700,sr
  763  00000464  4238FA19                       clr.b   $FFFFFA19.w             ; both timers stopped,
  764  00000468  023800F0FA1D                   andi.b  #$F0,$FFFFFA1D.w
  765  0000046E  08B80005FA07                   bclr    #5,$FFFFFA07.w          ; disabled and masked - the claim
  766  00000474  08B80005FA13                   bclr    #5,$FFFFFA13.w          ; handed back bit by bit
  767  0000047A  08B80004FA09                   bclr    #4,$FFFFFA09.w
  768  00000480  08B80004FA15                   bclr    #4,$FFFFFA15.w
  769  00000486  08B80005FA0B                   bclr    #5,$FFFFFA0B.w          ; and no pending ticks of ours
  770  0000048C  08B80004FA0D                   bclr    #4,$FFFFFA0D.w
  771  00000492  41FAxxxx                       lea     yx6_drums(pc),a0
  772  00000496  4210                           clr.b   (a0)
  773                                   ; The silence stays inside the mask: selecting a register and writing it are
  774                                   ; two bus cycles, and a polite host's system interrupts - about to get their
  775                                   ; state back - use the chip too.
  776  00000498  41F9FFFF8800                   lea     YX6_PSG,a0
  777  0000049E  7008                           moveq   #8,d0                   ; R8, R9, R10 are the voice volumes
  778                                   .silence:
  779  000004A0  1080                           move.b  d0,(a0)
  780  000004A2  42280002                       clr.b   2(a0)
  781  000004A6  5200                           addq.b  #1,d0
  782  000004A8  B03C000B                       cmp.b   #11,d0
  783  000004AC  66F2                           bne.s   .silence
  784  000004AE  46DF                           move.w  (sp)+,sr
  785  000004B0  4E75                           rts
  786                                   
  787                                   ; -----------------------------------------------------------------------------
  788                                   ; The effect machinery. The per-frame stage lives inlined in YX6_play; what
  789                                   ; follows is everything it drives: the two slot descriptors, the tick
  790                                   ; handlers, and the one slot machine that serves both timers.
  791                                   ; -----------------------------------------------------------------------------
  792                                   
  793                                   ; The slot descriptors - see the SD_ equates. Slot 1 owns Timer A, slot 2
  794                                   ; Timer D, whose control nibble is shared with Timer C and only ever changed
  795                                   ; read-modify-write; the slot machine uses that form for both, which on
  796                                   ; Timer A writes the same values a clear would.
  797                                           even
  798                                   yx6_desc1:
  799  000004B2  0000                           dc.b    0,0                     ; E last, T last
  800  000004B4  FA19FA1F0134                   dc.w    $FA19,$FA1F,$0134       ; control, data, vector
  801  000004BA  00000000                       dc.l    0                       ; PARM, set per effect
  802  000004BE  0000000000000000               dc.l    0,0                     ; ISR block, other slot: yx6_link
  803                                   yx6_desc2:
  804  000004C6  0000                           dc.b    0,0
  805  000004C8  FA1DFA250110                   dc.w    $FA1D,$FA25,$0110
  806  000004CE  00000000                       dc.l    0
  807  000004D2  0000000000000000               dc.l    0,0
  808                                   
  809                                   ; -----------------------------------------------------------------------------
  810                                   ; The tick handlers, in maxYMiser's shipping forms: the PSG select and write
  811                                   ; in as few instructions as the bus allows, patched immediates instead of
  812                                   ; state, software end-of-interrupt as TOS runs the MFP - written as an
  813                                   ; immediate byte, since the in-service registers ignore written ones. All
  814                                   ; MFP interrupts arrive at 68000 level 6, so these never nest, and every
  815                                   ; patched operand is addressed pc-relatively so the player stays loadable
  816                                   ; anywhere - which also means it must run from RAM, where a demo lives.
  817                                   ;
  818                                   ; The two slots' handlers are the same text twice, and MUST stay
  819                                   ; byte-congruent: the slot machine and yx6_drum_start reach every patched
  820                                   ; operand through ISR_ offsets measured on the A block. The rig checks the
  821                                   ; congruence from the symbol table. The park entries - where YX6_init aims
  822                                   ; the vectors while no effect runs - are the handlers' own tails.
  823                                   ;
  824                                   ; The timers STACK: each handler drops the IPL to 5 as soon as its PSG
  825                                   ; select/data pair is complete, so the MFP's higher-priority channel -
  826                                   ; Timer A over Timer D - can nest instead of waiting a whole tick. The
  827                                   ; nesting is strictly one-way: Timer A interrupts Timer D's handlers,
  828                                   ; never the reverse (SEI mode admits only higher MFP priorities while an
  829                                   ; in-service bit is set), and nothing of the player's sits above Timer A.
  830                                   ; That direction is why the USP park belongs to the D-side drum alone: the
  831                                   ; A-side drum - the one that can nest into a parked window - always uses
  832                                   ; the stack, so a parked USP survives. The drop must never come before
  833                                   ; the handler's LAST chip write: a nested tick re-selects the PSG.
  834                                   ;
  835                                   ; The patch offsets are load-bearing:
  836                                   ;   drum:  select immediate at +3, sample address at +8, flag mask at _clear+3
  837                                   ;   sid:   select at +2 and volume at +4 inside the imm long; the partner's
  838                                   ;          address low word at +14, past the IPL drop, patched by yx6_link
  839                                   ;   buzz:  the shape at +4
  840                                   ; The SID vector swap patches the vector's LOW word only, so the two halves
  841                                   ; of a block must share their address high word: keep the player inside one
  842                                   ; 64K segment - anywhere a program smaller than 64K naturally loads.
  843                                   ; -----------------------------------------------------------------------------
  844                                   
  845                                   ; One drum tick: the sample byte goes straight to the voice's volume register.
  846                                   ; The byte after the last has bit 7 set, so the same move answers "done": park
  847                                   ; the volume mid-scale against the click, stop the timer, drop the flag.
  848                                   yx6_drumA:
  849  000004DA  11FC00088800                   move.b  #8,$FFFF8800.w          ; SMC +3: select the drummed volume
  850  000004E0  11F9123456788802               move.b  $12345678,$FFFF8802.w   ; SMC +8: the next sample byte
  851  000004E8  6Bxx                           bmi.s   .ended
  852  000004EA  46FC2500                       move.w  #$2500,sr               ; pair done: the other timer may stack
  853  000004EE  2F08                           move.l  a0,-(sp)                ; the stack, never the USP: this side
  854  000004F0  41FAFFF0                       lea     yx6_drumA+8(pc),a0      ; nests into parked windows
  855  000004F4  5290                           addq.l  #1,(a0)                 ; step the operand itself
  856  000004F6  205F                           movea.l (sp)+,a0
  857  000004F8  11FC00DFFA0F                   move.b  #$DF,$FFFFFA0F.w
  858  000004FE  4E73                           rte
  859                                   .ended:
  860  00000500  11FC000D8802                   move.b  #$D,$FFFF8802.w         ; middle volume: no click
  861  00000506  023800F0FA19                   andi.b  #$F0,$FFFFFA19.w        ; the sample ran out: stop Timer A
  862  0000050C  46FC2500                       move.w  #$2500,sr
  863  00000510  2F08                           move.l  a0,-(sp)
  864  00000512  41FAxxxx                       lea     yx6_drums(pc),a0
  865                                   yx6_drumA_clear:
  866  00000516  021000FF                       andi.b  #$FF,(a0)               ; SMC +3: drop the voice's drum flag
  867  0000051A  205F                           movea.l (sp)+,a0
  868                                   yx6_parkA:
  869  0000051C  11FC00DFFA0F                   move.b  #$DF,$FFFFFA0F.w
  870  00000522  4E73                           rte
  871                                   
  872                                   ; The SID square: each tick writes one half of the square - the volume or
  873                                   ; silence - and installs the other half as the next tick, one word into the
  874                                   ; vector. Select and data land in one move.l: the immediate's bytes hit
  875                                   ; $8800 (select) and $8802 (data) by bus layout.
  876                                   yx6_sidA_on:
  877  00000524  21FC08000F008800               move.l  #$08000F00,$FFFF8800.w  ; SMC +2 select, +4 volume
  878  0000052C  46FC2500                       move.w  #$2500,sr
  879  00000530  31FC00000136                   move.w  #0,$136.w               ; SMC +14: the quiet half is next
  880  00000536  11FC00DFFA0F                   move.b  #$DF,$FFFFFA0F.w
  881  0000053C  4E73                           rte
  882                                   yx6_sidA_off:
  883  0000053E  21FC080000008800               move.l  #$08000000,$FFFF8800.w  ; SMC +2 select; silence
  884  00000546  46FC2500                       move.w  #$2500,sr
  885  0000054A  31FC00000136                   move.w  #0,$136.w               ; SMC +14: the loud half is next
  886  00000550  11FC00DFFA0F                   move.b  #$DF,$FFFFFA0F.w
  887  00000556  4E73                           rte
  888                                   
  889                                   ; The sync-buzzer tick: writing the shape to R13 restarts the envelope, and
  890                                   ; that restart at the timer's rate is the whole effect.
  891                                   yx6_buzzA:
  892  00000558  21FC0D0000008800               move.l  #$0D000000,$FFFF8800.w  ; SMC +4: the shape
  893  00000560  46FC2500                       move.w  #$2500,sr
  894  00000564  11FC00DFFA0F                   move.b  #$DF,$FFFFFA0F.w
  895  0000056A  4E73                           rte
  896                                   
  897                                   ; Slot 2's instances: Timer D's stop, vector and in-service bit, otherwise
  898                                   ; the A block byte for byte.
  899                                   yx6_drumD:
  900  0000056C  11FC00088800                   move.b  #8,$FFFF8800.w
  901  00000572  11F9123456788802               move.b  $12345678,$FFFF8802.w
  902  0000057A  6Bxx                           bmi.s   .ended
  903  0000057C  46FC2500                       move.w  #$2500,sr               ; Timer A may nest from here on, and
  904                                           .if YX6_SUPER_HOST              ; never parks the USP itself - so
  905  00000580  4E60                           move    a0,usp                  ; this side may
  906                                           .else
  907                                 -         move.l  a0,-(sp)
  908                                 -         .endif
  909  00000582  41FAFFF0                       lea     yx6_drumD+8(pc),a0
  910  00000586  5290                           addq.l  #1,(a0)
  911                                           .if YX6_SUPER_HOST
  912  00000588  4E68                           move    usp,a0
  913                                           .else
  914                                 -         movea.l (sp)+,a0
  915                                 -         .endif
  916  0000058A  11FC00EFFA11                   move.b  #$EF,$FFFFFA11.w
  917  00000590  4E73                           rte
  918                                   .ended:
  919  00000592  11FC000D8802                   move.b  #$D,$FFFF8802.w
  920  00000598  023800F0FA1D                   andi.b  #$F0,$FFFFFA1D.w
  921  0000059E  46FC2500                       move.w  #$2500,sr
  922                                           .if YX6_SUPER_HOST
  923  000005A2  4E60                           move    a0,usp
  924                                           .else
  925                                 -         move.l  a0,-(sp)
  926                                 -         .endif
  927  000005A4  41FAxxxx                       lea     yx6_drums(pc),a0
  928                                   yx6_drumD_clear:
  929  000005A8  021000FF                       andi.b  #$FF,(a0)
  930                                           .if YX6_SUPER_HOST
  931  000005AC  4E68                           move    usp,a0
  932                                           .else
  933                                 -         movea.l (sp)+,a0
  934                                 -         .endif
  935                                   yx6_parkD:
  936  000005AE  11FC00EFFA11                   move.b  #$EF,$FFFFFA11.w
  937  000005B4  4E73                           rte
  938                                   
  939                                   yx6_sidD_on:
  940  000005B6  21FC08000F008800               move.l  #$08000F00,$FFFF8800.w
  941  000005BE  46FC2500                       move.w  #$2500,sr
  942  000005C2  31FC00000112                   move.w  #0,$112.w
  943  000005C8  11FC00EFFA11                   move.b  #$EF,$FFFFFA11.w
  944  000005CE  4E73                           rte
  945                                   yx6_sidD_off:
  946  000005D0  21FC080000008800               move.l  #$08000000,$FFFF8800.w
  947  000005D8  46FC2500                       move.w  #$2500,sr
  948  000005DC  31FC00000112                   move.w  #0,$112.w
  949  000005E2  11FC00EFFA11                   move.b  #$EF,$FFFFFA11.w
  950  000005E8  4E73                           rte
  951                                   
  952                                   yx6_buzzD:
  953  000005EA  21FC0D0000008800               move.l  #$0D000000,$FFFF8800.w
  954  000005F2  46FC2500                       move.w  #$2500,sr
  955  000005F6  11FC00EFFA11                   move.b  #$EF,$FFFFFA11.w
  956  000005FC  4E73                           rte
  957                                   
  958                                   yx6_drums:
  959  000005FE  00                             dc.b    0                       ; voice bits 0-2: a drum is running
  960  000005FF  00                             even
  961                                   
  962                                   ; Where the patched operands sit, measured on the A block; the D block is
  963                                   ; byte-congruent, so the same offsets serve both through SD_ISR.
  964                                   ; rmac evaluates left to right: the parentheses are load-bearing.
  965           =00000003               ISR_DRUM_SEL    equ     3
  966           =00000008               ISR_DRUM_PTR    equ     8
  967           =0000003F               ISR_CLEAR       equ     (yx6_drumA_clear-yx6_drumA)+3
  968           =0000004A               ISR_SIDON       equ     yx6_sidA_on-yx6_drumA
  969           =0000004C               ISR_SIDON_SEL   equ     ISR_SIDON+2
  970           =0000004E               ISR_SID_VOL     equ     ISR_SIDON+4
  971           =00000058               ISR_SIDON_NEXT  equ     ISR_SIDON+14
  972           =00000064               ISR_SIDOFF      equ     yx6_sidA_off-yx6_drumA
  973           =00000066               ISR_SIDOFF_SEL  equ     ISR_SIDOFF+2
  974           =00000072               ISR_SIDOFF_NEXT equ     ISR_SIDOFF+14
  975           =0000007E               ISR_BUZZ        equ     yx6_buzzA-yx6_drumA
  976           =00000082               ISR_BUZZ_SHAPE  equ     ISR_BUZZ+4
  977                                   
  978                                   ; -----------------------------------------------------------------------------
  979                                   ; yx6_link, from YX6_init: the run-time addresses only a loaded player knows.
  980                                   ; Each descriptor gets its ISR block and its partner, both slots' last code
  981                                   ; and count are cleared, and the SID halves get each other's address low
  982                                   ; word - the vector's high word never changes, and neither do these, so
  983                                   ; they are patched once here rather than on every SID start.
  984                                   ; -----------------------------------------------------------------------------
  985                                   yx6_link:
  986  00000600  41FAFEB0                       lea     yx6_desc1(pc),a0
  987  00000604  43FAFEC0                       lea     yx6_desc2(pc),a1
  988  00000608  21490010                       move.l  a1,SD_OTHER(a0)
  989  0000060C  23480010                       move.l  a0,SD_OTHER(a1)
  990  00000610  4250                           clr.w   (a0)                    ; E and T last, both slots
  991  00000612  4251                           clr.w   (a1)
  992  00000614  45FAFEC4                       lea     yx6_drumA(pc),a2
  993  00000618  214A000C                       move.l  a2,SD_ISR(a0)
  994  0000061C  61xx                           bsr.s   .partners
  995  0000061E  45FAFF4C                       lea     yx6_drumD(pc),a2
  996  00000622  234A000C                       move.l  a2,SD_ISR(a1)
  997                                   .partners:
  998  00000626  41EA0064                       lea     ISR_SIDOFF(a2),a0       ; each half installs the other
  999  0000062A  2008                           move.l  a0,d0
 1000  0000062C  35400058                       move.w  d0,ISR_SIDON_NEXT(a2)
 1001  00000630  41EA004A                       lea     ISR_SIDON(a2),a0
 1002  00000634  2008                           move.l  a0,d0
 1003  00000636  35400072                       move.w  d0,ISR_SIDOFF_NEXT(a2)
 1004  0000063A  4E75                           rts
 1005                                   
 1006                                   ; -----------------------------------------------------------------------------
 1007                                   ; yx6_slot: one slot of the effect stage - both slots, through a5.
 1008                                   ; A changed code reprograms the slot's timer from scratch, a held one
 1009                                   ; updates only the count (a running MFP timer loads it at its next reload),
 1010                                   ; a dropped one stops the timer - unless the slot ran a drum, which
 1011                                   ; finishes by itself. A held DRUM code is a trigger on EVERY frame it is
 1012                                   ; present, as the reference player starts one on each coded frame: real
 1013                                   ; dumps carry back-to-back codes whose ring bytes name different samples -
 1014                                   ; an attack, then a body - and only a full restart plays the second one.
 1015                                   ;
 1016                                   ; in: d0.b = E (never 0 with E-last also 0: the caller's gate), d1.b = T,
 1017                                   ;     a5 = the slot's descriptor, a3 = workspace, d3.l = N.
 1018                                   ; preserves d3/a3/a5; clobbers d0-d2/d4-d5, a0-a2/a4.
 1019                                   ; -----------------------------------------------------------------------------
 1020                                   yx6_slot:
 1021  0000063C  B015                           cmp.b   (a5),d0
 1022  0000063E  6700xxxx                       beq.w   .held
 1023  00000642  1815                           move.b  (a5),d4                 ; what the slot was doing before
 1024  00000644  1A80                           move.b  d0,(a5)
 1025  00000646  4A00                           tst.b   d0
 1026  00000648  6700xxxx                       beq.w   .released
 1027                                   ; A new code: find the parameter register's ring - r8+voice carries the SID
 1028                                   ; volume, the drum number or the buzzer shape - then let the type arm its
 1029                                   ; handler; every type then (re)programs the timer the same way. The voice
 1030                                   ; stays live in d5, the parameter byte in a1, for whoever needs them.
 1031  0000064C  1A00                           move.b  d0,d5
 1032  0000064E  E80D                           lsr.b   #4,d5
 1033  00000650  CA7C0003                       and.w   #3,d5
 1034  00000654  5345                           subq.w  #1,d5                   ; the voice, 0..2
 1035  00000656  3405                           move.w  d5,d2
 1036  00000658  5042                           addq.w  #8,d2
 1037  0000065A  C4EB0024                       mulu.w  YX6_N(a3),d2
 1038  0000065E  2B420008                       move.l  d2,SD_PARM(a5)
 1039  00000662  2253                           movea.l YX6_CURSOR(a3),a1
 1040  00000664  D3C2                           adda.l  d2,a1                   ; a1 = the slot's parameter byte
 1041  00000666  1400                           move.b  d0,d2                   ; (d4 still holds the OLD code, for
 1042  00000668  C43C00C0                       and.b   #$C0,d2                 ; the retune test below)
 1043  0000066C  67xx                           beq.s   .sid
 1044  0000066E  B43C0040                       cmp.b   #$40,d2
 1045  00000672  67xx                           beq.s   .drum
 1046  00000674  1811                           move.b  (a1),d4                 ; $C0, the buzzer ($80 never packs):
 1047  00000676  C83C000F                       and.b   #15,d4                  ; the shape rides the tick's immediate
 1048  0000067A  206D000C                       movea.l SD_ISR(a5),a0
 1049  0000067E  11440082                       move.b  d4,ISR_BUZZ_SHAPE(a0)
 1050  00000682  41E8007E                       lea     ISR_BUZZ(a0),a0
 1051  00000686  60xx                           bra.s   .armed
 1052                                   .sid:
 1053                                   ; While a drum owns this voice, its volume register is the drum's alone: the
 1054                                   ; SID stays un-armed and the cleared last-code makes every following frame
 1055                                   ; retry, so it comes back by itself the frame after the drum ends. That is
 1056                                   ; the reference player's priority, where the drum overrides the volume.
 1057  00000688  7401                           moveq   #1,d2                   ; (d4 still holds the OLD code)
 1058  0000068A  EB2A                           lsl.b   d5,d2
 1059  0000068C  C43AFF70                       and.b   yx6_drums(pc),d2
 1060  00000690  67xx                           beq.s   .sid_free
 1061  00000692  4215                           clr.b   (a5)
 1062  00000694  4E75                           rts
 1063                                   .sid_free:
 1064                                   ; A code that differs from the old one ONLY in its prescaler is the same
 1065                                   ; SID sliding across a prescaler boundary - real tunes wobble across one
 1066                                   ; many times a second. The reference player free-runs the square's phase
 1067                                   ; through frequency changes, so keep the installed half: retune the timer
 1068                                   ; without touching the vector. A full restart here would reset the phase
 1069                                   ; to the loud half every flip - an audible ticking.
 1070  00000696  1400                           move.b  d0,d2
 1071  00000698  B902                           eor.b   d4,d2
 1072  0000069A  C43C00F0                       and.b   #$F0,d2                 ; type and voice unchanged?
 1073  0000069E  67xx                           beq.s   .sid_retune
 1074  000006A0  3805                           move.w  d5,d4                   ; a fresh SID: the voice's volume
 1075  000006A2  5044                           addq.w  #8,d4                   ; register into both halves' selects
 1076  000006A4  206D000C                       movea.l SD_ISR(a5),a0
 1077  000006A8  1144004C                       move.b  d4,ISR_SIDON_SEL(a0)
 1078  000006AC  11440066                       move.b  d4,ISR_SIDOFF_SEL(a0)
 1079  000006B0  1811                           move.b  (a1),d4
 1080  000006B2  C83C000F                       and.b   #15,d4
 1081  000006B6  1144004E                       move.b  d4,ISR_SID_VOL(a0)      ; the loud half's volume
 1082  000006BA  41E8004A                       lea     ISR_SIDON(a0),a0
 1083  000006BE  60xx                           bra.s   .armed
 1084                                   .sid_retune:
 1085  000006C0  1811                           move.b  (a1),d4                 ; the volume still tracks the ring
 1086  000006C2  C83C000F                       and.b   #15,d4
 1087  000006C6  206D000C                       movea.l SD_ISR(a5),a0
 1088  000006CA  1144004E                       move.b  d4,ISR_SID_VOL(a0)
 1089  000006CE  306D0006                       movea.w SD_VEC(a5),a0           ; keep whichever half is installed:
 1090  000006D2  2050                           movea.l (a0),a0                 ; .armed writes the same value back
 1091  000006D4  60xx                           bra.s   .armed
 1092                                   .drum:
 1093  000006D6  6100xxxx                       bsr     yx6_drum_start
 1094                                   .armed:
 1095  000006DA  1B410001                       move.b  d1,SD_TLAST(a5)
 1096  000006DE  326D0002                       movea.w SD_CTRL(a5),a1
 1097  000006E2  346D0006                       movea.w SD_VEC(a5),a2
 1098  000006E6  40E7                           move.w  sr,-(sp)
 1099  000006E8  007C0700                       ori.w   #$0700,sr
 1100  000006EC  021100F0                       andi.b  #$F0,(a1)               ; stop, then vector, count, prescaler
 1101  000006F0  2488                           move.l  a0,(a2)
 1102  000006F2  346D0004                       movea.w SD_DATA(a5),a2
 1103  000006F6  1481                           move.b  d1,(a2)
 1104  000006F8  1A00                           move.b  d0,d5
 1105  000006FA  CA3C0007                       and.b   #7,d5
 1106  000006FE  8B11                           or.b    d5,(a1)
 1107  00000700  46DF                           move.w  (sp)+,sr
 1108  00000702  4E75                           rts
 1109                                   .released:
 1110  00000704  C83C00C0                       and.b   #$C0,d4                 ; the level dropped: stop the timer -
 1111  00000708  B83C0040                       cmp.b   #$40,d4                 ; unless a drum is finishing by itself
 1112  0000070C  67xx                           beq.s   .out
 1113  0000070E  326D0002                       movea.w SD_CTRL(a5),a1
 1114  00000712  021100F0                       andi.b  #$F0,(a1)
 1115                                   .out:
 1116  00000716  4E75                           rts
 1117                                   .held:                                  ; E != 0 here: the caller's gate
 1118  00000718  1A00                           move.b  d0,d5
 1119  0000071A  CA3C00C0                       and.b   #$C0,d5
 1120  0000071E  BA3C0040                       cmp.b   #$40,d5
 1121  00000722  67B2                           beq.s   .drum                   ; a held drum code triggers again
 1122  00000724  B22D0001                       cmp.b   SD_TLAST(a5),d1         ; reload only a CHANGED count: a write
 1123  00000728  67xx                           beq.s   .track                  ; meeting the counter at 01 is
 1124  0000072A  1B410001                       move.b  d1,SD_TLAST(a5)         ; indeterminate, so do not roll dice
 1125  0000072E  346D0004                       movea.w SD_DATA(a5),a2          ; fifty times a second
 1126  00000732  1481                           move.b  d1,(a2)
 1127                                   .track:
 1128                                   ; The level-held effects track their parameter every frame: the SID volume
 1129                                   ; and the buzzer shape follow the voice's ring byte, as the reference player
 1130                                   ; re-reads them.
 1131  00000734  2053                           movea.l YX6_CURSOR(a3),a0
 1132  00000736  D1ED0008                       adda.l  SD_PARM(a5),a0
 1133  0000073A  1810                           move.b  (a0),d4
 1134  0000073C  C83C000F                       and.b   #15,d4
 1135  00000740  206D000C                       movea.l SD_ISR(a5),a0
 1136  00000744  4A05                           tst.b   d5                      ; $00 SID, $C0 buzzer
 1137  00000746  67xx                           beq.s   .vol
 1138  00000748  11440082                       move.b  d4,ISR_BUZZ_SHAPE(a0)
 1139  0000074C  4E75                           rts
 1140                                   .vol:
 1141  0000074E  1144004E                       move.b  d4,ISR_SID_VOL(a0)
 1142  00000752  4E75                           rts
 1143                                   
 1144                                   ; -----------------------------------------------------------------------------
 1145                                   ; yx6_drum_start: read the sample number from the drummed voice's ring byte
 1146                                   ; and silence that byte - it is a number, not a volume - flag the voice for
 1147                                   ; the mixer pass, then arm the drum routine: its select register, its sample
 1148                                   ; address, and the flag-clearing mask, all patched into its own operands.
 1149                                   ; If the other slot holds a SID on this same voice, the drum takes the
 1150                                   ; volume register for itself, as the reference player's drum override does:
 1151                                   ; stop that SID's timer and clear its last code, so the slot retries every
 1152                                   ; frame - suppressed while the flag is up - and restarts the SID by itself
 1153                                   ; the frame after the drum ends.
 1154                                   ; Called from the new-code path AND the held retrigger, which has neither
 1155                                   ; the voice nor the parameter pointer at hand - so it derives its own.
 1156                                   ; in: d0.b = E, a5 = the descriptor, SD_PARM set; out: a0 = the handler;
 1157                                   ; keeps d0/d1/d3/a5.
 1158                                   ; -----------------------------------------------------------------------------
 1159                                   yx6_drum_start:
 1160  00000754  2053                           movea.l YX6_CURSOR(a3),a0
 1161  00000756  D1ED0008                       adda.l  SD_PARM(a5),a0
 1162  0000075A  6100xxxx                       bsr     yx6_borrow              ; the ring gets this byte back
 1163  0000075E  7800                           moveq   #0,d4
 1164  00000760  1810                           move.b  (a0),d4                 ; the sample number, validated at pack
 1165  00000762  4210                           clr.b   (a0)                    ; sanitize: silence, not a number
 1166  00000764  1A00                           move.b  d0,d5
 1167  00000766  E80D                           lsr.b   #4,d5
 1168  00000768  CA7C0003                       and.w   #3,d5
 1169  0000076C  5345                           subq.w  #1,d5                   ; the voice, for flag and select
 1170  0000076E  7401                           moveq   #1,d2
 1171  00000770  EB2A                           lsl.b   d5,d2
 1172  00000772  41FAFE8A                       lea     yx6_drums(pc),a0
 1173  00000776  8510                           or.b    d2,(a0)                 ; the mixer pass forces this voice off
 1174  00000778  4602                           not.b   d2
 1175  0000077A  226D000C                       movea.l SD_ISR(a5),a1
 1176  0000077E  1342003F                       move.b  d2,ISR_CLEAR(a1)        ; the end tick drops the same flag
 1177  00000782  286D0010                       movea.l SD_OTHER(a5),a4         ; a SID on this voice in the other
 1178  00000786  1414                           move.b  (a4),d2                 ; slot: the drum takes the register
 1179  00000788  C43C00C0                       and.b   #$C0,d2
 1180  0000078C  66xx                           bne.s   .keep
 1181  0000078E  1414                           move.b  (a4),d2
 1182  00000790  B102                           eor.b   d0,d2
 1183  00000792  C43C0030                       and.b   #$30,d2
 1184  00000796  66xx                           bne.s   .keep
 1185  00000798  306C0002                       movea.w SD_CTRL(a4),a0
 1186  0000079C  021000F0                       andi.b  #$F0,(a0)               ; stop the other slot's SID
 1187  000007A0  4214                           clr.b   (a4)                    ; and let it retry every frame
 1188                                   .keep:
 1189  000007A2  3405                           move.w  d5,d2
 1190  000007A4  5042                           addq.w  #8,d2                   ; the voice's volume register
 1191  000007A6  13420003                       move.b  d2,ISR_DRUM_SEL(a1)     ; the tick's select immediate
 1192  000007AA  D844                           add.w   d4,d4                   ; a drum table entry is six bytes:
 1193  000007AC  3404                           move.w  d4,d2                   ; 6n = 2n + 4n
 1194  000007AE  D844                           add.w   d4,d4
 1195  000007B0  D842                           add.w   d2,d4
 1196  000007B2  246B0014                       movea.l YX6_FILE(a3),a2
 1197  000007B6  204A                           movea.l a2,a0
 1198  000007B8  D1E8001C                       adda.l  YH_DRUMS(a0),a0
 1199  000007BC  24304000                       move.l  0(a0,d4.w),d2           ; the sample's offset in the file
 1200  000007C0  D48A                           add.l   a2,d2
 1201  000007C2  23420008                       move.l  d2,ISR_DRUM_PTR(a1)     ; the tick reads through its operand
 1202  000007C6  2049                           movea.l a1,a0                   ; the handler is the block base
 1203  000007C8  4E75                           rts
 1204                                   
 1205                                   ; Records a ring byte about to be edited, for the restore after the burst.
 1206                                   ; in: a0 = the byte; clobbers d2.
 1207                                   yx6_borrow:
 1208  000007CA  7400                           moveq   #0,d2
 1209  000007CC  142B0036                       move.b  YX6_PATCHES(a3),d2
 1210  000007D0  522B0036                       addq.b  #1,YX6_PATCHES(a3)
 1211  000007D4  17902037                       move.b  (a0),YX6_PATCH_VAL(a3,d2.w)
 1212  000007D8  D442                           add.w   d2,d2
 1213  000007DA  D442                           add.w   d2,d2
 1214  000007DC  2788203A                       move.l  a0,YX6_PATCH_ADDR(a3,d2.w)
 1215  000007E0  4E75                           rts
    4                                           include "ST4_wrap.S"
    1                                   ; -----------------------------------------------------------------------------
    2                                   ; ST4_wrap.S - ST4: counted-wrap ring decompressor for the Atari ST (68000)
    3                                   ;
    4                                   ; By Robbert van Dalen, based on ZX1 v1.5 by Einar Saukas and on ST1_wrap.S,
    5                                   ; which this follows instruction for instruction wherever the format allows.
    6                                   ; Written by Claude (Anthropic's Claude Code) under Robbert's direction. Use it
    7                                   ; freely, including commercially, as long as your documentation says you used
    8                                   ; ZX1 through ST4 (see LICENSE).
    9                                   ;
   10                                   ; ST4_wrap is ST1_wrap with ST4's three streams and units: the literal payload
   11                                   ; comes from stream B in a2 and the offsets from stream C in a4 (bytes) or D in
   12                                   ; a5 (words), lengths and budgets count units of ST4_UNIT bytes, and the copy
   13                                   ; moves a unit at a time. With the offsets gone, stream A holds nothing but
   14                                   ; bits, so the queue refills a word at a time. Set the unit size before
   15                                   ; including:
   16                                   ;
   17                                   ;       ST4_UNIT    equ     4
   18                                   ;               include "ST4_wrap.S"
   19                                   ;
   20                                   ; !!! LIKE ST1_wrap, THIS HAS NO DONE STATE !!!
   21                                   ; The caller must know the exact output size O in units, make exactly
   22                                   ; T = ceil(O/C) decode calls, and never call again.
   23                                   ;
   24                                   ; The ring is N BYTES and must be a whole number of units; the caller resets a1
   25                                   ; to the ring start after every F = N/(C*UNIT) calls. Budgets and remaining
   26                                   ; counts are units; offsets, positions and N are bytes - which is what keeps
   27                                   ; the wrap arithmetic identical to ST1_wrap's.
   28                                   ;
   29                                   ; The copy engine runs two ladders. Match segments of at most sixteen units -
   30                                   ; measured to be four of every five segments a small-budget streamer makes,
   31                                   ; with the whole-chunk segment the most common of all - take a counter-free
   32                                   ; ladder that falls straight into the match epilogue: no full-pass shift, no
   33                                   ; loop counter, no post-copy kind test. Literals and longer segments take the
   34                                   ; classic counted ladder. And there is no first-call test: ST4_init seeds the
   35                                   ; bit queue with one virtual 0 flag ($4000), so a fresh state decodes itself
   36                                   ; through a zero-unit match segment and reads that flag as "begin literals"
   37                                   ; exactly where the old entry branch went.
   38                                   ;
   39                                   ; The container is ST4.S's: twenty bytes of header - signature, O, and where
   40                                   ; streams B, C and D begin - then A, B, C and D in order. See ST4.S for the
   41                                   ; eight instructions that open one.
   42                                   ;
   43                                   ; THE STATE IS YOUR REGISTERS:
   44                                   ;
   45                                   ;   a0.l  position in stream A          a1.l  write pointer
   46                                   ;   a2.l  position in stream B          a4.l  stream C, the byte offsets
   47                                   ;   a5.l  stream D, the word offsets    d0.w  bit queue ($8000 empty)
   48                                   ;   d1.l  -ring_start.low : units remaining
   49                                   ;   d2.l  N : signed byte offset (+lastOffset*UNIT literals, - during a match)
   50                                   ;
   51                                   ;   resume in    d3.w   this call's budget in UNITS
   52                                   ;   CLOBBERED    d3.w d4.l d5.l a3.l
   53                                   ;   untouched    d6 d7 a6
   54                                   ;
   55                                   ; ASSUMPTIONS (unchecked; violating them is undefined behaviour):
   56                                   ;
   57                                   ;   1. THE RING SIZE N IS A MULTIPLE OF ST4_UNIT, and the ring starts on a unit
   58                                   ;      boundary - as does the destination. A wide move would fault on an odd
   59                                   ;      address, and the caller's wrap has to land on a unit
   60                                   ;   2. N mod (C * ST4_UNIT) = 0, so F = N/(C*UNIT) calls fill the ring exactly
   61                                   ;   3. no offset exceeds 32512 BYTES - the packer clamps -m to that
   62                                   ;   4. no operation is longer than 65535 units - compress with -l65535
   63                                   ;   5. the caller knows O and makes exactly T = ceil(O/C) calls, as ST1_wrap
   64                                   ;   6. streams A and D start on even addresses, and A holds an even number of
   65                                   ;      bytes: the bit queue is refilled with a move.w, and so is a word offset
   66                                   ;
   67                                   ; Compress with st4 -k<UNIT> -m<ring/UNIT> -l65535.
   68                                   ; -----------------------------------------------------------------------------
   69                                   
   70                                   ; The asset's signature for this build: 'S4', format version 4, and the unit
   71                                   ; size this decoder was assembled for. One cmp.l against a file's first long
   72                                   ; proves all three at once.
   73           =53340401               ST4_SIGNATURE   equ     $53340400+ST4_UNIT
   74                                   
   75                                   ; One unit copied, at the width this build was made for.
   76                                           .macro ST4_MOVE
   77                                 .         .if ST4_UNIT=4
   78                                 .         move.l  (a3)+,(a1)+
   79                                 .         .endif
   80                                 .         .if ST4_UNIT=2
   81                                 .         move.w  (a3)+,(a1)+
   82                                 .         .endif
   83                                 .         .if ST4_UNIT=1
   84                                 .         move.b  (a3)+,(a1)+
   85                                 .         .endif
   86                                 .         .endm
   87                                   
   88                                   ; Jump table: bra.w keeps 4-byte slots (base+0/4). A counted ring has no
   89                                   ; one-shot entry; the caller drains it through ST4_resume.
   90  000007E2  6000xxxx                               bra.w   ST4_init
   91  000007E6  6000xxxx                               bra.w   ST4_resume
   92                                   
   93                                   ; ST4_init: a0 = A, a1 = first ring byte, a2 = B, a4 = C, a5 = D,
   94                                   ; d3.w = N.
   95                                   ; Packs -ring_start.low/N above the common state; writes no memory.
   96                                   ; Java: the Decompressor constructor / reset().
   97                                   ST4_init:
   98  000007EA  7200                           moveq   #0,d1
   99  000007EC  9249                           sub.w   a1,d1                   ; -ring_start.low, exact modulo 65536
  100  000007EE  4841                           swap    d1                      ; pack it high; remaining = 0
  101                                   ; The initial offset has to land in the low word after the swap, so it starts
  102                                   ; in the high half. moveq would put -1 there whatever the unit size, which is
  103                                   ; a byte short at k=2 and three at k=4 - and only shows up on a stream whose
  104                                   ; first match reuses INITIAL_OFFSET.
  105  000007F0  243CFFFF0000                   move.l  #(-ST4_UNIT)<<16,d2
  106  000007F6  3403                           move.w  d3,d2                   ; N lives below it for now
  107  000007F8  4842                           swap    d2                      ; N above, -INITIAL_OFFSET*UNIT below
  108                                   ; One virtual 0 flag, then the empty sentinel. The first resume call runs a
  109                                   ; zero-unit match segment through the normal path - remaining is zero, so
  110                                   ; n = 0 and the ladder is entered at its end - and lands in match_transition,
  111                                   ; which shifts $4000 into $8000: the flag reads as "begin literals" and the
  112                                   ; queue is the empty sentinel the old first call started from. That is what
  113                                   ; lets ST4_resume skip a first-call test on every call.
  114  000007FA  303C4000                       move.w  #$4000,d0
  115  000007FE  4E75                           rts
  116                                   
  117                                   source_wrapped:
  118  00000800  2A02                           move.l  d2,d5
  119  00000802  4245                           clr.w   d5
  120  00000804  4845                           swap    d5                      ; zero-extend N from d2.high
  121  00000806  D7C5                           adda.l  d5,a3                   ; raw source + N, back into the ring
  122  00000808  60xx                           bra.s   copy
  123                                   
  124                                   ; ST4_resume: a0/a1/d0/d1/d2 = state and d3.w = this call's budget.
  125                                   ; Continuing calls emit d3 bytes; the final call may be shorter. The caller
  126                                   ; knows the final span from O; [old a1 .. new a1) is fresh output.
  127                                   ST4_resume:
  128  0000080A  3803                           move.w  d3,d4                   ; seed n from the budget; a fresh state
  129                                   segment:                                ; runs one 0-unit match segment and
  130  0000080C  B841                           cmp.w   d1,d4                   ; reads the seeded flag afterwards.
  131  0000080E  63xx                           bls.s   budget_fits             ; n = min(budget, remaining)
  132  00000810  3801                           move.w  d1,d4
  133                                   budget_fits:
  134  00000812  4A42                           tst.w   d2                      ; positive lastOffset means LITERALS
  135  00000814  6Axx                           bpl.s   literal_source
  136                                   ; MATCH: derive the source and split a segment that crosses the ring end.
  137  00000816  2649                           movea.l a1,a3                   ; raw source = dst + -lastOffset*UNIT
  138  00000818  D6C2                           adda.w  d2,a3                   ; which is why the offset is kept scaled
  139  0000081A  2A01                           move.l  d1,d5
  140  0000081C  4845                           swap    d5                      ; d5.w = -ring_start.low
  141  0000081E  DA49                           add.w   a1,d5                   ; d5.w = destination position
  142  00000820  DA42                           add.w   d2,d5                   ; add -offset; carry means unwrapped
  143  00000822  65xx                           bcs.s   copy                    ; unwrapped source cannot cross before dst
  144  00000824  4445                           neg.w   d5                      ; wrapped: room = offset - position
  145                                   ; The room is bytes and the segment is units, so bring them to the same scale.
  146                                   ; Both are whole units - offsets and positions are - so the shift is exact.
  147                                           .if ST4_UNIT=2
  148                                 -         lsr.w   #1,d5
  149                                 -         .endif
  150                                           .if ST4_UNIT=4
  151                                 -         lsr.w   #2,d5              ; one shift, not two: 10 cycles, not 16
  152                                 -         .endif
  153  00000826  BA44                           cmp.w   d4,d5                   ; source units before the ring end
  154  00000828  64D6                           bcc.s   source_wrapped
  155  0000082A  3805                           move.w  d5,d4                   ; stop this segment at the source wrap
  156  0000082C  60D2                           bra.s   source_wrapped
  157                                   
  158                                   copy:                                   ; MATCH copies only reach this entry
  159  0000082E  9244                           sub.w   d4,d1                   ; consume n from the operation
  160  00000830  9644                           sub.w   d4,d3                   ; and from this call's budget
  161  00000832  B87C0011                       cmp.w   #17,d4
  162  00000836  64xx                           bcc.s   copy_slow               ; n >= 17: the counted ladder
  163  00000838  D844                           add.w   d4,d4
  164  0000083A  4444                           neg.w   d4                      ; d4 = -2n is the dispatch index itself,
  165  0000083C  4EFB40xx                       jmp     fast_end(pc,d4.w)       ; and $ffxx for byte_offset afterwards
  166                                   fast_ladder:
  167                                   ; Sixteen unit moves: entry at fast_end-2k copies k units.
  168                                           .rept   16
  169                                 #         ST4_MOVE
                                      #         .endr
                                      #         ST4_MOVE
                                      @         .if ST4_UNIT=4
                                      -         move.l  (a3)+,(a1)+
