#!/bin/sh
# The Java suite as .github/workflows/test.yml runs it, on this machine.
# A test that skips is a check that did not run, so this requires what the
# skipping tests need, runs the suite, and reads the skip count back: a
# count above 0 ends this with exit 1 and the lines that report it.
# doc/tools.md.
#
#   bin/suite [maven argument ...]
set -e
root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
cd "$root"

# GoParityTest builds the Go tools and reads them against the Java tree,
# and skips where go is absent. ConsistencyTest and RigsTest assemble the
# decoders with rmac, which they run from the path. RigsTest decodes under
# unicorn, which python3 imports. The C# tree is a separate suite, which
# dotnet runs after the Java one.
if ! command -v go >/dev/null 2>&1; then
    echo "suite: GoParityTest builds the Go tools, and go is not on the path" >&2
    exit 2
fi
if ! command -v rmac >/dev/null 2>&1; then
    echo "suite: the decoders are assembled by rmac, which is not on the path" >&2
    exit 2
fi
if ! python3 -c "import unicorn" >/dev/null 2>&1; then
    echo "suite: RigsTest decodes under unicorn: pip install unicorn" >&2
    exit 2
fi
if ! command -v dotnet >/dev/null 2>&1; then
    echo "suite: the C# tree is tested by dotnet, which is not on the path" >&2
    exit 2
fi

log=target/suite.log
status=target/suite.status
mkdir -p target
( set +e; mvn -B --no-transfer-progress "$@" test 2>&1; echo $? > "$status" ) | tee "$log"
[ "$(cat "$status")" = 0 ] || exit "$(cat "$status")"

said=$(grep -oE 'Tests run: [0-9]+, Failures: [0-9]+, Errors: [0-9]+, Skipped: [0-9]+$' \
    "$log" | tail -1)
if [ -z "$said" ]; then
    echo "suite: the run reported no count of tests" >&2
    exit 1
fi
skipped=${said##*: }
if [ "$skipped" != 0 ]; then
    echo "suite: $skipped skipped, and a whole run reads 0" >&2
    grep -E 'Skipped: [1-9]' "$log" >&2
    exit 1
fi
java=$(echo "$said" | sed -n 's/^Tests run: \([0-9]*\).*/\1/p')

# The C# tree: dotnet test reports one line of counts, and a skip there is
# a check that did not run as much as one in the Java suite.
( set +e; dotnet test csharp/Nt4.slnx 2>&1; echo $? > "$status" ) | tee -a "$log"
[ "$(cat "$status")" = 0 ] || exit "$(cat "$status")"
counts=$(grep -oE 'Failed: +[0-9]+, Passed: +[0-9]+, Skipped: +[0-9]+' "$log" | tail -1)
if [ -z "$counts" ]; then
    echo "suite: dotnet test reported no count of tests" >&2
    exit 1
fi
if [ "$(echo "$counts" | sed -n 's/.*Skipped: *\([0-9]*\).*/\1/p')" != 0 ]; then
    echo "suite: the C# tree skipped a test: $counts" >&2
    exit 1
fi
csharp=$(echo "$counts" | sed -n 's/.*Passed: *\([0-9]*\).*/\1/p')
echo "suite: $java tests and $csharp in C#, 0 skipped"
