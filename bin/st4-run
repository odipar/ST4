#!/bin/sh
# Runs one of ST4's Java tools out of target/classes, and builds first where
# a source is newer than the last build. The two scripts beside this one name
# a class and pass their arguments on.
#
# A tool reads standard input and writes standard output, so the build is
# given no input of its own and its output goes to standard error.
set -e

class=$1
shift

root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
classes=$root/target/classes
built=$classes/.built

if [ ! -f "$built" ] || [ -n "$(find "$root/src/main/java" \
        -newer "$built" -print -quit 2>/dev/null)" ]; then
    (cd "$root" && mvn -q compile </dev/null >&2)
    : > "$built"
fi

exec java -cp "$classes" "$class" "$@"
